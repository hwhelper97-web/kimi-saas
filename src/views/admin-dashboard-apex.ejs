<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= typeof businessName !=='undefined' ? businessName + ' — Naxton Technologies' : 'Naxton Technologies' %>
  </title>
  <link rel="icon" type="image/png" href="<%= platformLogo || '' %>">

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin-apex.css" />

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body data-theme="ocean">
  <script>
    (function() {
      try {
        const user = JSON.parse(localStorage.getItem("user") || "{}");
        const theme = user.theme || localStorage.getItem("apex_theme") || "default";
        document.body.setAttribute("data-theme", theme);
      } catch (e) {}
    })();
  </script>

  <div class="apex-layout">

    <!-- SIDEBAR -->
    <aside class="apex-sidebar">
      <div class="sidebar-header">
        <div class="logo-box">
          <% if (typeof platformLogo !=='undefined' && platformLogo) { %>
            <img id="brandLogoImg" src="<%= platformLogo %>" style="width: 100%; height: 100%; object-fit: contain;" />
            <i data-lucide="bot" id="brandLogoPlaceholder" style="display: none;"></i>
            <% } else { %>
              <img id="brandLogoImg" src="" style="width: 100%; height: 100%; object-fit: contain; display: none;" />
              <i data-lucide="bot" id="brandLogoPlaceholder"></i>
              <% } %>
        </div>
        <div class="logo-text">
          <h2 style="font-size: 1rem; font-weight: 700;" id="brandLogoText">
            <%= typeof businessName !=='undefined' ? businessName : (typeof projectName !=='undefined' ? projectName
              : 'Naxton Technologies' ) %>
          </h2>
          <p style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;">AI
            Voice Suite</p>
        </div>
      </div>

      <nav class="sidebar-nav" id="sidebarNav">
        <!-- Navigation items will be injected here by JS -->
      </nav>

      <div class="sidebar-footer" style="margin-top: auto; padding-top: 2rem; border-top: 1px solid var(--border);">
        <a class="apex-nav-item" onclick="logout()" style="color: var(--danger);">
          <i data-lucide="log-out"></i>
          <span>Sign Out</span>
        </a>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="apex-main">

      <!-- TOP HEADER -->
      <header class="apex-header">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <% if (typeof user !== 'undefined' && user.role === 'SUPERADMIN') { %>
            <a href="/superadmin" class="action-btn" style="background: var(--success); color: white; border: none; width: auto; padding: 0 1rem; gap: 0.5rem; text-decoration: none; display: flex; align-items: center; height: 40px;">
              <i data-lucide="arrow-left"></i>
              <span style="font-size: 0.75rem; font-weight: 700;">Back to SuperAdmin</span>
            </a>
          <% } %>
          <div class="header-search">
            <i data-lucide="search"></i>
            <input type="text" id="globalSearch" placeholder="Search for actions, orders, staff... (Ctrl+K)"
              oninput="handleGlobalSearch(this.value)" />
          </div>
        </div>

        <div class="header-actions">
          <div class="select-wrap" style="margin-right: 1rem;">
            <select id="businessSwitcher" onchange="switchBusiness(this.value)"
              style="background: var(--bg-muted); border: 1px solid var(--border); color: var(--text-primary); padding: 0.5rem 1rem; border-radius: 0.5rem; outline: none; font-size: 0.875rem;">
              <option value="">Switch Business</option>
            </select>
          </div>

          <div class="theme-selector" style="position: relative; margin-right: 1rem;">
            <button class="action-btn" id="themeBtn" title="Change Theme" onclick="toggleThemeMenu()">
              <i data-lucide="palette"></i>
            </button>
            <div id="themeMenu" class="apex-card" style="position: absolute; top: 100%; right: 0; width: 240px; z-index: 1000; display: none; margin-top: 0.5rem; padding: 1rem; border: 1px solid var(--border); box-shadow: var(--shadow-md);">
              <h4 style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; margin-bottom: 1rem; color: var(--text-muted);">Select Theme</h4>
              <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem;">
                <div class="theme-swatch" onclick="applyTheme('default')" style="background: #3b82f6;" title="Default Blue"></div>
                <div class="theme-swatch" onclick="applyTheme('light')" style="background: #ffffff; border: 1px solid #ccc;" title="Clean Light"></div>
                <div class="theme-swatch" onclick="applyTheme('midnight')" style="background: #0f172a;" title="Midnight Blue"></div>
                <div class="theme-swatch" onclick="applyTheme('forest')" style="background: #14532d;" title="Forest Green"></div>
                <div class="theme-swatch" onclick="applyTheme('sunset')" style="background: #431424;" title="Sunset Rose"></div>
                <div class="theme-swatch" onclick="applyTheme('cyberpunk')" style="background: #d946ef;" title="Cyberpunk Pink"></div>
                <div class="theme-swatch" onclick="applyTheme('ocean')" style="background: #082f49;" title="Deep Ocean"></div>
                <div class="theme-swatch" onclick="applyTheme('royal')" style="background: #1e1b4b;" title="Royal Purple"></div>
                <div class="theme-swatch" onclick="applyTheme('espresso')" style="background: #1c1917;" title="Espresso Brown"></div>
                <div class="theme-swatch" onclick="applyTheme('lavender')" style="background: #2e1065;" title="Lavender Mist"></div>
                <div class="theme-swatch" onclick="applyTheme('emerald')" style="background: #064e3b;" title="Emerald Isle"></div>
                <div class="theme-swatch" onclick="applyTheme('crimson')" style="background: #450a0a;" title="Crimson Red"></div>
                <div class="theme-swatch" onclick="applyTheme('slate')" style="background: #0f172a;" title="Slate Professional"></div>
                <div class="theme-swatch" onclick="applyTheme('neon')" style="background: #000000; border: 1px solid #22c55e;" title="Neon Green"></div>
                <div class="theme-swatch" onclick="applyTheme('minimalist')" style="background: #f8fafc; border: 1px solid #ddd;" title="Minimalist"></div>
              </div>
            </div>
          </div>

          <button class="action-btn" style="margin-right: 1rem;">
            <i data-lucide="bell"></i>
          </button>

          <div class="user-profile">
            <div class="user-avatar" style="overflow: hidden; padding: 0; background: transparent;">
              <img id="headerAvatarImg" src=""
                style="width: 100%; height: 100%; object-fit: cover; display: none; border-radius: 50%;" />
              <span id="headerAvatarText"
                style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; background: var(--primary);">AD</span>
            </div>
            <div style="padding-right: 0.75rem;">
              <p id="headerProfileName" style="font-size: 0.75rem; font-weight: 600;">Admin</p>
              <p style="font-size: 0.625rem; color: var(--text-muted);">Owner</p>
            </div>
          </div>
        </div>
      </header>

      <!-- PAGE CONTENT -->
      <div class="apex-content" id="scrollContainer">
        <div class="page-header" id="pageHeader">
          <h1 id="pageTitle">Dashboard</h1>
          <p id="pageSubtitle">Welcome back. Here's what's happening with your business today.</p>
        </div>

        <!-- DYNAMIC CONTENT AREA -->
        <div id="contentArea" style="flex: 1; display: flex; flex-direction: column;"></div>

        <!-- DASHBOARD GRID (Only visible on dashboard) -->
        <div id="dashboardGrid" style="display: none;">

          <div id="liveFeedContainer" class="apex-card"
            style="display: none; border: 1px solid var(--primary); background: rgba(var(--primary-rgb), 0.05); margin-bottom: 2rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
              <div style="display:flex; align-items:center; gap:0.5rem;">
                <div class="status-dot online"></div>
                <h3 style="font-size: 0.875rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;">
                  Live AI Interaction</h3>
              </div>
              <span id="liveCallId"
                style="font-size: 0.625rem; font-family: monospace; color: var(--text-muted);"></span>
            </div>
            <div id="liveTranscript"
              style="font-size: 0.875rem; line-height: 1.6; max-height: 150px; overflow-y: auto; padding: 1rem; background: var(--bg-card); border-radius: 0.5rem; border: 1px dashed var(--border);">
              <p style="color: var(--text-muted); font-style: italic;">Waiting for incoming voice stream...</p>
            </div>
          </div>

          <!-- STATS GRID -->
          <div class="apex-grid" id="statsGrid">
            <!-- Stat cards will be injected here -->
          </div>

          <!-- MAIN ANALYTICS ROW -->
          <div class="dashboard-main-grid">

            <div class="left-col">
              <div class="apex-card">
                <div class="card-header">
                  <h3 class="card-title">Revenue Growth</h3>
                  <div class="header-actions">
                    <button class="action-btn" style="width: auto; padding: 0 0.75rem; font-size: 0.75rem;">Last 7
                      Days</button>
                  </div>
                </div>
                <div style="height: 300px;">
                  <canvas id="revenueChart"></canvas>
                </div>
              </div>

              <div class="apex-card">
                <div class="card-header">
                  <h3 class="card-title">Call Volume History</h3>
                </div>
                <div style="height: 250px;">
                  <canvas id="callsChart"></canvas>
                </div>
              </div>
            </div>

            <div class="right-col">
              <!-- LIVE AI OPERATIONS -->
              <div class="apex-card dashboard-live-card" style="height: 350px; margin-bottom: 2rem;">
                <div class="card-header" style="flex-shrink: 0;">
                  <h3 class="card-title">Live AI Operations</h3>
                  <span class="pulse-indicator"
                    style="width: 8px; height: 8px; background: var(--success); border-radius: 50%;"></span>
                </div>
                <div id="liveCallsContainer"
                  style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem; padding-right: 4px; margin-bottom: 1rem; scrollbar-width: thin; scrollbar-color: var(--border) transparent;">
                  <div class="empty-state"
                    style="text-align: center; padding: 2rem; color: var(--text-muted); font-size: 0.875rem;">
                    Monitoring active streams...
                  </div>
                </div>
              </div>

              <!-- RECENT ACTIVITY WIDGET (Orders or Appointments) -->
              <div class="apex-card" id="recentOrdersWidget" style="height: 350px; display: flex; flex-direction: column;">
                <div class="card-header">
                  <h3 class="card-title" id="recentActivityTitle">Recent Orders</h3>
                  <i id="recentActivityIcon" data-lucide="shopping-bag" style="width: 16px; color: var(--primary);"></i>
                </div>
                <div id="dashboardOrdersList" style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 0.75rem;">
                   <div class="empty-state" style="text-align: center; padding: 2rem; color: var(--text-muted); font-size: 0.875rem;">
                    Waiting for orders...
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- FIXED PLATFORM WATERMARK -->
      <div
        style="position: fixed; bottom: 1rem; right: 1.5rem; font-size: 0.65rem; color: var(--text-muted); z-index: 50; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500; pointer-events: none;">
        Software by Naxton Technologies LLC
      </div>
    </main>
  </div>

  <!-- NOTIFICATIONS -->
  <div id="notificationBox" class="notification"
    style="position: fixed; top: 1.5rem; right: 1.5rem; transform: translateX(120%); transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); background: var(--bg-card); border: 1px solid var(--border); padding: 1.25rem 1.5rem; border-radius: var(--radius); box-shadow: var(--shadow-xl); z-index: 9999; display: flex; align-items: center; gap: 1rem; backdrop-filter: blur(12px);">
    <div id="notificationIcon" style="width: 40px; height: 40px; border-radius: 0.75rem; background: rgba(var(--primary-rgb), 0.1); display: flex; align-items: center; justify-content: center; color: var(--primary); flex-shrink: 0;">
      <i data-lucide="bell"></i>
    </div>
    <div>
      <h4 id="notificationTitle" style="font-size: 0.875rem; font-weight: 700;">Notification</h4>
      <p id="notificationText" style="font-size: 0.75rem; color: var(--text-secondary);">Something happened.</p>
    </div>
    <button onclick="document.getElementById('notificationBox').style.transform = 'translateX(120%)'" style="background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 0.25rem; margin-left: auto;">
      <i data-lucide="x" style="width: 14px; height: 14px;"></i>
    </button>
  </div>

  <audio id="notifySound" src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" preload="auto"></audio>
  <audio id="orderSound" src="https://assets.mixkit.co/active_storage/sfx/1066/1066-preview.mp3" preload="auto"></audio>

  <!-- NAXTON DEEP SYNC OVERLAY -->
  <div id="syncOverlay" class="modal-overlay"
    style="background: rgba(8, 51, 68, 0.95); backdrop-filter: blur(12px); display: none; opacity: 1; pointer-events: auto;">
    <div style="text-align: center; color: white; width: 100%; max-width: 500px;">
      <div style="position: relative; width: 200px; height: 200px; margin: 0 auto 3rem;">
        <svg viewBox="0 0 100 100" style="transform: rotate(-90deg); width: 100%; height: 100%;">
          <circle cx="50" cy="50" r="45" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="2" />
          <circle id="syncProgressCircle" cx="50" cy="50" r="45" fill="none" stroke="var(--primary)" stroke-width="4"
            stroke-dasharray="283" stroke-dashoffset="283"
            style="transition: stroke-dashoffset 0.5s ease-out; stroke-linecap: round; filter: drop-shadow(0 0 10px var(--primary));" />
        </svg>
        <div
          style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;">
          <span id="syncPercent" style="font-size: 3rem; font-weight: 800; font-family: 'JetBrains Mono';">0%</span>
          <span
            style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.2em; opacity: 0.6;">Synchronizing</span>
        </div>
      </div>

      <h2 id="syncStatus" style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem;">Initializing AI
        Crawler...</h2>
      <p style="color: var(--text-muted); font-size: 0.875rem;">Naxton Deep Sync is building your database. Please stay
        on this page.</p>

      <div
        style="margin-top: 3rem; display: flex; align-items: center; justify-content: center; gap: 1rem; color: var(--text-muted); font-size: 0.75rem;">
        <i data-lucide="shield-check" style="width: 14px; height: 14px; color: var(--success);"></i>
        <span>AI Secure Link Established</span>
      </div>
    </div>
  </div>

  <!-- SECURITY CONFIRMATION MODAL -->
  <div id="securityModal" class="modal-overlay">
    <div class="modal-container" style="max-width: 450px;">
      <div class="modal-header">
        <h3 style="color: var(--error); display: flex; align-items: center; gap: 0.5rem;">
          <i data-lucide="shield-alert"></i>
          Security Verification
        </h3>
        <button class="close-modal" onclick="closeModal('securityModal')">&times;</button>
      </div>
      <div style="margin-bottom: 1.5rem;">
        <p style="font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;" id="securityModalTitle">Confirm
          Permanent Deletion</p>
        <p style="font-size: 0.875rem; color: var(--text-muted);" id="securityModalText">This action is irreversible.
          All menu items, call logs, and customer data for this business will be permanently erased.</p>
      </div>

      <div class="form-group">
        <label style="font-weight: 600;">Enter Superadmin Password</label>
        <input type="password" id="securityConfirmPass" class="form-control" placeholder="••••••••"
          style="border-color: var(--error);" />
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2rem;">
        <button class="action-btn"
          style="background: var(--bg-muted); color: var(--text-primary); border: 1px solid var(--border); justify-content: center;"
          onclick="closeModal('securityModal')">Cancel</button>
        <button id="securityConfirmBtn" class="action-btn"
          style="background: var(--error); color: white; border: none; justify-content: center; font-weight: 700;">CONFIRM
          DELETE</button>
      </div>
    </div>
  </div>

  <!-- CATEGORY MODAL -->
  <div id="categoryModal" class="modal-overlay">
    <div class="modal-container" style="max-width: 500px;">
      <div class="modal-header">
        <h3 id="categoryModalTitle">Add Category</h3>
        <button class="close-modal" onclick="closeModal('categoryModal')">&times;</button>
      </div>
      <div class="form-group">
        <label>Category Name</label>
        <input type="text" id="catName" class="form-control" placeholder="e.g. Haircuts, Main Dishes, Facials" />
      </div>
      <div class="form-group">
        <label>Description (Optional)</label>
        <textarea id="catDesc" class="form-control" rows="3"></textarea>
      </div>
      <div class="form-group">
        <label>Category Image</label>
        <div style="display: flex; gap: 0.5rem;">
          <input type="text" id="catImage" class="form-control" placeholder="https://..." style="flex: 1;" />
          <input type="file" id="catImageFile" style="display: none;" accept="image/*" onchange="document.getElementById('catImage').value = this.files[0].name" />
          <button type="button" class="action-btn" style="width: auto; padding: 0 1rem; font-size: 0.75rem;" onclick="document.getElementById('catImageFile').click()">
            <i data-lucide="upload" style="width: 14px; margin-right: 4px;"></i> Upload Local
          </button>
        </div>
      </div>
      <div style="display: flex; gap: 1rem; margin-top: 2rem;">
        <button id="deleteCatBtn" class="action-btn" style="background: rgba(239, 68, 68, 0.1); color: var(--danger); border: 1px solid rgba(239, 68, 68, 0.2); justify-content: center; display: none;" onclick="deleteCategory()">DELETE</button>
        <div style="flex: 1; display: flex; justify-content: flex-end; gap: 0.75rem;">
          <button class="action-btn" style="border: 1px solid var(--border); justify-content: center; width: auto; padding: 0 1.5rem;" onclick="closeModal('categoryModal')">Cancel</button>
          <button class="action-btn" style="background: var(--primary); color: white; border: none; justify-content: center; font-weight: 700; width: auto; padding: 0 1.5rem;" onclick="saveCategory()">SAVE</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ITEM / SERVICE MODAL -->
  <div id="itemModal" class="modal-overlay">
    <div class="modal-container" style="max-width: 600px;">
      <div class="modal-header">
        <h3 id="itemModalTitle">Add Item / Service</h3>
        <button class="close-modal" onclick="closeModal('itemModal')">&times;</button>
      </div>
      
      <!-- 🚀 Enterprise Menu Tabs -->
      <div class="apex-tabs">
        <div class="apex-tab-item active" onclick="switchTab('general', this)">
          <i data-lucide="info" style="width: 14px;"></i> General
        </div>
        <div class="apex-tab-item" onclick="switchTab('variants', this)">
          <i data-lucide="layers" style="width: 14px;"></i> Variants
        </div>
        <div class="apex-tab-item" onclick="switchTab('modifiers', this)">
          <i data-lucide="settings-2" style="width: 14px;"></i> Modifiers
        </div>
        <div class="apex-tab-item" onclick="switchTab('addons', this)">
          <i data-lucide="plus-circle" style="width: 14px;"></i> Addons
        </div>
        <div class="apex-tab-item" onclick="switchTab('advanced', this)">
          <i data-lucide="zap" style="width: 14px;"></i> Advanced & AI
        </div>
      </div>

      <!-- Tab Content: General -->
      <div id="tab-general" class="apex-tab-content active">
        <div class="apex-grid" style="grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div class="form-group" style="grid-column: 1 / -1;">
            <label>Name</label>
            <input type="text" id="itemName" class="form-control" placeholder="e.g. Premium Haircut" />
          </div>
          <div class="form-group">
            <label>Base Price ($)</label>
            <input type="number" step="0.01" id="itemPrice" class="form-control" placeholder="0.00" />
          </div>
          <div class="form-group">
            <label id="durationLabel">Duration / Prep Time (Min)</label>
            <input type="number" id="itemDuration" class="form-control" value="30" />
          </div>
          <div class="form-group">
            <label>Category</label>
            <select id="itemCategory" class="form-control"></select>
          </div>
          <div class="form-group">
            <label>Pricing Type</label>
            <select id="itemPricingType" class="form-control">
              <option value="FIXED">Fixed Price</option>
              <option value="VARIABLE">Starts At</option>
              <option value="TIME_BASED">Per Hour</option>
            </select>
          </div>
        </div>

        <div class="form-group" style="margin-top: 1rem;">
          <label>Description</label>
          <textarea id="itemDesc" class="form-control" rows="3" placeholder="Tell your customers about this service..."></textarea>
        </div>

        <div class="form-group">
          <label>Item Image</label>
          <div style="display: flex; gap: 0.5rem;">
            <input type="text" id="itemImage" class="form-control" placeholder="https://..." style="flex: 1;" />
            <input type="file" id="itemImageFile" style="display: none;" accept="image/*" onchange="document.getElementById('itemImage').value = this.files[0].name" />
            <button type="button" class="action-btn" style="width: auto; padding: 0 1rem; font-size: 0.75rem;" onclick="document.getElementById('itemImageFile').click()">
              <i data-lucide="upload" style="width: 14px; margin-right: 4px;"></i> Upload Local
            </button>
          </div>
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px dashed var(--border);">
          <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; cursor: pointer;">
            <input type="checkbox" id="itemIsVeg" /> Vegetarian
          </label>
          <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; cursor: pointer;">
            <input type="checkbox" id="itemIsVegan" /> Vegan
          </label>
          <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; cursor: pointer;">
            <input type="checkbox" id="itemIsPopular" /> Popular
          </label>
          <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; cursor: pointer;">
            <input type="checkbox" id="itemIsNew" /> New
          </label>
        </div>
      </div>

      <!-- Tab Content: Variants -->
      <div id="tab-variants" class="apex-tab-content">
        <label style="font-weight: 700; color: var(--text-primary); display: block; margin-bottom: 0.5rem;">Sizes & Variants</label>
        <p style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 1rem;">Add different sizes like Small, Large, or variants with specific pricing.</p>
        <div id="variantRepeater"></div>
        <button type="button" class="action-btn" style="margin-top: 1rem; width: auto; padding: 0 1rem; border: 1px dashed var(--border);" onclick="addVariantRow()">
          <i data-lucide="plus" style="width: 14px; margin-right: 4px;"></i> Add Size/Variant
        </button>
      </div>

      <!-- Tab Content: Modifiers -->
      <div id="tab-modifiers" class="apex-tab-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <label style="font-weight: 700; color: var(--text-primary);">Modifier Groups</label>
          <button type="button" class="action-btn" style="width: auto; height: 28px; font-size: 0.7rem; padding: 0 0.75rem; background: var(--bg-muted);" onclick="openModifierGroupModal()">
            <i data-lucide="plus" style="width: 12px; margin-right: 4px;"></i> Create New Group
          </button>
        </div>
        <p style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 1rem;">Select the modifier groups that apply to this item (e.g. Spice Level, Extra Toppings).</p>
        <div id="modifierGroupList" class="multi-select-box"></div>
      </div>

      <!-- Tab Content: Addons -->
      <div id="tab-addons" class="apex-tab-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <label style="font-weight: 700; color: var(--text-primary);">Upsell Addons</label>
          <button type="button" class="action-btn" style="width: auto; height: 28px; font-size: 0.7rem; padding: 0 0.75rem; background: var(--bg-muted);" onclick="openAddonModal()">
            <i data-lucide="plus" style="width: 12px; margin-right: 4px;"></i> Create New Addon
          </button>
        </div>
        <p style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 1rem;">Select items to suggest as addons (e.g. Fries, Coke).</p>
        <div id="addonList" class="multi-select-box"></div>
      </div>

      <!-- Tab Content: Advanced -->
      <div id="tab-advanced" class="apex-tab-content">
        <div class="apex-grid" style="grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div class="form-group">
            <label>Calories</label>
            <input type="number" id="itemCalories" class="form-control" placeholder="0" />
          </div>
          <div class="form-group">
            <label>Spicy Level (0-3)</label>
            <input type="number" id="itemSpicyLevel" class="form-control" min="0" max="3" value="0" />
          </div>
          <div class="form-group" style="grid-column: 1 / -1;">
            <label>Allergens (Comma separated)</label>
            <input type="text" id="itemAllergens" class="form-control" placeholder="e.g. Nuts, Dairy, Gluten" />
          </div>
        </div>

        <div class="form-group" style="margin-top: 1.5rem; border-top: 1px solid var(--border); padding-top: 1.5rem;">
          <label style="display: flex; align-items: center; gap: 0.5rem; color: var(--primary); font-weight: 700;">
            <i data-lucide="mic" style="width: 16px;"></i>
            AI Voice Aliases
          </label>
          <div id="aliasContainer" style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem; margin-top: 0.5rem;"></div>
          <div style="display: flex; gap: 0.5rem;">
            <input type="text" id="aliasInput" class="form-control" placeholder="Add variation..." style="flex: 1;" onkeydown="if(event.key==='Enter') addAliasTag()" />
            <button type="button" class="action-btn" style="width: auto; padding: 0 1rem; border-color: var(--primary); color: var(--primary);" onclick="generateSuggestedAliases()">
              <i data-lucide="sparkles" style="width: 14px; margin-right: 4px;"></i> Suggest
            </button>
          </div>
        </div>

        <div class="form-group" style="margin-top: 1.5rem; border-top: 1px solid var(--border); padding-top: 1.5rem;">
          <label style="font-weight: 700;">Availability Rules</label>
          <div class="apex-grid" style="grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 0.5rem;">
            <div class="form-group">
              <label>Start Time</label>
              <input type="time" id="availStart" class="form-control" />
            </div>
            <div class="form-group">
              <label>End Time</label>
              <input type="time" id="availEnd" class="form-control" />
            </div>
            <div class="form-group" style="grid-column: 1 / -1;">
              <label>Stock Quantity (Optional)</label>
              <input type="number" id="itemStock" class="form-control" placeholder="Infinite" />
            </div>
          </div>
        </div>
      </div>

      <div style="display: flex; gap: 1rem; margin-top: 2rem;">
        <button id="deleteItemBtn" class="action-btn" style="background: rgba(239, 68, 68, 0.1); color: var(--danger); border: 1px solid rgba(239, 68, 68, 0.2); justify-content: center; display: none;" onclick="deleteItem(editingItemId)">DELETE</button>
        <div style="flex: 1; display: flex; justify-content: flex-end; gap: 0.75rem;">
          <button class="action-btn" style="border: 1px solid var(--border); justify-content: center; width: auto; padding: 0 1.5rem;" onclick="closeModal('itemModal')">Cancel</button>
          <button class="action-btn" style="background: var(--primary); color: white; border: none; justify-content: center; font-weight: 700; width: auto; padding: 0 1.5rem;" onclick="saveItem()">SAVE CHANGES</button>
        </div>
      </div>
    </div>
  </div>

  <!-- CALL TRANSCRIPT MODAL -->
  <div id="transcriptModal" class="modal-overlay">
    <div class="modal-container" style="max-width: 700px; height: 80vh; display: flex; flex-direction: column;">
      <div class="modal-header">
        <div>
          <h3 id="transcriptTitle">Call Transcript</h3>
          <p id="transcriptSubtitle" style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;"></p>
        </div>
        <button class="close-modal" onclick="closeModal('transcriptModal')">&times;</button>
      </div>
      
      <div id="transcriptContent" style="flex: 1; overflow-y: auto; padding: 1.5rem; background: var(--bg-muted); border-radius: 0.5rem; margin-top: 1rem; border: 1px solid var(--border);">
        <!-- Messages injected here -->
      </div>

      <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
        <div id="transcriptFooter" style="font-size: 0.75rem; color: var(--text-muted);">
          <!-- Call metadata -->
        </div>
        <button class="action-btn" style="border: 1px solid var(--border); justify-content: center; width: auto; padding: 0 1.5rem;" onclick="closeModal('transcriptModal')">Close</button>
      </div>
    </div>
  </div>


  <!-- APP SCRIPT -->
  <script src="/js/admin-apex.js?v=<%= Date.now() %>"></script>
  <script>
    // Initialize Lucide icons
    lucide.createIcons();
  </script>

  <!-- ElevenLabs ConvAI Widget -->
</body>

</html>
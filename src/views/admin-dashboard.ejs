<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof businessName !== 'undefined' ? businessName + ' — Naxton Technologies LLC' : 'Naxton Technologies LLC' %></title>
  <link rel="icon" type="image/png" href="<%= platformLogo || '' %>">
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin-apex.css" />
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
</head>
<body data-theme="dark">

  <div class="apex-layout">
    
    <!-- SIDEBAR -->
    <aside class="apex-sidebar">
      <div class="sidebar-header">
        <div class="logo-box">
          <% if (typeof platformLogo !== 'undefined' && platformLogo) { %>
            <img id="brandLogoImg" src="<%= platformLogo %>" style="width: 100%; height: 100%; object-fit: contain;" />
            <i data-lucide="bot" id="brandLogoPlaceholder" style="display: none;"></i>
          <% } else { %>
            <img id="brandLogoImg" src="" style="width: 100%; height: 100%; object-fit: contain; display: none;" />
            <i data-lucide="bot" id="brandLogoPlaceholder"></i>
          <% } %>
        </div>
        <div class="logo-text">
          <h2 style="font-size: 1rem; font-weight: 700;" id="brandLogoText"><%= typeof businessName !== 'undefined' ? businessName : (typeof projectName !== 'undefined' ? projectName : 'Naxton Technologies LLC') %></h2>
          <p style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;">AI Voice Suite</p>
        </div>
      </div>

      <nav class="sidebar-nav" id="sidebarNav">
        <!-- Navigation items will be injected here by JS -->
      </nav>

      <div class="sidebar-footer" style="margin-top: auto; padding-top: 2rem; border-top: 1px solid var(--border);">
        <a class="apex-nav-item" onclick="logout()" style="color: var(--danger);">
          <i data-lucide="log-out"></i>
          <span>Sign Out</span>
        </a>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="apex-main">
      
      <!-- TOP HEADER -->
      <header class="apex-header">
        <div class="header-search">
          <i data-lucide="search"></i>
          <input type="text" id="globalSearch" placeholder="Search for actions, orders, staff... (Ctrl+K)" oninput="handleGlobalSearch(this.value)" />
        </div>
        
        <div class="header-actions">
          <div class="select-wrap" style="margin-right: 1rem;">
            <select id="businessSwitcher" onchange="switchBusiness(this.value)" style="background: var(--bg-muted); border: 1px solid var(--border); color: var(--text-primary); padding: 0.5rem 1rem; border-radius: 0.5rem; outline: none; font-size: 0.875rem;">
              <option value="">Switch Business</option>
            </select>
          </div>
          
          <button class="apex-btn apex-btn-sm apex-btn-secondary" style="width: 2.5rem; height: 2.5rem; padding: 0;">
            <i data-lucide="bell"></i>
          </button>
          
          <div class="user-profile">
            <div class="user-avatar" style="overflow: hidden; padding: 0; background: transparent;">
              <img id="headerAvatarImg" src="" style="width: 100%; height: 100%; object-fit: cover; display: none; border-radius: 50%;" />
              <span id="headerAvatarText" style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; background: var(--primary);">AD</span>
            </div>
            <div style="padding-right: 0.75rem;">
              <p id="headerProfileName" style="font-size: 0.75rem; font-weight: 600;">Admin</p>
              <p style="font-size: 0.625rem; color: var(--text-muted);">Owner</p>
            </div>
          </div>
        </div>
      </header>

      <!-- PAGE CONTENT -->
      <div class="apex-content" id="scrollContainer">
        <div class="page-header" id="pageHeader">
          <h1 id="pageTitle">Dashboard</h1>
          <p id="pageSubtitle">Welcome back. Here's what's happening with your business today.</p>
        </div>

        <!-- DYNAMIC CONTENT AREA -->
        <div id="contentArea"></div>

        <!-- DASHBOARD GRID (Only visible on dashboard) -->
        <div id="dashboardGrid" style="display: none;">
          
          <div id="liveFeedContainer" class="apex-card" style="display: none; border: 1px solid var(--primary); background: rgba(var(--primary-rgb), 0.05); margin-bottom: 2rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
                <div style="display:flex; align-items:center; gap:0.5rem;">
                    <div class="status-dot online"></div>
                    <h3 style="font-size: 0.875rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;">Live AI Interaction</h3>
                </div>
                <span id="liveCallId" style="font-size: 0.625rem; font-family: monospace; color: var(--text-muted);"></span>
            </div>
            <div id="liveTranscript" style="font-size: 0.875rem; line-height: 1.6; max-height: 150px; overflow-y: auto; padding: 1rem; background: var(--bg-card); border-radius: 0.5rem; border: 1px dashed var(--border);">
                <p style="color: var(--text-muted); font-style: italic;">Waiting for incoming voice stream...</p>
            </div>
          </div>

          <!-- STATS GRID -->
          <div class="apex-grid" id="statsGrid">
            <!-- Stat cards will be injected here -->
          </div>

          <!-- MAIN ANALYTICS ROW -->
          <div class="dashboard-main-grid">
            
            <div class="left-col">
              <div class="apex-card">
                <div class="card-header">
                  <h3 class="card-title">Revenue Growth</h3>
                  <div class="header-actions">
                    <button class="apex-btn apex-btn-sm apex-btn-secondary">Last 7 Days</button>
                  </div>
                </div>
                <div style="height: 300px;">
                  <canvas id="revenueChart"></canvas>
                </div>
              </div>

              <div class="apex-card">
                <div class="card-header">
                  <h3 class="card-title">Call Volume History</h3>
                </div>
                <div style="height: 250px;">
                  <canvas id="callsChart"></canvas>
                </div>
              </div>
            </div>

            <div class="right-col">
              <div class="apex-card dashboard-live-card" style="height: 720px;">
                <div class="card-header" style="flex-shrink: 0;">
                  <h3 class="card-title">Live AI Operations</h3>
                  <span class="pulse-indicator" style="width: 8px; height: 8px; background: var(--success); border-radius: 50%;"></span>
                </div>
                <div id="liveCallsContainer" style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem; padding-right: 4px; margin-bottom: 1rem; scrollbar-width: thin; scrollbar-color: var(--border) transparent;">
                  <div class="empty-state" style="text-align: center; padding: 2rem; color: var(--text-muted); font-size: 0.875rem;">
                    Monitoring active streams...
                  </div>
                </div>
                
                <div style="margin-top: auto; padding-top: 1.5rem; border-top: 1px solid var(--border);">
                  <div style="display: flex; justify-content: space-between; font-size: 0.75rem; margin-bottom: 0.5rem;">
                    <span style="color: var(--text-muted);">Avg. Latency</span>
                    <span style="color: var(--success); font-weight: 600;">840ms</span>
                  </div>
                  <div style="display: flex; justify-content: space-between; font-size: 0.75rem;">
                    <span style="color: var(--text-muted);">AI Accuracy</span>
                    <span style="color: var(--primary); font-weight: 600;">98.2%</span>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>
      
      <!-- FIXED PLATFORM WATERMARK -->
      <div style="position: fixed; bottom: 1rem; right: 1.5rem; font-size: 0.65rem; color: var(--text-muted); z-index: 50; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500; pointer-events: none;">
        Software by Naxton Technologies LLC
      </div>
    </main>
  </div>

  <!-- NOTIFICATIONS -->
  <div id="notificationBox" class="notification" style="position: fixed; top: 1.5rem; right: 1.5rem; transform: translateX(120%); transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); background: var(--bg-card); border: 1px solid var(--border); padding: 1rem 1.5rem; border-radius: var(--radius); box-shadow: var(--shadow-md); z-index: 1000; display: flex; align-items: center; gap: 1rem;">
    <div style="color: var(--primary);"><i data-lucide="bell"></i></div>
    <div>
      <h4 id="notificationTitle" style="font-size: 0.875rem; font-weight: 600;">Notification</h4>
      <p id="notificationText" style="font-size: 0.75rem; color: var(--text-secondary);">Something happened.</p>
    </div>
  </div>
  
  <audio id="notifySound" src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" preload="auto"></audio>
  
  <!-- NAXTON DEEP SYNC OVERLAY -->
  <div id="syncOverlay" class="modal-overlay" style="background: rgba(8, 51, 68, 0.95); backdrop-filter: blur(12px); display: none; opacity: 1; pointer-events: auto;">
    <div style="text-align: center; color: white; width: 100%; max-width: 500px;">
      <div style="position: relative; width: 200px; height: 200px; margin: 0 auto 3rem;">
        <svg viewBox="0 0 100 100" style="transform: rotate(-90deg); width: 100%; height: 100%;">
          <circle cx="50" cy="50" r="45" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="2" />
          <circle id="syncProgressCircle" cx="50" cy="50" r="45" fill="none" stroke="var(--primary)" stroke-width="4" 
                  stroke-dasharray="283" stroke-dashoffset="283" style="transition: stroke-dashoffset 0.5s ease-out; stroke-linecap: round; filter: drop-shadow(0 0 10px var(--primary));" />
        </svg>
        <div style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;">
          <span id="syncPercent" style="font-size: 3rem; font-weight: 800; font-family: 'JetBrains Mono';">0%</span>
          <span style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.2em; opacity: 0.6;">Synchronizing</span>
        </div>
      </div>
      
      <h2 id="syncStatus" style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem;">Initializing AI Crawler...</h2>
      <p style="color: var(--text-muted); font-size: 0.875rem;">Naxton Deep Sync is building your database. Please stay on this page.</p>
      
      <div style="margin-top: 3rem; display: flex; align-items: center; justify-content: center; gap: 1rem; color: var(--text-muted); font-size: 0.75rem;">
        <i data-lucide="shield-check" style="width: 14px; height: 14px; color: var(--success);"></i>
        <span>AI Secure Link Established</span>
      </div>
    </div>
  </div>

  <!-- SECURITY CONFIRMATION MODAL -->
  <div id="securityModal" class="modal-overlay">
    <div class="modal-container" style="max-width: 450px;">
      <div class="modal-header">
        <h3 style="color: var(--error); display: flex; align-items: center; gap: 0.5rem;">
          <i data-lucide="shield-alert"></i>
          Security Verification
        </h3>
        <button class="close-modal" onclick="closeModal('securityModal')">&times;</button>
      </div>
      <div style="margin-bottom: 1.5rem;">
        <p style="font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;" id="securityModalTitle">Confirm Permanent Deletion</p>
        <p style="font-size: 0.875rem; color: var(--text-muted);" id="securityModalText">This action is irreversible. All menu items, call logs, and customer data for this business will be permanently erased.</p>
      </div>
      
      <div class="form-group">
        <label style="font-weight: 600;">Enter Superadmin Password</label>
        <input type="password" id="securityConfirmPass" class="form-control" placeholder="••••••••" style="border-color: var(--error);" />
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2rem;">
        <button class="apex-btn apex-btn-secondary" onclick="closeModal('securityModal')">Cancel</button>
        <button id="securityConfirmBtn" class="apex-btn apex-btn-danger">CONFIRM DELETE</button>
      </div>
    </div>
  </div>

  <!-- APP SCRIPT -->
  <script src="/js/admin-apex.js"></script>
  <script>
    // Initialize Lucide icons
    lucide.createIcons();
  </script>

  <!-- ElevenLabs ConvAI Widget -->
</body>
</html>

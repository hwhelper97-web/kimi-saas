<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Demo Center — SuperAdmin Control</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#38BDF8',
            secondary: '#2563EB',
            bgDark: '#0F172A',
            cardDark: '#1E293B',
            textMain: '#F8FAFC',
            textDim: '#94A3B8'
          },
          fontFamily: {
            orbitron: ['Orbitron', 'sans-serif'],
            sans: ['Plus Jakarta Sans', 'sans-serif']
          }
        }
      }
    }
  </script>
</head>
<body class="font-sans bg-slate-900 text-textMain antialiased min-h-full flex flex-col">

  <!-- Navigation Bar -->
  <header class="w-full bg-slate-800 border-b border-slate-700 px-6 py-4 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/superadmin" class="w-9 h-9 rounded-xl bg-gradient-to-tr from-primary to-secondary flex items-center justify-center text-white font-orbitron font-black text-sm">
        SA
      </a>
      <div>
        <h1 class="font-orbitron font-bold text-sm tracking-wider text-white uppercase">Naxton Demo Center Control</h1>
        <p class="text-[10px] text-slate-400">SuperAdmin Lead &amp; Live Demo Monitoring</p>
      </div>
    </div>

    <div class="flex items-center gap-4">
      <a href="/superadmin" class="text-xs font-bold text-slate-300 hover:text-white uppercase transition-colors">
        Superadmin Hub
      </a>
      <a href="/demo" target="_blank" class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-primary/20 border border-primary/30 hover:bg-primary/30 transition-all uppercase">
        Open Public Demo Wizard &rarr;
      </a>
    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto p-6 space-y-8">
    
    <!-- Top Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5 text-left">
        <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest block mb-1">TOTAL DEMO SESSIONS</span>
        <span class="text-3xl font-black font-orbitron text-primary" id="stat-total-demos">0</span>
      </div>
      <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5 text-left">
        <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest block mb-1">ACTIVE DEMOS</span>
        <span class="text-3xl font-black font-orbitron text-emerald-400" id="stat-active-demos">0</span>
      </div>
      <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5 text-left">
        <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest block mb-1">TODAY'S PROSPECTS</span>
        <span class="text-3xl font-black font-orbitron text-secondary" id="stat-today-demos">0</span>
      </div>
      <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5 text-left">
        <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest block mb-1">EXPIRED DEMOS</span>
        <span class="text-3xl font-black font-orbitron text-red-400" id="stat-expired-demos">0</span>
      </div>
    </div>

    <!-- Filters & Search Bar -->
    <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <button onclick="filterStatus('')" class="filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-primary text-slate-900" id="btn-filter-all">All</button>
        <button onclick="filterStatus('ACTIVE')" class="filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-700 text-slate-300 hover:bg-slate-600" id="btn-filter-active">Active</button>
        <button onclick="filterStatus('EXPIRED')" class="filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-700 text-slate-300 hover:bg-slate-600" id="btn-filter-expired">Expired</button>
      </div>

      <div class="w-full sm:w-72 relative">
        <input type="text" id="search-input" onkeyup="handleSearchKey(event)" placeholder="Search business, email, owner..." class="w-full px-4 py-2 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:border-primary focus:outline-none" />
      </div>
    </div>

    <!-- SMTP Email Delivery System Panel -->
    <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5 text-left space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="font-orbitron font-bold text-sm text-white uppercase flex items-center gap-2">
            <span>📧 SMTP Email Delivery System</span>
            <span id="smtp-status-badge" class="px-2 py-0.5 text-[9px] rounded-full bg-slate-700 text-slate-300 font-sans">Checking...</span>
          </h3>
          <p class="text-xs text-slate-400">Configure SMTP credentials (Gmail, SendGrid, Resend, cPanel) so demo dashboard links deliver directly to customer inbox.</p>
        </div>
        <button onclick="toggleSmtpForm()" class="px-3 py-1.5 rounded-xl bg-slate-700 hover:bg-slate-600 text-xs font-bold text-slate-200 transition-colors">
          Configure SMTP &rarr;
        </button>
      </div>

      <div id="smtp-form-container" class="hidden pt-4 border-t border-slate-700 space-y-4 font-sans text-xs">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <div>
            <label class="block text-[11px] font-bold text-slate-400 mb-1">SMTP Host (e.g., smtp.gmail.com)</label>
            <input type="text" id="smtpHost" placeholder="smtp.gmail.com" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white focus:border-primary focus:outline-none" />
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-400 mb-1">SMTP Port (587 or 465)</label>
            <input type="number" id="smtpPort" placeholder="587" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white focus:border-primary focus:outline-none" />
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-400 mb-1">Sender Email / From Address</label>
            <input type="text" id="smtpFrom" placeholder='"Naxton AI" <demo@naxtontechnologies.com>' class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white focus:border-primary focus:outline-none" />
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-400 mb-1">SMTP Username / Email</label>
            <input type="text" id="smtpUser" placeholder="your-email@gmail.com" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white focus:border-primary focus:outline-none" />
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-400 mb-1">SMTP Password / App Password</label>
            <input type="password" id="smtpPass" placeholder="••••••••••••" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white focus:border-primary focus:outline-none" />
          </div>
          <div class="flex items-end">
            <button onclick="saveSmtpSettings()" class="w-full py-2 bg-primary hover:bg-primary/90 text-slate-900 font-bold rounded-xl transition-all uppercase text-xs">
              Save SMTP Settings
            </button>
          </div>
        </div>

        <!-- Test Email Dispatcher -->
        <div class="pt-3 border-t border-slate-700/60 flex flex-col sm:flex-row items-center gap-3">
          <input type="email" id="testEmailInput" placeholder="Enter recipient email address to test..." class="w-full sm:w-80 px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white text-xs focus:border-primary focus:outline-none" />
          <button onclick="sendTestEmail()" class="w-full sm:w-auto px-5 py-2 bg-emerald-500 hover:bg-emerald-600 text-slate-900 font-bold rounded-xl transition-all text-xs uppercase flex items-center justify-center gap-2">
            <span>🚀 Send Test Email</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Demo List Table -->
    <div class="bg-slate-800 border border-slate-700 rounded-2xl overflow-hidden shadow-xl">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-900/60 font-orbitron text-[10px] text-slate-400 uppercase tracking-wider">
            <tr>
              <th class="py-3.5 px-4">Business &amp; Contact</th>
              <th class="py-3.5 px-4">Model</th>
              <th class="py-3.5 px-4">Created / Expires</th>
              <th class="py-3.5 px-4 text-center">Calls</th>
              <th class="py-3.5 px-4 text-center">Actions Created</th>
              <th class="py-3.5 px-4">Status</th>
              <th class="py-3.5 px-4 text-right">Controls</th>
            </tr>
          </thead>
          <tbody id="demo-table-body" class="divide-y divide-slate-700/80 text-slate-300 font-mono">
            <tr>
              <td colspan="7" class="py-8 text-center text-slate-500 font-sans">Loading demo sessions...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </main>

  <script>
    lucide.createIcons();

    let currentStatusFilter = '';
    let currentSearch = '';

    async function loadAdminDemos() {
      try {
        const query = new URLSearchParams();
        if (currentStatusFilter) query.append('status', currentStatusFilter);
        if (currentSearch) query.append('search', currentSearch);

        const res = await fetch(`/api/superadmin/demos?${query.toString()}`);
        const json = await res.json();

        if (json.success && json.data) {
          const { demos, total, totalActive, totalExpired, todayDemos } = json.data;
          document.getElementById('stat-total-demos').innerText = total || 0;
          document.getElementById('stat-active-demos').innerText = totalActive || 0;
          document.getElementById('stat-today-demos').innerText = todayDemos || 0;
          document.getElementById('stat-expired-demos').innerText = totalExpired || 0;

          renderTable(demos || []);
        }
      } catch (e) {
        console.error('Failed to load demos:', e);
      }
    }

    function renderTable(demos) {
      const tbody = document.getElementById('demo-table-body');
      if (demos.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-slate-500 font-sans">No demo sessions found matching criteria.</td></tr>`;
        return;
      }

      tbody.innerHTML = demos.map(d => {
        const isActive = d.status === 'ACTIVE';
        const ordersCount = d.business?._count?.orders || 0;
        const apptsCount = d.business?._count?.appointments || 0;
        const totalActions = ordersCount + apptsCount;

        return `
          <tr class="hover:bg-slate-700/40 transition-colors">
            <td class="py-3.5 px-4 font-sans">
              <div class="font-bold text-white">${d.businessName}</div>
              <div class="text-[11px] text-slate-400">${d.contactName} &bull; <a href="mailto:${d.email}" class="text-primary hover:underline">${d.email}</a></div>
            </td>
            <td class="py-3.5 px-4 uppercase text-[10px]">
              <span class="px-2 py-0.5 rounded bg-slate-700 text-slate-300 font-bold">${d.businessType}</span>
            </td>
            <td class="py-3.5 px-4 text-[11px]">
              <div>In: ${new Date(d.createdAt).toLocaleDateString()}</div>
              <div class="text-slate-500">Exp: ${new Date(d.expiresAt).toLocaleTimeString()}</div>
            </td>
            <td class="py-3.5 px-4 text-center font-bold text-white">
              ${d.callCount} / ${d.maxCalls}
            </td>
            <td class="py-3.5 px-4 text-center font-bold ${totalActions > 0 ? 'text-emerald-400' : 'text-slate-500'}">
              ${totalActions} ${d.businessType === 'restaurant' ? 'Orders' : 'Bookings'}
            </td>
            <td class="py-3.5 px-4">
              <span class="px-2.5 py-0.5 rounded-full text-[9px] font-bold ${isActive ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-red-500/20 text-red-400 border border-red-500/30'}">
                ${d.status}
              </span>
            </td>
            <td class="py-3.5 px-4 text-right space-x-2 font-sans">
              <a href="/demo/live/${d.token}" target="_blank" class="px-2.5 py-1 rounded-lg bg-primary/20 text-primary border border-primary/30 hover:bg-primary hover:text-slate-900 transition-colors text-[11px] font-bold">
                View Live
              </a>
              <button onclick="extendDemo('${d.token}')" class="px-2.5 py-1 rounded-lg bg-slate-700 text-slate-200 hover:bg-slate-600 transition-colors text-[11px] font-bold">
                +24h
              </button>
              <button onclick="releasePhone('${d.token}')" class="px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-300 hover:bg-amber-500 hover:text-slate-900 transition-colors text-[11px] font-bold" title="Unbind phone number and return to UNASSIGNED inventory">
                Release Phone
              </button>
              ${isActive ? `
                <button onclick="deactivateDemo('${d.token}')" class="px-2.5 py-1 rounded-lg bg-red-500/20 text-red-400 hover:bg-red-500 hover:text-white transition-colors text-[11px] font-bold">
                  Stop
                </button>
              ` : ''}
            </td>
          </tr>
        `;
      }).join('');
    }

    function filterStatus(status) {
      currentStatusFilter = status;
      document.querySelectorAll('.filter-btn').forEach(b => {
        b.className = 'filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-700 text-slate-300 hover:bg-slate-600';
      });
      if (status === '') document.getElementById('btn-filter-all').className = 'filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-primary text-slate-900';
      if (status === 'ACTIVE') document.getElementById('btn-filter-active').className = 'filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-emerald-500 text-slate-900';
      if (status === 'EXPIRED') document.getElementById('btn-filter-expired').className = 'filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-red-500 text-white';

      loadAdminDemos();
    }

    function handleSearchKey(e) {
      currentSearch = e.target.value;
      loadAdminDemos();
    }

    async function extendDemo(token) {
      if (!confirm('Extend this demo by 24 hours?')) return;
      const res = await fetch(`/api/superadmin/demos/${token}/extend`, { method: 'POST' });
      const json = await res.json();
      if (json.success) {
        alert('Demo extended successfully!');
        loadAdminDemos();
      }
    }

    async function deactivateDemo(token) {
      if (!confirm('Deactivate this demo session immediately?')) return;
      const res = await fetch(`/api/superadmin/demos/${token}/deactivate`, { method: 'POST' });
      const json = await res.json();
      if (json.success) {
        alert('Demo deactivated!');
        loadAdminDemos();
      }
    }

    async function releasePhone(token) {
      if (!confirm('Release this demo phone number back to UNASSIGNED inventory immediately?')) return;
      const res = await fetch(`/api/superadmin/demos/${token}/release-phone`, { method: 'POST' });
      const json = await res.json();
      if (json.success) {
        alert(json.message || 'Phone number released back to UNASSIGNED inventory!');
        loadAdminDemos();
      } else {
        alert(json.message || json.error || 'Failed to release phone');
      }
    }

    function toggleSmtpForm() {
      const el = document.getElementById('smtp-form-container');
      el.classList.toggle('hidden');
      if (!el.classList.contains('hidden')) {
        loadSmtpSettings();
      }
    }

    async function loadSmtpSettings() {
      try {
        const res = await fetch('/api/superadmin/settings');
        const json = await res.json();
        if (json.success && json.data) {
          const d = json.data;
          if (document.getElementById('resendApiKey')) document.getElementById('resendApiKey').value = d.resendApiKey || '';
          document.getElementById('smtpHost').value = d.smtpHost || '';
          document.getElementById('smtpPort').value = d.smtpPort || 587;
          document.getElementById('smtpFrom').value = d.smtpFrom || '';
          document.getElementById('smtpUser').value = d.smtpUser || '';
          document.getElementById('smtpPass').value = d.smtpPass || '';

          const badge = document.getElementById('smtp-status-badge');
          if (d.resendApiKey || (d.smtpHost && d.smtpUser)) {
            badge.className = 'px-2 py-0.5 text-[9px] rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-sans';
            badge.innerText = d.resendApiKey ? 'Resend API Active ✓' : 'SMTP Configured ✓';
          } else {
            badge.className = 'px-2 py-0.5 text-[9px] rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 font-sans';
            badge.innerText = 'Not Configured';
          }
        }
      } catch (e) {
        console.error('Failed loading SMTP settings:', e);
      }
    }

    async function saveSmtpSettings() {
      const payload = {
        resendApiKey: document.getElementById('resendApiKey') ? document.getElementById('resendApiKey').value.trim() : undefined,
        smtpHost: document.getElementById('smtpHost').value.trim(),
        smtpPort: parseInt(document.getElementById('smtpPort').value) || 587,
        smtpFrom: document.getElementById('smtpFrom').value.trim(),
        smtpUser: document.getElementById('smtpUser').value.trim(),
        smtpPass: document.getElementById('smtpPass').value.trim()
      };

      const res = await fetch('/api/superadmin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const json = await res.json();
      if (json.success) {
        alert('Email & SMTP Settings Saved Successfully!');
        loadSmtpSettings();
      } else {
        alert('Failed saving settings: ' + (json.message || json.error));
      }
    }

    async function sendTestEmail() {
      const toEmail = document.getElementById('testEmailInput').value.trim();
      if (!toEmail) return alert('Please enter an email address for testing.');

      const res = await fetch('/api/superadmin/settings/test-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ toEmail })
      });
      const json = await res.json();
      if (json.success) {
        alert('🎉 SUCCESS: ' + json.message);
      } else {
        alert('❌ FAILED: ' + (json.error || json.message));
      }
    }

    loadAdminDemos();
    loadSmtpSettings();
  </script>
</body>
</html>

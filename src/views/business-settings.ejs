<% if (!business) { %>
  <div class="glass-card entrance-fade-up" style="text-align:center; padding:5rem 2rem; background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(16px); border-radius: 2rem; border: 1px solid rgba(255,255,255,0.1); max-width: 600px; margin: 4rem auto;">
    <div class="icon-pulse" style="margin-bottom: 2rem;">
      <i data-lucide="alert-circle" style="width:64px; height:64px; color:var(--warning); opacity: 0.8;"></i>
    </div>
    <h2 style="font-size: 2rem; font-weight: 800; background: linear-gradient(135deg, #fff 0%, #aaa 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">No Business Found</h2>
    <p style="color:var(--text-muted); font-size: 1.1rem; max-width: 400px; margin: 1rem auto 2rem auto;">It looks like you haven't set up a business yet. Let's create your first workspace to begin.</p>
    <button class="apex-btn" onclick="loadSection('business-new')">Create My Business</button>
  </div>
<% } else { %>


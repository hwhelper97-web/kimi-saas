            <option value="Asia/Tokyo" <%= business.timezone === 'Asia/Tokyo' ? 'selected' : '' %>>Asia/Tokyo — Japan (Tokyo, Osaka) (GMT+9)</option>
            <option value="Asia/Seoul" <%= business.timezone === 'Asia/Seoul' ? 'selected' : '' %>>Asia/Seoul — South Korea (Seoul) (GMT+9)</option>
            <option value="Asia/Taipei" <%= business.timezone === 'Asia/Taipei' ? 'selected' : '' %>>Asia/Taipei — Taiwan (Taipei) (GMT+8)</option>
            <option value="Asia/Bangkok" <%= business.timezone === 'Asia/Bangkok' ? 'selected' : '' %>>Asia/Bangkok — Thailand & Indochina (Bangkok, Hanoi, HCMC) (GMT+7)</option>
            <option value="Asia/Kuala_Lumpur" <%= business.timezone === 'Asia/Kuala_Lumpur' ? 'selected' : '' %>>Asia/Kuala_Lumpur — Malaysia (Kuala Lumpur) (GMT+8)</option>
            <option value="Asia/Manila" <%= business.timezone === 'Asia/Manila' ? 'selected' : '' %>>Asia/Manila — Philippines (Manila) (GMT+8)</option>
            <option value="Asia/Jakarta" <%= business.timezone === 'Asia/Jakarta' ? 'selected' : '' %>>Asia/Jakarta — Indonesia West (Jakarta) (GMT+7)</option>
            <option value="Asia/Makassar" <%= business.timezone === 'Asia/Makassar' ? 'selected' : '' %>>Asia/Makassar — Indonesia Central (Bali, Makassar) (GMT+8)</option>
            <option value="Asia/Jayapura" <%= business.timezone === 'Asia/Jayapura' ? 'selected' : '' %>>Asia/Jayapura — Indonesia East (GMT+9)</option>
            <option value="Asia/Yangon" <%= business.timezone === 'Asia/Yangon' ? 'selected' : '' %>>Asia/Yangon — Myanmar (Yangon) (GMT+6:30)</option>
          </optgroup>

          <optgroup label="🇿🇦 🇳🇬 🇰🇪 Sub-Saharan Africa">
            <option value="Africa/Johannesburg" <%= business.timezone === 'Africa/Johannesburg' ? 'selected' : '' %>>Africa/Johannesburg — South Africa (Johannesburg, Cape Town) (GMT+2)</option>
            <option value="Africa/Lagos" <%= business.timezone === 'Africa/Lagos' ? 'selected' : '' %>>Africa/Lagos — Nigeria (Lagos) (GMT+1)</option>
            <option value="Africa/Nairobi" <%= business.timezone === 'Africa/Nairobi' ? 'selected' : '' %>>Africa/Nairobi — Kenya (Nairobi) (GMT+3)</option>
            <option value="Africa/Accra" <%= business.timezone === 'Africa/Accra' ? 'selected' : '' %>>Africa/Accra — Ghana (Accra) (GMT+0)</option>
            <option value="Africa/Addis_Ababa" <%= business.timezone === 'Africa/Addis_Ababa' ? 'selected' : '' %>>Africa/Addis_Ababa — Ethiopia (Addis Ababa) (GMT+3)</option>
            <option value="Africa/Dar_es_Salaam" <%= business.timezone === 'Africa/Dar_es_Salaam' ? 'selected' : '' %>>Africa/Dar_es_Salaam — Tanzania (GMT+3)</option>
            <option value="Africa/Luanda" <%= business.timezone === 'Africa/Luanda' ? 'selected' : '' %>>Africa/Luanda — Angola (GMT+1)</option>
          </optgroup>

          <optgroup label="🇦🇺 🇳🇿 🇵🇬 Oceania & Australia">
            <option value="Australia/Sydney" <%= business.timezone === 'Australia/Sydney' ? 'selected' : '' %>>Australia/Sydney — Australia Eastern (Sydney, Melbourne, Canberra)</option>
            <option value="Australia/Brisbane" <%= business.timezone === 'Australia/Brisbane' ? 'selected' : '' %>>Australia/Brisbane — Australia Queensland (No DST)</option>
            <option value="Australia/Adelaide" <%= business.timezone === 'Australia/Adelaide' ? 'selected' : '' %>>Australia/Adelaide — Australia Central (Adelaide)</option>
            <option value="Australia/Perth" <%= business.timezone === 'Australia/Perth' ? 'selected' : '' %>>Australia/Perth — Australia Western (Perth)</option>
            <option value="Pacific/Auckland" <%= business.timezone === 'Pacific/Auckland' ? 'selected' : '' %>>Pacific/Auckland — New Zealand (Auckland, Wellington)</option>
            <option value="Pacific/Fiji" <%= business.timezone === 'Pacific/Fiji' ? 'selected' : '' %>>Pacific/Fiji — Fiji</option>
            <option value="Pacific/Guam" <%= business.timezone === 'Pacific/Guam' ? 'selected' : '' %>>Pacific/Guam — Guam (GMT+10)</option>
          </optgroup>

          <optgroup label="🇮🇸 🌊 Atlantic & Others">
            <option value="Atlantic/Reykjavik" <%= business.timezone === 'Atlantic/Reykjavik' ? 'selected' : '' %>>Atlantic/Reykjavik — Iceland (Reykjavik) (GMT+0)</option>
            <option value="Atlantic/Azores" <%= business.timezone === 'Atlantic/Azores' ? 'selected' : '' %>>Atlantic/Azores — Azores (GMT-1)</option>
          </optgroup>
        </select>
      </div>

      <div class="form-group-premium col-span-2">
        <label><i data-lucide="image"></i> Brand Identity (Logo)</label>
        <div style="display:flex; gap:1.25rem; align-items:center; flex-wrap:wrap;">
          <div id="logoPreview" class="logo-preview-box">
            <% if (business.logoUrl) { %>
              <img src="<%= business.logoUrl %>" alt="Business Logo" />
            <% } else { %>
              <i data-lucide="image" style="width: 24px; height: 24px; opacity: 0.3;"></i>
            <% } %>
          </div>
          <div style="flex:1; min-width: 260px;">
            <input type="text" id="bizLogo" class="form-control-premium" value="<%= business.logoUrl || '' %>" placeholder="External Image URL" style="margin-bottom: 0.75rem;" />
            <div style="display: flex; gap: 0.75rem;">
              <input type="file" id="bizLogoFile" style="display:none;" accept="image/*" onchange="handleLogoUpload(this)" />
              <button type="button" class="action-btn-premium" onclick="document.getElementById('bizLogoFile').click()">
                <i data-lucide="upload-cloud"></i> Upload New Image
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 🤖 AI Agent Configuration -->
  <div class="glass-card" style="border-top: 2px solid rgba(var(--primary-rgb), 0.4);">
    <div class="card-header-premium">
      <div class="header-icon-box" style="background: rgba(var(--primary-rgb), 0.12); color: var(--primary);">
        <i data-lucide="sparkles"></i>
      </div>
      <div>
        <h3 class="card-title-premium">AI Voice Synthesis & Persona</h3>
        <p class="card-subtitle-premium">Configure the voice and logic of your digital frontline assistant.</p>
      </div>
      <span class="badge badge-premium">Elite Engine V2</span>
    </div>

    <% const isAppointment = ['appointment', 'salon', 'clinic', 'spa', 'barber'].some(t => (business.type || '').includes(t)); %>

    <div class="card-body-grid">
      <div class="form-group-premium col-span-2">
        <label><i data-lucide="user"></i> AI Entity Name</label>
        <input type="text" id="aiName" class="form-control-premium" value="<%= business.aiName || 'Sarah' %>" placeholder="e.g. Sarah" />
        <p class="input-hint">The cognitive identity your AI will use when engaging with clients.</p>
      </div>

      <div class="form-group-premium col-span-2">
        <label><i data-lucide="users"></i> AI Gender Identity</label>
        <div style="display: flex; gap: 1rem;">
          <label class="gender-btn <%= (business.aiGender === 'female' || !business.aiGender) ? 'active' : '' %>" onclick="setGender('female')">
            <input type="radio" name="aiGender" value="female" <%= (business.aiGender === 'female' || !business.aiGender) ? 'checked' : '' %> style="display:none;">
            <i data-lucide="user-round-plus"></i> Female
          </label>
          <label class="gender-btn <%= business.aiGender === 'male' ? 'active' : '' %>" onclick="setGender('male')">
            <input type="radio" name="aiGender" value="male" <%= business.aiGender === 'male' ? 'checked' : '' %> style="display:none;">
            <i data-lucide="user-round"></i> Male
          </label>
        </div>
      </div>

      <div class="form-group-premium">
        <label><i data-lucide="brain"></i> Cognitive Personality</label>
        <select id="aiPersonality" class="form-control-premium" onchange="filterVoices()">
          <option value="friendly" <%= business.aiPersonality === 'friendly' ? 'selected' : '' %>>Friendly & Warm</option>
          <option value="professional" <%= (business.aiPersonality === 'professional' || !business.aiPersonality) ? 'selected' : '' %>>Professional & Elite</option>
          <option value="energetic" <%= business.aiPersonality === 'energetic' ? 'selected' : '' %>>Energetic & Vibrant</option>
        </select>
      </div>

      <div class="form-group-premium">
        <label><i data-lucide="mic-2"></i> Voice Signature</label>
        <select id="aiVoiceId" class="form-control-premium highlight-select">
          <!-- Populated by JS -->
        </select>
      </div>

      <div id="customAgentInput" class="form-group-premium col-span-2" style="display: none;">
        <label><i data-lucide="key"></i> Custom ElevenLabs Agent ID</label>
        <input type="text" id="customAiVoiceId" class="form-control-premium" value="<%= business.aiVoiceId %>" placeholder="agent_..." />
      </div>

      <% if (isAppointment) { %>
      <div class="form-group-premium col-span-2">
        <label><i data-lucide="hourglass"></i> Session Cycle (Minutes)</label>
        <input type="number" id="appointmentDuration" class="form-control-premium" value="<%= business.appointmentDuration || 30 %>" />
      </div>
      <% } %>
    </div>
  </div>

  <!-- 📞 Phone Routing & Human Call Transfer -->
  <div class="glass-card" style="border-top: 2px solid rgba(0, 242, 255, 0.4);">
    <div class="card-header-premium">
      <div class="header-icon-box" style="background: rgba(0, 242, 255, 0.1); color: #00f2ff;">
        <i data-lucide="phone-call"></i>
      </div>
      <div>
        <h3 class="card-title-premium">Phone Routing & Human Call Transfer</h3>
        <p class="card-subtitle-premium">Keep your existing business number. Forward calls to Naxton AI and escalate to a human manager 24/7.</p>
      </div>
      <span class="badge badge-premium" style="border-color: rgba(0,242,255,0.3); color:#00f2ff; background: rgba(0,242,255,0.05);">US Telephony</span>
    </div>

    <div class="card-body-grid">
      <!-- 1. Existing Customer-Facing Business Number -->
      <div class="form-group-premium">
        <label><i data-lucide="building"></i> Existing Business Number (Customer-Facing)</label>
        <input type="text" id="existingBizPhone" class="form-control-premium" value="<%= business.phoneNumber || '' %>" placeholder="+1 (305) 555-1000" />
        <p class="input-hint">The public number your customers already call. Forward this number to your Naxton AI line.</p>
      </div>

      <!-- 2. Naxton / Twilio AI Proxy Number -->
      <div class="form-group-premium">
        <label><i data-lucide="cpu"></i> Naxton AI Dedicated Number</label>
        <div style="display:flex; gap:0.5rem;">
          <input type="text" id="naxtonAiPhone" class="form-control-premium" readonly value="Loading..." placeholder="No Twilio AI Line" style="background:rgba(0,0,0,0.3);" />
          <button type="button" class="action-btn-premium" onclick="document.getElementById('provisionBox').style.display = document.getElementById('provisionBox').style.display === 'none' ? 'block' : 'none';" style="white-space:nowrap;">
            <i data-lucide="plus-circle"></i> Provision Line
          </button>
        </div>
        <p class="input-hint">Receives forwarded calls from your business phone provider.</p>
      </div>

      <!-- Inline Provision Box -->
      <div id="provisionBox" class="col-span-2" style="display:none; background:rgba(0,0,0,0.4); border:1px solid var(--glass-border); border-radius:1rem; padding:1.5rem;">
        <h4 style="color:white; font-size:0.9rem; margin-bottom:1rem; display:flex; align-items:center; gap:0.5rem;"><i data-lucide="search" style="width:16px; height:16px; color:#00f2ff;"></i> Provision US Twilio AI Number</h4>
        <div style="display:flex; gap:1rem; align-items:center; flex-wrap:wrap;">
          <input type="text" id="areaCodeSearch" class="form-control-premium" placeholder="3-digit Area Code (e.g. 305)" style="max-width:220px;" />
          <button type="button" class="action-btn-premium" onclick="searchNumbers()"><i data-lucide="search"></i> Search Numbers</button>
        </div>
        <div id="numberList" style="margin-top:1rem; display:none;"></div>
      </div>

      <!-- 3. Owner / Manager Transfer Number (Verified Destination) -->
      <div class="form-group-premium col-span-2">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem; flex-wrap:wrap; gap:0.5rem;">
          <label style="margin-bottom:0;"><i data-lucide="user-check"></i> Owner / Manager Transfer Number (Human Escalation)</label>
          <span id="transferVerifyBadge" class="badge" style="font-size:0.65rem; padding:0.3rem 0.6rem; border-radius:1rem; background:rgba(255,170,0,0.1); color:#ffaa00; border:1px solid rgba(255,170,0,0.3);">
            ⚠️ Verification Pending
          </span>
        </div>
        <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
          <input type="text" id="humanTransferNumber" class="form-control-premium" style="flex:1; min-width:220px;" placeholder="+1 (305) 555-3000" />
          <button type="button" id="sendOtpBtn" class="action-btn-premium" onclick="requestOtpVerification()" style="white-space:nowrap; background:rgba(0,242,255,0.1); border-color:rgba(0,242,255,0.3); color:#00f2ff;">
            <i data-lucide="shield-check"></i> Verify Number
          </button>
        </div>
        <p class="input-hint">When callers request to speak with the manager or owner, Naxton bridges live calls to this verified US number.</p>
      </div>

      <!-- OTP Verification Box -->
      <div id="otpVerifyBox" class="col-span-2" style="display:none; background:linear-gradient(135deg, rgba(0,242,255,0.08) 0%, rgba(0,0,0,0.4) 100%); border:1px solid rgba(0,242,255,0.3); border-radius:1rem; padding:1.5rem;">
        <h4 style="color:white; font-size:0.95rem; margin-bottom:0.5rem; display:flex; align-items:center; gap:0.5rem;"><i data-lucide="key-round" style="width:18px; height:18px; color:#00f2ff;"></i> Enter 6-Digit SMS Verification Code</h4>
        <p style="color:var(--text-muted); font-size:0.8rem; margin-bottom:1rem;">We sent a 6-digit verification code via SMS to your manager transfer number. Code expires in 10 minutes.</p>
        <div style="display:flex; gap:1rem; max-width:400px; flex-wrap:wrap;">
          <input type="text" id="otpCodeInput" class="form-control-premium" placeholder="123456" maxlength="6" style="text-align:center; font-family:'JetBrains Mono', monospace; font-size:1.2rem; letter-spacing:0.3em; flex:1; min-width:140px;" />
          <button type="button" class="action-btn-premium" onclick="submitOtpCode()" style="background:#00f2ff; color:#000; font-weight:800;">
            Confirm Verification
          </button>
        </div>
      </div>

      <!-- 4. Controls: AI Answering, Human Transfer Toggle, Timeout -->
      <div class="form-group-premium">
        <label><i data-lucide="bot"></i> 24/7 AI Receptionist Answering</label>
        <select id="aiEnabledToggle" class="form-control-premium">
          <option value="true">ENABLED — AI answers calls automatically</option>
          <option value="false">DISABLED — Direct call forwarding to manager</option>
        </select>
      </div>

      <div class="form-group-premium">
        <label><i data-lucide="phone-forwarded"></i> Human Call Transfer Escalation</label>
        <select id="humanTransferEnabledToggle" class="form-control-premium">
          <option value="true">ENABLED — AI can transfer live calls to manager</option>
          <option value="false">DISABLED — AI handles calls without transferring</option>
        </select>
      </div>

      <div class="form-group-premium">
        <label><i data-lucide="timer"></i> Transfer Ring Timeout (Seconds)</label>
        <input type="number" id="transferTimeoutSec" class="form-control-premium" value="30" min="10" max="60" />
      </div>

      <div class="form-group-premium">
        <label><i data-lucide="shield-alert"></i> Fallback Destination Number</label>
        <input type="text" id="fallbackNumberInput" class="form-control-premium" placeholder="+1 (305) 555-4000" />
      </div>

      <!-- 5. Carrier Call Forwarding Guide -->
      <div class="col-span-2" style="background:rgba(255,255,255,0.02); border:1px solid var(--glass-border); border-radius:1rem; padding:1.5rem;">
        <h4 style="color:white; font-size:0.9rem; margin-bottom:1rem; display:flex; align-items:center; gap:0.5rem;">
          <i data-lucide="arrow-right-left" style="color:var(--primary);"></i> How to Forward Your Business Phone Number
        </h4>
        <p style="color:var(--text-muted); font-size:0.8rem; margin-bottom:1rem;">
          Your customers keep calling your existing business number. Set up call forwarding with your phone provider to route incoming calls to your Naxton AI number.
        </p>
        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:1rem; font-size:0.8rem;">
          <div style="background:rgba(0,0,0,0.3); padding:0.9rem; border-radius:0.75rem; border:1px solid rgba(255,255,255,0.05);">
            <strong style="color:#fff;">🇺🇸 US & 🇨🇦 Canada (AT&T / Verizon):</strong><br>
            Dial <code style="color:#00f2ff; background:rgba(0,242,255,0.1); padding:0.1rem 0.4rem; border-radius:0.25rem;">*72</code> + <span class="naxtonAiPhoneDisplay" style="color:#fff;">Naxton AI Number</span>
          </div>
          <div style="background:rgba(0,0,0,0.3); padding:0.9rem; border-radius:0.75rem; border:1px solid rgba(255,255,255,0.05);">
            <strong style="color:#fff;">🇵🇰 Pakistan (Jazz / Zong / Telenor / Ufone):</strong><br>
            Dial <code style="color:#00f2ff; background:rgba(0,242,255,0.1); padding:0.1rem 0.4rem; border-radius:0.25rem;">*21*</code> + <span class="naxtonAiPhoneDisplay" style="color:#fff;">Naxton AI Number</span> + <code style="color:#00f2ff; background:rgba(0,242,255,0.1); padding:0.1rem 0.4rem; border-radius:0.25rem;">#</code>
          </div>
          <div style="background:rgba(0,0,0,0.3); padding:0.9rem; border-radius:0.75rem; border:1px solid rgba(255,255,255,0.05);">
            <strong style="color:#fff;">🇬🇧 UK & 🇦🇪 UAE (GSM Standard):</strong><br>
            Dial <code style="color:#00f2ff; background:rgba(0,242,255,0.1); padding:0.1rem 0.4rem; border-radius:0.25rem;">**21*</code> + <span class="naxtonAiPhoneDisplay" style="color:#fff;">Naxton AI Number</span> + <code style="color:#00f2ff; background:rgba(0,242,255,0.1); padding:0.1rem 0.4rem; border-radius:0.25rem;">#</code>
          </div>
          <div style="background:rgba(0,0,0,0.3); padding:0.9rem; border-radius:0.75rem; border:1px solid rgba(255,255,255,0.05);">
            <strong style="color:#fff;">VoIP / Softphone (Google Voice / RingCentral):</strong><br>
            Go to Settings ➜ Call Forwarding ➜ Add Naxton AI Number
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- 🚀 Operational Constraints & Fulfillment -->
  <% if (!isAppointment) { %>
  <div class="glass-card">
    <div class="card-header-premium">
      <div class="header-icon-box" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
        <i data-lucide="truck"></i>
      </div>
      <div>
        <h3 class="card-title-premium">Logistics & Fulfillment</h3>
        <p class="card-subtitle-premium">Control how your physical inventory reaches your clientele.</p>
      </div>
    </div>

    <div class="card-body-grid">
      <label class="toggle-card <%= business.dineInAvailable ? 'active' : '' %>" onclick="toggleCardActive(this)">
        <div class="toggle-content">
          <i data-lucide="utensils"></i>
          <span>Dine-In Operations</span>
        </div>
        <input type="checkbox" id="dineInAvailable" <%= business.dineInAvailable ? 'checked' : '' %> class="hidden-check" />
      </label>

      <label class="toggle-card <%= business.takeawayAvailable ? 'active' : '' %>" onclick="toggleCardActive(this)">
        <div class="toggle-content">
          <i data-lucide="package"></i>
          <span>Takeaway / Curbside</span>
        </div>
        <input type="checkbox" id="takeawayAvailable" <%= business.takeawayAvailable ? 'checked' : '' %> class="hidden-check" />
      </label>

      <label class="toggle-card <%= business.deliveryAvailable ? 'active' : '' %>" onclick="toggleCardActive(this); document.getElementById('radiusGroup').style.opacity = this.querySelector('input').checked ? '1' : '0.4'">
        <div class="toggle-content">
          <i data-lucide="map"></i>
          <span>Global Delivery</span>
        </div>
        <input type="checkbox" id="deliveryAvailable" <%= business.deliveryAvailable ? 'checked' : '' %> class="hidden-check" />
      </label>

      <div class="form-group-premium" id="radiusGroup" style="transition: all 0.4s; opacity: <%= business.deliveryAvailable ? 1 : 0.4 %>; pointer-events: <%= business.deliveryAvailable ? 'auto' : 'none' %>;">
        <label><i data-lucide="ruler"></i> Operational Radius (KM)</label>
        <input type="number" step="0.5" id="deliveryRadius" class="form-control-premium" value="<%= business.deliveryRadius || 5.0 %>" />
      </div>

      <div class="form-group-premium col-span-2">
        <label class="toggle-card highlight-card <%= business.reservationsEnabled ? 'active' : '' %>" onclick="toggleCardActive(this)" style="flex-direction: row; justify-content: space-between; padding: 1.5rem; text-align: left;">
          <div style="display: flex; gap: 1rem; align-items: center;">
            <i data-lucide="calendar-check" style="width: 24px; height: 24px;"></i>
            <div>
              <span style="display: block; font-weight: 700; color: white;">Mandatory Reservations</span>
              <span style="font-size: 0.75rem; opacity: 0.7;">Require clients to secure time slots via AI.</span>
            </div>
          </div>
          <input type="checkbox" id="reservationsEnabled" <%= business.reservationsEnabled ? 'checked' : '' %> class="hidden-check" />
        </label>
      </div>
    </div>
  </div>
  <% } %>

  <!-- 🔒 Access Control & Governance -->
  <div class="glass-card">
    <div class="card-header-premium">
      <div class="header-icon-box" style="background: rgba(255,255,255,0.06);">
        <i data-lucide="shield-check"></i>
      </div>
      <div>
        <h3 class="card-title-premium">Access Control & Governance</h3>
        <p class="card-subtitle-premium">Manage team permissions and workspace security.</p>
      </div>
    </div>
    <div style="padding: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem;">
      <p style="color:var(--text-muted); font-size:0.875rem; max-width: 450px; margin: 0;">Configure granular role-based access controls for your staff members and executive team.</p>
      <button class="action-btn-premium" onclick="loadSection('staff')">
        <i data-lucide="users"></i> Manage Personnel
      </button>
    </div>
  </div>

  <!-- 💾 Global Footer Actions -->
  <div class="footer-actions-glass">
    <div style="display: flex; align-items: center; gap: 0.75rem; color: var(--text-muted); font-size: 0.8rem;">
      <i data-lucide="info" style="width: 16px; height: 16px; color: var(--primary);"></i>
      <span>Last synced: <%= new Date().toLocaleTimeString() %></span>
    </div>
    <div style="display: flex; gap: 1rem;">
      <button class="apex-btn-outline" onclick="loadSection('dashboard')">Cancel</button>
      <button class="apex-btn" onclick="saveBusiness()" id="saveProfileBtn">
        <i data-lucide="save"></i> Save Settings
      </button>
    </div>

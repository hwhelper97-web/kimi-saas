  .icon-pulse { animation: icon-pulse 3s infinite ease-in-out; }
</style>
<script>
  let currentGender = '<%= business.aiGender || 'female' %>';
  const bizType = '<%= business.type || 'appointment' %>';
  const currentVoiceId = '<%= business.aiVoiceId %>';

  const allAgents = [
    // --- APPOINTMENT / SALON ---
    { id: "agent_5501kqtn1qjxe5nvyc9x6zyn8w8g", voiceId: "DODLEQrClDo8wCz460ld", name: "Lauren (Friendly & Soft)", gender: "female", personality: "friendly", category: "appointment" },
    { id: "agent_5501kqtn1qjxe5nvyc9x6zyn8w8g", voiceId: "ImnfuV8oxhB7ya99oJfc", name: "Helen (Warm & Articulate)", gender: "female", personality: "professional", category: "appointment" },
    { id: "agent_9401kqqj87jzf9mrmfwsprqh3frh", voiceId: "DODLEQrClDo8wCz460ld", name: "Lauren (Friendly & Soft)", gender: "female", personality: "friendly", category: "appointment" },
    { id: "agent_9401kqqj87jzf9mrmfwsprqh3frh", voiceId: "ImnfuV8oxhB7ya99oJfc", name: "Helen (Warm & Articulate)", gender: "female", personality: "professional", category: "appointment" },
    { id: "agent_9401kqqj87jzf9mrmfwsprqh3frh", voiceId: "UgBBYS2sOqTuMpoF3BR0", name: "Mark (Natural Conversation)", gender: "male", personality: "friendly", category: "appointment" },
    { id: "agent_9401kqqj87jzf9mrmfwsprqh3frh", name: "Sarah (Default)", gender: "female", personality: "professional", category: "appointment" },
    { id: "agent_9401kqqj87jzf9mrmfwsprqh3frh", name: "Adam (Male Pro)", gender: "male", personality: "professional", category: "appointment" },
    
    // --- ORDER / RESTAURANT ---
    { id: "agent_9401kqqj87jzf9mrmfwsprqh3frh", voiceId: "DODLEQrClDo8wCz460ld", name: "Lauren (Friendly & Soft)", gender: "female", personality: "friendly", category: "appointment" },
    { id: "agent_9401kqqj87jzf9mrmfwsprqh3frh", voiceId: "ImnfuV8oxhB7ya99oJfc", name: "Helen (Warm & Articulate)", gender: "female", personality: "professional", category: "appointment" },
    { id: "agent_9401kqqj87jzf9mrmfwsprqh3frh", voiceId: "cgSgspJ2msm6clMCkdW9", name: "Jessica (Energetic)", gender: "female", personality: "energetic", category: "appointment" },
    { id: "agent_9401kqqj87jzf9mrmfwsprqh3frh", name: "Sarah (Default)", gender: "female", personality: "professional", category: "appointment" },
    { id: "agent_9401kqqj87jzf9mrmfwsprqh3frh", voiceId: "cgSgspJ2msm6clMCkdW9", name: "Jessica (Upbeat Host)", gender: "female", personality: "energetic", category: "order" },
    { id: "agent_9401kqqj87jzf9mrmfwsprqh3frh", voiceId: "ImnfuV8oxhB7ya99oJfc", name: "Helen (Calm Attendant)", gender: "female", personality: "professional", category: "order" },
    { id: "agent_9401kqqj87jzf9mrmfwsprqh3frh", voiceId: "nPczCjzI2devNBz1zQrb", name: "Brian (Friendly Order Agent)", gender: "male", personality: "friendly", category: "order" },
    { id: "agent_9401kqqj87jzf9mrmfwsprqh3frh", name: "Sarah (Female Pro)", gender: "female", personality: "professional", category: "order" },
    { id: "agent_9401kqqj87jzf9mrmfwsprqh3frh", voiceId: "N2lExwZ6p0LnJHBNp15o", name: "Jarvis (Concierge Pro)", gender: "male", personality: "professional", category: "order" },
    { id: "agent_9401kqqj87jzf9mrmfwsprqh3frh", voiceId: "DODLEQrClDo8wCz460ld", name: "Lauren (Soft Helper)", gender: "female", personality: "friendly", category: "order" }
  ];

  function setGender(gender) {
    currentGender = gender;
    document.querySelectorAll('.gender-btn').forEach(btn => {
      btn.classList.toggle('active', btn.querySelector('input').value === gender);
      if (btn.querySelector('input').value === gender) btn.querySelector('input').checked = true;
    });
    filterVoices();
  }

  function filterVoices() {
    const personality = document.getElementById('aiPersonality').value;
    const category = bizType.includes('order') ? 'order' : 'appointment';
    const voiceSelect = document.getElementById('aiVoiceId');
    const customInput = document.getElementById('customAgentInput');
    
    // Filter matching agents
    const filtered = allAgents.filter(a => 
      a.gender === currentGender && 
      a.personality === personality && 
      a.category === category
    );

    // If no perfect match, filter by gender + category
    let finalSelection = filtered;
    if (finalSelection.length === 0) {
      finalSelection = allAgents.filter(a => a.gender === currentGender && a.category === category);
    }

    voiceSelect.innerHTML = finalSelection.map(a => 
      '<option value="' + a.id + '" ' + (a.voiceId ? 'data-voice="' + a.voiceId + '"' : '') + ' ' + (currentVoiceId === a.id ? 'selected' : '') + '>' + a.name + ' (Elite Synthesis)</option>'
    ).join('');

    voiceSelect.innerHTML += '<option value="custom" ' + (!allAgents.find(a => a.id === currentVoiceId) && currentVoiceId ? 'selected' : '') + '>-- Custom Agent ID --</option>';

    // Trigger custom input visibility
    if (voiceSelect.value === 'custom') customInput.style.display = 'block';
    else customInput.style.display = 'none';
  }

  async function saveBusiness() {
    const btn = document.getElementById('saveProfileBtn');
    const originalHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="spin" data-lucide="refresh-cw"></i> Saving...';
    if (window.lucide) lucide.createIcons();

    const selectedDays = Array.from(document.querySelectorAll('input[name="bizDays"]:checked')).map(i => i.value).join(',');

    const payload = {
      name: document.getElementById('bizName').value,
      phoneNumber: document.getElementById('bizPhone').value,
      address: document.getElementById('bizAddress').value,
      openTime: document.getElementById('bizOpenTime').value,
      closeTime: document.getElementById('bizCloseTime').value,
      timings: selectedDays,
      currency: document.getElementById('bizCurrency').value,
      taxRate: parseFloat(document.getElementById('bizTaxRate').value) || 0,
      logoUrl: document.getElementById('bizLogo').value,
      aiName: document.getElementById('aiName').value,
      aiGender: currentGender,
      aiPersonality: document.getElementById('aiPersonality').value,
      aiVoiceId: document.getElementById('aiVoiceId').value === 'custom' ? document.getElementById('customAiVoiceId').value : document.getElementById('aiVoiceId').value
    };

    const selectedVoiceOption = document.getElementById('aiVoiceId').options[document.getElementById('aiVoiceId').selectedIndex];
    if (selectedVoiceOption && selectedVoiceOption.dataset.voice) {
      payload.aiVoice = 'eleven_' + selectedVoiceOption.dataset.voice;
    } else {
      payload.aiVoice = 'nova'; // Fallback / Default
    }

    const apptDur = document.getElementById('appointmentDuration');
    if (apptDur) {
      const val = parseInt(apptDur.value) || 30;
      payload.appointmentDuration = val;
      payload.slotInterval = val;
    }

    const bizTz = document.getElementById('bizTimezone');
    if (bizTz) payload.timezone = bizTz.value;

    const dineIn = document.getElementById('dineInAvailable');
    if (dineIn) payload.dineInAvailable = dineIn.checked;

    const takeaway = document.getElementById('takeawayAvailable');
    if (takeaway) payload.takeawayAvailable = takeaway.checked;

    const delivery = document.getElementById('deliveryAvailable');
    if (delivery) payload.deliveryAvailable = delivery.checked;

    const radius = document.getElementById('deliveryRadius');
    if (radius) payload.deliveryRadius = parseFloat(radius.value) || 5.0;

    const resv = document.getElementById('reservationsEnabled');
    if (resv) payload.reservationsEnabled = resv.checked;

    try {
      const bId = getBusinessId();
      const res = await fetch(`/api/business/${bId}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + (localStorage.getItem("accessToken") || window.token)
        },
        body: JSON.stringify(payload)
      });
      const result = await res.json();
      if (result.success) {
        notify("Neural personality synchronized. AI frontier updated.", "Success");
      } else {
        notify(result.error || "Update failed", "Error");
      }

      // 📞 Also save phone routing configuration
      const phonePayload = {
        businessId: bId,
        businessPhoneNumber: document.getElementById('existingBizPhone')?.value,
        transferNumber: document.getElementById('humanTransferNumber')?.value,
        fallbackNumber: document.getElementById('fallbackNumberInput')?.value,
        aiEnabled: document.getElementById('aiEnabledToggle')?.value === 'true',
        humanTransferEnabled: document.getElementById('humanTransferEnabledToggle')?.value === 'true',
        transferTimeout: parseInt(document.getElementById('transferTimeoutSec')?.value) || 30
      };

      const phoneUrl = currentPhoneConfigId ? `/api/phone/config/${currentPhoneConfigId}` : '/api/phone/config';
      const phoneMethod = currentPhoneConfigId ? 'PUT' : 'POST';
      await fetch(phoneUrl, {
        method: phoneMethod,
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + (localStorage.getItem("accessToken") || window.token)
        },
        body: JSON.stringify(phonePayload)
      });

    } catch (err) {
      console.error(err);
      notify("Platform connection error", "Error");
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalHtml;
      if (window.lucide) lucide.createIcons();
    }
  }

  // --- Phone Routing & OTP Verification Handlers ---
  let currentPhoneConfigId = null;

  async function loadPhoneConfig() {
    try {
      const bId = getBusinessId();
      const res = await fetch(`/api/phone/config?businessId=${bId}`, {
        headers: { 'Authorization': 'Bearer ' + (localStorage.getItem("accessToken") || window.token) }
      });
      const result = await res.json();
      let phoneVal = '';
      if (result.success && result.data && result.data.length > 0) {
        const cfg = result.data[0];
        currentPhoneConfigId = cfg.id;
        
        if (cfg.twilioPhoneNumber && cfg.twilioPhoneNumber !== 'PENDING') {
          phoneVal = cfg.twilioPhoneNumber;
        }
        if (cfg.businessPhoneNumber && document.getElementById('existingBizPhone')) {
          document.getElementById('existingBizPhone').value = cfg.businessPhoneNumber;
        }
        if (cfg.transferNumber && document.getElementById('humanTransferNumber')) {
          document.getElementById('humanTransferNumber').value = cfg.transferNumber;
        }
        if (cfg.fallbackNumber && document.getElementById('fallbackNumberInput')) {
          document.getElementById('fallbackNumberInput').value = cfg.fallbackNumber;
        }
        if (cfg.transferTimeout && document.getElementById('transferTimeoutSec')) {
          document.getElementById('transferTimeoutSec').value = cfg.transferTimeout;
        }
        if (document.getElementById('aiEnabledToggle')) {
          document.getElementById('aiEnabledToggle').value = cfg.aiEnabled ? 'true' : 'false';
        }
        if (document.getElementById('humanTransferEnabledToggle')) {
          document.getElementById('humanTransferEnabledToggle').value = cfg.humanTransferEnabled ? 'true' : 'false';
        }

        const badge = document.getElementById('transferVerifyBadge');
        if (badge) {
          if (cfg.transferVerificationStatus === 'VERIFIED') {
            badge.style.background = 'rgba(0, 255, 136, 0.1)';
            badge.style.color = '#00ff88';
            badge.style.borderColor = 'rgba(0, 255, 136, 0.3)';
            badge.innerHTML = '✓ Verified Destination';
          } else {
            badge.style.background = 'rgba(255, 170, 0, 0.1)';
            badge.style.color = '#ffaa00';
            badge.style.borderColor = 'rgba(255, 170, 0, 0.3)';
            badge.innerHTML = '⚠️ Verification Pending';
          }
        }
      }

      const phoneInput = document.getElementById('naxtonAiPhone');
      if (phoneInput) {
        phoneInput.value = phoneVal || 'No Twilio AI Line Linked';
      }
      document.querySelectorAll('.naxtonAiPhoneDisplay').forEach(el => el.textContent = phoneVal || 'No Twilio AI Line');
    } catch (e) {
      console.error("Failed loading phone config:", e);
    }
  }

  async function requestOtpVerification() {
    const num = document.getElementById('humanTransferNumber')?.value;
    if (!num) return notify("Please enter a transfer phone number first", "Warning");

    const btn = document.getElementById('sendOtpBtn');
    if (btn) { btn.disabled = true; btn.innerHTML = 'Sending Code...'; }

    try {
      const res = await fetch('/api/phone/request-transfer-verification', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + (localStorage.getItem("accessToken") || window.token)
        },
        body: JSON.stringify({
          id: currentPhoneConfigId,
          businessId: getBusinessId(),
          transferNumber: num
        })
      });
      const result = await res.json();
      if (result.success) {
        notify("Verification code sent via SMS to " + num, "Success");
        document.getElementById('otpVerifyBox').style.display = 'block';
      } else {
        notify(result.error || "Failed to send verification code", "Error");
      }
    } catch (err) {
      notify("Network error requesting verification code", "Error");
    } finally {
      if (btn) { btn.disabled = false; btn.innerHTML = '<i data-lucide="shield-check"></i> Verify Number'; }
      if (window.lucide) lucide.createIcons();
    }
  }

  async function submitOtpCode() {
    const otp = document.getElementById('otpCodeInput')?.value;
    if (!otp || otp.length < 6) return notify("Please enter the 6-digit SMS code", "Warning");

    try {
      const res = await fetch('/api/phone/verify-transfer-otp', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + (localStorage.getItem("accessToken") || window.token)
        },
        body: JSON.stringify({
          id: currentPhoneConfigId,
          businessId: getBusinessId(),
          otp: otp.trim()
        })
      });
      const result = await res.json();
      if (result.success) {
        notify("Transfer number verified successfully!", "Success");
        document.getElementById('otpVerifyBox').style.display = 'none';
        loadPhoneConfig();
      } else {
        notify(result.error || "Verification failed", "Error");
      }
    } catch (err) {
      notify("Verification request failed", "Error");
    }
  }

  // --- Phone Number Provisioning ---
  async function searchNumbers() {
    const areaCode = document.getElementById('areaCodeSearch')?.value;
    const list = document.getElementById('numberList');
    if (!list) return;

    list.innerHTML = '<div style="padding:2rem; text-align:center; color:var(--text-muted);"><div class="spin" style="margin:0 auto 1rem;"></div>Searching numbers...</div>';
    list.style.display = 'block';

    try {
      const res = await fetch(`/api/call/provision/search?areaCode=${areaCode || ''}&businessId=${getBusinessId()}`, {
        headers: { 'Authorization': 'Bearer ' + (localStorage.getItem("accessToken") || window.token) }
      });
      const result = await res.json();
      
      let html = '';

      // 1. Show existing inventory numbers if any exist
      if (result.inventory && result.inventory.length > 0) {
        html += '<div style="margin-bottom:1.5rem;"><h5 style="color:#00f2ff; font-size:0.8rem; text-transform:uppercase; font-weight:700; margin-bottom:0.75rem;">📦 Existing Account Inventory Numbers</h5>';
        html += result.inventory.map(n => 
          '<div style="display:flex; justify-content:space-between; align-items:center; padding:0.75rem 1rem; background:rgba(255,255,255,0.03); border:1px solid var(--glass-border); border-radius:0.75rem; margin-bottom:0.5rem;">' +
            '<div>' +
              '<span style="font-weight:700; font-family:\'JetBrains Mono\', monospace; color:white;">' + n.phoneNumber + '</span>' +
              (n.businessName ? ' <span style="font-size:0.7rem; color:var(--text-muted);">(' + n.businessName + ')</span>' : ' <span style="font-size:0.7rem; color:#00ff88;">(Available)</span>') +
            '</div>' +
            '<button class="action-btn-premium" style="padding:0.35rem 0.75rem; font-size:0.75rem; background:rgba(0,242,255,0.1); color:#00f2ff; border-color:rgba(0,242,255,0.3);" onclick="linkNumber(\'' + n.phoneNumber + '\')">' +
              '<i data-lucide="link"></i> Link to Business' +
            '</button>' +
          '</div>'
        ).join('');
        html += '</div>';
      }

      // 2. Show new search results
      if (result.success && result.data && result.data.length > 0) {
        html += '<div><h5 style="color:#fff; font-size:0.8rem; text-transform:uppercase; font-weight:700; margin-bottom:0.75rem;">🌐 Buy New US Twilio Number</h5>';
        html += result.data.map(n => 
          '<div style="display:flex; justify-content:space-between; align-items:center; padding:0.75rem 1rem; border-bottom:1px solid var(--glass-border);">' +
            '<span style="font-weight:600; font-family:\'JetBrains Mono\', monospace; color:white;">' + n.friendlyName + '</span>' +
            '<button class="action-btn-premium" style="padding:0.35rem 0.75rem; font-size:0.75rem;" onclick="purchaseNumber(\'' + n.phoneNumber + '\')">' +
              'Secure & Buy' +
            '</button>' +
          '</div>'
        ).join('');
        html += '</div>';
      } else if (!result.inventory || result.inventory.length === 0) {
        html = '<div style="padding:2rem; text-align:center; color:var(--text-muted);">No matching phone numbers found. Try another area code.</div>';
      }

      list.innerHTML = html;
      if (window.lucide) lucide.createIcons();
    } catch (err) {
      notify("Number search failed", "Error");
      list.style.display = 'none';
    }
  }

  // --- Custom Confirm Modal Helper ---
  function showConfirmModal({ title, text, icon = 'shield-alert', confirmText = 'Confirm', onConfirm }) {
    const modal = document.getElementById('confirmModal');
    if (!modal) return;

    document.getElementById('confirmModalTitle').textContent = title || 'Confirm Action';
    document.getElementById('confirmModalText').innerHTML = text || 'Are you sure you want to proceed?';
    
    const iconEl = document.getElementById('confirmModalIcon');
    if (iconEl) {
      iconEl.setAttribute('data-lucide', icon);
      if (window.lucide) lucide.createIcons();
    }

    const btn = document.getElementById('confirmModalBtn');
    if (btn) {
      btn.textContent = confirmText;
      btn.onclick = async function() {
        btn.disabled = true;
        btn.innerHTML = '<i class="spin" data-lucide="refresh-cw"></i> Processing...';
        if (window.lucide) lucide.createIcons();
        try {
          if (onConfirm) await onConfirm();
        } finally {
          btn.disabled = false;
          closeConfirmModal();
        }
      };
    }

    modal.style.display = 'flex';
  }

  function closeConfirmModal() {
    const modal = document.getElementById('confirmModal');
    if (modal) modal.style.display = 'none';
  }

  function purchaseNumber(phoneNumber) {
    showConfirmModal({
      title: "Secure & Buy Twilio Line",
      text: `Are you sure you want to purchase <strong style="color:#00f2ff; font-family:'JetBrains Mono', monospace;">${phoneNumber}</strong>?<br><span style="font-size:0.8rem; opacity:0.8; display:block; margin-top:0.4rem;">This will provision a dedicated 24/7 AI bridge for your business.</span>`,
      icon: "shopping-bag",
      confirmText: "Buy & Link Line",
      onConfirm: async () => {
        try {
          const res = await fetch('/api/call/provision/purchase', {
            method: "POST",
            headers: { 
              "Content-Type": "application/json",
              "Authorization": "Bearer " + (localStorage.getItem("accessToken") || window.token)
            },
            body: JSON.stringify({ phoneNumber, businessId: getBusinessId() })
          });
          const result = await res.json();
          
          if (result.success) {
            notify("Secure line successfully provisioned!", "Success");
            if (document.getElementById('naxtonAiPhone')) document.getElementById('naxtonAiPhone').value = phoneNumber;
            document.querySelectorAll('.naxtonAiPhoneDisplay').forEach(el => el.textContent = phoneNumber);
            document.getElementById('numberList').style.display = 'none';
            document.getElementById('provisionBox').style.display = 'none';
            loadPhoneConfig();
          } else {
            notify(result.error || "Provisioning failed", "Error");
          }
        } catch (err) {
          notify("Neural link interrupted", "Error");
        }
      }
    });
  }

  function linkNumber(phoneNumber) {
    showConfirmModal({
      title: "Link Account Inventory Line",
      text: `Are you sure you want to link <strong style="color:#00f2ff; font-family:'JetBrains Mono', monospace;">${phoneNumber}</strong> to this business?<br><span style="font-size:0.8rem; opacity:0.8; display:block; margin-top:0.4rem;">Incoming calls will route directly to your AI receptionist.</span>`,
      icon: "link",
      confirmText: "Link Line Now",
      onConfirm: async () => {
        try {
          const res = await fetch('/api/call/provision/link', {
            method: "POST",
            headers: { 
              "Content-Type": "application/json",
              "Authorization": "Bearer " + (localStorage.getItem("accessToken") || window.token)
            },
            body: JSON.stringify({ phoneNumber, businessId: getBusinessId() })
          });
          const result = await res.json();
          
          if (result.success) {
            notify("Phone number successfully linked to business!", "Success");
            if (document.getElementById('naxtonAiPhone')) document.getElementById('naxtonAiPhone').value = phoneNumber;
            document.querySelectorAll('.naxtonAiPhoneDisplay').forEach(el => el.textContent = phoneNumber);
            document.getElementById('numberList').style.display = 'none';
            document.getElementById('provisionBox').style.display = 'none';
            loadPhoneConfig();
          } else {
            notify(result.error || "Linking failed", "Error");
          }
        } catch (err) {
          notify("Network error linking number", "Error");
        }
      }
    });
  }

  // --- UI Helpers ---
  function toggleDayActive(input) {
    input.parentElement.classList.toggle('active', input.checked);
  }

  function toggleCardActive(label) {
    const input = label.querySelector('input');
    if (!input) return;
    input.checked = !input.checked;
    label.classList.toggle('active', input.checked);
    if (input.onchange) input.onchange();
  }

  function handleLogoUpload(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        const preview = document.getElementById('logoPreview');
        if (preview) {
          preview.innerHTML = '<img src="' + e.target.result + '" style="width:100%; height:100%; object-fit:contain;" />';
          preview.style.borderStyle = "solid";
          preview.style.borderColor = "var(--primary)";
        }
        notify("Visual identity staged. Ready for propagation.", "Success");
      }
      reader.readAsDataURL(input.files[0]);
    }
  }

  // Init
  if (window.lucide) lucide.createIcons();
  filterVoices(); // Run initial filter
  loadPhoneConfig(); // Load active phone routing & transfer status

  document.getElementById('aiVoiceId')?.addEventListener('change', function() {
    const customInput = document.getElementById('customAgentInput');
    if (!customInput) return;
    if (this.value === 'custom') customInput.style.display = 'block';
    else customInput.style.display = 'none';
  });
</script>
<% } %>

<% if (typeof layout === 'undefined' || layout !== false) { %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Support Ticket | Naxton AI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    :root {
      --primary: #6366f1;
      --primary-hover: #4f46e5;
      --bg: #f8fafc;
      --bg-card: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border: #e2e8f0;
      --radius: 12px;
      --shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
      --input-bg: #ffffff;
    }

    [data-theme="ocean"] {
      --bg: #0f172a;
      --bg-card: #1e293b;
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      --border: rgba(255,255,255,0.1);
      --shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
      --input-bg: #1e293b;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg);
      color: var(--text-main);
      line-height: 1.5;
    }
  </style>
</head>
<body data-theme="ocean">
<% } %>

  <style>
    .create-ticket-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 0;
    }

    .ticket-header-small { margin-bottom: 2rem; }
    .ticket-header-small h1 { font-family: 'Outfit', sans-serif; font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; }
    .subtitle { color: var(--text-muted); font-size: 1rem; }

    .ticket-layout { display: grid; grid-template-columns: 1fr 340px; gap: 2rem; }

    .form-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 2rem;
      box-shadow: var(--shadow);
    }

    .section-title {
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .form-group { margin-bottom: 1.25rem; }
    label { display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.5rem; }
    
    input, select, textarea {
      width: 100%;
      padding: 0.75rem 1rem;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      background: var(--input-bg);
      color: var(--text-main);
      font-family: inherit;
      font-size: 0.875rem;
      transition: all 0.2s;
    }

    select option { background: var(--bg-card); color: var(--text-main); }
    
    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }

    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }

    .rich-editor {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }

    .editor-toolbar {
      padding: 0.5rem;
      background: rgba(255,255,255,0.03);
      border-bottom: 1px solid var(--border);
      display: flex;
      gap: 0.5rem;
    }

    .toolbar-btn {
      width: 32px;
      height: 32px;
      border-radius: 6px;
      border: none;
      background: transparent;
      color: var(--text-muted);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }
    .toolbar-btn:hover { background: var(--primary); color: white; }

    .upload-area {
      border: 2px dashed var(--border);
      border-radius: var(--radius);
      padding: 2rem;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s;
      position: relative;
    }
    .upload-area:hover { border-color: var(--primary); background: rgba(99, 102, 241, 0.05); }

    /* Sidebar Styles */
    .sidebar-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .sidebar-title { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1.25rem; color: var(--text-muted); }

    .step-item { display: flex; gap: 1rem; margin-bottom: 1.5rem; }
    .step-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: rgba(99, 102, 241, 0.1);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .timeline { position: relative; padding-left: 2rem; }
    .timeline::before {
      content: ''; position: absolute; left: 7px; top: 0; bottom: 0; width: 2px;
      background: var(--border);
    }
    .timeline-item { position: relative; margin-bottom: 1.5rem; }
    .timeline-dot {
      position: absolute; left: -2rem; top: 4px; width: 16px; height: 16px;
      border-radius: 50%; background: var(--bg-card); border: 3px solid var(--border);
    }
    .timeline-item.active .timeline-dot { border-color: var(--primary); background: var(--primary); }

    .btn {
      padding: 0.75rem 1.25rem;
      border-radius: var(--radius);
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
      border: none;
      font-family: inherit;
      font-size: 0.875rem;
    }
    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: var(--primary-hover); transform: translateY(-2px); box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.4); }
    .btn-ghost { background: transparent; color: var(--text-muted); }

    .footer-actions {
      display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1.5rem;
      padding-top: 1.5rem; border-top: 1px solid var(--border);
    }
  </style>

  <div class="create-ticket-container">
    <div class="ticket-layout">
      <div class="main-form">
        <form id="ticketForm" class="form-card">
          <div class="section-title">
            <i data-lucide="info" style="color: var(--primary);"></i>
            1. Describe Your Issue
          </div>

          <div class="form-group">
            <label>Subject *</label>
            <input type="text" id="subject" placeholder="Briefly describe the problem" required>
          </div>

          <div class="grid-2">
            <div class="form-group">
              <label>Category *</label>
              <select id="category" required>
                <option value="">Select a category</option>
                <option value="technical">Technical Issue</option>
                <option value="billing">Billing & Subscription</option>
                <option value="account">Account Access</option>
                <option value="feature">Feature Request</option>
              </select>
            </div>
            <div class="form-group">
              <label>Priority *</label>
              <select id="priority" required>
                <option value="low">Low</option>
                <option value="medium" selected>Medium</option>
                <option value="high">High</option>
                <option value="urgent">Urgent</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label>Description *</label>
            <div class="rich-editor">
              <div class="editor-toolbar">
                <button type="button" class="toolbar-btn" onclick="wrapTicketText('**', '**')"><i data-lucide="bold"></i></button>
                <button type="button" class="toolbar-btn" onclick="wrapTicketText('_', '_')"><i data-lucide="italic"></i></button>
                <button type="button" class="toolbar-btn" onclick="wrapTicketText('- ', '')"><i data-lucide="list"></i></button>
                <button type="button" class="toolbar-btn" onclick="wrapTicketText('[', '](url)')"><i data-lucide="link"></i></button>
                <button type="button" class="toolbar-btn" onclick="document.getElementById('fileInput').click()"><i data-lucide="image"></i></button>
              </div>
              <textarea id="description" rows="8" placeholder="Provide as much detail as possible..." required style="border: none; background: transparent; padding: 1rem;"></textarea>
            </div>
          </div>

          <div class="form-group">
            <label>Attachments</label>
            <div class="upload-area" id="dropZone" onclick="document.getElementById('fileInput').click()">
              <input type="file" id="fileInput" multiple style="display: none;" onchange="handleFileSelect(event)">
              <i data-lucide="upload-cloud" style="width: 32px; height: 32px; color: var(--primary); margin-bottom: 0.5rem;"></i>
              <p style="font-weight: 600; font-size: 0.85rem;" id="uploadText">Drag and drop files here or <span style="color: var(--primary);">click to browse</span></p>
              <p style="font-size: 0.7rem; color: var(--text-muted); margin-top: 0.25rem;">Max file size: 10MB (PNG, JPG, PDF, DOCX)</p>
            </div>
            <div id="fileList" style="margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.5rem;"></div>
          </div>

          <div class="section-title" style="margin-top: 2rem;">
            <i data-lucide="user" style="color: var(--primary);"></i>
            2. Contact Information
          </div>

          <div class="grid-2">
            <div class="form-group">
              <label>Email Address *</label>
              <input type="email" id="email" value="<%= user ? user.email : '' %>" readonly>
            </div>
            <div class="form-group">
              <label>Phone Number (Optional)</label>
              <input type="tel" id="phone" placeholder="+1 (555) 000-0000">
            </div>
          </div>

          <div class="footer-actions">
            <button type="button" class="btn btn-ghost" onclick="loadSection('tickets')">Cancel</button>
            <button type="submit" class="btn btn-primary">Submit Ticket</button>
          </div>
        </form>
      </div>

      <aside class="sidebar">
        <div class="sidebar-card">
          <h3 class="sidebar-title">Before You Submit</h3>
          <div class="step-item">
            <div class="step-icon"><i data-lucide="search" style="width: 16px;"></i></div>
            <div>
              <p style="font-size: 0.8rem; font-weight: 600;">Search Knowledge Base</p>
              <p style="font-size: 0.75rem; color: var(--text-muted);">Most common issues are solved in our help guides.</p>
            </div>
          </div>
          <div class="step-item">
            <div class="step-icon"><i data-lucide="edit-3" style="width: 16px;"></i></div>
            <div>
              <p style="font-size: 0.8rem; font-weight: 600;">Provide Details</p>
              <p style="font-size: 0.75rem; color: var(--text-muted);">The more details you provide, the faster we can help you.</p>
            </div>
          </div>
        </div>

        <div class="sidebar-card">
          <h3 class="sidebar-title">What Happens Next?</h3>
          <div class="timeline">
            <div class="timeline-item active">
              <div class="timeline-dot"></div>
              <p style="font-size: 0.8rem; font-weight: 600;">Ticket Created</p>
              <p style="font-size: 0.75rem; color: var(--text-muted);">We'll receive your ticket and send a confirmation email.</p>
            </div>
            <div class="timeline-item">
              <div class="timeline-dot"></div>
              <p style="font-size: 0.8rem; font-weight: 600;">In Review</p>
              <p style="font-size: 0.75rem; color: var(--text-muted);">Our team will review your issue and determine the best solution.</p>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script>
    if (window.lucide) lucide.createIcons();

    function wrapTicketText(before, after) {
      const textarea = document.getElementById("description");
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const text = textarea.value;
      const selectedText = text.substring(start, end);
      textarea.value = text.substring(0, start) + before + selectedText + after + text.substring(end);
      textarea.focus();
      textarea.setSelectionRange(start + before.length, end + before.length);
    }

    function handleFileSelect(e) {
      const files = e.target.files;
      const list = document.getElementById("fileList");
      const text = document.getElementById("uploadText");
      
      list.innerHTML = "";
      if (files.length > 0) {
        text.innerHTML = `<strong>${files.length}</strong> file(s) selected`;
        Array.from(files).forEach(file => {
          const badge = document.createElement("div");
          badge.style = "padding: 0.25rem 0.75rem; background: var(--primary); color: white; border-radius: 100px; font-size: 0.75rem;";
          badge.textContent = file.name;
          list.appendChild(badge);
        });
      } else {
        text.innerHTML = 'Drag and drop files here or <span style="color: var(--primary);">click to browse</span>';
      }
    }

    // Drag and drop logic
    const dropZone = document.getElementById("dropZone");
    if (dropZone) {
        dropZone.ondragover = (e) => { e.preventDefault(); dropZone.classList.add("dragging"); };
        dropZone.ondragleave = () => dropZone.classList.remove("dragging");
        dropZone.ondrop = (e) => {
          e.preventDefault();
          dropZone.classList.remove("dragging");
          document.getElementById("fileInput").files = e.dataTransfer.files;
          handleFileSelect({ target: document.getElementById("fileInput") });
        };
    }

    document.getElementById("ticketForm").onsubmit = async (e) => {
      e.preventDefault();
      
      const btn = e.target.querySelector('button[type="submit"]');
      const originalText = btn.innerText;
      btn.innerText = "Submitting...";
      btn.disabled = true;

      const data = {
        title: document.getElementById("subject").value,
        description: document.getElementById("description").value,
        priority: document.getElementById("priority").value,
        category: document.getElementById("category").value,
        email: document.getElementById("email").value,
        phone: document.getElementById("phone").value,
        tenantId: "<%= user ? user.tenantId : '' %>",
        businessId: getBusinessId()
      };

      try {
        const res = await fetch("/api/support/tickets", {
          method: "POST",
          headers: { 
              "Content-Type": "application/json",
              "Authorization": "Bearer " + (window.token || localStorage.getItem("accessToken"))
          },
          body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success) {
          notify("Ticket created successfully!", "Success");
          loadSection('tickets');
        } else {
          notify("Error: " + result.message, "Error");
        }
      } catch (err) {
        console.error(err);
        notify("Failed to submit ticket. Please check your connection.", "Error");
      } finally {
        btn.innerText = originalText;
        btn.disabled = false;
      }
    };
  </script>

<% if (typeof layout === 'undefined' || layout !== false) { %>
</body>
</html>
<% } %>

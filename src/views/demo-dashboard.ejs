<!DOCTYPE html>
<html lang="en" class="h-full bg-[#0F172A]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#38BDF8',
            secondary: '#2563EB',
            accent: '#7DD3FC',
            bgDark: '#0F172A',
            cardDark: '#1E293B',
            textMain: '#F8FAFC',
            textDim: '#94A3B8'
          },
          fontFamily: {
            orbitron: ['Orbitron', 'sans-serif'],
            sans: ['Plus Jakarta Sans', 'sans-serif']
          }
        }
      }
    }
  </script>
</head>
<body class="font-sans bg-[#0F172A] text-textMain antialiased min-h-full flex flex-col">

  <!-- Top Banner Header -->
  <header class="w-full bg-[#1E293B]/90 backdrop-blur-md border-b border-slate-700/80 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/" title="Return to Home Page" class="w-10 h-10 rounded-xl bg-gradient-to-tr from-primary to-secondary flex items-center justify-center text-white font-orbitron font-black text-lg shadow-md hover:scale-105 transition-transform">
          N
        </a>
        <a href="/" title="Return to Home Page" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[10px] font-bold text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-all uppercase shadow-sm active:scale-95">
          <svg class="w-3.5 h-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          <span class="hidden sm:inline">Home</span>
        </a>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="font-orbitron font-bold text-sm text-white tracking-wider"><%= session.businessName %></h1>
            <span class="px-2 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-400 border border-emerald-500/30" id="badge-status">
              <%= session.status === 'ACTIVE' ? '🟢 LIVE DEMO ACTIVE' : '🔴 EXPIRED' %>
            </span>
          </div>
          <p class="text-[10px] text-slate-400 font-mono">
            AI Receptionist: <strong class="text-primary"><%= session.aiName %></strong> &bull; Type: <span class="uppercase text-slate-300 font-bold"><%= session.businessType %></span>
          </p>
        </div>
      </div>

      <div class="flex items-center gap-6">
        <div class="hidden sm:flex flex-col items-end">
          <span class="text-[9px] font-mono text-slate-400 uppercase tracking-widest">DEMO EXPIRATION</span>
          <span class="font-orbitron font-black text-sm text-emerald-400" id="countdown-timer">--:--:--</span>
        </div>
        <button type="button" onclick="openBecomeCustomerModal()" class="px-5 py-2.5 rounded-full text-xs font-bold tracking-wider text-slate-900 bg-gradient-to-r from-primary to-emerald-400 hover:opacity-95 transition-all uppercase shadow-lg shadow-primary/20 flex items-center gap-1.5 cursor-pointer transform hover:scale-105">
          <i data-lucide="sparkles" class="w-3.5 h-3.5 text-slate-900"></i>
          <span>Become a Customer</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-6 py-8 space-y-8">
    
    <!-- TOP ROW: CALL INSTRUCTION & LIVE STATUS CARDS -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <!-- Call Instruction Box (lg:col-span-7) -->
      <div class="lg:col-span-7 bg-[#1E293B] border border-slate-700/80 rounded-3xl p-6 sm:p-8 relative overflow-hidden shadow-xl">
        <div class="absolute top-0 right-0 p-6 opacity-10 pointer-events-none">
          <i data-lucide="phone-call" class="w-32 h-32 text-primary"></i>
        </div>

        <div class="space-y-4 relative z-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-[10px] font-bold text-primary uppercase tracking-widest">
            <i data-lucide="phone-outgoing" class="w-3.5 h-3.5"></i>
            <span>STEP 1: CALL YOUR AI RECEPTIONIST</span>
          </div>

          <div>
            <span class="text-xs text-slate-400 uppercase tracking-wider block mb-1">Dial Demo Phone Number</span>
            <div class="font-orbitron font-black text-3xl sm:text-4xl text-white tracking-wider flex items-center gap-3">
              <span id="display-phone-number"><%= session.phoneNumber || "+18884918668" %></span>
              <button onclick="copyPhoneNumber()" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors" title="Copy Number">
                <i data-lucide="copy" class="w-4 h-4"></i>
              </button>
            </div>
          </div>

          <p class="text-xs text-slate-300 leading-relaxed max-w-xl">
            Call this number directly from your cell phone. Speak naturally to <strong class="text-primary"><%= session.aiName %></strong>.
            <% if (session.businessType === 'restaurant') { %>
              Ask for menu recommendations, place an order, and hear live price calculation.
            <% } else { %>
              Ask about services, pricing, and book a live appointment slot in real time.
            <% } %>
          </p>

          <div class="flex flex-wrap items-center gap-6 pt-4 border-t border-slate-700/80 text-xs font-mono text-slate-400">
            <div>CALLS REMAINING: <strong class="text-white" id="calls-remaining"><%= session.maxCalls - session.callCount %> / <%= session.maxCalls %></strong></div>
            <div>MAX DURATION: <strong class="text-white">10 mins</strong></div>
          </div>
        </div>
      </div>

      <!-- Live Call Interaction Box (lg:col-span-5) -->
      <div class="lg:col-span-5 bg-[#1E293B] border border-slate-700/80 rounded-3xl p-6 sm:p-8 flex flex-col justify-center items-center text-center relative overflow-hidden shadow-xl" id="call-status-card">
        
        <!-- Idle State -->
        <div id="state-idle" class="space-y-4">
          <div class="w-20 h-20 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center mx-auto text-primary shadow-inner">
            <i data-lucide="mic" class="w-8 h-8"></i>
          </div>
          <div>
            <div class="inline-flex items-center gap-2 text-xs font-bold font-mono text-slate-400 uppercase tracking-widest mb-1">
              <span class="w-2 h-2 rounded-full bg-slate-500"></span>
              <span>WAITING FOR CALL</span>
            </div>
            <p class="text-xs text-slate-400 max-w-xs mx-auto">
              Dial the number above from your phone to launch live interaction.
            </p>
          </div>
        </div>

        <!-- Active Call State -->
        <div id="state-active" class="space-y-4 hidden">
          <div class="relative">
            <div class="w-24 h-24 rounded-full bg-emerald-500/20 border-2 border-emerald-500 flex items-center justify-center mx-auto text-emerald-400 animate-pulse">
              <i data-lucide="phone-in-talk" class="w-10 h-10"></i>
            </div>
            <span class="absolute -top-1 -right-1 flex h-4 w-4">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-4 w-4 bg-emerald-500"></span>
            </span>
          </div>
          <div>
            <div class="inline-flex items-center gap-2 text-xs font-black font-mono text-emerald-400 uppercase tracking-widest mb-1">
              <span>🎙️ LIVE CALL CONNECTED</span>
            </div>
            <p class="text-xs text-slate-300 font-mono" id="caller-id-display">
              Caller: Connected
            </p>
          </div>
        </div>

      </div>

    </div>

    <!-- MIDDLE ROW: TRANSCRIPTS & REASONING LOG & LIVE DB ACTION -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <!-- Live Conversation Transcript (lg:col-span-5) -->
      <div class="lg:col-span-5 bg-[#1E293B] border border-slate-700/80 rounded-3xl p-6 flex flex-col h-[420px] shadow-xl">
        <div class="flex items-center justify-between pb-4 border-b border-slate-700/80">
          <div class="flex items-center gap-2">
            <i data-lucide="message-square-code" class="w-4 h-4 text-primary"></i>
            <h3 class="font-orbitron font-bold text-xs uppercase tracking-wider text-white">Live Conversation Transcript</h3>
          </div>
          <span class="text-[9px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">REALTIME WS</span>
        </div>

        <div id="transcript-container" class="flex-1 overflow-y-auto py-4 space-y-3 font-sans text-xs text-slate-300 pr-2">
          <div class="text-center text-slate-500 py-16 text-xs italic">
            [Waiting for call connection...]<br>
            Transcripts will stream here in real time as you speak.
          </div>
        </div>
      </div>

      <!-- AI Reasoning Log (lg:col-span-3) -->
      <div class="lg:col-span-3 bg-[#1E293B] border border-slate-700/80 rounded-3xl p-6 flex flex-col h-[420px] shadow-xl">
        <div class="flex items-center justify-between pb-4 border-b border-slate-700/80">
          <div class="flex items-center gap-2">
            <i data-lucide="cpu" class="w-4 h-4 text-primary"></i>
            <h3 class="font-orbitron font-bold text-xs uppercase tracking-wider text-white">AI Reasoning Log</h3>
          </div>
          <span class="text-[9px] font-mono text-slate-400 bg-slate-800 px-2 py-0.5 rounded">EVENTS</span>
        </div>

        <div id="reasoning-container" class="flex-1 overflow-y-auto py-4 space-y-2 font-mono text-[11px] text-slate-400 pr-2">
          <div class="p-2.5 rounded-xl bg-slate-900/60 border border-slate-800 text-slate-300">
            ✓ Demo environment active
          </div>
          <div class="p-2.5 rounded-xl bg-slate-900/60 border border-slate-800 text-slate-300">
            ✓ AI Agent context loaded
          </div>
          <div class="p-2.5 rounded-xl bg-slate-900/60 border border-slate-800 text-slate-300">
            ✓ Telephony stream listening
          </div>
        </div>
      </div>

      <!-- Live Database Action (Orders / Appointments) (lg:col-span-4) -->
      <div class="lg:col-span-4 bg-[#1E293B] border border-slate-700/80 rounded-3xl p-6 flex flex-col h-[420px] shadow-xl">
        <div class="flex items-center justify-between pb-4 border-b border-slate-700/80">
          <div class="flex items-center gap-2">
            <i data-lucide="database" class="w-4 h-4 text-primary"></i>
            <h3 class="font-orbitron font-bold text-xs uppercase tracking-wider text-white" id="db-action-title">
              <%= session.businessType === 'restaurant' ? 'Live Order Panel' : 'Live Appointment Booking' %>
            </h3>
          </div>
          <span class="text-[9px] font-mono text-primary bg-primary/10 px-2 py-0.5 rounded border border-primary/20">DB ACTION</span>
        </div>

        <div id="db-action-container" class="flex-1 overflow-y-auto py-4 flex flex-col items-center justify-center text-center">
          <i data-lucide="<%= session.businessType === 'restaurant' ? 'shopping-cart' : 'calendar-check' %>" class="w-12 h-12 text-slate-600 mb-3"></i>
          <p class="text-xs text-slate-400 font-bold uppercase tracking-wider">
            <%= session.businessType === 'restaurant' ? 'No Orders Created Yet' : 'No Appointments Booked Yet' %>
          </p>
          <p class="text-[11px] text-slate-500 mt-1 max-w-xs">
            <%= session.businessType === 'restaurant' 
                ? 'Call the AI and request food items to see the backend order created live.' 
                : 'Call the AI and request a date/time to see the slot reserved live.' %>
          </p>
        </div>
      </div>

    </div>

    <!-- BOTTOM ROW: HISTORICAL CALL RECORDS -->
    <div class="bg-[#1E293B] border border-slate-700/80 rounded-3xl p-6 shadow-xl space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-700/80">
        <h3 class="font-orbitron font-bold text-xs uppercase tracking-wider text-white flex items-center gap-2">
          <i data-lucide="history" class="w-4 h-4 text-primary"></i>
          <span>Session Call Logs</span>
        </h3>
        <span class="text-xs font-mono text-slate-400" id="call-count-label">Total Calls: 0</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-sans text-slate-300">
          <thead>
            <tr class="text-[10px] font-mono text-slate-400 uppercase border-b border-slate-700/60">
              <th class="py-2.5 px-4">Time</th>
              <th class="py-2.5 px-4">Caller ID</th>
              <th class="py-2.5 px-4">Duration</th>
              <th class="py-2.5 px-4">Status</th>
              <th class="py-2.5 px-4">Outcome Summary</th>
            </tr>
          </thead>
          <tbody id="call-history-body" class="divide-y divide-slate-800">
            <tr>
              <td colspan="5" class="py-8 text-center text-slate-500 text-xs italic">
                No call logs recorded for this session yet.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </main>

  <!-- 🚀 BECOME A CUSTOMER / LOCK ENTERPRISE DEAL MODAL -->
  <div id="become-customer-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-[#1E293B] border border-slate-700/80 rounded-3xl p-6 sm:p-8 max-w-xl w-full shadow-2xl space-y-6 relative overflow-hidden text-left">
      <button onclick="closeBecomeCustomerModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white transition-colors" aria-label="Close">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>

      <div id="deal-form-view" class="space-y-4">
        <div class="space-y-1">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/20 border border-primary/30 text-[10px] font-black text-primary uppercase tracking-widest">
            <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
            <span>PERMANENT 24/7 AI RECEPTIONIST DEPLOYMENT</span>
          </div>
          <h3 class="font-orbitron font-black text-xl text-white">Claim Your Permanent AI Suite</h3>
          <p class="text-xs text-slate-400 leading-relaxed font-medium">
            Lock in enterprise pricing for <strong><%= session.businessName %></strong>. Our deployment team will provision your dedicated phone node, CRM webhooks, and custom voice agent within 2 hours.
          </p>
        </div>

        <form id="deal-inquiry-form" onsubmit="submitBecomeCustomerDeal(event)" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-bold text-slate-300 uppercase tracking-wider mb-1">Contact Name *</label>
              <input type="text" id="deal-contactName" required value="<%= session.contactName %>" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:border-primary focus:outline-none" />
            </div>
            <div>
              <label class="block text-[10px] font-bold text-slate-300 uppercase tracking-wider mb-1">Business Name *</label>
              <input type="text" id="deal-businessName" required value="<%= session.businessName %>" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white font-bold placeholder-slate-500 focus:border-primary focus:outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-bold text-slate-300 uppercase tracking-wider mb-1">Work Email Address *</label>
              <input type="email" id="deal-email" required value="<%= session.email %>" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:border-primary focus:outline-none" />
            </div>
            <div>
              <label class="block text-[10px] font-bold text-slate-300 uppercase tracking-wider mb-1">Direct Mobile Phone *</label>
              <input type="tel" id="deal-phone" required value="<%= session.phone || '' %>" placeholder="+1 (555) 000-0000" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:border-primary focus:outline-none" />
            </div>
          </div>

          <div>
            <label class="block text-[10px] font-bold text-slate-300 uppercase tracking-wider mb-1">Select Architecture &amp; Package Interest</label>
            <select id="deal-planInterest" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white focus:border-primary focus:outline-none">
              <option value="Nexa Prime (24/7 AI Receptionist + Live Orders/Appointments)">⚡ Nexa Prime — 24/7 Permanent AI Receptionist &amp; Live Orders</option>
              <option value="Nexa Enterprise Fleet (Multi-Branch Call Routing + CRM)">🏢 Nexa Enterprise — Multi-Branch Fleet &amp; CRM Integrations</option>
              <option value="Existing Business Number Forwarding (*72 Carrier Trunking)">📞 Existing Business Number Forwarding (*72 Carrier Setup)</option>
              <option value="Bespoke Voice Engine & Dedicated Carrier Node">🛠️ Bespoke Custom Voice Engine &amp; Dedicated Carrier Node</option>
            </select>
          </div>

          <div>
            <label class="block text-[10px] font-bold text-slate-300 uppercase tracking-wider mb-1">Special Requirements / Custom Voice Instructions</label>
            <textarea id="deal-notes" rows="2" placeholder="e.g. Integrate with our Clover POS, handle 5 concurrent call channels..." class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:border-primary focus:outline-none resize-none"></textarea>
          </div>

          <div class="flex items-center justify-between pt-3 border-t border-slate-700/80">
            <button type="button" onclick="closeBecomeCustomerModal()" class="px-5 py-2.5 rounded-full text-xs font-bold text-slate-400 hover:text-white uppercase">
              Cancel
            </button>
            <button type="submit" id="deal-submit-btn" class="px-7 py-3 rounded-full text-xs font-black tracking-wider text-slate-900 bg-gradient-to-r from-primary to-emerald-400 hover:opacity-95 shadow-lg shadow-primary/20 uppercase flex items-center gap-2">
              <i data-lucide="check-circle" class="w-4 h-4 text-slate-900"></i>
              <span id="deal-submit-text">SUBMIT DEAL INQUIRY &amp; LOCK PRICING &rarr;</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Success Confirmation View -->
      <div id="deal-success-view" class="hidden text-center py-6 space-y-4">
        <div class="w-16 h-16 bg-emerald-500/20 border border-emerald-500/40 rounded-full flex items-center justify-center mx-auto text-emerald-400">
          <i data-lucide="check" class="w-8 h-8"></i>
        </div>
        <h3 class="font-orbitron font-black text-xl text-white">DEAL INQUIRY CONFIRMED</h3>
        <p class="text-xs text-slate-300 max-w-md mx-auto leading-relaxed">
          Your custom enterprise deal inquiry has been submitted! A confirmation email has been dispatched to your inbox. Our deployment architects will contact you within 2 hours.
        </p>
        <button onclick="closeBecomeCustomerModal()" class="px-6 py-2.5 rounded-full text-xs font-bold text-slate-900 bg-primary hover:bg-secondary uppercase shadow-md">
          Back to Live Dashboard
        </button>
      </div>

    </div>
  </div>

  <footer class="w-full border-t border-slate-800 py-4 bg-[#0F172A] text-center text-xs text-slate-500">
    &copy; <%= new Date().getFullYear() %> Naxton Technologies. All rights reserved. Interactive Voice AI Suite.
  </footer>

  <script>
    if (window.lucide) lucide.createIcons();

    const sessionToken = "<%= session.token %>";
    const expiresAtMs = new Date("<%= session.expiresAt.toISOString() %>").getTime();
    const businessType = "<%= session.businessType %>";
    let isCallActive = false;

    // Countdown Timer
    function updateCountdown() {
      const now = Date.now();
      const diff = expiresAtMs - now;

      if (diff <= 0) {
        document.getElementById('countdown-timer').innerText = "00:00:00 (EXPIRED)";
        document.getElementById('countdown-timer').className = "font-orbitron font-black text-sm text-red-500";
        document.getElementById('badge-status').innerText = "🔴 EXPIRED";
        document.getElementById('badge-status').className = "px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-red-500/20 text-red-400 border border-red-500/30";
        return;
      }

      const hrs = Math.floor(diff / (1000 * 60 * 60));
      const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const secs = Math.floor((diff % (1000 * 60)) / 1000);

      document.getElementById('countdown-timer').innerText = 
        `${String(hrs).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }
    setInterval(updateCountdown, 1000);
    updateCountdown();

    function copyPhoneNumber() {
      const num = document.getElementById('display-phone-number').innerText;
      navigator.clipboard.writeText(num);
      alert(`Phone number ${num} copied to clipboard!`);
    }

    function openBecomeCustomerModal() {
      document.getElementById('become-customer-modal').classList.remove('hidden');
    }

    function closeBecomeCustomerModal() {
      document.getElementById('become-customer-modal').classList.add('hidden');
    }

    async function submitBecomeCustomerDeal(e) {
      e.preventDefault();
      const contactName = document.getElementById('deal-contactName').value.trim();
      const businessName = document.getElementById('deal-businessName').value.trim();
      const email = document.getElementById('deal-email').value.trim();
      const phone = document.getElementById('deal-phone').value.trim();
      const planInterest = document.getElementById('deal-planInterest').value;
      const notes = document.getElementById('deal-notes').value.trim();

      const btn = document.getElementById('deal-submit-btn');
      const btnText = document.getElementById('deal-submit-text');
      btn.disabled = true;
      btnText.innerText = 'SUBMITTING DEAL...';

      try {
        const res = await fetch('/api/demo/become-customer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contactName, businessName, email, phone, planInterest, notes })
        });
        const data = await res.json();

        if (data.success) {
          document.getElementById('deal-form-view').classList.add('hidden');
          document.getElementById('deal-success-view').classList.remove('hidden');
        } else {
          alert(data.error || 'Failed to submit deal inquiry.');
        }
      } catch (err) {
        alert('Network error while submitting deal inquiry. Please try again.');
      } finally {
        btn.disabled = false;
        btnText.innerText = 'SUBMIT DEAL INQUIRY & LOCK PRICING →';
      }
    }

    // Socket.IO Real-Time Stream
    const socket = io();

    socket.on('connect', () => {
      console.log('[SOCKET] Connected to realtime telemetry stream');
      socket.emit('join_business', { businessId: "<%= session.businessId %>" });
    });

    socket.on('call_status_update', (data) => {
      console.log('[SOCKET] Call status:', data);
      if (data.status === 'in-progress' || data.status === 'active') {
        setCallActiveState(true, data.fromNumber || 'Voice Customer');
        logActivity(`📞 Call Incoming from ${data.fromNumber || 'Voice Customer'}`);
      } else if (data.status === 'completed' || data.status === 'ended') {
        setCallActiveState(false);
        logActivity(`🏁 Call Completed (${data.duration || 0}s)`);
        syncDemoData();
      }
    });

    socket.on('transcript_update', (data) => {
      console.log('[SOCKET] Transcript packet:', data);
      appendTranscriptChunk(data.speaker || 'ai', data.text || data.message || '');
      logActivity(`💬 Speech Chunk: ${data.speaker === 'user' ? 'Customer' : 'AI Assistant'}`);
    });

    socket.on('order_created', (data) => {
      console.log('[SOCKET] Order Created:', data);
      logActivity(`📦 LIVE DB EVENT: Order #${data.orderId || 'NEW'} Created! Total: $${data.totalPrice || 0}`);
      renderOrderResult(data);
    });

    socket.on('appointment_created', (data) => {
      console.log('[SOCKET] Appointment Created:', data);
      logActivity(`📅 LIVE DB EVENT: Appointment Booked for ${data.serviceName || 'Service'} on ${data.date}`);
      renderAppointmentResult(data);
    });

    function setCallActiveState(active, callerNumber = '') {
      isCallActive = active;
      const stateIdle = document.getElementById('state-idle');
      const stateActive = document.getElementById('state-active');
      const callerDisplay = document.getElementById('caller-id-display');

      if (active) {
        stateIdle.classList.add('hidden');
        stateActive.classList.remove('hidden');
        callerDisplay.innerText = `Caller: ${callerNumber}`;
      } else {
        stateActive.classList.add('hidden');
        stateIdle.classList.remove('hidden');
      }
    }

    function logActivity(msg) {
      const container = document.getElementById('reasoning-container');
      const div = document.createElement('div');
      div.className = 'p-2.5 rounded-xl bg-slate-900/60 border border-slate-800 text-slate-300 animate-fade-in';
      div.innerText = `${new Date().toLocaleTimeString()} - ${msg}`;
      container.prepend(div);
    }

    function appendTranscriptChunk(speaker, text) {
      const container = document.getElementById('transcript-container');
      
      // Remove idle placeholder if present
      if (container.children.length === 1 && container.children[0].classList.contains('text-center')) {
        container.innerHTML = '';
      }

      const div = document.createElement('div');
      if (speaker === 'user' || speaker === 'customer') {
        div.className = 'p-3 rounded-2xl bg-slate-800/90 border border-slate-700 text-slate-100 max-w-[85%] self-start text-left';
        div.innerHTML = `<span class="text-[10px] font-bold text-primary block uppercase mb-1">Customer</span>${text}`;
      } else {
        div.className = 'p-3 rounded-2xl bg-secondary/20 border border-secondary/30 text-sky-100 max-w-[85%] ml-auto text-right';
        div.innerHTML = `<span class="text-[10px] font-bold text-sky-400 block uppercase mb-1"><%= session.aiName %> (AI)</span>${text}`;
      }
      container.appendChild(div);
      container.scrollTop = container.scrollHeight;
    }

    function renderFullTranscript(transcriptText) {
      if (!transcriptText) return;
      const container = document.getElementById('transcript-container');
      container.innerHTML = '';

      const lines = transcriptText.split('\n');
      lines.forEach(line => {
        if (!line.trim()) return;
        const isAI = line.toLowerCase().includes('agent:') || line.toLowerCase().includes('assistant:') || line.toLowerCase().includes('sarah:');
        const text = line.replace(/^(user|customer|agent|assistant|sarah):/i, '').trim();

        const div = document.createElement('div');
        if (isAI) {
          div.className = 'p-3 rounded-2xl bg-secondary/20 border border-secondary/30 text-sky-100 max-w-[85%] ml-auto text-right';
          div.innerHTML = `<span class="text-[10px] font-bold text-sky-400 block uppercase mb-1"><%= session.aiName %> (AI)</span>${text}`;
        } else {
          div.className = 'p-3 rounded-2xl bg-slate-800/90 border border-slate-700 text-slate-100 max-w-[85%] self-start text-left';
          div.innerHTML = `<span class="text-[10px] font-bold text-primary block uppercase mb-1">Customer</span>${text}`;
        }
        container.appendChild(div);
      });
      container.scrollTop = container.scrollHeight;
    }

    function renderOrderResult(order) {
      const container = document.getElementById('db-action-container');
      if (!order || !container) return;

      const itemsHtml = (order.items || []).map(i => `
        <div class="flex items-center justify-between py-1 text-xs border-b border-slate-700/50">
          <span>${i.menuItem ? i.menuItem.name : 'Item'} (x${i.quantity || 1})</span>
          <span class="font-mono text-primary font-bold">$${(i.unitPrice * (i.quantity || 1)).toFixed(2)}</span>
        </div>
      `).join('');

      container.innerHTML = `
        <div class="w-full text-left space-y-3 font-sans">
          <div class="p-3 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-between">
            <div>
              <span class="text-[9px] font-black text-emerald-400 uppercase tracking-widest block">ORDER CONFIRMED IN DB</span>
              <span class="text-sm font-bold text-white">Order #${(order.id || '').substring(0, 8).toUpperCase()}</span>
            </div>
            <span class="text-xs font-mono text-emerald-400 font-black">$${parseFloat(order.totalPrice || 0).toFixed(2)}</span>
          </div>

          <div class="p-3.5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-2">
            <span class="text-[10px] font-bold text-slate-400 uppercase block tracking-wider">Ordered Items</span>
            ${itemsHtml || '<div class="text-xs text-slate-400">Standard Order Items</div>'}
          </div>

          <div class="text-[10px] font-mono text-slate-400 flex items-center justify-between px-1">
            <span>Customer: ${order.customerName || 'Voice Customer'}</span>
            <span>Status: <strong class="text-emerald-400 uppercase">${order.status || 'CONFIRMED'}</strong></span>
          </div>
        </div>
      `;
    }

    function renderAppointmentResult(appt) {
      const container = document.getElementById('db-action-container');
      if (!appt || !container) return;

      container.innerHTML = `
        <div class="w-full text-left space-y-3 font-sans">
          <div class="p-3 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-between">
            <div>
              <span class="text-[9px] font-black text-emerald-400 uppercase tracking-widest block">APPOINTMENT BOOKED IN DB</span>
              <span class="text-sm font-bold text-white">${appt.service ? appt.service.name : 'Service Appointment'}</span>
            </div>
            <span class="text-xs font-mono text-emerald-400 font-black">$${parseFloat(appt.service ? appt.service.price : 0).toFixed(2)}</span>
          </div>

          <div class="p-3.5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-2 text-xs text-slate-300">
            <div><strong class="text-slate-400">Date/Time:</strong> ${new Date(appt.startTime || Date.now()).toLocaleString()}</div>
            <div><strong class="text-slate-400">Client:</strong> ${appt.customerName || appt.customerPhone || 'Voice Client'}</div>
            <div><strong class="text-slate-400">Status:</strong> <span class="text-emerald-400 font-bold uppercase">${appt.status || 'CONFIRMED'}</span></div>
          </div>
        </div>
      `;
    }

    async function syncDemoData() {
      try {
        // 1. Sync Session State & Calls Remaining
        const sRes = await fetch(`/api/demo/session/${sessionToken}`);
        const sData = await sRes.json();
        if (sData.success && sData.session) {
          const s = sData.session;
          document.getElementById('calls-remaining').innerText = `${s.maxCalls - s.callCount} / ${s.maxCalls}`;
          if (s.isExpired) {
            document.getElementById('badge-status').innerText = '🔴 EXPIRED';
            document.getElementById('badge-status').className = 'px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-red-500/20 text-red-400 border border-red-500/30';
          }
        }

        // 2. Sync Call Logs & Active Call State
        const cRes = await fetch(`/api/demo/session/${sessionToken}/calls`);
        const cData = await cRes.json();
        if (cData.success && cData.calls) {
          const calls = cData.calls;
          document.getElementById('call-count-label').innerText = `Total Calls: ${calls.length}`;

          if (calls.length > 0) {
            const latestCall = calls[0];

            if (latestCall.outcome === 'active') {
              if (!isCallActive) {
                setCallActiveState(true, latestCall.fromNumber || 'Voice Customer');
                logActivity(`📞 Call Incoming from ${latestCall.fromNumber || 'Voice Customer'}`);
                logActivity(`🎙️ Voice Stream Connected to Nexa AI Engine`);
                logActivity(`🧠 AI Knowledge & Calendar Loaded`);
              }
            } else {
              if (isCallActive) {
                setCallActiveState(false);
                logActivity(`🏁 Call Completed & Saved (${latestCall.duration || 0}s)`);
              }
            }

            if (latestCall.transcript) {
              renderFullTranscript(latestCall.transcript);
            }

            renderCallHistoryTable(calls);
          }
        }

        // 3. Sync Action Result (Orders or Appointments)
        if (businessType === 'restaurant') {
          const oRes = await fetch(`/api/demo/session/${sessionToken}/orders`);
          const oData = await oRes.json();
          if (oData.success && oData.orders && oData.orders.length > 0) {
            renderOrderResult(oData.orders[0]);
          }
        } else {
          const aRes = await fetch(`/api/demo/session/${sessionToken}/appointments`);
          const aData = await aRes.json();
          if (aData.success && aData.appointments && aData.appointments.length > 0) {
            renderAppointmentResult(aData.appointments[0]);
          }
        }

      } catch (e) {
        console.error('[SYNC_ERROR]', e.message);
      }
    }

    function renderCallHistoryTable(calls) {
      const tbody = document.getElementById('call-history-body');
      if (!tbody || calls.length === 0) return;

      tbody.innerHTML = calls.map(c => `
        <tr>
          <td class="py-3 px-4">${new Date(c.createdAt).toLocaleTimeString()}</td>
          <td class="py-3 px-4">${c.fromNumber || 'Voice Customer'}</td>
          <td class="py-3 px-4">${c.duration || 0}s</td>
          <td class="py-3 px-4">
            <span class="px-2 py-0.5 rounded text-[9px] font-bold ${c.outcome === 'success' || c.outcome === 'active' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-slate-700 text-slate-300'} uppercase">
              ${c.outcome || 'Completed'}
            </span>
          </td>
          <td class="py-3 px-4 text-slate-200">${c.summary || c.actionTaken || 'AI Handled'}</td>
        </tr>
      `).join('');
    }

    // Run sync immediately on page load, then poll every 1.5 seconds
    syncDemoData();
    setInterval(syncDemoData, 1500);
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en" class="h-full bg-[#0F172A]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#38BDF8',
            secondary: '#2563EB',
            accent: '#7DD3FC',
            bgDark: '#0F172A',
            cardDark: '#1E293B',
            textMain: '#F8FAFC',
            textDim: '#94A3B8'
          },
          fontFamily: {
            orbitron: ['Orbitron', 'sans-serif'],
            sans: ['Plus Jakarta Sans', 'sans-serif']
          }
        }
      }
    }
  </script>
</head>
<body class="font-sans bg-[#0F172A] text-textMain antialiased min-h-full flex flex-col">

  <!-- Top Banner Header -->
  <header class="w-full bg-[#1E293B]/90 backdrop-blur-md border-b border-slate-700/80 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/" class="w-10 h-10 rounded-xl bg-gradient-to-tr from-primary to-secondary flex items-center justify-center text-white font-orbitron font-black text-lg shadow-md">
          N
        </a>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="font-orbitron font-bold text-sm text-white tracking-wider"><%= session.businessName %></h1>
            <span class="px-2 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-400 border border-emerald-500/30" id="badge-status">
              <%= session.status === 'ACTIVE' ? '🟢 LIVE DEMO ACTIVE' : '🔴 EXPIRED' %>
            </span>
          </div>
          <p class="text-[10px] text-slate-400 font-mono">
            AI Receptionist: <strong class="text-primary"><%= session.aiName %></strong> &bull; Type: <span class="uppercase text-slate-300 font-bold"><%= session.businessType %></span>
          </p>
        </div>
      </div>

      <div class="flex items-center gap-6">
        <div class="hidden sm:flex flex-col items-end">
          <span class="text-[9px] font-mono text-slate-400 uppercase tracking-widest">DEMO EXPIRATION</span>
          <span class="font-orbitron font-black text-sm text-emerald-400" id="countdown-timer">--:--:--</span>
        </div>
        <a href="/login" class="px-5 py-2.5 rounded-full text-xs font-bold tracking-wider text-slate-900 bg-primary hover:bg-secondary transition-all uppercase shadow-lg shadow-primary/20">
          Become a Customer
        </a>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-6 py-8 space-y-8">
    
    <!-- TOP ROW: CALL INSTRUCTION & LIVE STATUS CARDS -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <!-- Call Instruction Box (lg:col-span-7) -->
      <div class="lg:col-span-7 bg-[#1E293B] border border-slate-700/80 rounded-3xl p-6 sm:p-8 relative overflow-hidden shadow-xl">
        <div class="absolute top-0 right-0 p-6 opacity-10 pointer-events-none">
          <i data-lucide="phone-call" class="w-32 h-32 text-primary"></i>
        </div>

        <div class="space-y-4 relative z-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-[10px] font-bold text-primary uppercase tracking-widest">
            <i data-lucide="phone-outgoing" class="w-3.5 h-3.5"></i>
            <span>STEP 1: CALL YOUR AI RECEPTIONIST</span>
          </div>

          <div>
            <span class="text-xs text-slate-400 uppercase tracking-wider block mb-1">Dial Demo Phone Number</span>
            <div class="font-orbitron font-black text-3xl sm:text-4xl text-white tracking-wider flex items-center gap-3">
              <span id="display-phone-number"><%= session.phoneNumber || "+18884918668" %></span>
              <button onclick="navigator.clipboard.writeText('<%= session.phoneNumber %>'); alert('Phone number copied!');" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors" title="Copy Number">
                <i data-lucide="copy" class="w-4 h-4"></i>
              </button>
            </div>
          </div>

          <p class="text-xs text-slate-300 leading-relaxed max-w-xl">
            Call this number directly from your cell phone. Speak naturally to <strong class="text-primary"><%= session.aiName %></strong>.
            <%= session.businessType === 'restaurant' ? 'Ask for menu recommendations, place an order, and hear live price calculation.' : 'Ask for service availability, pick a time, and confirm your booking.' %>
          </p>

          <div class="pt-2 flex items-center gap-6 text-[11px] font-mono text-slate-400 border-t border-slate-700/60">
            <div>CALLS REMAINING: <strong class="text-white" id="calls-remaining"><%= session.maxCalls - session.callCount %> / <%= session.maxCalls %></strong></div>
            <div>MAX DURATION: <strong class="text-white"><%= session.maxCallDuration %> mins</strong></div>
          </div>
        </div>
      </div>

      <!-- Live Call Status Pill Box (lg:col-span-5) -->
      <div class="lg:col-span-5 bg-[#1E293B] border border-slate-700/80 rounded-3xl p-6 sm:p-8 flex flex-col items-center justify-center text-center shadow-xl relative overflow-hidden">
        <div id="status-ring" class="w-20 h-20 rounded-full bg-primary/10 border border-primary/30 flex items-center justify-center mb-4 transition-all duration-500">
          <i data-lucide="mic" id="status-icon" class="w-8 h-8 text-primary"></i>
        </div>

        <h3 id="call-status-heading" class="font-orbitron font-bold text-sm tracking-wider text-slate-200 uppercase mb-1">
          &bull; WAITING FOR CALL
        </h3>
        <p id="call-status-subtext" class="text-xs text-slate-400 max-w-xs">
          Dial the number above from your phone to launch live interaction.
        </p>
      </div>

    </div>

    <!-- MIDDLE ROW: 3 REALTIME PANELS -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <!-- PANEL 1: LIVE CONVERSATION TRANSCRIPT (lg:col-span-5) -->
      <div class="lg:col-span-5 bg-[#1E293B] border border-slate-700/80 rounded-3xl p-6 flex flex-col h-[520px] shadow-xl">
        <div class="flex items-center justify-between border-b border-slate-700 pb-4 mb-4">
          <div class="flex items-center gap-2">
            <i data-lucide="message-square" class="w-4 h-4 text-primary"></i>
            <h3 class="font-orbitron font-bold text-xs uppercase tracking-wider text-white">Live Conversation Transcript</h3>
          </div>
          <span class="text-[9px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">REALTIME WS</span>
        </div>

        <!-- Transcript Feed -->
        <div id="transcript-feed" class="flex-1 overflow-y-auto space-y-3.5 pr-1 scrollbar-thin text-xs">
          <div class="text-center py-16 text-slate-500 font-mono text-[11px]" id="empty-transcript-msg">
            <p>[Waiting for call connection...]</p>
            <p class="text-[10px] text-slate-600 mt-1">Transcripts will stream here in real time as you speak.</p>
          </div>
        </div>
      </div>

      <!-- PANEL 2: AI REASONING LOG (lg:col-span-3) -->
      <div class="lg:col-span-3 bg-[#1E293B] border border-slate-700/80 rounded-3xl p-6 flex flex-col h-[520px] shadow-xl">
        <div class="flex items-center justify-between border-b border-slate-700 pb-4 mb-4">
          <div class="flex items-center gap-2">
            <i data-lucide="cpu" class="w-4 h-4 text-secondary"></i>
            <h3 class="font-orbitron font-bold text-xs uppercase tracking-wider text-white">AI Reasoning Log</h3>
          </div>
          <span class="text-[9px] font-mono text-secondary bg-secondary/10 px-2 py-0.5 rounded-full border border-secondary/20">EVENTS</span>
        </div>

        <!-- Activity Stream -->
        <div id="activity-feed" class="flex-1 overflow-y-auto space-y-2.5 pr-1 scrollbar-thin text-[11px] font-mono">
          <div class="p-2.5 rounded-xl bg-slate-800/60 border border-slate-700 text-slate-400">
            ✓ Demo environment active
          </div>
          <div class="p-2.5 rounded-xl bg-slate-800/60 border border-slate-700 text-slate-400">
            ✓ AI Agent context loaded
          </div>
          <div class="p-2.5 rounded-xl bg-slate-800/60 border border-slate-700 text-slate-400">
            ✓ Telephony stream listening
          </div>
        </div>
      </div>

      <!-- PANEL 3: LIVE ACTION RESULT (ORDER OR APPOINTMENT) (lg:col-span-4) -->
      <div class="lg:col-span-4 bg-[#1E293B] border border-slate-700/80 rounded-3xl p-6 flex flex-col h-[520px] shadow-xl">
        <div class="flex items-center justify-between border-b border-slate-700 pb-4 mb-4">
          <div class="flex items-center gap-2">
            <i data-lucide="<%= session.businessType === 'restaurant' ? 'shopping-bag' : 'calendar-check' %>" class="w-4 h-4 text-emerald-400"></i>
            <h3 class="font-orbitron font-bold text-xs uppercase tracking-wider text-white">
              <%= session.businessType === 'restaurant' ? 'Live Order Panel' : 'Live Appointment Panel' %>
            </h3>
          </div>
          <span class="text-[9px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">DB ACTION</span>
        </div>

        <!-- Result Container -->
        <div id="action-result-container" class="flex-1 overflow-y-auto pr-1">
          <% if (session.businessType === 'restaurant') { %>
            <% if (session.business.orders && session.business.orders.length > 0) { %>
              <% const latest = session.business.orders[0]; %>
              <div class="p-5 rounded-2xl bg-slate-800/90 border border-emerald-500/40 space-y-4 animate-fade-in shadow-lg">
                <div class="flex justify-between items-center border-b border-slate-700 pb-3">
                  <div>
                    <span class="text-[10px] font-mono text-emerald-400 uppercase tracking-widest block mb-0.5">CONFIRMED ORDER</span>
                    <h4 class="font-orbitron font-bold text-base text-emerald-400">#DEMO-<%= latest.orderNumber || latest.id.slice(0, 6) %></h4>
                  </div>
                  <span class="px-3 py-1 rounded-full text-[10px] font-black bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 uppercase">CONFIRMED ✓</span>
                </div>
                <div class="space-y-2">
                  <% (latest.items || []).forEach(item => { %>
                    <div class="flex justify-between items-center text-slate-200 text-xs p-2 rounded-xl bg-slate-900/60 border border-slate-700/50">
                      <span><strong class="text-emerald-400 font-mono"><%= item.quantity %>x</strong> <%= item.menuItem ? item.menuItem.name : (item.selectedAddons || 'Item') %></span>
                      <span class="font-mono font-bold text-white">$<%= ((item.unitPrice || 10) * item.quantity).toFixed(2) %></span>
                    </div>
                  <% }) %>
                </div>
                <div class="border-t border-slate-700 pt-3 flex justify-between items-center font-bold text-sm text-white">
                  <span class="uppercase text-xs text-slate-400 font-mono">Total Price</span>
                  <span class="font-mono text-emerald-400 text-base">$<%= (latest.total || 0).toFixed(2) %></span>
                </div>
              </div>
            <% } else { %>
              <div class="h-full flex flex-col items-center justify-center text-center text-slate-500 space-y-2 p-6">
                <i data-lucide="shopping-cart" class="w-10 h-10 text-slate-600 mb-2"></i>
                <p class="font-bold text-xs uppercase text-slate-400">No Orders Created Yet</p>
                <p class="text-[11px] text-slate-500">Call the AI and request food items to see the backend order created live.</p>
              </div>
            <% } %>
          <% } else { %>
            <% if (session.business.appointments && session.business.appointments.length > 0) { %>
              <% const latestAppt = session.business.appointments[0]; %>
              <div class="p-5 rounded-2xl bg-slate-800/90 border border-emerald-500/40 space-y-4 animate-fade-in shadow-lg">
                <div class="flex justify-between items-center border-b border-slate-700 pb-3">
                  <div>
                    <span class="text-[10px] font-mono text-emerald-400 uppercase tracking-widest block mb-0.5">BOOKED APPOINTMENT</span>
                    <h4 class="font-orbitron font-bold text-base text-white"><%= latestAppt.customerName %></h4>
                  </div>
                  <span class="px-3 py-1 rounded-full text-[10px] font-black bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 uppercase">CONFIRMED ✓</span>
                </div>
                <div class="space-y-2.5 text-xs text-slate-200 font-sans">
                  <div class="flex items-center justify-between p-2 rounded-xl bg-slate-900/60 border border-slate-700/60">
                    <span class="text-slate-400 uppercase font-bold text-[10px]">Service</span>
                    <strong class="text-white font-bold"><%= latestAppt.service ? latestAppt.service.name : (latestAppt.serviceName || 'Appointment Service') %></strong>
                  </div>
                  <div class="flex items-center justify-between p-2 rounded-xl bg-slate-900/60 border border-slate-700/60">
                    <span class="text-slate-400 uppercase font-bold text-[10px]">Scheduled Time</span>
                    <strong class="text-primary font-bold"><%= new Date(latestAppt.appointmentTime || latestAppt.createdAt).toLocaleString([], { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></strong>
                  </div>
                  <div class="flex items-center justify-between p-2 rounded-xl bg-slate-900/60 border border-slate-700/60">
                    <span class="text-slate-400 uppercase font-bold text-[10px]">Customer Contact</span>
                    <strong class="text-emerald-400 font-bold"><%= latestAppt.customerPhone || 'Phone Contact' %></strong>
                  </div>
                </div>
              </div>
            <% } else { %>
              <div class="h-full flex flex-col items-center justify-center text-center text-slate-500 space-y-2 p-6">
                <i data-lucide="calendar" class="w-10 h-10 text-slate-600 mb-2"></i>
                <p class="font-bold text-xs uppercase text-slate-400">No Appointments Booked Yet</p>
                <p class="text-[11px] text-slate-500">Call the AI and book a service to see calendar reservation created live.</p>
              </div>
            <% } %>
          <% } %>
        </div>
      </div>

    </div>

    <!-- CALL HISTORY TABLE -->
    <div class="bg-[#1E293B] border border-slate-700/80 rounded-3xl p-6 shadow-xl">
      <div class="flex items-center justify-between border-b border-slate-700 pb-4 mb-6">
        <h3 class="font-orbitron font-bold text-xs uppercase tracking-wider text-white">Call Log History</h3>
        <span class="text-xs text-slate-400 font-mono" id="call-count-label">Total Calls: <%= session.business.calls ? session.business.calls.length : 0 %></span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-800/80 font-orbitron text-[10px] text-slate-400 uppercase tracking-wider">
            <tr>
              <th class="py-3 px-4">Timestamp</th>
              <th class="py-3 px-4">Caller</th>
              <th class="py-3 px-4">Duration</th>
              <th class="py-3 px-4">Outcome</th>
              <th class="py-3 px-4">Action Taken</th>
            </tr>
          </thead>
          <tbody id="call-history-body" class="divide-y divide-slate-700 text-slate-300 font-mono">
            <% if (session.business.calls && session.business.calls.length > 0) { %>
              <% session.business.calls.forEach(c => { %>
                <tr>
                  <td class="py-3 px-4"><%= new Date(c.createdAt).toLocaleTimeString() %></td>
                  <td class="py-3 px-4"><%= c.fromNumber %></td>
                  <td class="py-3 px-4"><%= c.duration || 0 %>s</td>
                  <td class="py-3 px-4">
                    <span class="px-2 py-0.5 rounded text-[9px] font-bold <%= c.outcome === 'success' || c.outcome === 'active' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-slate-700 text-slate-300' %> uppercase">
                      <%= c.outcome || 'Completed' %>
                    </span>
                  </td>
                  <td class="py-3 px-4 text-slate-200"><%= c.summary || c.actionTaken || 'AI Handled' %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" class="py-6 text-center text-slate-500">No calls recorded yet. Dial the phone number to start your first call.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- POST-DEMO HIGH-CONVERTING CONVERSION CTA -->
    <div id="convert-card" class="bg-gradient-to-r from-secondary via-primary to-secondary rounded-3xl p-8 text-center text-white shadow-2xl space-y-6 relative overflow-hidden">
      <div class="max-w-2xl mx-auto space-y-3">
        <h2 class="font-orbitron font-black text-2xl sm:text-3xl tracking-tight uppercase">
          Your AI Just Completed a Real Interaction.
        </h2>
        <p class="text-sm text-blue-100 leading-relaxed">
          Imagine deploying <%= session.aiName %> to handle 100% of your business calls 24/7 without missing a single customer order or appointment.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a href="/login" class="px-8 py-4 rounded-full text-xs font-black tracking-wider text-slate-900 bg-white hover:bg-blue-50 shadow-xl transition-all uppercase">
          START WITH NAXTON TODAY &rarr;
        </a>
        <a href="/#contact" class="px-8 py-4 rounded-full text-xs font-bold tracking-wider text-white border border-white/30 hover:bg-white/10 transition-all uppercase">
          TALK TO OUR TEAM
        </a>
      </div>
    </div>

  </main>

  <script>
    lucide.createIcons();

    const businessId = "<%= session.businessId %>";
    const sessionToken = "<%= session.token %>";
    const businessType = "<%= session.businessType %>";
    let expiresSeconds = <%= session.remainingSeconds %>;
    let isCallActive = false;
    let loggedMessages = new Set();

    // Countdown Timer
    setInterval(() => {
      if (expiresSeconds > 0) {
        expiresSeconds--;
        const h = String(Math.floor(expiresSeconds / 3600)).padStart(2, '0');
        const m = String(Math.floor((expiresSeconds % 3600) / 60)).padStart(2, '0');
        const s = String(expiresSeconds % 60).padStart(2, '0');
        document.getElementById('countdown-timer').innerText = `${h}:${m}:${s}`;
      } else {
        document.getElementById('countdown-timer').innerText = '00:00:00';
        document.getElementById('badge-status').innerText = '🔴 EXPIRED';
        document.getElementById('badge-status').className = 'px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-red-500/20 text-red-400 border border-red-500/30';
      }
    }, 1000);

    // Socket.io Realtime Listeners
    const socket = io();

    socket.on('connect', () => {
      console.log('[Socket] Connected to Live Demo Gateway for Business:', businessId);
      socket.emit('join_business', businessId);
      socket.emit('join_superadmin');
    });

    // Realtime Transcripts
    function handleTranscript(role, text) {
      if (!text || !text.trim()) return;
      appendTranscript(role, text);
      const isUser = role === 'user' || role === 'customer';
      logActivity(isUser ? `🗣️ Prospect Speaking: "${text.slice(0, 40)}..."` : `🤖 AI Speaking: "${text.slice(0, 40)}..."`);
    }

    socket.on('call_transcribed', (data) => handleTranscript(data.role, data.text));
    socket.on('live-transcript', (data) => handleTranscript(data.role || 'ai', data.text));
    socket.on('speech_processed', (data) => handleTranscript('user', data.text));

    // Realtime Debug / AI Reasoning Event
    socket.on('call_debug', (data) => {
      if (data && data.message) {
        logActivity(`⚙️ AI Engine: ${data.message}`);
      }
    });

    // Realtime Call Started
    socket.on('call_started', (data) => {
      setCallActiveState(true, data.from || 'Caller');
      logActivity(`📞 Call Incoming from ${data.from || 'Prospect Phone'}`);
      logActivity(`🎙️ Voice Stream Connected to Nexa AI Engine`);
      logActivity(`🧠 AI Knowledge & 1-Week Calendar Loaded`);
    });

    // Realtime Call Ended
    socket.on('call_ended', (data) => {
      setCallActiveState(false);
      logActivity(`🏁 Call Completed & Saved (${data.duration || 0}s)`);
      syncDemoData();
    });

    // Realtime New Order
    socket.on('new_order', (order) => {
      logActivity(`✅ Order created live: #${order.orderNumber || (order.id ? order.id.slice(0, 6) : '101')} ($${order.total || 0})`);
      renderOrderResult(order);
      syncDemoData();
    });

    // Realtime New Appointment
    socket.on('new_appointment', (appt) => {
      logActivity(`✅ Appointment created live: ${appt.customerName || appt.name}`);
      renderAppointmentResult(appt);
      syncDemoData();
    });

    function setCallActiveState(active, caller = 'Caller') {
      isCallActive = active;
      const heading = document.getElementById('call-status-heading');
      const subtext = document.getElementById('call-status-subtext');
      const ring = document.getElementById('status-ring');
      const icon = document.getElementById('status-icon');

      if (active) {
        heading.innerText = '🟢 LIVE CALL IN PROGRESS';
        heading.className = 'font-orbitron font-bold text-sm tracking-wider text-emerald-400 uppercase animate-pulse';
        subtext.innerText = `Call connected from ${caller}. AI Receptionist speaking...`;
        ring.className = 'w-20 h-20 rounded-full bg-emerald-500/20 border border-emerald-500/50 flex items-center justify-center mb-4';
        icon.className = 'w-8 h-8 text-emerald-400 animate-bounce';
      } else {
        heading.innerText = '✓ CALL COMPLETED & SAVED';
        heading.className = 'font-orbitron font-bold text-sm tracking-wider text-primary uppercase';
        subtext.innerText = 'Call finished. AI results updated live below.';
        ring.className = 'w-20 h-20 rounded-full bg-primary/10 border border-primary/30 flex items-center justify-center mb-4';
        icon.className = 'w-8 h-8 text-primary';
      }
    }

    function appendTranscript(role, text) {
      const feed = document.getElementById('transcript-feed');
      const emptyMsg = document.getElementById('empty-transcript-msg');
      if (emptyMsg) emptyMsg.remove();

      const isUser = role === 'user' || role === 'USER' || role === 'customer';
      const msgKey = `${isUser ? 'user' : 'ai'}:${text.trim()}`;
      if (loggedMessages.has(msgKey)) return;
      loggedMessages.add(msgKey);

      const div = document.createElement('div');
      div.className = `p-3.5 rounded-2xl border shadow-sm ${isUser ? 'bg-slate-800/95 border-emerald-500/30 text-white ml-6' : 'bg-sky-950/80 border-sky-500/40 text-slate-100 font-medium mr-6'}`;
      div.innerHTML = `
        <div class="flex items-center justify-between text-[10px] font-bold mb-1.5 pb-1 border-b border-slate-700/50">
          <span class="flex items-center gap-1 ${isUser ? 'text-emerald-400' : 'text-sky-300'} font-orbitron uppercase">
            ${isUser ? '👤 CUSTOMER' : '🤖 AI RECEPTIONIST'}
          </span>
          <span class="text-slate-400 font-mono text-[9px]">${new Date().toLocaleTimeString()}</span>
        </div>
        <div class="text-xs leading-relaxed text-slate-100">${text}</div>
      `;
      feed.appendChild(div);
      feed.scrollTop = feed.scrollHeight;
    }

    function renderFullTranscript(fullText) {
      if (!fullText || !fullText.trim()) return;
      const lines = fullText.split('\n');
      lines.forEach(line => {
        if (line.startsWith('USER:')) {
          appendTranscript('user', line.replace('USER:', '').trim());
        } else if (line.startsWith('AI:') || line.startsWith('ASSISTANT:')) {
          appendTranscript('ai', line.replace(/^(AI|ASSISTANT):/, '').trim());
        }
      });
    }

    function logActivity(message) {
      const feed = document.getElementById('activity-feed');
      if (!feed) return;
      
      const existing = Array.from(feed.children).map(c => c.innerText);
      if (existing.includes(message)) return;

      const div = document.createElement('div');
      div.className = 'p-2.5 rounded-xl bg-slate-800/80 border border-emerald-500/30 text-emerald-300 font-mono text-[11px] animate-fade-in flex items-center gap-1.5';
      div.innerText = message;
      feed.appendChild(div);
      feed.scrollTop = feed.scrollHeight;
    }

    function renderOrderResult(order) {
      const container = document.getElementById('action-result-container');
      if (!order) return;

      const displayId = order.displayId || `#DEMO-${order.orderNumber || (order.id ? order.id.slice(0, 6) : '101')}`;
      const itemsHtml = (order.items || []).map(i => `
        <div class="flex justify-between items-center text-slate-200 text-xs p-2 rounded-xl bg-slate-900/60 border border-slate-700/50">
          <span><strong class="text-emerald-400 font-mono">${i.quantity || 1}x</strong> ${i.menuItem ? i.menuItem.name : (i.selectedAddons || i.name || 'Item')}</span>
          <span class="font-mono font-bold text-white">$${((i.unitPrice || i.price || 10) * (i.quantity || 1)).toFixed(2)}</span>
        </div>
      `).join('');

      container.innerHTML = `
        <div class="p-5 rounded-2xl bg-slate-800/90 border border-emerald-500/40 space-y-4 animate-fade-in shadow-lg">
          <div class="flex justify-between items-center border-b border-slate-700 pb-3">
            <div>
              <span class="text-[10px] font-mono text-emerald-400 uppercase tracking-widest block mb-0.5">CONFIRMED ORDER</span>
              <h4 class="font-orbitron font-bold text-base text-emerald-400">${displayId}</h4>
            </div>
            <span class="px-3 py-1 rounded-full text-[10px] font-black bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 uppercase">CONFIRMED ✓</span>
          </div>
          <div class="space-y-2">
            ${itemsHtml || `<div class="text-slate-300 text-xs">Order items confirmed</div>`}
          </div>
          <div class="border-t border-slate-700 pt-3 flex justify-between items-center font-bold text-sm text-white">
            <span class="uppercase text-xs text-slate-400 font-mono">Total Price</span>
            <span class="font-mono text-emerald-400 text-base">$${(order.total || 0).toFixed(2)}</span>
          </div>
        </div>
      `;
    }

    function renderAppointmentResult(appt) {
      const container = document.getElementById('action-result-container');
      if (!appt) return;

      const apptTime = appt.appointmentTime ? new Date(appt.appointmentTime).toLocaleString([], {
        weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit'
      }) : new Date().toLocaleString();

      const serviceTitle = appt.service ? appt.service.name : (appt.serviceName || appt.service || 'Appointment Service');
      const clientName = appt.customerName || appt.name || 'Voice Customer';
      const clientPhone = appt.customerPhone || appt.phone || 'Phone Contact';

      container.innerHTML = `
        <div class="p-5 rounded-2xl bg-slate-800/90 border border-emerald-500/40 space-y-4 animate-fade-in shadow-lg">
          <div class="flex justify-between items-center border-b border-slate-700 pb-3">
            <div>
              <span class="text-[10px] font-mono text-emerald-400 uppercase tracking-widest block mb-0.5">BOOKED APPOINTMENT</span>
              <h4 class="font-orbitron font-bold text-base text-white">${clientName}</h4>
            </div>
            <span class="px-3 py-1 rounded-full text-[10px] font-black bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 uppercase">CONFIRMED ✓</span>
          </div>
          <div class="space-y-2.5 text-xs text-slate-200 font-sans">
            <div class="flex items-center justify-between p-2 rounded-xl bg-slate-900/60 border border-slate-700/60">
              <span class="text-slate-400 uppercase font-bold text-[10px]">Service</span>
              <strong class="text-white font-bold">${serviceTitle}</strong>
            </div>
            <div class="flex items-center justify-between p-2 rounded-xl bg-slate-900/60 border border-slate-700/60">
              <span class="text-slate-400 uppercase font-bold text-[10px]">Scheduled Time</span>
              <strong class="text-primary font-bold">${apptTime}</strong>
            </div>
            <div class="flex items-center justify-between p-2 rounded-xl bg-slate-900/60 border border-slate-700/60">
              <span class="text-slate-400 uppercase font-bold text-[10px]">Customer Contact</span>
              <strong class="text-emerald-400 font-bold">${clientPhone}</strong>
            </div>
          </div>
        </div>
      `;
    }

    // High-Frequency Live Data Sync (1.5-second polling backup)
    async function syncDemoData() {
      try {
        // 1. Sync Session State & Calls Remaining
        const sRes = await fetch(`/api/demo/session/${sessionToken}`);
        const sData = await sRes.json();
        if (sData.success && sData.session) {
          const s = sData.session;
          document.getElementById('calls-remaining').innerText = `${s.maxCalls - s.callCount} / ${s.maxCalls}`;
          if (s.isExpired) {
            document.getElementById('badge-status').innerText = '🔴 EXPIRED';
            document.getElementById('badge-status').className = 'px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-red-500/20 text-red-400 border border-red-500/30';
          }
        }

        // 2. Sync Call Logs & Active Call State
        const cRes = await fetch(`/api/demo/session/${sessionToken}/calls`);
        const cData = await cRes.json();
        if (cData.success && cData.calls) {
          const calls = cData.calls;
          document.getElementById('call-count-label').innerText = `Total Calls: ${calls.length}`;

          if (calls.length > 0) {
            const latestCall = calls[0];

            if (latestCall.outcome === 'active') {
              if (!isCallActive) {
                setCallActiveState(true, latestCall.fromNumber || 'Voice Customer');
                logActivity(`📞 Call Incoming from ${latestCall.fromNumber || 'Voice Customer'}`);
                logActivity(`🎙️ Voice Stream Connected to Nexa AI Engine`);
                logActivity(`🧠 AI Knowledge & 1-Week Calendar Loaded`);
              }
            } else {
              if (isCallActive) {
                setCallActiveState(false);
                logActivity(`🏁 Call Completed & Saved (${latestCall.duration || 0}s)`);
              }
            }

            if (latestCall.transcript) {
              renderFullTranscript(latestCall.transcript);
            }

            renderCallHistoryTable(calls);
          }
        }

        // 3. Sync Action Result (Orders or Appointments)
        if (businessType === 'restaurant') {
          const oRes = await fetch(`/api/demo/session/${sessionToken}/orders`);
          const oData = await oRes.json();
          if (oData.success && oData.orders && oData.orders.length > 0) {
            renderOrderResult(oData.orders[0]);
          }
        } else {
          const aRes = await fetch(`/api/demo/session/${sessionToken}/appointments`);
          const aData = await aRes.json();
          if (aData.success && aData.appointments && aData.appointments.length > 0) {
            renderAppointmentResult(aData.appointments[0]);
          }
        }

      } catch (e) {
        console.error('[SYNC_ERROR]', e.message);
      }
    }

    function renderCallHistoryTable(calls) {
      const tbody = document.getElementById('call-history-body');
      if (!tbody || calls.length === 0) return;

      tbody.innerHTML = calls.map(c => `
        <tr>
          <td class="py-3 px-4">${new Date(c.createdAt).toLocaleTimeString()}</td>
          <td class="py-3 px-4">${c.fromNumber || 'Voice Customer'}</td>
          <td class="py-3 px-4">${c.duration || 0}s</td>
          <td class="py-3 px-4">
            <span class="px-2 py-0.5 rounded text-[9px] font-bold ${c.outcome === 'success' || c.outcome === 'active' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-slate-700 text-slate-300'} uppercase">
              ${c.outcome || 'Completed'}
            </span>
          </td>
          <td class="py-3 px-4 text-slate-200">${c.summary || c.actionTaken || 'AI Handled'}</td>
        </tr>
      `).join('');
    }

    // Run sync immediately on page load, then poll every 1.5 seconds
    syncDemoData();
    setInterval(syncDemoData, 1500);
  </script>
</body>
</html>

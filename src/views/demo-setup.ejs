    function switchPrimaryModel(type) {
      selectedType = type;
      document.getElementById('form-businessType').value = type;

      const tabRest = document.getElementById('tab-model-restaurant');
      const tabAppt = document.getElementById('tab-model-appointment');

      if (type === 'restaurant') {
        tabRest.className = "flex-1 py-3 px-4 rounded-xl text-xs font-black uppercase tracking-wider transition-all bg-primary text-slate-900 shadow-md";
        tabAppt.className = "flex-1 py-3 px-4 rounded-xl text-xs font-bold uppercase tracking-wider transition-all text-slate-400 hover:text-white";
        document.getElementById('subcategories-restaurant').classList.remove('hidden');
        document.getElementById('subcategories-appointment').classList.add('hidden');
        selectSubCategory('pizzeria', 'restaurant', 'Bella Pizzeria');
      } else {
        tabAppt.className = "flex-1 py-3 px-4 rounded-xl text-xs font-black uppercase tracking-wider transition-all bg-primary text-slate-900 shadow-md";
        tabRest.className = "flex-1 py-3 px-4 rounded-xl text-xs font-bold uppercase tracking-wider transition-all text-slate-400 hover:text-white";
        document.getElementById('subcategories-appointment').classList.remove('hidden');
        document.getElementById('subcategories-restaurant').classList.add('hidden');
        selectSubCategory('salon', 'appointment', 'Luxe Hair Salon');
      }
    }

    function selectSubCategory(sub, type, defaultName) {
      selectedSub = sub;
      selectedType = type;

      document.getElementById('form-subType').value = sub;
      document.getElementById('form-businessType').value = type;
      document.getElementById('form-businessName').value = defaultName;

      // Update UI cards
      document.querySelectorAll('.subcard').forEach(card => {
        card.className = "subcard border-2 border-slate-700/80 hover:border-primary rounded-2xl p-4 cursor-pointer hover:shadow-lg transition-all bg-[#0F172A] text-slate-300";
      });

      const activeCard = document.getElementById(`subcard-${sub}`);
      if (activeCard) {
        activeCard.className = "subcard border-2 border-primary ring-2 ring-primary/20 rounded-2xl p-4 cursor-pointer hover:shadow-lg transition-all bg-[#1E293B] text-white shadow-primary/10";
      }

      renderItemsPreview();
    }

    function renderItemsPreview() {
      const grid = document.getElementById('items-preview-grid');
      const title = document.getElementById('offerings-title');
      const items = PRESETS[selectedSub] || [];

      title.innerText = selectedType === 'restaurant' ? 'Pre-Loaded Menu Items' : 'Pre-Loaded Service Catalog';

      grid.innerHTML = items.map(item => `
        <div class="p-3.5 rounded-xl bg-[#0F172A] border border-slate-700/80 flex items-center justify-between text-xs">
          <span class="font-bold text-white">${item.name}</span>
          <span class="font-mono text-primary font-bold">${item.price}</span>
        </div>
      `).join('');
    }

    function goToStep(step) {
      currentStep = step;
      document.getElementById('wizard-step-1').classList.add('hidden');
      document.getElementById('wizard-step-2').classList.add('hidden');
      document.getElementById('wizard-step-3').classList.add('hidden');

      document.getElementById(`wizard-step-${step}`).classList.remove('hidden');

      const indicator = document.getElementById('step-indicator-text');
      const percentage = document.getElementById('step-percentage');
      const bar = document.getElementById('step-progress-bar');

      if (step === 1) {
        indicator.innerText = "Step 1 of 3 — Select Business Category";
        percentage.innerText = "33% Completed";
        bar.className = "bg-gradient-to-r from-primary to-secondary h-2 rounded-full transition-all duration-500 w-1/3";
      } else if (step === 2) {
        indicator.innerText = "Step 2 of 3 — Configure Business & AI";
        percentage.innerText = "66% Completed";
        bar.className = "bg-gradient-to-r from-primary to-secondary h-2 rounded-full transition-all duration-500 w-2/3";
      } else if (step === 3) {
        indicator.innerText = "Step 3 of 3 — Launch Interactive Call";
        percentage.innerText = "100% Completed";
        bar.className = "bg-gradient-to-r from-primary to-emerald-400 h-2 rounded-full transition-all duration-500 w-full";
        renderItemsPreview();
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    async function submitDemoSetup() {
      const email = document.getElementById('form-email').value.trim();
      const ownerName = document.getElementById('form-ownerName').value.trim();
      const businessName = document.getElementById('form-businessName').value.trim();
      const phone = document.getElementById('form-phone').value.trim();

      if (!email || !ownerName || !businessName) {
        alert("Please complete all required fields (Work Email, Name, and Business Name).");
        goToStep(2);
        return;
      }

      const launchBtn = document.getElementById('launch-demo-btn');
      launchBtn.disabled = true;
      launchBtn.innerHTML = `
        <span class="inline-block animate-spin font-bold">⌛</span>
        <span>ALLOCATING INVENTORY NUMBER...</span>
      `;

      try {
        const response = await fetch('/api/demo/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            businessName,
            businessType: selectedType,
            subType: selectedSub,
            ownerName,
            email,
            phone,
            city: document.getElementById('form-city').value || 'San Francisco',
            aiName: document.getElementById('form-aiName').value || 'Sarah',
            customGreeting: document.getElementById('form-customGreeting').value || ''
          })
        });

        const data = await response.json();

        if (data.success && data.redirectUrl) {
          window.location.href = data.redirectUrl;
        } else if (data.code === 'NUMBERS_BUSY') {
          launchBtn.disabled = false;
          launchBtn.innerHTML = `
            <i data-lucide="phone-call" class="w-4 h-4 text-slate-900"></i>
            <span>LAUNCH DEMO SESSION &amp; GET NUMBER &rarr;</span>
          `;
          document.getElementById('waitlist-email').value = email;
          document.getElementById('waitlist-fullName').value = ownerName;
          document.getElementById('waitlist-phone').value = phone;
          document.getElementById('waitlist-modal').classList.remove('hidden');
        } else {
          alert(data.error || 'Failed to create demo session.');
          launchBtn.disabled = false;
          launchBtn.innerHTML = `
            <i data-lucide="phone-call" class="w-4 h-4 text-slate-900"></i>
            <span>LAUNCH DEMO SESSION &amp; GET NUMBER &rarr;</span>
          `;
        }
      } catch (err) {
        console.error('[DEMO_SETUP_ERR]', err);
        alert('Network error while allocating demo number. Please try again.');
        launchBtn.disabled = false;
        launchBtn.innerHTML = `
          <i data-lucide="phone-call" class="w-4 h-4 text-slate-900"></i>
          <span>LAUNCH DEMO SESSION &amp; GET NUMBER &rarr;</span>
        `;
      }
    }

    async function submitWaitlistReservation(e) {
      e.preventDefault();
      const email = document.getElementById('waitlist-email').value.trim();
      const fullName = document.getElementById('waitlist-fullName').value.trim();
      const mobilePhone = document.getElementById('waitlist-phone').value.trim();

      const btn = document.getElementById('waitlist-submit-btn');
      btn.disabled = true;
      btn.innerText = 'RESERVING...';

      try {
        const response = await fetch('/api/demo/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, fullName, mobilePhone, category: selectedSub })
        });
        const data = await response.json();
        alert(data.message || 'Priority reservation confirmed!');
        closeWaitlistModal();
      } catch (err) {
        alert('Failed to submit waitlist reservation.');
      } finally {
        btn.disabled = false;
        btn.innerText = 'Reserve Priority Line →';
      }
    }

    function closeWaitlistModal() {
      document.getElementById('waitlist-modal').classList.add('hidden');
    }
  </script>

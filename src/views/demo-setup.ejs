<!DOCTYPE html>
<html lang="en" class="h-full bg-[#07090E]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#38BDF8',
            secondary: '#2563EB',
            accent: '#7DD3FC',
            bgDark: '#07090E',
            cardDark: '#1E293B',
            textMain: '#F8FAFC',
            textDim: '#94A3B8',
            borderClr: '#334155'
          },
          fontFamily: {
            orbitron: ['Orbitron', 'sans-serif'],
            sans: ['Plus Jakarta Sans', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style>
    .ambient-orb {
      position: fixed;
      border-radius: 9999px;
      filter: blur(120px);
      opacity: 0.18;
      pointer-events: none;
      z-index: 0;
    }
    .orb-1 { width: 550px; height: 550px; background: #38BDF8; top: -100px; left: -100px; }
    .orb-2 { width: 650px; height: 650px; background: #2563EB; bottom: -150px; right: -150px; }

    .btn-gradient {
      background: linear-gradient(135deg, #38BDF8 0%, #2563EB 100%) !important;
      color: #0F172A !important;
      font-weight: 900 !important;
    }
    .btn-gradient:hover {
      opacity: 0.95;
      box-shadow: 0 10px 25px -5px rgba(56, 189, 248, 0.4);
    }
  </style>
</head>
<body class="font-sans text-textMain antialiased h-full flex flex-col bg-[#07090E] relative overflow-x-hidden">

  <!-- Ambient Glowing Background Orbs -->
  <div class="ambient-orb orb-1"></div>
  <div class="ambient-orb orb-2"></div>

  <!-- Header -->
  <header class="w-full bg-[#1E293B]/80 backdrop-blur-md border-b border-slate-800 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-primary to-secondary flex items-center justify-center text-slate-900 font-orbitron font-black text-lg shadow-md shadow-primary/20">
          N
        </div>
        <div class="flex flex-col">
          <span class="font-orbitron font-black text-sm tracking-[2px] bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"><%= projectName %></span>
          <span class="text-[9px] font-bold text-emerald-400 tracking-widest uppercase flex items-center gap-1">
            <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-ping"></span>
            LIVE DEMO CENTER
          </span>
        </div>
      </a>

      <div class="flex items-center gap-4">
        <a href="/" class="text-xs font-bold text-slate-400 hover:text-primary uppercase transition-colors hidden sm:inline-block">
          Return to Main Site
        </a>
        <a href="/login" class="px-5 py-2.5 rounded-full text-xs font-bold tracking-wider text-slate-900 bg-primary hover:bg-secondary transition-all uppercase shadow-lg shadow-primary/20">
          Access Portal
        </a>
      </div>
    </div>
  </header>

  <!-- Main Setup Container -->
  <main class="flex-1 max-w-4xl w-full mx-auto px-6 py-12 relative z-10">
    
    <!-- Hero Header -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-xs font-black text-emerald-400 uppercase tracking-widest mb-4 shadow-sm">
        <i data-lucide="zap" class="w-4 h-4 text-emerald-400"></i>
        <span>INSTANT 12-HOUR TRIAL — INVENTORY PHONE ALLOCATION</span>
      </div>
      <h1 class="font-orbitron font-black text-3xl sm:text-4xl text-white tracking-tight mb-3">
        Build Your AI Receptionist &amp; <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">Call It Live</span>
      </h1>
      <p class="text-sm sm:text-base text-slate-400 leading-relaxed">
        Experience a real phone call with an AI receptionist tailored to your exact industry in under 2 minutes.
      </p>
    </div>

    <!-- Progress Indicator -->
    <div class="mb-10">
      <div class="flex items-center justify-between text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">
        <span id="step-indicator-text" class="text-primary font-black">Step 1 of 3 — Select Business Category</span>
        <span id="step-percentage" class="font-mono text-emerald-400">33% Completed</span>
      </div>
      <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden border border-slate-700/60">
        <div id="step-progress-bar" class="bg-gradient-to-r from-primary to-secondary h-2 rounded-full transition-all duration-500 w-1/3 shadow-sm shadow-primary"></div>
      </div>
    </div>

    <!-- Multi-Step Form Card -->
    <div class="bg-[#1E293B]/90 backdrop-blur-xl border border-slate-700/80 rounded-3xl p-6 sm:p-10 shadow-2xl relative overflow-hidden">

      <!-- STEP 1: BUSINESS TYPE & SUB-CATEGORY SELECTION -->
      <div id="wizard-step-1" class="space-y-8">
        <div>
          <h2 class="font-orbitron font-bold text-lg text-white uppercase mb-2">Select Your Business Category</h2>
          <p class="text-xs text-slate-400">Choose your operational model and specific industry to pre-load realistic AI conversations and offerings.</p>
        </div>

        <!-- Primary Model Switch Tabs -->
        <div class="flex p-1.5 rounded-2xl bg-[#0F172A] border border-slate-700/80 gap-2 max-w-md mx-auto">
          <button type="button" onclick="switchPrimaryModel('restaurant')" id="tab-model-restaurant" class="flex-1 py-3 px-4 rounded-xl text-xs font-black uppercase tracking-wider transition-all bg-primary text-slate-900 shadow-md">
            🍕 Order-Based AI
          </button>
          <button type="button" onclick="switchPrimaryModel('appointment')" id="tab-model-appointment" class="flex-1 py-3 px-4 rounded-xl text-xs font-bold uppercase tracking-wider transition-all text-slate-400 hover:text-white">
            📅 Appointment-Based AI
          </button>
        </div>

        <!-- ORDER-BASED SUB-CATEGORIES -->
        <div id="subcategories-restaurant" class="space-y-4">
          <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">Choose Order Industry Sub-Category:</div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            
            <div onclick="selectSubCategory('pizzeria', 'restaurant', 'Bella Pizzeria')" id="subcard-pizzeria" class="subcard border-2 border-primary ring-2 ring-primary/20 rounded-2xl p-4 cursor-pointer hover:shadow-lg transition-all bg-[#0F172A] text-white">
              <div class="text-2xl mb-2">🍕</div>
              <h3 class="font-orbitron font-bold text-sm text-white uppercase mb-1">Pizzeria &amp; Italian</h3>
              <p class="text-[11px] text-slate-400">Pizza, garlic bread, calzones, soft drinks.</p>
            </div>

            <div onclick="selectSubCategory('cafe', 'restaurant', 'Roast &amp; Brew Cafe')" id="subcard-cafe" class="subcard border-2 border-slate-700/80 hover:border-primary rounded-2xl p-4 cursor-pointer hover:shadow-lg transition-all bg-[#0F172A] text-slate-300">
              <div class="text-2xl mb-2">☕</div>
              <h3 class="font-orbitron font-bold text-sm text-white uppercase mb-1">Cafe &amp; Coffee Shop</h3>
              <p class="text-[11px] text-slate-400">Espresso, macchiatos, croissants, avocado toast.</p>
            </div>

            <div onclick="selectSubCategory('burger', 'restaurant', 'Smash Burger Co.')" id="subcard-burger" class="subcard border-2 border-slate-700/80 hover:border-primary rounded-2xl p-4 cursor-pointer hover:shadow-lg transition-all bg-[#0F172A] text-slate-300">
              <div class="text-2xl mb-2">🍔</div>
              <h3 class="font-orbitron font-bold text-sm text-white uppercase mb-1">Burger &amp; Fast Food</h3>
              <p class="text-[11px] text-slate-400">Cheeseburgers, chicken sandwiches, fries, shakes.</p>
            </div>

            <div onclick="selectSubCategory('sushi', 'restaurant', 'Sakura Sushi Bistro')" id="subcard-sushi" class="subcard border-2 border-slate-700/80 hover:border-primary rounded-2xl p-4 cursor-pointer hover:shadow-lg transition-all bg-[#0F172A] text-slate-300">
              <div class="text-2xl mb-2">🍣</div>
              <h3 class="font-orbitron font-bold text-sm text-white uppercase mb-1">Sushi &amp; Asian Bistro</h3>
              <p class="text-[11px] text-slate-400">Sushi rolls, bento boxes, gyoza, miso soup.</p>
            </div>

            <div onclick="selectSubCategory('retail', 'restaurant', 'Urban Apparel Boutique')" id="subcard-retail" class="subcard border-2 border-slate-700/80 hover:border-primary rounded-2xl p-4 cursor-pointer hover:shadow-lg transition-all bg-[#0F172A] text-slate-300">
              <div class="text-2xl mb-2">🛍️</div>
              <h3 class="font-orbitron font-bold text-sm text-white uppercase mb-1">Retail &amp; Boutique</h3>
              <p class="text-[11px] text-slate-400">Streetwear hoodies, organic tees, tote bags, candles.</p>
            </div>

          </div>
        </div>

        <!-- APPOINTMENT-BASED SUB-CATEGORIES -->
        <div id="subcategories-appointment" class="space-y-4 hidden">
          <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">Choose Appointment Industry Sub-Category:</div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            
            <div onclick="selectSubCategory('salon', 'appointment', 'Luxe Hair Salon')" id="subcard-salon" class="subcard border-2 border-slate-700/80 hover:border-primary rounded-2xl p-4 cursor-pointer hover:shadow-lg transition-all bg-[#0F172A] text-slate-300">
              <div class="text-2xl mb-2">💇</div>
              <h3 class="font-orbitron font-bold text-sm text-white uppercase mb-1">Hair Salon &amp; Barber</h3>
              <p class="text-[11px] text-slate-400">Haircuts, beard trims, balayage, styling.</p>
            </div>

            <div onclick="selectSubCategory('spa', 'appointment', 'Tranquility Spa &amp; Wellness')" id="subcard-spa" class="subcard border-2 border-slate-700/80 hover:border-primary rounded-2xl p-4 cursor-pointer hover:shadow-lg transition-all bg-[#0F172A] text-slate-300">
              <div class="text-2xl mb-2">💅</div>
              <h3 class="font-orbitron font-bold text-sm text-white uppercase mb-1">Spa &amp; Wellness Center</h3>
              <p class="text-[11px] text-slate-400">Deep tissue massage, facials, aromatherapy packages.</p>
            </div>

            <div onclick="selectSubCategory('clinic', 'appointment', 'Apex Medical Clinic')" id="subcard-clinic" class="subcard border-2 border-slate-700/80 hover:border-primary rounded-2xl p-4 cursor-pointer hover:shadow-lg transition-all bg-[#0F172A] text-slate-300">
              <div class="text-2xl mb-2">🩺</div>
              <h3 class="font-orbitron font-bold text-sm text-white uppercase mb-1">Medical Clinic &amp; Dental</h3>
              <p class="text-[11px] text-slate-400">General checkups, dental cleanings, consultations.</p>
            </div>

            <div onclick="selectSubCategory('hotel', 'appointment', 'Grand Horizon Hotel')" id="subcard-hotel" class="subcard border-2 border-slate-700/80 hover:border-primary rounded-2xl p-4 cursor-pointer hover:shadow-lg transition-all bg-[#0F172A] text-slate-300">
              <div class="text-2xl mb-2">🏨</div>
              <h3 class="font-orbitron font-bold text-sm text-white uppercase mb-1">Hotel &amp; Resort Concierge</h3>
              <p class="text-[11px] text-slate-400">Room reservations, airport shuttles, late checkouts.</p>
            </div>

            <div onclick="selectSubCategory('consulting', 'appointment', 'Vanguard Consulting')" id="subcard-consulting" class="subcard border-2 border-slate-700/80 hover:border-primary rounded-2xl p-4 cursor-pointer hover:shadow-lg transition-all bg-[#0F172A] text-slate-300">
              <div class="text-2xl mb-2">💼</div>
              <h3 class="font-orbitron font-bold text-sm text-white uppercase mb-1">Consulting &amp; Professional</h3>
              <p class="text-[11px] text-slate-400">Strategy calls, technical audits, legal consultations.</p>
            </div>

          </div>
        </div>

        <div class="flex justify-end pt-4 border-t border-slate-700/80">
          <button type="button" onclick="goToStep(2)" class="px-8 py-3.5 rounded-full text-xs font-black tracking-wider text-slate-900 bg-gradient-to-r from-primary via-secondary to-primary hover:opacity-95 shadow-lg shadow-primary/20 transition-all uppercase flex items-center gap-2 cursor-pointer">
            <span>Continue to Business Details</span>
            <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </button>
        </div>

      </div>

      <!-- STEP 2: BUSINESS & AI CONFIGURATION -->
      <div id="wizard-step-2" class="space-y-8 hidden">
        <div>
          <h2 class="font-orbitron font-bold text-lg text-white uppercase mb-2">Configure Business &amp; AI Details</h2>
          <p class="text-xs text-slate-400">Provide basic information so your AI agent knows who it is representing.</p>
        </div>

        <form id="demo-config-form" class="space-y-6">
          <input type="hidden" id="form-businessType" value="restaurant" />
          <input type="hidden" id="form-subType" value="pizzeria" />

          <!-- Business Info Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs font-bold text-slate-300 uppercase mb-2">Business Name *</label>
              <input type="text" id="form-businessName" required value="Bella Pizzeria" placeholder="e.g. Bella Pizzeria or Luxe Salon" class="w-full px-4 py-3 bg-[#0F172A] border border-slate-700 rounded-xl text-sm text-white font-bold placeholder-slate-500 focus:border-primary focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-300 uppercase mb-2">Your Name (Contact) *</label>
              <input type="text" id="form-ownerName" required placeholder="e.g. Alex Morgan" class="w-full px-4 py-3 bg-[#0F172A] border border-slate-700 rounded-xl text-sm text-white placeholder-slate-500 focus:border-primary focus:outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs font-bold text-slate-300 uppercase mb-2">Work Email Address (Compulsory) *</label>
              <input type="email" id="form-email" required placeholder="alex@business.com" class="w-full px-4 py-3 bg-[#0F172A] border border-slate-700 rounded-xl text-sm text-white placeholder-slate-500 focus:border-primary focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-300 uppercase mb-2">Your Phone Number (Optional)</label>
              <input type="tel" id="form-phone" placeholder="+1 (555) 000-0000" class="w-full px-4 py-3 bg-[#0F172A] border border-slate-700 rounded-xl text-sm text-white placeholder-slate-500 focus:border-primary focus:outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs font-bold text-slate-300 uppercase mb-2">City</label>
              <input type="text" id="form-city" value="San Francisco" class="w-full px-4 py-3 bg-[#0F172A] border border-slate-700 rounded-xl text-sm text-white placeholder-slate-500 focus:border-primary focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-300 uppercase mb-2">AI Assistant Name</label>
              <input type="text" id="form-aiName" value="Sarah" class="w-full px-4 py-3 bg-[#0F172A] border border-slate-700 rounded-xl text-sm text-white placeholder-slate-500 focus:border-primary focus:outline-none" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase mb-2">Custom Voice Greeting (Optional)</label>
            <textarea id="form-customGreeting" rows="2" placeholder="e.g. Thanks for calling Bella Pizzeria! How can I help you order today?" class="w-full px-4 py-3 bg-[#0F172A] border border-slate-700 rounded-xl text-sm text-white placeholder-slate-500 focus:border-primary focus:outline-none"></textarea>
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-slate-700/80">
            <button type="button" onclick="goToStep(1)" class="px-6 py-3 rounded-full text-xs font-bold text-slate-400 hover:text-white uppercase transition-colors">
              &larr; Back
            </button>
            <button type="button" onclick="goToStep(3)" class="px-8 py-3.5 rounded-full text-xs font-black tracking-wider text-slate-900 bg-gradient-to-r from-primary via-secondary to-primary hover:opacity-95 shadow-lg shadow-primary/20 transition-all uppercase flex items-center gap-2 cursor-pointer">
              <span>Review Menu &amp; Offerings</span>
              <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </button>
          </div>
        </form>
      </div>

      <!-- STEP 3: PRE-LOADED OFFERINGS REVIEW & LAUNCH -->
      <div id="wizard-step-3" class="space-y-8 hidden">
        <div>
          <h2 class="font-orbitron font-bold text-lg text-white uppercase mb-2">Review Industry Offerings &amp; Launch</h2>
          <p class="text-xs text-slate-400">These items or services have been pre-loaded into your AI knowledge base. When you call, ask about these items directly!</p>
        </div>

        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <h3 id="offerings-title" class="font-orbitron font-bold text-xs uppercase tracking-wider text-primary">Pre-Loaded Menu Items</h3>
            <span class="text-[10px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">AI READY</span>
          </div>

          <div id="items-preview-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <!-- Dynamically Rendered -->
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-start gap-3">
          <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5"></i>
          <p class="text-xs text-emerald-300 leading-relaxed">
            Your 12-hour demo session will allocate a dedicated inventory phone number. You can call immediately from your phone and see real-time transcripts and order/appointment results updated on screen!
          </p>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-slate-700/80">
          <button type="button" onclick="goToStep(2)" class="px-6 py-3 rounded-full text-xs font-bold text-slate-400 hover:text-white uppercase transition-colors">
            &larr; Back
          </button>

          <button type="button" id="launch-demo-btn" onclick="submitDemoSetup()" class="px-10 py-4 rounded-full text-xs font-black tracking-wider text-slate-900 bg-gradient-to-r from-emerald-400 via-primary to-emerald-400 hover:opacity-95 shadow-xl shadow-emerald-500/20 transition-all uppercase flex items-center gap-2 cursor-pointer">
            <i data-lucide="phone-call" class="w-4 h-4 text-slate-900"></i>
            <span>LAUNCH DEMO SESSION &amp; GET NUMBER &rarr;</span>
          </button>
        </div>
      </div>

    </div>

  </main>

  <!-- VIP DEMO QUEUE WAITLIST MODAL -->
  <div id="waitlist-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center p-6 hidden animate-fade-in">
    <div class="bg-[#0F172A] border border-emerald-500/40 rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl space-y-6 relative overflow-hidden">
      <div class="absolute top-0 right-0 p-6 opacity-10 pointer-events-none">
        <i data-lucide="clock" class="w-32 h-32 text-emerald-400"></i>
      </div>

      <div class="space-y-2 relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-[10px] font-black text-emerald-400 uppercase tracking-widest">
          <i data-lucide="shield-alert" class="w-3.5 h-3.5"></i>
          <span>SYSTEM DEMO NUMBERS CURRENTLY BUSY</span>
        </div>
        <h3 class="font-orbitron font-black text-xl text-white">Reserve Priority Demo Line</h3>
        <p class="text-xs text-slate-300 leading-relaxed">
          All our active system demo phone lines are currently handling live prospect test calls. Leave your details below to reserve the next available phone line. We will email your direct credentials as soon as a line frees up!
        </p>
      </div>

      <form id="waitlist-form" onsubmit="submitWaitlistReservation(event)" class="space-y-4 relative z-10">
        <div>
          <label class="block text-[11px] font-bold text-slate-300 uppercase mb-1">Work Email Address (Compulsory) *</label>
          <input type="email" id="waitlist-email" required placeholder="you@company.com" class="w-full px-4 py-3 bg-slate-900/90 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:border-emerald-400 focus:outline-none" />
        </div>
        <div>
          <label class="block text-[11px] font-bold text-slate-300 uppercase mb-1">Full Name *</label>
          <input type="text" id="waitlist-fullName" required placeholder="John Doe" class="w-full px-4 py-3 bg-slate-900/90 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:border-emerald-400 focus:outline-none" />
        </div>
        <div>
          <label class="block text-[11px] font-bold text-slate-300 uppercase mb-1">Mobile Phone Number *</label>
          <input type="tel" id="waitlist-phone" required placeholder="+1 (555) 000-0000" class="w-full px-4 py-3 bg-slate-900/90 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:border-emerald-400 focus:outline-none" />
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button type="button" onclick="closeWaitlistModal()" class="px-5 py-2.5 rounded-full text-xs font-bold text-slate-400 hover:text-white uppercase">
            Cancel
          </button>
          <button type="submit" id="waitlist-submit-btn" class="px-6 py-3 rounded-full text-xs font-black tracking-wider text-slate-900 bg-emerald-400 hover:bg-emerald-300 shadow-lg shadow-emerald-500/20 uppercase">
            Reserve Priority Line &rarr;
          </button>
        </div>
      </form>
    </div>
  </div>

  <footer class="w-full border-t border-slate-800 py-6 mt-12 bg-[#07090E] relative z-10">
    <div class="max-w-7xl mx-auto px-6 text-center text-[11px] text-slate-500 font-mono">
      &copy; 2026 <%= projectName %>. All rights reserved. Strict Phone Inventory Allocation Policy Enabled.
    </div>
  </footer>

  <script>
    lucide.createIcons();

    let currentStep = 1;
    let selectedType = "restaurant";
    let selectedSub = "pizzeria";

    const PRESETS = {
      pizzeria: [
        { name: "Pizza Margherita", price: "$12.00" },
        { name: "Chicken Fajita Pizza", price: "$15.00" },
        { name: "Pepperoni Supreme Pizza", price: "$16.50" },
        { name: "Garlic Bread", price: "$5.00" },
        { name: "Soft Drink", price: "$2.50" }
      ],
      cafe: [
        { name: "Iced Caramel Macchiato", price: "$5.50" },
        { name: "Double Shot Espresso", price: "$3.50" },

        <label>Severity Level</label>
        <select name="severity" class="form-control">
          <option value="minor">Minor — Degraded performance, workaround available</option>
          <option value="major">Major — Significant service disruption</option>
          <option value="critical">Critical — Complete service outage</option>
        </select>

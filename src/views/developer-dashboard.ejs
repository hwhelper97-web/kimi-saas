</div>

<!-- ══════════════ SCRIPTS ══════════════ -->
<script>
lucide.createIcons();
let charts = {};
let currentSection = 'overview';

// ─── Navigation ─────────────────────────────────────────────
function switchSection(sectionId) {
  document.querySelectorAll('.section-container').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.apex-nav-item').forEach(n => n.classList.remove('active'));
  const section = document.getElementById('section-' + sectionId);
  const nav = document.getElementById('nav-' + sectionId);
  if (section) section.classList.add('active');
  if (nav) nav.classList.add('active');
  currentSection = sectionId;
  loadSectionData(sectionId);
  window.scrollTo(0, 0);
}

function refreshCurrentSection() { loadSectionData(currentSection); }

async function loadSectionData(id) {
  switch(id) {
    case 'overview':    await loadOverview(); break;
    case 'monitoring':  await loadMonitoring(); break;
    case 'logs':        await loadLogs(); break;
    case 'tickets':     await loadTickets(); break;
    case 'incidents':   await loadIncidents(); break;
    case 'deployment':  await loadDeployments(); break;
    case 'ai':          await loadAiInfrastructure(); break;
    case 'queues':      await loadQueues(); break;
    case 'debugging':   await loadDebugging(); break;
    case 'personality': await loadAiSettings(); break;
    case 'tasks':       await loadTasks(); break;
    case 'notes':       await loadNotes(); break;
  }
}

// ─── Safe API Fetch ──────────────────────────────────────────
async function apiFetch(url) {
  try {
    const res = await fetch(url);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    return await res.json();
  } catch (err) {
    console.error('[DEV-DASH] API error:', url, err.message);
    return { success: false, data: null, error: err.message };
  }
}

function severityBadge(sev) {
  const map = { critical: 'badge-red', major: 'badge-amber', minor: 'badge-cyan', low: 'badge-green' };
  return `<span class="badge ${map[sev] || 'badge-slate'}">${(sev||'unknown').toUpperCase()}</span>`;
}
function priorityBadge(p) {
  const map = { critical: 'badge-red', urgent: 'badge-red', high: 'badge-amber', medium: 'badge-cyan', low: 'badge-green' };
  return `<span class="badge ${map[p] || 'badge-slate'}">${(p||'N/A').toUpperCase()}</span>`;
}
function statusBadge(s) {
  const map = { open: 'badge-red', investigating: 'badge-amber', monitoring: 'badge-cyan', resolved: 'badge-green', fixing: 'badge-amber', testing: 'badge-purple', 'in_progress': 'badge-amber', todo: 'badge-slate', done: 'badge-green' };
  return `<span class="badge ${map[s] || 'badge-slate'}">${(s||'unknown').replace(/_/g,' ').toUpperCase()}</span>`;
}
function fmtDate(d) { return d ? new Date(d).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) : '—'; }
function fmtTime(d) { return d ? new Date(d).toLocaleTimeString('en-US', { hour:'2-digit', minute:'2-digit' }) : '—'; }
function fmtDateTime(d) { return d ? `${fmtDate(d)}, ${fmtTime(d)}` : '—'; }

// ─── Overview ────────────────────────────────────────────────
async function loadOverview() {
  const { data } = await apiFetch('/developer/api/analytics');
  if (!data) return;

  document.getElementById('overview-stats').innerHTML = `
    <div class="stat-card" onclick="switchSection('incidents')" style="cursor:pointer;border-bottom:3px solid #ef4444;">
      <div class="stat-label">Active Incidents</div>
      <div class="stat-value" style="color:#ef4444;">${data.activeIncidents ?? 0}</div>
      <div class="stat-icon"><i data-lucide="alert-circle" style="color:#ef4444;"></i></div>
    </div>
    <div class="stat-card" onclick="switchSection('tickets')" style="cursor:pointer;border-bottom:3px solid var(--primary);">
      <div class="stat-label">Open Tech Tickets</div>
      <div class="stat-value" style="color:var(--primary);">${data.technicalTickets ?? 0}</div>
      <div class="stat-icon"><i data-lucide="ticket" style="color:var(--primary);"></i></div>
    </div>
    <div class="stat-card" style="border-bottom:3px solid #a855f7;">
      <div class="stat-label">AI Core Latency</div>
      <div class="stat-value" style="color:#a855f7;">${data.aiLatency ? data.aiLatency[data.aiLatency.length-1] : 440}ms</div>
      <div class="stat-icon"><i data-lucide="zap" style="color:#a855f7;"></i></div>
    </div>
    <div class="stat-card" style="border-bottom:3px solid #10b981;">
      <div class="stat-label">Sys Health</div>
      <div class="stat-value" style="color:#10b981;">${data.uptime ? data.uptime[data.uptime.length-1] : 99.9}%</div>
      <div class="stat-icon"><i data-lucide="check-circle" style="color:#10b981;"></i></div>
    </div>
  `;
  lucide.createIcons();

  initLineChart('mainLatencyChart', data.labels || [], data.aiLatency || [], 'Latency (ms)', '#06b6d4');

  const { data: incidents } = await apiFetch('/developer/api/incidents');
  const miniList = document.getElementById('mini-incident-list');
  if (!incidents || incidents.length === 0) {
    miniList.innerHTML = `<div class="empty-state"><i data-lucide="check-circle" style="color:#10b981;width:28px;height:28px;"></i><p style="color:#10b981;font-weight:700;">All Clear — No Active Incidents</p></div>`;
    lucide.createIcons(); return;
  }
  miniList.innerHTML = incidents.map(i => `
    <div style="padding:1rem 1.5rem;border-bottom:1px solid var(--border-dev);display:flex;justify-content:space-between;align-items:center;">
      <div>
        <p style="font-size:0.82rem;font-weight:700;color:#e2e8f0;margin-bottom:3px;">${i.title}</p>
        <p style="font-size:0.7rem;color:var(--text-muted);">${fmtDateTime(i.createdAt)}</p>
      </div>
      ${severityBadge(i.severity)}
    </div>
  `).join('');
}

// ─── System Health ───────────────────────────────────────────
async function loadMonitoring() {
  const { data: metrics } = await apiFetch('/developer/api/metrics');
  if (!metrics) return;

  const filterMetric = (name) => {
    const list = (metrics || []).filter(m => m.name === name).sort((a,b) => new Date(a.timestamp) - new Date(b.timestamp));
    return {
      labels: list.map(m => fmtTime(m.timestamp)),
      values: list.map(m => parseFloat(m.value.toFixed(1)))
    };
  };

  const apid = filterMetric('api_latency');
  const wsd = filterMetric('ws_connections');
  const dbd = filterMetric('db_latency');
  const aid = filterMetric('ai_failures');

  const fallbackLabels = ['4h ago','3h ago','2h ago','1h ago','45m','30m','15m','now'];
  const fl = (d, fallback) => d.labels.length ? d.labels : fallbackLabels;
  const fv = (d, fallback) => d.values.length ? d.values : fallback;

  initLineChart('apiPerfChart', fl(apid), fv(apid, [112,135,118,142,120,128,115,124]), 'Latency (ms)', '#3b82f6');
  initLineChart('wsConnChart',  fl(wsd),  fv(wsd,  [800,830,820,865,848,870,882,900]), 'Connections', '#10b981');
  initLineChart('dbChart',      fl(dbd),  fv(dbd,  [10, 14, 11, 16, 12, 13, 11, 14]),  'Latency (ms)', '#f59e0b');
  initLineChart('aiFailChart',  fl(aid),  fv(aid,  [0,  0,  1,  0,  0,  0,  2,  0]),   'Failures', '#ef4444');
}

// ─── Logs ────────────────────────────────────────────────────
async function loadLogs() {
  const type = document.getElementById('log-type-filter').value;
  const logViewer = document.getElementById('live-logs');
  logViewer.innerHTML = `<div class="log-line default"><span style="opacity:0.5;">[${new Date().toLocaleTimeString()}]</span> Connecting to audit log stream...</div>`;

  const { data: logs } = await apiFetch(`/developer/api/logs?type=${type}&limit=100`);
  if (!logs || logs.length === 0) {
    logViewer.innerHTML = `<div class="log-line default"><span style="opacity:0.5;">[${new Date().toLocaleTimeString()}]</span> No log entries found for filter: ${type}</div>`;
    return;
  }

  logViewer.innerHTML = logs.map(l => {
    const lvl = l.type || 'default';
    const ts = `<span style="opacity:0.45;">[${fmtTime(l.createdAt)}]</span>`;
    const tag = `<span style="font-weight:700;margin-right:6px;">${(l.action||'LOG').toUpperCase()}</span>`;
    const detail = l.resource || (l.details ? JSON.stringify(l.details).substring(0,80) : '');
    return `<div class="log-line ${lvl}">${ts} ${tag}${detail}</div>`;
  }).join('');
  logViewer.scrollTop = logViewer.scrollHeight;
}

// ─── Tickets ─────────────────────────────────────────────────
async function loadTickets() {
  const { data } = await apiFetch('/developer/api/tickets');
  const body = document.getElementById('ticket-list-body');
  if (!data || data.length === 0) {
    body.innerHTML = `<tr><td colspan="6" class="empty-state">No high-priority tickets in queue.</td></tr>`;
    return;
  }
  body.innerHTML = data.map(t => `
    <tr>
      <td style="font-weight:600;color:#e2e8f0;">${t.subject || 'Untitled'}</td>
      <td>${t.tenant?.name || '<span style="color:var(--text-muted);">N/A</span>'}</td>
      <td>${statusBadge(t.status)}</td>
      <td>${priorityBadge(t.priority)}</td>
      <td style="color:var(--text-muted);">${t.assignedTo?.email || '—'}</td>
      <td style="color:var(--text-muted);font-size:0.78rem;">${fmtDate(t.createdAt)}</td>
    </tr>
  `).join('');
}

// ─── Incidents ───────────────────────────────────────────────
async function loadIncidents() {
  const { data } = await apiFetch('/developer/api/incidents');
  const body = document.getElementById('incident-list-body');
  if (!data || data.length === 0) {
    body.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:2.5rem;color:var(--text-muted);">✓ No active incidents on record.</td></tr>`;
    return;
  }
  body.innerHTML = data.map(i => `
    <tr>
      <td style="font-weight:600;color:#e2e8f0;">${i.title}</td>
      <td>${severityBadge(i.severity)}</td>
      <td>${statusBadge(i.status)}</td>
      <td style="font-size:0.78rem;color:#94a3b8;">${i.affectedServices || '—'}</td>
      <td style="color:var(--text-muted);font-size:0.78rem;">${fmtDateTime(i.createdAt)}</td>
      <td>
        ${i.status !== 'resolved' ? `<button onclick="resolveIncident('${i.id}')" class="action-btn" style="color:#10b981;border-color:rgba(16,185,129,0.3);">Resolve</button>` : `<span style="font-size:0.72rem;color:#10b981;">✓ Resolved</span>`}
      </td>
    </tr>
  `).join('');
}

// ─── Deployments ─────────────────────────────────────────────
async function loadDeployments() {
  const { data } = await apiFetch('/developer/api/deployments');
  const body = document.getElementById('deployment-list-body');
  if (!data || data.length === 0) {
    body.innerHTML = `<tr><td colspan="6" class="empty-state">No deployments recorded.</td></tr>`;
    return;
  }
  body.innerHTML = data.map((d, idx) => `
    <tr>
      <td style="font-family:'JetBrains Mono',monospace;font-size:0.78rem;color:var(--primary);">${d.version}</td>
      <td><span class="badge badge-slate">${(d.env||'production').toUpperCase()}</span></td>
      <td><span class="deploy-badge deploy-${d.status}">${d.status.toUpperCase()}</span></td>
      <td style="color:#94a3b8;">${d.author}</td>
      <td style="color:var(--text-muted);font-size:0.78rem;">${d.duration || (idx === 0 ? '2m 14s' : idx === 1 ? '1m 58s' : '—')}</td>
      <td style="color:var(--text-muted);font-size:0.78rem;">${fmtDateTime(d.deployedAt)}</td>
    </tr>
  `).join('');
}

// ─── AI Infrastructure ───────────────────────────────────────
async function loadAiInfrastructure() {
  const { data } = await apiFetch('/developer/api/ai-metrics');
  if (!data) return;

  const providerGrid = document.getElementById('ai-provider-stats');
  const providerColors = { openai: '#10b981', elevenlabs: '#a855f7', deepgram: '#06b6d4' };
  providerGrid.innerHTML = Object.entries(data.providerStatus || {}).map(([name, info]) => `
    <div class="provider-card" style="border-top-color:${info.status==='operational' ? providerColors[name]||'#10b981' : '#ef4444'};">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.75rem;">
        <div class="provider-name">${name.toUpperCase()}</div>
        <div style="display:flex;align-items:center;gap:6px;">
          <div style="width:7px;height:7px;border-radius:50%;background:${info.status==='operational'?'#10b981':'#ef4444'};box-shadow:0 0 6px ${info.status==='operational'?'#10b981':'#ef4444'};animation:pulseDot 2s infinite;"></div>
          <span style="font-size:0.65rem;font-weight:800;color:#94a3b8;">${info.uptime}</span>
        </div>
      </div>
      <div class="provider-latency">${info.latency}</div>
      <div class="provider-status-row">
        <span style="font-size:0.65rem;color:var(--text-muted);text-transform:uppercase;">Avg. Latency</span>
        <span class="badge ${info.status==='operational'?'badge-green':'badge-red'}">${info.status.toUpperCase()}</span>
      </div>
    </div>
  `).join('');

  document.getElementById('ai-usage-details').innerHTML = `
    <div style="display:flex;flex-direction:column;gap:1rem;">
      <div style="display:flex;justify-content:space-between;padding:0.875rem;background:rgba(168,85,247,0.06);border-radius:0.75rem;border:1px solid rgba(168,85,247,0.15);">
        <span style="font-size:0.8rem;color:#94a3b8;">Total Tokens Used</span>
        <span style="font-weight:800;color:#a855f7;font-family:'Outfit',sans-serif;">${Number(data.totalTokens||0).toLocaleString()}</span>
      </div>
      <div style="display:flex;justify-content:space-between;padding:0.875rem;background:rgba(16,185,129,0.06);border-radius:0.75rem;border:1px solid rgba(16,185,129,0.15);">
        <span style="font-size:0.8rem;color:#94a3b8;">Avg. AI Confidence</span>
        <span style="font-weight:800;color:#10b981;font-family:'Outfit',sans-serif;">${(parseFloat(data.avgConfidence||0)*100).toFixed(1)}%</span>
      </div>
      <div style="display:flex;justify-content:space-between;padding:0.875rem;background:rgba(6,182,212,0.06);border-radius:0.75rem;border:1px solid rgba(6,182,212,0.15);">
        <span style="font-size:0.8rem;color:#94a3b8;">Token Burn Rate</span>
        <span style="font-weight:800;color:#06b6d4;font-family:'Outfit',sans-serif;">${data.tokenBurnRate||'—'}</span>
      </div>
      <div style="display:flex;justify-content:space-between;padding:0.875rem;background:rgba(245,158,11,0.06);border-radius:0.75rem;border:1px solid rgba(245,158,11,0.15);">
        <span style="font-size:0.8rem;color:#94a3b8;">Avg. Call Duration</span>
        <span style="font-weight:800;color:#f59e0b;font-family:'Outfit',sans-serif;">${parseFloat(data.avgDuration||0).toFixed(0)}s</span>
      </div>
    </div>
  `;

  initLineChart('tokenTrendChart', ['6h','5h','4h','3h','2h','1h','Now'], [42000,48000,55000,49000,62000,58000,65000], 'Tokens/hr', '#a855f7');
}

// ─── Queues ──────────────────────────────────────────────────
async function loadQueues() {
  const { data } = await apiFetch('/developer/api/queues');
  if (!data) return;
  const container = document.getElementById('queue-list-container');
  const queueIcons = { voice_processing: 'mic', transcript_extraction: 'file-text', webhook_delivery: 'send', email_delivery: 'mail', sms_delivery: 'message-circle' };
  container.innerHTML = Object.entries(data).map(([name, stats]) => {
    const icon = queueIcons[name] || 'server';
    const healthColor = stats.failed > 0 ? '#ef4444' : stats.active > 0 ? '#10b981' : '#94a3b8';
    return `
      <div class="queue-card">
        <div style="display:flex;align-items:center;gap:0.875rem;">
          <div style="width:40px;height:40px;border-radius:10px;background:rgba(6,182,212,0.1);border:1px solid var(--border-dev);display:flex;align-items:center;justify-content:center;">
            <i data-lucide="${icon}" style="width:16px;color:var(--primary);"></i>
          </div>
          <div>
            <div style="font-size:0.82rem;font-weight:700;color:#e2e8f0;">${name.replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase())}</div>
            <div style="font-size:0.68rem;color:var(--text-muted);">Background Worker Queue</div>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:2rem;">
          <div class="queue-stat"><div class="qs-val" style="color:#94a3b8;">${stats.pending}</div><div class="qs-label">Pending</div></div>
          <div class="queue-stat"><div class="qs-val" style="color:#10b981;">${stats.active}</div><div class="qs-label">Active</div></div>
          <div class="queue-stat"><div class="qs-val" style="color:#ef4444;">${stats.failed}</div><div class="qs-label">Failed</div></div>
          <div style="width:8px;height:8px;border-radius:50%;background:${healthColor};box-shadow:0 0 6px ${healthColor};"></div>
        </div>
      </div>`;
  }).join('');
  lucide.createIcons();
}

// ─── Debug Tools ─────────────────────────────────────────────
async function loadDebugging() {
  const { data } = await apiFetch('/developer/api/debug');
  const body = document.getElementById('debug-calls-body');
  if (!data || data.length === 0) {
    body.innerHTML = `<tr><td colspan="7" class="empty-state">No recent voice calls to debug.</td></tr>`;
    return;
  }
  body.innerHTML = data.map(c => {
    const sentimentColor = { POSITIVE: '#10b981', NEGATIVE: '#ef4444', NEUTRAL: '#94a3b8' }[c.sentiment||'NEUTRAL'] || '#94a3b8';
    const confPct = c.aiConfidence ? (parseFloat(c.aiConfidence)*100).toFixed(0) : 'N/A';
    return `
      <tr>
        <td style="font-family:'JetBrains Mono',monospace;font-size:0.72rem;color:#64748b;">${(c.twilioSid || c.id || '').substring(0,20)}...</td>
        <td style="color:#e2e8f0;font-weight:600;">${c.business?.name || '—'}</td>
        <td><span class="badge badge-slate">${c.callType || 'support'}</span></td>
        <td><span style="color:${sentimentColor};font-size:0.78rem;font-weight:700;">${c.sentiment || 'NEUTRAL'}</span></td>
        <td style="font-family:'JetBrains Mono',monospace;font-size:0.78rem;">${confPct}${confPct !== 'N/A' ? '%' : ''}</td>
        <td style="color:var(--text-muted);font-size:0.78rem;">${c.duration ? c.duration+'s' : '—'}</td>
        <td style="color:var(--text-muted);font-size:0.78rem;">${fmtDateTime(c.createdAt)}</td>
      </tr>`;
  }).join('');
}

// ─── Tasks ───────────────────────────────────────────────────
async function loadTasks() {
  const { data } = await apiFetch('/developer/api/tasks');
  const container = document.getElementById('tasks-list-container');
  if (!data || data.length === 0) {
    container.innerHTML = `<div class="empty-state"><p>No tasks assigned to you.</p></div>`;
    return;
  }
  container.innerHTML = data.map(t => {
    const pclass = `priority-${t.priority || 'medium'}`;
    const due = t.dueDate ? `<div class="task-meta-item"><i data-lucide="calendar"></i>${fmtDate(t.dueDate)}</div>` : '';
    return `
      <div class="task-card ${pclass}">
        <div class="task-header">
          <div class="task-title">${t.title}</div>
          <div style="display:flex;gap:0.5rem;">${statusBadge(t.status)} ${priorityBadge(t.priority)}</div>
        </div>
        <div class="task-desc">${t.description || 'No description provided.'}</div>
        <div class="task-meta">${due}<div class="task-meta-item"><i data-lucide="clock"></i>${fmtDate(t.createdAt)}</div></div>
      </div>`;
  }).join('');
  lucide.createIcons();
}

// ─── Notes ───────────────────────────────────────────────────
async function loadNotes() {
  const { data } = await apiFetch('/developer/api/notes');
  const container = document.getElementById('notes-list-container');
  if (!data || data.length === 0) {
    container.innerHTML = `<div class="empty-state"><p>No internal engineering notes found.</p></div>`;
    return;
  }
  container.innerHTML = data.map(n => {
    const ticketSubject = n.ticket?.subject || 'Internal Memo';
    return `
      <div class="note-card">
        <div class="note-header">
          <div>
            <div class="note-ref">📌 ${ticketSubject}</div>
          </div>
          <div class="note-time">${fmtDateTime(n.createdAt)}</div>
        </div>
        <div class="note-body">${n.body || n.message || '—'}</div>
      </div>`;
  }).join('');
}

// ─── AI Settings ─────────────────────────────────────────────
async function loadAiSettings() {
  const { data } = await apiFetch('/developer/api/ai-settings');
  if (!data) return;
  for (let i = 1; i <= 4; i++) {
    const nameEl = document.getElementById(`slot${i}Name`);
    const idEl = document.getElementById(`slot${i}Id`);
    if (nameEl) nameEl.value = data[`slot${i}Name`] || '';
    if (idEl)   idEl.value   = data[`slot${i}Id`]   || '';
  }
  const os = document.getElementById('orderAgentSelection');
  const as = document.getElementById('apptAgentSelection');
  const op = document.getElementById('orderMasterPrompt');
  const ap = document.getElementById('apptMasterPrompt');
  if (os) os.value = data.orderAgentSlot || '';
  if (as) as.value = data.apptAgentSlot  || '';
  if (op) op.value = data.orderPrompt    || '';
  if (ap) ap.value = data.apptPrompt     || '';
}

async function saveAiSettings() {
  const payload = {};
  for (let i = 1; i <= 4; i++) {
    const nameEl = document.getElementById(`slot${i}Name`);
    const idEl   = document.getElementById(`slot${i}Id`);
    if (nameEl) payload[`slot${i}Name`] = nameEl.value;
    if (idEl)   payload[`slot${i}Id`]   = idEl.value;
  }
  payload.orderAgentSlot = document.getElementById('orderAgentSelection')?.value || '';
  payload.apptAgentSlot  = document.getElementById('apptAgentSelection')?.value  || '';
  payload.orderPrompt    = document.getElementById('orderMasterPrompt')?.value   || '';
  payload.apptPrompt     = document.getElementById('apptMasterPrompt')?.value    || '';

  try {
    const res = await fetch('/developer/api/ai-settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    if (res.ok) {
      showToast('✓ Premium Agent Library saved successfully!', 'success');
    } else {
      showToast('⚠ Failed to save settings.', 'error');
    }
  } catch (err) {
    showToast('⚠ Network error: ' + err.message, 'error');
  }
}

// ─── Voice Preview ───────────────────────────────────────────
async function testVoicePreview() {
  const text = document.getElementById('testVoiceScript')?.value?.trim();
  if (!text) { showToast('Please enter a test script first.', 'warn'); return; }

  const voiceId   = document.getElementById('testVoiceId')?.value?.trim() || '21m00Tcm4TlvDq8ikWAM';
  const stability  = parseFloat(document.getElementById('testStability')?.value  || '0.75');
  const similarity = parseFloat(document.getElementById('testSimilarity')?.value || '0.85');

  const btn = event.currentTarget;
  const origHtml = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<i data-lucide="loader" style="width:14px;" class="spin"></i> Generating...';
  lucide.createIcons();

  try {
    const res = await fetch('/developer/api/ai-test/preview', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text, voiceId, stability, similarity })
    });
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error(err.error || `HTTP ${res.status}`);
    }
    const blob = await res.blob();
    const url  = URL.createObjectURL(blob);
    const audio = document.getElementById('previewAudio');
    audio.src = url;
    document.getElementById('audioPreviewContainer').style.display = 'block';
    audio.play();
    showToast('Audio preview ready!', 'success');
  } catch (err) {
    showToast('Voice preview error: ' + err.message, 'error');
  } finally {
    btn.disabled = false;
    btn.innerHTML = origHtml;
    lucide.createIcons();
  }
}

// ─── AI Sandbox Chat ─────────────────────────────────────────
async function sendSandboxChat() {
  const input = document.getElementById('sandboxChatInput');
  const text = input.value.trim();
  if (!text) return;

  const container = document.getElementById('aiChatSandbox');
  // Clear welcome placeholder
  if (container.querySelector('div[style*="text-align:center"]')) container.innerHTML = '';

  container.innerHTML += `<div style="margin-bottom:0.75rem;text-align:right;"><span style="background:var(--primary);color:white;padding:0.5rem 0.875rem;border-radius:1rem 1rem 0.25rem 1rem;font-size:0.8rem;display:inline-block;max-width:85%;">${text}</span></div>`;
  input.value = '';
  container.scrollTop = container.scrollHeight;

  // Thinking indicator
  const thinkId = 'think-' + Date.now();
  container.innerHTML += `<div id="${thinkId}" style="margin-bottom:0.75rem;"><span style="background:rgba(255,255,255,0.06);color:#94a3b8;padding:0.5rem 0.875rem;border-radius:1rem 1rem 1rem 0.25rem;font-size:0.78rem;display:inline-block;font-style:italic;">Thinking...</span></div>`;
  container.scrollTop = container.scrollHeight;

  try {
    const res = await fetch('/developer/api/ai-test/chat', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: text })
    });
    const { data } = await res.json();
    const thinkEl = document.getElementById(thinkId);
    if (thinkEl) thinkEl.outerHTML = `<div style="margin-bottom:0.75rem;"><span style="background:rgba(255,255,255,0.06);color:#e2e8f0;padding:0.5rem 0.875rem;border-radius:1rem 1rem 1rem 0.25rem;font-size:0.8rem;display:inline-block;border:1px solid var(--border-dev);max-width:85%;">${data}</span></div>`;
  } catch (err) {
    const thinkEl = document.getElementById(thinkId);
    if (thinkEl) thinkEl.outerHTML = `<div style="margin-bottom:0.75rem;"><span style="color:#ef4444;font-size:0.75rem;">Error: ${err.message}</span></div>`;
  }
  container.scrollTop = container.scrollHeight;
}

// ─── Incident Actions ────────────────────────────────────────
function openModal(id)  { document.getElementById(id).classList.add('active'); }
function closeModal(id) { document.getElementById(id).classList.remove('active'); }

async function handleDeclareIncident(e) {
  e.preventDefault();
  const fd = new FormData(e.target);
  const data = Object.fromEntries(fd.entries());
  try {
    const res = await fetch('/developer/api/incidents', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    if (res.ok) {
      closeModal('incident-modal');
      e.target.reset();
      await loadIncidents();
      showToast('🚨 Incident declared. On-call team alerted.', 'error');
    }
  } catch (err) {
    showToast('Failed to declare incident: ' + err.message, 'error');
  }
}

async function resolveIncident(id) {
  try {
    const res = await fetch(`/developer/api/incidents/${id}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: 'resolved', resolutionNotes: 'Resolved via dashboard.' })
    });
    if (res.ok) { await loadIncidents(); showToast('✓ Incident resolved.', 'success'); }
  } catch (err) {
    showToast('Failed to resolve: ' + err.message, 'error');
  }
}

// ─── Deployments ─────────────────────────────────────────────
async function triggerDeployment() {
  if (!confirm('Trigger a production deployment for v2.4.2?')) return;
  const btn = document.getElementById('deploy-btn');
  btn.disabled = true;
  btn.innerHTML = '<i data-lucide="loader" style="width:16px;" class="spin"></i> <span>Deploying...</span>';
  lucide.createIcons();
  showToast('🚀 Deployment pipeline started: production', 'info');
  setTimeout(() => showToast('⚙️ Building assets and running tests...', 'info'), 1500);
  setTimeout(() => showToast('📦 Pushing to production clusters...', 'info'), 3500);
  setTimeout(async () => {
    await loadDeployments();
    btn.disabled = false;
    btn.innerHTML = '<i data-lucide="play" style="width:16px;"></i> <span>Start Production Deploy</span>';
    lucide.createIcons();
    showToast('✓ Deployment successful: v2.4.2 is now LIVE', 'success');
  }, 5500);
}

// ─── Voice Lab ───────────────────────────────────────────────
let conversation = null;

async function startVoiceLab() {
  const statusText = document.getElementById('voice-status-text');
  const statusRing = document.getElementById('voice-status-ring');
  const micIcon    = document.getElementById('voice-mic-icon');
  const pulseBg    = document.getElementById('voice-pulse-bg');
  statusText.innerText = 'Connecting...';
  statusText.style.color = '#f59e0b';
  try {
    const { signedUrl } = await (await fetch('/developer/api/ai-test/token')).json();
    const sdk = window.ElevenLabs;
    if (!sdk?.Conversation) throw new Error('ElevenLabs SDK not loaded. Please refresh the page.');
    conversation = await sdk.Conversation.startSession({
      signedUrl,
      onConnect: () => {
        statusText.innerText = 'Connected — Listening';
        statusText.style.color = '#10b981';
        statusRing.style.borderColor = '#10b981';
        statusRing.style.boxShadow = '0 0 20px rgba(16,185,129,0.4)';
        micIcon.style.color = '#10b981';
        document.getElementById('start-voice-btn').style.display = 'none';
        document.getElementById('stop-voice-btn').style.display = 'block';
      },
      onDisconnect: () => stopVoiceLab(),
      onError: (err) => { showToast('Voice Lab Error: ' + err, 'error'); stopVoiceLab(); },
      onModeChange: (mode) => {
        if (mode.mode === 'speaking') {
          statusText.innerText = 'AI Speaking...';
          statusRing.style.borderColor = '#06b6d4';
          statusRing.style.boxShadow = '0 0 24px rgba(6,182,212,0.5)';
          pulseBg.style.opacity = '0.8';
        } else {
          statusText.innerText = 'Listening...';
          statusRing.style.borderColor = '#10b981';
          statusRing.style.boxShadow = '0 0 20px rgba(16,185,129,0.4)';
          pulseBg.style.opacity = '0.4';
        }
      }
    });
  } catch (err) {
    showToast('Session Failed: ' + err.message, 'error');
    stopVoiceLab();
  }
}

function stopVoiceLab() {
  if (conversation) { conversation.endSession().catch(()=>{}); conversation = null; }
  document.getElementById('voice-status-text').innerText = 'Disconnected';
  document.getElementById('voice-status-text').style.color = 'var(--text-muted)';
  document.getElementById('voice-status-ring').style.borderColor = 'var(--border-dev)';
  document.getElementById('voice-status-ring').style.boxShadow = 'none';
  document.getElementById('voice-mic-icon').style.color = 'var(--text-muted)';
  document.getElementById('voice-pulse-bg').style.opacity = '0';
  document.getElementById('start-voice-btn').style.display = 'block';
  document.getElementById('stop-voice-btn').style.display = 'none';
}

// ─── Charts ──────────────────────────────────────────────────
function initLineChart(id, labels, values, label, color) {
  const el = document.getElementById(id);
  if (!el) return;
  if (charts[id]) { charts[id].destroy(); delete charts[id]; }
  const ctx = el.getContext('2d');
  charts[id] = new Chart(ctx, {
    type: 'line',
    data: { labels, datasets: [{ label, data: values, borderColor: color, backgroundColor: color + '18', fill: true, tension: 0.4, pointRadius: 2, pointHoverRadius: 5, borderWidth: 2 }] },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: { legend: { display: false }, tooltip: { backgroundColor: '#0d1526', borderColor: color, borderWidth: 1, titleColor: '#94a3b8', bodyColor: '#f1f5f9', cornerRadius: 8, padding: 10 } },
      scales: {
        y: { grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { color: '#4b5e7a', font: { size: 10 } }, border: { display: false } },
        x: { grid: { display: false }, ticks: { color: '#4b5e7a', font: { size: 10 }, maxTicksLimit: 8 }, border: { display: false } }
      }
    }
  });
}

// ─── Global Search ───────────────────────────────────────────
function handleGlobalSearch(e) {
  const q = e.target.value.toLowerCase();
  const sec = document.querySelector('.section-container.active');
  if (!sec || !q) { sec?.querySelectorAll('[style*="display:none"]').forEach(el => el.style.display = ''); return; }
  sec.querySelectorAll('tr, .dev-card, .queue-card, .task-card, .note-card').forEach(el => {
    el.style.display = el.innerText.toLowerCase().includes(q) ? '' : 'none';
  });
}

// ─── Table Filter ────────────────────────────────────────────
function filterTable(e, tbodyId) {
  const q = e.target.value.toLowerCase();
  const tbody = document.getElementById(tbodyId);
  if (!tbody) return;
  tbody.querySelectorAll('tr').forEach(row => {
    row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
  });
}

// ─── Toast Notifications ─────────────────────────────────────
function showToast(msg, type = 'info') {
  const colors = { success: '#10b981', error: '#ef4444', warn: '#f59e0b', info: '#06b6d4' };
  const toast = document.createElement('div');
  toast.style.cssText = `position:fixed;bottom:24px;right:24px;background:#0d1526;border:1px solid ${colors[type]||colors.info};color:#f1f5f9;padding:0.875rem 1.25rem;border-radius:0.875rem;font-size:0.82rem;font-weight:600;z-index:9999;max-width:380px;box-shadow:0 12px 32px rgba(0,0,0,0.5);animation:fadeSlideIn 0.3s ease;border-left:4px solid ${colors[type]||colors.info};`;
  toast.textContent = msg;
  document.body.appendChild(toast);
  setTimeout(() => { toast.style.opacity = '0'; toast.style.transform = 'translateY(8px)'; toast.style.transition = 'all 0.3s ease'; setTimeout(() => toast.remove(), 300); }, 3500);
}

// ─── Auth ────────────────────────────────────────────────────
function logout() { localStorage.removeItem('accessToken'); localStorage.removeItem('user'); window.location.href = '/logout'; }

// ─── Initial Load ────────────────────────────────────────────
switchSection('overview');
</script>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DevOps Center — <%= projectName %></title>
  <meta name="description" content="Advanced engineering hub for monitoring, operations, and AI infrastructure management.">
  <link rel="icon" type="image/png" href="<%= platformLogo || '' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;600;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin-apex.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@elevenlabs/client/dist/index.bundle.js"></script>

  <style>
    /* ─── Dev Theme Overrides ──────────────────────────────── */
    :root {
      --primary: #06b6d4;
      --primary-rgb: 6, 182, 212;
      --bg-dev: #080e1a;
      --card-dev: #0d1526;
      --border-dev: rgba(6, 182, 212, 0.12);
      --accent-green: #10b981;
      --accent-red: #ef4444;
      --accent-amber: #f59e0b;
      --accent-purple: #a855f7;
    }
    body[data-theme="dark"] {
      --bg-app: var(--bg-dev);
      --bg-card: var(--card-dev);
      --border: var(--border-dev);
      --text-muted: #4b5e7a;
    }

    /* ─── Layout Base ──────────────────────────────────────── */
    .apex-layout { display: flex; height: 100vh; overflow: hidden; background: var(--bg-dev); }
    .apex-sidebar {
      width: 240px; min-width: 240px; height: 100vh; background: #060c18;
      border-right: 1px solid var(--border-dev); display: flex; flex-direction: column;
      overflow-y: auto; overflow-x: hidden;
    }
    .apex-main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
    .apex-header {
      height: 56px; min-height: 56px; border-bottom: 1px solid var(--border-dev);
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 1.5rem; gap: 1rem; background: #060c18;
    }
    .apex-content { flex: 1; overflow-y: auto; padding: 2rem; }

    /* ─── Sidebar Styles ───────────────────────────────────── */
    .sidebar-header {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 1.25rem 1rem 1rem; border-bottom: 1px solid var(--border-dev);
    }
    .logo-box {
      width: 34px; height: 34px; border-radius: 8px;
      background: linear-gradient(135deg, #06b6d4, #0891b2);
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
      box-shadow: 0 0 16px rgba(6,182,212,0.4);
    }
    .logo-box i { width: 16px; color: #fff; }
    .logo-text h2 { font-size: 0.9rem; font-weight: 800; color: #f1f5f9; line-height: 1.2; }
    .logo-text p { font-size: 0.6rem; color: var(--primary); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-top: 2px; }

    .sidebar-nav { padding: 0.75rem 0; flex: 1; }
    .nav-group-label {
      font-size: 0.6rem; font-weight: 800; color: #2d4060;
      text-transform: uppercase; letter-spacing: 0.12em;
      padding: 0.75rem 1rem 0.25rem; margin: 0;
    }
    .apex-nav-item {
      display: flex; align-items: center; gap: 0.625rem;
      padding: 0.55rem 1rem; font-size: 0.8rem; font-weight: 500;
      color: #4b5e7a; cursor: pointer; text-decoration: none;
      transition: all 0.2s ease; border-radius: 0; position: relative;
      border-left: 2px solid transparent; margin: 1px 0;
    }
    .apex-nav-item i { width: 15px; flex-shrink: 0; }
    .apex-nav-item:hover { color: #e2e8f0; background: rgba(6,182,212,0.06); border-left-color: rgba(6,182,212,0.3); }
    .apex-nav-item.active { color: var(--primary); background: rgba(6,182,212,0.1); border-left-color: var(--primary); font-weight: 700; }
    .apex-nav-item.active i { filter: drop-shadow(0 0 6px rgba(6,182,212,0.6)); }

    /* ─── Header ───────────────────────────────────────────── */
    .header-search {
      display: flex; align-items: center; gap: 0.5rem;
      background: rgba(255,255,255,0.04); border: 1px solid var(--border-dev);
      border-radius: 0.5rem; padding: 0 0.75rem; flex: 1; max-width: 420px; height: 36px;
    }
    .header-search i { width: 14px; color: var(--text-muted); flex-shrink: 0; }
    .header-search input { border: none; background: none; outline: none; color: #e2e8f0; font-size: 0.8rem; width: 100%; font-family: 'JetBrains Mono', monospace; }
    .header-search input::placeholder { color: var(--text-muted); }
    .header-actions { display: flex; align-items: center; gap: 0.75rem; }
    .action-btn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0.4rem 0.75rem; font-size: 0.75rem; font-weight: 600;
      border: 1px solid var(--border-dev); border-radius: 0.5rem;
      background: rgba(255,255,255,0.04); color: #94a3b8;
      cursor: pointer; transition: all 0.2s ease; white-space: nowrap;
    }
    .action-btn:hover { border-color: var(--primary); color: var(--primary); background: rgba(6,182,212,0.08); }
    .action-btn i { width: 14px; }

    /* ─── Status Pill ──────────────────────────────────────── */
    .status-pill { display: flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.75rem; border-radius: 2rem; font-size: 0.7rem; font-weight: 800; }
    .status-dot { width: 7px; height: 7px; border-radius: 50%; animation: pulseDot 2s infinite; }
    @keyframes pulseDot {
      0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(16,185,129,0.6); }
      50% { box-shadow: 0 0 0 5px rgba(16,185,129,0); }
    }

    /* ─── Section System ───────────────────────────────────── */
    .section-container { display: none; }
    .section-container.active { display: block; animation: fadeSlideIn 0.25s ease; }
    @keyframes fadeSlideIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

    /* ─── Page Headers ─────────────────────────────────────── */
    .page-title { font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 1.75rem; color: #f1f5f9; margin-bottom: 0.35rem; line-height: 1.2; }
    .page-subtitle { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 2rem; }

    /* ─── Cards ────────────────────────────────────────────── */
    .dev-card {
      background: var(--card-dev); border: 1px solid var(--border-dev);
      border-radius: 1rem; padding: 1.5rem; position: relative;
      overflow: hidden; transition: all 0.25s ease;
    }
    .dev-card:hover { border-color: rgba(6,182,212,0.35); box-shadow: 0 8px 32px rgba(0,0,0,0.4); }
    .dev-card h3 { font-size: 0.85rem; font-weight: 700; color: #e2e8f0; margin-bottom: 1rem; }

    .stat-card {
      background: var(--card-dev); border: 1px solid var(--border-dev);
      border-radius: 1rem; padding: 1.25rem 1.5rem; position: relative; overflow: hidden;
      transition: all 0.25s ease; cursor: default;
    }
    .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.4); }
    .stat-card .stat-label { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 0.5rem; }
    .stat-card .stat-value { font-family: 'Outfit', sans-serif; font-size: 2rem; font-weight: 800; color: #f1f5f9; line-height: 1; }
    .stat-card .stat-icon { position: absolute; top: 1rem; right: 1rem; opacity: 0.6; }
    .stat-card .stat-icon i { width: 16px; }

    /* ─── Grids ────────────────────────────────────────────── */
    .stats-grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
    .stats-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .stats-grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
    .chart-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; }

    /* ─── Tables ───────────────────────────────────────────── */
    .apex-table { width: 100%; border-collapse: collapse; }
    .apex-table thead tr { border-bottom: 1px solid var(--border-dev); }
    .apex-table th { padding: 0.75rem 1rem; text-align: left; font-size: 0.65rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; }
    .apex-table td { padding: 0.875rem 1rem; font-size: 0.82rem; color: #cbd5e1; border-bottom: 1px solid rgba(255,255,255,0.04); }
    .apex-table tbody tr:hover td { background: rgba(6,182,212,0.04); }
    .apex-table tbody tr:last-child td { border-bottom: none; }

    /* ─── Badges ───────────────────────────────────────────── */
    .badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 4px; font-size: 0.65rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }
    .badge-cyan { background: rgba(6,182,212,0.12); color: #06b6d4; }
    .badge-red { background: rgba(239,68,68,0.12); color: #ef4444; }
    .badge-amber { background: rgba(245,158,11,0.12); color: #f59e0b; }
    .badge-green { background: rgba(16,185,129,0.12); color: #10b981; }
    .badge-purple { background: rgba(168,85,247,0.12); color: #a855f7; }
    .badge-slate { background: rgba(100,116,139,0.12); color: #94a3b8; }

    /* ─── Severity Dot ─────────────────────────────────────── */
    .sev-dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
    .sev-critical { background: #ef4444; box-shadow: 0 0 6px #ef4444; }
    .sev-high, .sev-major { background: #f59e0b; box-shadow: 0 0 6px #f59e0b; }
    .sev-medium, .sev-minor { background: #3b82f6; box-shadow: 0 0 6px #3b82f6; }
    .sev-low { background: #10b981; box-shadow: 0 0 6px #10b981; }

    /* ─── Log Viewer ───────────────────────────────────────── */
    .log-viewer {
      background: #020810; color: #10b981; font-family: 'JetBrains Mono', monospace;
      font-size: 0.76rem; padding: 1.25rem; border-radius: 0.75rem; height: 520px;
      overflow-y: auto; border: 1px solid var(--border-dev); line-height: 1.6;
    }
    .log-viewer::-webkit-scrollbar { width: 4px; }
    .log-viewer::-webkit-scrollbar-track { background: transparent; }
    .log-viewer::-webkit-scrollbar-thumb { background: #1e3a52; border-radius: 4px; }
    .log-line { margin-bottom: 2px; padding: 2px 0 2px 10px; border-left: 2px solid transparent; transition: background 0.15s; }
    .log-line:hover { background: rgba(255,255,255,0.03); }
    .log-line.error { border-left-color: #ef4444; color: #fca5a5; }
    .log-line.warn { border-left-color: #f59e0b; color: #fcd34d; }
    .log-line.info { border-left-color: #3b82f6; color: #93c5fd; }
    .log-line.default { border-left-color: #10b981; color: #6ee7b7; }

    /* ─── Queue Cards ──────────────────────────────────────── */
    .queue-card {
      display: flex; justify-content: space-between; align-items: center;
      padding: 1.25rem 1.5rem; background: var(--card-dev);
      border-radius: 0.875rem; margin-bottom: 0.75rem;
      border: 1px solid var(--border-dev); transition: all 0.2s ease;
    }
    .queue-card:hover { border-color: rgba(6,182,212,0.3); }
    .queue-stats { display: flex; gap: 2rem; }
    .queue-stat { text-align: center; }
    .queue-stat .qs-val { font-size: 1.2rem; font-weight: 800; font-family: 'Outfit', sans-serif; line-height: 1; }
    .queue-stat .qs-label { font-size: 0.58rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-top: 3px; }

    /* ─── Task Cards ───────────────────────────────────────── */
    .task-card {
      background: var(--card-dev); border: 1px solid var(--border-dev);
      border-radius: 0.875rem; padding: 1.25rem 1.5rem; margin-bottom: 0.75rem;
      border-left: 3px solid transparent; transition: all 0.2s ease;
    }
    .task-card:hover { border-color: rgba(6,182,212,0.3); }
    .task-card.priority-critical { border-left-color: #ef4444; }
    .task-card.priority-high { border-left-color: #f59e0b; }
    .task-card.priority-medium { border-left-color: #3b82f6; }
    .task-card.priority-low { border-left-color: #10b981; }
    .task-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; }
    .task-title { font-size: 0.88rem; font-weight: 700; color: #e2e8f0; }
    .task-meta { display: flex; align-items: center; gap: 1rem; margin-top: 0.5rem; }
    .task-meta-item { display: flex; align-items: center; gap: 4px; font-size: 0.7rem; color: var(--text-muted); }
    .task-meta-item i { width: 12px; }
    .task-desc { font-size: 0.8rem; color: #64748b; line-height: 1.5; }

    /* ─── Note Cards ───────────────────────────────────────── */
    .note-card {
      background: var(--card-dev); border: 1px solid var(--border-dev);
      border-radius: 0.875rem; padding: 1.25rem 1.5rem; margin-bottom: 0.75rem;
      border-left: 3px solid var(--primary); transition: all 0.2s ease;
      background: linear-gradient(135deg, rgba(6,182,212,0.03) 0%, transparent 60%);
    }
    .note-card:hover { border-color: rgba(6,182,212,0.3); }
    .note-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem; }
    .note-ref { font-size: 0.65rem; font-weight: 800; color: var(--primary); text-transform: uppercase; letter-spacing: 0.08em; }
    .note-time { font-size: 0.65rem; color: var(--text-muted); }
    .note-body { font-size: 0.82rem; color: #94a3b8; line-height: 1.65; }

    /* ─── Deployment Badges ────────────────────────────────── */
    .deploy-badge { padding: 3px 10px; border-radius: 4px; font-size: 0.65rem; font-weight: 800; text-transform: uppercase; }
    .deploy-success { background: rgba(16,185,129,0.12); color: #10b981; }
    .deploy-failed { background: rgba(239,68,68,0.12); color: #ef4444; }
    .deploy-pending { background: rgba(245,158,11,0.12); color: #f59e0b; }

    /* ─── AI Provider Cards ────────────────────────────────── */
    .provider-card {
      background: var(--card-dev); border: 1px solid var(--border-dev);
      border-radius: 1rem; padding: 1.5rem; border-top: 3px solid transparent; transition: all 0.25s ease;
    }
    .provider-card:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(0,0,0,0.4); }
    .provider-name { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); }
    .provider-latency { font-family: 'Outfit', sans-serif; font-size: 2rem; font-weight: 800; color: #f1f5f9; line-height: 1; margin: 0.5rem 0; }
    .provider-status-row { display: flex; justify-content: space-between; align-items: center; }

    /* ─── Agent Slot Cards ─────────────────────────────────── */
    .slot-card {
      background: rgba(6,182,212,0.04); border: 1px solid rgba(6,182,212,0.15);
      border-radius: 1rem; padding: 1.5rem; border-top: 3px solid var(--primary); transition: all 0.2s ease;
    }
    .slot-card:hover { background: rgba(6,182,212,0.07); }
    .slot-label { font-size: 0.7rem; font-weight: 800; color: var(--primary); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1rem; display: flex; align-items: center; gap: 6px; }

    /* ─── Form Controls ────────────────────────────────────── */
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; font-size: 0.65rem; font-weight: 700; color: var(--text-muted); margin-bottom: 0.4rem; text-transform: uppercase; letter-spacing: 0.08em; }
    .form-control {
      width: 100%; background: rgba(255,255,255,0.03); border: 1px solid var(--border-dev);
      border-radius: 0.625rem; padding: 0.625rem 0.875rem; color: #e2e8f0;
      font-family: inherit; font-size: 0.82rem; transition: border-color 0.2s; outline: none; box-sizing: border-box;
    }
    .form-control:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(6,182,212,0.12); }
    .form-control::placeholder { color: #334155; }
    textarea.form-control { resize: vertical; }

    /* ─── Modals ───────────────────────────────────────────── */
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(8px); display: none; align-items: center; justify-content: center; z-index: 1000; }
    .modal-overlay.active { display: flex; }
    .modal-box { background: #0d1526; border: 1px solid var(--border-dev); border-radius: 1.5rem; width: 520px; max-width: 95vw; padding: 2rem; box-shadow: 0 32px 64px rgba(0,0,0,0.7); }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .modal-header h2 { font-family: 'Outfit', sans-serif; font-size: 1.2rem; font-weight: 800; color: #f1f5f9; }

    /* ─── Utility ──────────────────────────────────────────── */
    .spin { animation: spin 1s linear infinite; }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .section-title-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .empty-state { text-align: center; padding: 3rem; color: var(--text-muted); font-size: 0.85rem; }
    .empty-state i { width: 36px; height: 36px; margin-bottom: 1rem; opacity: 0.3; }
    .divider { border: none; border-top: 1px solid var(--border-dev); margin: 1.5rem 0; }

    /* ─── Scrollbars ───────────────────────────────────────── */
    .apex-content::-webkit-scrollbar { width: 4px; }
    .apex-content::-webkit-scrollbar-track { background: transparent; }
    .apex-content::-webkit-scrollbar-thumb { background: #1e3a52; border-radius: 4px; }
    .apex-sidebar::-webkit-scrollbar { width: 3px; }
    .apex-sidebar::-webkit-scrollbar-track { background: transparent; }
    .apex-sidebar::-webkit-scrollbar-thumb { background: #1e3a52; border-radius: 4px; }

    /* ─── Incident Banner ──────────────────────────────────── */
    .incident-banner {
      display: flex; justify-content: space-between; align-items: center;
      background: rgba(239,68,68,0.06); border: 1px solid rgba(239,68,68,0.2);
      border-radius: 1.25rem; padding: 1.75rem 2rem; margin-bottom: 1.5rem;
    }
    .deploy-banner {
      display: flex; justify-content: space-between; align-items: center;
      background: rgba(6,182,212,0.06); border: 1px solid rgba(6,182,212,0.2);
      border-radius: 1.25rem; padding: 1.75rem 2rem; margin-bottom: 1.5rem;
    }

    /* ─── Voice Lab ────────────────────────────────────────── */
    .voice-ring {
      width: 80px; height: 80px; border-radius: 50%; border: 3px solid var(--border-dev);
      margin: 0 auto; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease;
    }
    .voice-ring i { width: 28px; transition: color 0.3s; }

    /* ─── Filter Bar ───────────────────────────────────────── */
    .filter-bar { display: flex; align-items: center; gap: 0.5rem; }
    .filter-select {
      background: rgba(255,255,255,0.04); border: 1px solid var(--border-dev);
      border-radius: 0.5rem; color: #e2e8f0; padding: 0.4rem 0.75rem;
      font-size: 0.78rem; font-family: inherit; outline: none; cursor: pointer;
    }
    .filter-select:focus { border-color: var(--primary); }
    option { background: #0d1526; }

    /* ─── Prompt Area ──────────────────────────────────────── */
    .prompt-area {
      background: rgba(0,0,0,0.3); border: 1px solid var(--border-dev);
      border-radius: 0.875rem; padding: 1.5rem; margin-bottom: 0.5rem;
    }

    /* ─── Sidebar Footer ───────────────────────────────────── */
    .sidebar-footer { border-top: 1px solid var(--border-dev); padding: 0.75rem 0 0.5rem; margin-top: auto; }
    .user-pill { display: flex; align-items: center; gap: 0.625rem; padding: 0.75rem 1rem; }
    .user-avatar { width: 30px; height: 30px; border-radius: 50%; background: linear-gradient(135deg, #1e3a52, #0d1526); border: 1px solid var(--border-dev); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 800; color: var(--primary); flex-shrink: 0; }
    .user-email { font-size: 0.72rem; font-weight: 600; color: #94a3b8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .user-role { font-size: 0.58rem; color: var(--primary); font-weight: 800; text-transform: uppercase; }
    .logout-btn { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; font-size: 0.78rem; font-weight: 600; color: #64748b; cursor: pointer; transition: color 0.2s; }
    .logout-btn:hover { color: #ef4444; }
    .logout-btn i { width: 14px; }

    /* ─── Chat Sandbox ─────────────────────────────────────── */
    .chat-input-row { display: flex; align-items: center; gap: 0.5rem; background: rgba(255,255,255,0.04); border: 1px solid var(--border-dev); border-radius: 0.625rem; padding: 0 0.5rem; }
    .chat-input-row input { border: none; background: none; outline: none; color: #e2e8f0; font-size: 0.82rem; padding: 0.625rem 0.25rem; width: 100%; font-family: inherit; }
    .chat-send-btn { width: 28px; height: 28px; border-radius: 6px; background: var(--primary); border: none; color: white; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background 0.2s; }
    .chat-send-btn:hover { background: #0891b2; }
    .chat-send-btn i { width: 12px; }
  </style>
</head>
<body data-theme="dark">
<div class="apex-layout">

  <!-- ───────────── SIDEBAR ───────────── -->
  <aside class="apex-sidebar">
    <div class="sidebar-header">
      <div class="logo-box"><i data-lucide="terminal"></i></div>
      <div class="logo-text">
        <h2>DevOps Center</h2>
        <p>Engineering Hub</p>
      </div>
    </div>

    <nav class="sidebar-nav">
      <p class="nav-group-label">Monitoring</p>
      <a class="apex-nav-item active" id="nav-overview" onclick="switchSection('overview')">
        <i data-lucide="activity"></i><span>Overview</span>
      </a>
      <a class="apex-nav-item" id="nav-monitoring" onclick="switchSection('monitoring')">
        <i data-lucide="bar-chart-2"></i><span>System Health</span>
      </a>
      <a class="apex-nav-item" id="nav-logs" onclick="switchSection('logs')">
        <i data-lucide="file-text"></i><span>Logs Viewer</span>
      </a>

      <p class="nav-group-label">Operations</p>
      <a class="apex-nav-item" id="nav-tickets" onclick="switchSection('tickets')">
        <i data-lucide="ticket"></i><span>Technical Tickets</span>
      </a>
      <a class="apex-nav-item" id="nav-incidents" onclick="switchSection('incidents')">
        <i data-lucide="alert-triangle"></i><span>Incident Center</span>
      </a>
      <a class="apex-nav-item" id="nav-deployment" onclick="switchSection('deployment')">
        <i data-lucide="rocket"></i><span>Deployments</span>
      </a>

      <p class="nav-group-label">Infrastructure</p>
      <a class="apex-nav-item" id="nav-ai" onclick="switchSection('ai')">
        <i data-lucide="brain"></i><span>AI Infrastructure</span>
      </a>
      <a class="apex-nav-item" id="nav-queues" onclick="switchSection('queues')">
        <i data-lucide="cpu"></i><span>Queues & Workers</span>
      </a>
      <a class="apex-nav-item" id="nav-debugging" onclick="switchSection('debugging')">
        <i data-lucide="bug"></i><span>Debug Tools</span>
      </a>
      <a class="apex-nav-item" id="nav-personality" onclick="switchSection('personality')">
        <i data-lucide="sparkles"></i><span>AI Personality</span>
      </a>

      <p class="nav-group-label">Team</p>
      <a class="apex-nav-item" id="nav-tasks" onclick="switchSection('tasks')">
        <i data-lucide="check-square"></i><span>Assigned Tasks</span>
      </a>
      <a class="apex-nav-item" id="nav-notes" onclick="switchSection('notes')">
        <i data-lucide="sticky-note"></i><span>Internal Notes</span>
      </a>
    </nav>

    <div class="sidebar-footer">
      <div class="user-pill">
        <div class="user-avatar"><%= user.email.charAt(0).toUpperCase() %></div>
        <div style="overflow:hidden;">
          <div class="user-email"><%= user.email %></div>
          <div class="user-role">Developer</div>
        </div>
      </div>
      <div class="logout-btn" onclick="logout()">
        <i data-lucide="log-out"></i><span>Sign Out</span>
      </div>
    </div>
  </aside>

  <!-- ───────────── MAIN ───────────── -->
  <main class="apex-main">
    <header class="apex-header">
      <div class="header-search">
        <i data-lucide="terminal"></i>
        <input type="text" id="global-search" placeholder="Search logs, tickets, metrics..." onkeyup="handleGlobalSearch(event)" />
      </div>
      <div class="header-actions">
        <div class="status-pill" style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.2);">
          <div class="status-dot" style="background:#10b981;"></div>
          <span style="font-size:0.7rem;font-weight:800;color:#10b981;">PROD: ONLINE</span>
        </div>
        <button class="action-btn" onclick="refreshCurrentSection()" title="Refresh">
          <i data-lucide="refresh-cw"></i>
        </button>
      </div>
    </header>

    <div class="apex-content">

      <!-- ══════════════ OVERVIEW ══════════════ -->
      <div id="section-overview" class="section-container active">
        <div class="page-title">Operational Overview</div>
        <div class="page-subtitle">Platform engineering health at a glance.</div>

        <div class="stats-grid-4" id="overview-stats">
          <!-- populated by JS -->
        </div>

        <div class="chart-grid">
          <div class="dev-card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
              <h3 style="margin:0;">System Latency Trend</h3>
              <span class="badge badge-cyan">7-day</span>
            </div>
            <div style="height:280px;"><canvas id="mainLatencyChart"></canvas></div>
          </div>
          <div class="dev-card" style="padding:0;">
            <div style="padding:1.25rem 1.5rem;border-bottom:1px solid var(--border-dev);display:flex;align-items:center;gap:8px;">
              <i data-lucide="alert-circle" style="width:14px;color:#ef4444;"></i>
              <h3 style="margin:0;">Recent Incidents</h3>
            </div>
            <div id="mini-incident-list" style="max-height:340px;overflow-y:auto;"></div>
          </div>
        </div>
      </div>

      <!-- ══════════════ SYSTEM HEALTH ══════════════ -->
      <div id="section-monitoring" class="section-container">
        <div class="page-title">System Health</div>
        <div class="page-subtitle">Real-time infrastructure telemetry and performance indicators.</div>
        <div class="stats-grid-2" style="margin-bottom:1.5rem;">
          <div class="dev-card">
            <h3>API Response Latency</h3>
            <div style="height:220px;"><canvas id="apiPerfChart"></canvas></div>
          </div>
          <div class="dev-card">
            <h3>WebSocket Connections</h3>
            <div style="height:220px;"><canvas id="wsConnChart"></canvas></div>
          </div>
        </div>
        <div class="stats-grid-2">
          <div class="dev-card">
            <h3>Database Query Latency</h3>
            <div style="height:220px;"><canvas id="dbChart"></canvas></div>
          </div>
          <div class="dev-card">
            <h3>AI Completion Failures</h3>
            <div style="height:220px;"><canvas id="aiFailChart"></canvas></div>
          </div>
        </div>
      </div>

      <!-- ══════════════ LOGS VIEWER ══════════════ -->
      <div id="section-logs" class="section-container">
        <div class="section-title-bar">
          <div>
            <div class="page-title">Logs Viewer</div>
            <div class="page-subtitle">Audit trail and system event log stream.</div>
          </div>
          <div class="filter-bar">
            <select class="filter-select" id="log-type-filter" onchange="loadLogs()">
              <option value="all">All Logs</option>
              <option value="error">Errors Only</option>
              <option value="warn">Warnings Only</option>
              <option value="info">Info Only</option>
            </select>
            <button class="action-btn" onclick="loadLogs()"><i data-lucide="refresh-cw"></i></button>
          </div>
        </div>
        <div class="dev-card" style="padding:0;">
          <div style="padding:0.75rem 1.5rem;border-bottom:1px solid var(--border-dev);display:flex;align-items:center;gap:8px;">
            <div style="width:8px;height:8px;border-radius:50%;background:#10b981;box-shadow:0 0 6px #10b981;animation:pulseDot 2s infinite;"></div>
            <span style="font-size:0.72rem;font-weight:700;color:#94a3b8;font-family:'JetBrains Mono',monospace;">LIVE AUDIT STREAM</span>
          </div>
          <div id="live-logs" class="log-viewer"></div>
        </div>
      </div>

      <!-- ══════════════ TECHNICAL TICKETS ══════════════ -->
      <div id="section-tickets" class="section-container">
        <div class="page-title">Technical Queue</div>
        <div class="page-subtitle">High-priority and escalated support tickets requiring engineering attention.</div>
        <div class="dev-card" style="padding:0;">
          <div style="padding:1rem 1.5rem;border-bottom:1px solid var(--border-dev);">
            <input type="text" class="form-control" style="max-width:320px;" placeholder="Filter tickets..." onkeyup="filterTable(event,'ticket-list-body')">
          </div>
          <table class="apex-table">
            <thead>
              <tr>
                <th>Subject</th><th>Tenant</th><th>Status</th><th>Priority</th><th>Assigned</th><th>Created</th>
              </tr>
            </thead>
            <tbody id="ticket-list-body"></tbody>
          </table>
        </div>
      </div>

      <!-- ══════════════ INCIDENT CENTER ══════════════ -->
      <div id="section-incidents" class="section-container">
        <div class="incident-banner">
          <div>
            <div class="page-title" style="margin-bottom:0.3rem;">Incident Center</div>
            <div style="display:flex;align-items:center;gap:8px;color:#94a3b8;font-size:0.82rem;">
              <i data-lucide="shield-alert" style="width:14px;color:#ef4444;"></i>
              Active outages are monitored in real-time. Declare an incident to trigger on-call escalation.
            </div>
          </div>
          <button id="declare-btn" onclick="openModal('incident-modal')"
            style="background:linear-gradient(135deg,#ef4444,#b91c1c);color:white;border:none;padding:0.875rem 2rem;border-radius:1rem;font-weight:800;display:flex;align-items:center;gap:10px;font-size:0.85rem;box-shadow:0 8px 20px -4px rgba(239,68,68,0.4);cursor:pointer;transition:all 0.2s ease;white-space:nowrap;"
            onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 16px 28px -4px rgba(239,68,68,0.5)';"
            onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='0 8px 20px -4px rgba(239,68,68,0.4)';">
            <i data-lucide="alert-octagon" style="width:18px;"></i> Declare Incident
          </button>
        </div>
        <div class="dev-card" style="padding:0;">
          <table class="apex-table">
            <thead><tr><th>Title</th><th>Severity</th><th>Status</th><th>Affected Services</th><th>Reported</th><th>Actions</th></tr></thead>
            <tbody id="incident-list-body"></tbody>
          </table>
        </div>
      </div>

      <!-- ══════════════ DEPLOYMENTS ══════════════ -->
      <div id="section-deployment" class="section-container">
        <div class="deploy-banner">
          <div>
            <div class="page-title" style="margin-bottom:0.3rem;">Deployment Pipeline</div>
            <div style="display:flex;align-items:center;gap:8px;color:#94a3b8;font-size:0.82rem;">
              <i data-lucide="git-branch" style="width:14px;color:var(--primary);"></i>
              Target: <strong style="color:#f1f5f9;">production</strong> &nbsp;|&nbsp; Active Branch: <strong style="color:var(--primary);">main</strong>
            </div>
          </div>
          <button id="deploy-btn" onclick="triggerDeployment()"
            style="background:linear-gradient(135deg,#06b6d4,#0891b2);color:white;border:none;padding:0.875rem 2rem;border-radius:1rem;font-weight:800;display:flex;align-items:center;gap:10px;font-size:0.85rem;box-shadow:0 8px 20px -4px rgba(6,182,212,0.35);cursor:pointer;transition:all 0.2s ease;white-space:nowrap;"
            onmouseover="this.style.transform='translateY(-2px)';"
            onmouseout="this.style.transform='translateY(0)';">
            <i data-lucide="play" style="width:16px;"></i> Start Production Deploy
          </button>
        </div>
        <div class="dev-card" style="padding:0;">
          <table class="apex-table">
            <thead><tr><th>Version</th><th>Environment</th><th>Status</th><th>Author</th><th>Duration</th><th>Deployed At</th></tr></thead>
            <tbody id="deployment-list-body"></tbody>
          </table>
        </div>
      </div>

      <!-- ══════════════ AI INFRASTRUCTURE ══════════════ -->
      <div id="section-ai" class="section-container">
        <div class="page-title">AI Infrastructure</div>
        <div class="page-subtitle">Live status of AI service providers and token consumption analytics.</div>
        <div class="stats-grid-3" id="ai-provider-stats" style="margin-bottom:1.5rem;">
          <!-- populated by JS -->
        </div>
        <div class="stats-grid-2">
          <div class="dev-card">
            <h3>Token Consumption Trend</h3>
            <div style="height:260px;"><canvas id="tokenTrendChart"></canvas></div>
          </div>
          <div class="dev-card" id="ai-token-summary">
            <h3>Platform AI Usage</h3>
            <div id="ai-usage-details"></div>
          </div>
        </div>
      </div>

      <!-- ══════════════ QUEUES & WORKERS ══════════════ -->
      <div id="section-queues" class="section-container">
        <div class="section-title-bar">
          <div>
            <div class="page-title">Queues & Workers</div>
            <div class="page-subtitle">Background job queues and worker health status.</div>
          </div>
          <button class="action-btn" onclick="loadQueues()"><i data-lucide="refresh-cw"></i> Refresh</button>
        </div>
        <div id="queue-list-container"></div>
      </div>

      <!-- ══════════════ DEBUG TOOLS ══════════════ -->
      <div id="section-debugging" class="section-container">
        <div class="page-title">Debug Tools</div>
        <div class="page-subtitle">Recent voice calls with transcript metadata for debugging AI interactions.</div>
        <div class="dev-card" style="padding:0;">
          <div style="padding:0.875rem 1.5rem;border-bottom:1px solid var(--border-dev);display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:0.78rem;font-weight:700;color:#94a3b8;">Recent Voice Calls</span>
            <button class="action-btn" onclick="loadDebugging()"><i data-lucide="refresh-cw"></i></button>
          </div>
          <table class="apex-table">
            <thead>
              <tr><th>Call SID / ID</th><th>Business</th><th>Type</th><th>Sentiment</th><th>Confidence</th><th>Duration</th><th>Timestamp</th></tr>
            </thead>
            <tbody id="debug-calls-body"></tbody>
          </table>
        </div>
      </div>

      <!-- ══════════════ AI PERSONALITY ══════════════ -->
      <div id="section-personality" class="section-container">
        <div class="section-title-bar">
          <div>
            <div class="page-title">Premium Agent Library</div>
            <div class="page-subtitle">Manage high-fidelity ElevenLabs agents across 4 premium slots.</div>
          </div>
          <button onclick="saveAiSettings()"
            style="background:linear-gradient(135deg,#06b6d4,#0891b2);color:white;border:none;padding:0.75rem 1.75rem;border-radius:0.875rem;font-weight:800;font-size:0.82rem;display:flex;align-items:center;gap:8px;cursor:pointer;transition:all 0.2s ease;box-shadow:0 6px 16px -3px rgba(6,182,212,0.4);"
            onmouseover="this.style.transform='translateY(-1px)';" onmouseout="this.style.transform='translateY(0)';">
            <i data-lucide="save" style="width:14px;"></i> Save Changes
          </button>
        </div>

        <!-- Agent Slots -->
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:2rem;">
          <% for(let i=1; i<=4; i++) { %>
          <div class="slot-card">
            <div class="slot-label"><i data-lucide="cpu" style="width:12px;"></i> Slot <%= i %></div>
            <div class="form-group">
              <label>Nickname</label>
              <input type="text" id="slot<%= i %>Name" class="form-control" placeholder="e.g. Urdu Expert" />
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label>ElevenLabs Agent ID</label>
              <input type="text" id="slot<%= i %>Id" class="form-control" style="font-family:'JetBrains Mono',monospace;font-size:0.75rem;" placeholder="agent_..." />
            </div>
          </div>
          <% } %>
        </div>

        <!-- Global Assignment -->
        <div style="background:rgba(255,255,255,0.02);border:1px dashed var(--border-dev);border-radius:1.25rem;padding:1.75rem;margin-bottom:2rem;">
          <div style="font-size:0.75rem;font-weight:800;color:#94a3b8;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:1.25rem;display:flex;align-items:center;gap:8px;">
            <i data-lucide="link-2" style="width:14px;color:var(--primary);"></i> Global Agent Assignment
          </div>
          <div class="stats-grid-2">
            <div class="form-group" style="margin-bottom:0;">
              <label style="display:flex;align-items:center;gap:6px;"><i data-lucide="utensils" style="width:12px;color:#f59e0b;"></i> Restaurant (Order) Agent</label>
              <select id="orderAgentSelection" class="form-control">
                <option value="">-- Unassigned --</option>
                <option value="slot1">Premium Slot 1</option>
                <option value="slot2">Premium Slot 2</option>
                <option value="slot3">Premium Slot 3</option>
                <option value="slot4">Premium Slot 4</option>
              </select>
              <p style="font-size:0.68rem;color:var(--text-muted);margin-top:0.4rem;">Handles all food ordering voice calls.</p>
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label style="display:flex;align-items:center;gap:6px;"><i data-lucide="calendar" style="width:12px;color:#10b981;"></i> Appointment (Service) Agent</label>
              <select id="apptAgentSelection" class="form-control">
                <option value="">-- Unassigned --</option>
                <option value="slot1">Premium Slot 1</option>
                <option value="slot2">Premium Slot 2</option>
                <option value="slot3">Premium Slot 3</option>
                <option value="slot4">Premium Slot 4</option>
              </select>
              <p style="font-size:0.68rem;color:var(--text-muted);margin-top:0.4rem;">Handles booking and service scheduling calls.</p>
            </div>
          </div>
        </div>

        <!-- Master Prompts -->
        <div style="margin-bottom:2rem;">
          <div style="font-size:0.75rem;font-weight:800;color:#94a3b8;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:1.25rem;display:flex;align-items:center;gap:8px;">
            <i data-lucide="scroll-text" style="width:14px;color:#a855f7;"></i> Master Prompt Overrides
          </div>
          <div class="stats-grid-2">
            <div class="dev-card" style="border-top:3px solid #f59e0b;padding:1.5rem;">
              <h3 style="color:#f59e0b;margin-bottom:0.25rem;">Restaurant Master Prompt</h3>
              <p style="font-size:0.72rem;color:var(--text-muted);margin-bottom:1rem;">Strict rules governing all food ordering agents.</p>
              <textarea id="orderMasterPrompt" class="form-control" rows="10" style="font-family:'JetBrains Mono',monospace;font-size:0.76rem;line-height:1.6;" placeholder="Paste restaurant ordering rules..."></textarea>
            </div>
            <div class="dev-card" style="border-top:3px solid #10b981;padding:1.5rem;">
              <h3 style="color:#10b981;margin-bottom:0.25rem;">Service Master Prompt</h3>
              <p style="font-size:0.72rem;color:var(--text-muted);margin-bottom:1rem;">Strict rules governing all appointment/booking agents.</p>
              <textarea id="apptMasterPrompt" class="form-control" rows="10" style="font-family:'JetBrains Mono',monospace;font-size:0.76rem;line-height:1.6;" placeholder="Paste salon/service rules..."></textarea>
            </div>
          </div>
        </div>

        <!-- AI Intelligence Lab -->
        <div>
          <div style="font-size:0.75rem;font-weight:800;color:#94a3b8;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:1.25rem;display:flex;align-items:center;gap:8px;">
            <i data-lucide="flask-conical" style="width:14px;color:var(--primary);"></i> AI Intelligence Lab
          </div>
          <div class="stats-grid-3">

            <!-- Voice Preview -->
            <div class="dev-card" style="border-top:3px solid var(--primary);">
              <h3 style="display:flex;align-items:center;gap:8px;"><i data-lucide="volume-2" style="width:15px;color:var(--primary);"></i> Vocal Preview</h3>
              <p style="font-size:0.75rem;color:var(--text-muted);margin-bottom:1.25rem;">Synthesize real-time audio with custom voice settings.</p>
              <div class="form-group">
                <label>ElevenLabs Voice ID</label>
                <input type="text" id="testVoiceId" class="form-control" style="font-family:'JetBrains Mono',monospace;font-size:0.76rem;" value="21m00Tcm4TlvDq8ikWAM" placeholder="voice ID..." />
              </div>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:1rem;">
                <div class="form-group" style="margin-bottom:0;">
                  <label>Stability</label>
                  <input type="number" step="0.05" min="0" max="1" id="testStability" class="form-control" value="0.75" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                  <label>Similarity</label>
                  <input type="number" step="0.05" min="0" max="1" id="testSimilarity" class="form-control" value="0.85" />
                </div>
              </div>
              <div class="form-group">
                <label>Test Script</label>
                <textarea id="testVoiceScript" class="form-control" rows="3" style="font-size:0.8rem;">Welcome to Vision Salon! How can I help you today?</textarea>
              </div>
              <button onclick="testVoicePreview()"
                style="width:100%;background:linear-gradient(135deg,#06b6d4,#0891b2);color:white;border:none;padding:0.75rem;border-radius:0.75rem;font-weight:700;font-size:0.82rem;display:flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:all 0.2s ease;margin-top:0.5rem;"
                onmouseover="this.style.opacity='0.9';" onmouseout="this.style.opacity='1';">
                <i data-lucide="play" style="width:14px;"></i> Generate Audio Preview
              </button>
              <div id="audioPreviewContainer" style="margin-top:1rem;display:none;background:rgba(0,0,0,0.3);border-radius:0.75rem;padding:0.75rem;">
                <audio id="previewAudio" controls style="width:100%;height:34px;"></audio>
              </div>
            </div>

            <!-- Live Voice Interaction -->
            <div class="dev-card" style="border-top:3px solid #10b981;position:relative;overflow:hidden;">
              <div id="voice-pulse-bg" style="position:absolute;inset:0;background:radial-gradient(circle,rgba(16,185,129,0.1) 0%,transparent 70%);opacity:0;transition:opacity 0.5s;pointer-events:none;"></div>
              <h3 style="position:relative;display:flex;align-items:center;gap:8px;"><i data-lucide="mic" style="width:15px;color:#10b981;"></i> Live Voice Interaction</h3>
              <p style="font-size:0.75rem;color:var(--text-muted);margin-bottom:1.5rem;position:relative;">Talk to the AI agent using your microphone in real-time.</p>
              <div style="text-align:center;padding:1.5rem 0;position:relative;">
                <div class="voice-ring" id="voice-status-ring">
                  <i data-lucide="mic" id="voice-mic-icon" style="color:var(--text-muted);"></i>
                </div>
                <p id="voice-status-text" style="font-size:0.65rem;font-weight:800;color:var(--text-muted);margin-top:0.875rem;text-transform:uppercase;letter-spacing:0.1em;">Disconnected</p>
              </div>
              <div style="display:flex;gap:0.5rem;position:relative;">
                <button id="start-voice-btn" onclick="startVoiceLab()" style="flex:2;background:#10b981;color:white;border:none;padding:0.75rem;border-radius:0.75rem;font-weight:700;font-size:0.82rem;cursor:pointer;transition:background 0.2s;" onmouseover="this.style.background='#059669';" onmouseout="this.style.background='#10b981';">Start Session</button>
                <button id="stop-voice-btn" onclick="stopVoiceLab()" style="flex:1;background:#ef4444;color:white;border:none;padding:0.75rem;border-radius:0.75rem;font-weight:700;font-size:0.82rem;cursor:pointer;display:none;">Stop</button>
              </div>
            </div>

            <!-- Intelligence Sandbox -->
            <div class="dev-card" style="border-top:3px solid #a855f7;">
              <h3 style="display:flex;align-items:center;gap:8px;"><i data-lucide="message-square" style="width:15px;color:#a855f7;"></i> Intelligence Sandbox</h3>

              <div id="aiChatSandbox" style="height:210px;overflow-y:auto;background:rgba(0,0,0,0.25);border-radius:0.875rem;padding:1rem;margin-bottom:0.875rem;border:1px solid var(--border-dev);">
                <div style="text-align:center;margin-top:3rem;font-size:0.78rem;color:var(--text-muted);">Ask the AI anything to test its behaviour...</div>
              </div>
              <div class="chat-input-row">
                <input type="text" id="sandboxChatInput" placeholder="Type a message..." onkeypress="if(event.key==='Enter') sendSandboxChat()" />
                <button class="chat-send-btn" onclick="sendSandboxChat()"><i data-lucide="send"></i></button>

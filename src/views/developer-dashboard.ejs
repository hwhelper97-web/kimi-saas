</div>

<!-- ══════════════ MODAL: DECLARE INCIDENT ══════════════ -->
<div id="incident-modal" class="modal-overlay">
  <div class="modal-box">
    <div class="modal-header">
      <h2>🚨 Declare Global Incident</h2>

<style>
  :root {
    --market-primary: #00f2ff;
    --market-primary-glow: rgba(0, 242, 255, 0.3);
    --market-bg: #030712;
    --glass-bg: rgba(255, 255, 255, 0.02);
    --glass-border: rgba(255, 255, 255, 0.08);
    --text-muted: #64748b;
  }

  .quantum-hub {
    padding: 1rem;
    animation: slideUpFade 0.6s cubic-bezier(0.23, 1, 0.32, 1) forwards;
  }

  @keyframes slideUpFade {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .marketplace-header {
    margin-bottom: 4rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .market-title {
    font-size: 2.75rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    background: linear-gradient(135deg, #fff 0%, #94a3b8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* 💠 Integration Quantum Cards */
  .integration-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2.5rem;
    margin-bottom: 4rem;
  }

  .quantum-card {
    background: rgba(255, 255, 255, 0.01);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 2.5rem;
    padding: 2.5rem;
    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 40px -10px rgba(0,0,0,0.5);
  }

  .quantum-card:hover {
    transform: translateY(-12px) scale(1.02);
    border-color: var(--market-primary);
    background: rgba(0, 242, 255, 0.02);
    box-shadow: 0 30px 60px -15px rgba(0, 242, 255, 0.15);
  }

  .logo-luminescent {
    width: 64px;
    height: 64px;
    border-radius: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .logo-luminescent::after {
    content: '';
    position: absolute;
    inset: -10px;
    background: inherit;
    filter: blur(20px);
    opacity: 0.3;
    z-index: -1;
    border-radius: inherit;
  }

  /* 📟 Flux Stream Terminal */
  .flux-terminal {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--glass-border);
    border-radius: 2rem;
    padding: 2rem;
    position: relative;
    overflow: hidden;
  }

  .flux-terminal::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
    background-size: 100% 4px, 3px 100%;
    pointer-events: none;
    z-index: 2;
  }

  .terminal-content {
    height: 300px;
    overflow-y: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    line-height: 1.8;
    color: #10b981;
    scrollbar-width: none;
  }
  .terminal-content::-webkit-scrollbar { display: none; }

  /* 🎛 Quantum Toggles */
  input[type="checkbox"].quantum-toggle {
    width: 44px;
    height: 24px;
    appearance: none;
    background: rgba(255,255,255,0.05);
    border-radius: 100px;
    position: relative;
    cursor: pointer;
    transition: all 0.3s;
    border: 1px solid var(--glass-border);
  }

  input[type="checkbox"].quantum-toggle:checked {
    background: var(--market-primary);
    box-shadow: 0 0 15px var(--market-primary-glow);
  }

  input[type="checkbox"].quantum-toggle::before {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    background: white;
    border-radius: 50%;
    top: 2px;
    left: 2px;
    transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
  }

  input[type="checkbox"].quantum-toggle:checked::before {
    transform: translateX(20px);
  }

  .btn-quantum {
    background: linear-gradient(135deg, var(--market-primary) 0%, #0ea5e9 100%);
    color: #030712;
    padding: 1.25rem 2rem;
    border-radius: 1.5rem;
    border: none;
    font-weight: 800;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 10px 20px -5px var(--market-primary-glow);
  }

  .btn-quantum:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 40px -10px var(--market-primary-glow);
  }
</style>

<div class="quantum-hub">
  <div class="marketplace-header">
    <div>
      <h2 class="market-title">Quantum Hub</h2>
      <p style="color: var(--text-muted); font-size: 1.1rem; font-weight: 500; margin-top: 0.5rem;">Ecosystem synchronization and neural POS bridging.</p>
    </div>
    <div style="background: rgba(255,255,255,0.03); padding: 0.75rem 1.5rem; border-radius: 1.25rem; border: 1px solid var(--glass-border); display: flex; align-items: center; gap: 0.75rem;">
      <div style="width: 8px; height: 8px; border-radius: 50%; background: #10b981; box-shadow: 0 0 10px #10b981;"></div>
      <span style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: white;">Global Sync: Operational</span>
    </div>
  </div>

  <div class="integration-grid">

    <!-- TOAST CARD -->
    <div class="quantum-card" id="card-toast">
      <div style="display:flex; justify-content:space-between; align-items:start; margin-bottom: 2.5rem;">
        <div class="logo-luminescent" style="background: #ff4d00; color:white; font-weight:900; font-size:1.75rem;">T</div>
        <span class="badge badge-disconnected" id="badge-TOAST" style="padding: 0.5rem 1rem; border-radius: 0.75rem; font-size: 0.65rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border);">Disconnected</span>
      </div>
      <h3 style="font-size: 1.5rem; font-weight: 900; margin-bottom: 0.75rem; letter-spacing: -0.02em;">Toast POS</h3>
      <p style="font-size: 0.95rem; color: var(--text-muted); margin-bottom: 2.5rem; line-height: 1.6; font-weight: 500;">Premium restaurant management sync. Direct-to-kitchen injection and automated inventory protocols.</p>

      <div style="margin-top:auto; padding-top:2rem; border-top:1px solid var(--glass-border); display:flex; gap:1rem;">
        <button class="btn-quantum" id="btn-TOAST" style="flex:1;" onclick="connectIntegration('TOAST')">Initialize Link</button>
        <button style="width: 56px; height: 56px; border-radius: 1.25rem; background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); color: white; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.3s;" onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background='rgba(255,255,255,0.03)'" onclick="openSettings('TOAST')">
          <i data-lucide="settings" style="width: 20px;"></i>
        </button>
      </div>
    </div>

    <!-- SQUARE CARD -->
    <div class="quantum-card" id="card-square">
      <div style="display:flex; justify-content:space-between; align-items:start; margin-bottom: 2.5rem;">
        <div class="logo-luminescent" style="background: #3e4348; color:white;">
          <i data-lucide="square" style="width: 32px;"></i>
        </div>
        <span class="badge badge-disconnected" id="badge-SQUARE" style="padding: 0.5rem 1rem; border-radius: 0.75rem; font-size: 0.65rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border);">Disconnected</span>
      </div>
      <h3 style="font-size: 1.5rem; font-weight: 900; margin-bottom: 0.75rem; letter-spacing: -0.02em;">Square</h3>
      <p style="font-size: 0.95rem; color: var(--text-muted); margin-bottom: 2.5rem; line-height: 1.6; font-weight: 500;">Agile ecosystem synchronization. OAuth 2.0 secure bridging with real-time menu propagation.</p>

      <div style="margin-top:auto; padding-top:2rem; border-top:1px solid var(--glass-border); display:flex; gap:1rem;">
        <button class="btn-quantum" id="btn-SQUARE" style="flex:1;" onclick="connectIntegration('SQUARE')">Initialize Link</button>
        <button style="width: 56px; height: 56px; border-radius: 1.25rem; background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); color: white; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.3s;" onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background='rgba(255,255,255,0.03)'" onclick="openSettings('SQUARE')">
          <i data-lucide="settings" style="width: 20px;"></i>
        </button>
      </div>
    </div>

    <!-- CLOVER CARD -->
    <div class="quantum-card" id="card-clover">
      <div style="display:flex; justify-content:space-between; align-items:start; margin-bottom: 2.5rem;">
        <div class="logo-luminescent" style="background: #10b981; color:white; font-weight:900; font-size:1.75rem;">C</div>
        <span class="badge badge-disconnected" id="badge-CLOVER" style="padding: 0.5rem 1rem; border-radius: 0.75rem; font-size: 0.65rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border);">Disconnected</span>
      </div>
      <h3 style="font-size: 1.5rem; font-weight: 900; margin-bottom: 0.75rem; letter-spacing: -0.02em;">Clover</h3>
      <p style="font-size: 0.95rem; color: var(--text-muted); margin-bottom: 2.5rem; line-height: 1.6; font-weight: 500;">High-volume architectural sync. Advanced location bridging and distributed payment integration.</p>

      <div style="margin-top:auto; padding-top:2rem; border-top:1px solid var(--glass-border); display:flex; gap:1rem;">
        <button class="btn-quantum" id="btn-CLOVER" style="flex:1;" onclick="connectIntegration('CLOVER')">Initialize Link</button>
        <button style="width: 56px; height: 56px; border-radius: 1.25rem; background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); color: white; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.3s;" onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background='rgba(255,255,255,0.03)'" onclick="openSettings('CLOVER')">
          <i data-lucide="settings" style="width: 20px;"></i>
        </button>
      </div>
    </div>

  </div>

  <!-- 📟 FLUX STREAM MONITOR -->
  <div class="flux-terminal" style="margin-top: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 10px; height: 10px; border-radius: 50%; background: #10b981; box-shadow: 0 0 10px #10b981;"></div>
        <h3 style="font-size: 1.1rem; font-weight: 900; color: white;">Real-time Flux Stream</h3>
      </div>
      <button style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); color: white; padding: 0.6rem 1.25rem; border-radius: 0.75rem; cursor: pointer; font-size: 0.75rem; font-weight: 800; display: flex; align-items: center; gap: 0.5rem;" onclick="refreshLogs()">
        <i data-lucide="refresh-cw" style="width: 14px;"></i> Refresh Stream
      </button>
    </div>
    <div id="syncLogs" class="terminal-content">
      <div style="opacity:0.5;">[SYSTEM] Booting Flux-Bridge protocols...</div>
    </div>
  </div>
</div>

<script>
  (function() {
    if (window.lucide) lucide.createIcons();

    // -- State & Fetching --
    async function updateIntegrationStatuses() {
      try {
        const bId = (typeof getBusinessId === 'function' ? getBusinessId() : localStorage.getItem("activeBusinessId"));
        if (!bId) return;
        
        const res = await fetch(`/api/integrations/status?businessId=${bId}`, {
          headers: { Authorization: `Bearer ${localStorage.getItem("accessToken") || window.token}` }
        });
        const result = await res.json();
        
        if (result.success && Array.isArray(result.data)) {
          result.data.forEach(int => {
            const badge = document.getElementById(`badge-${int.provider}`);
            const btn = document.getElementById(`btn-${int.provider}`);
            if (badge) {
              badge.innerText = int.isConnected ? "Connected" : "Disconnected";
              badge.className = `badge ${int.isConnected ? 'badge-connected' : 'badge-disconnected'}`;
              if (int.isConnected) {
                badge.style.background = "rgba(0, 242, 255, 0.12)";
                badge.style.color = "#00f2ff";
                badge.style.borderColor = "rgba(0, 242, 255, 0.3)";
                badge.style.boxShadow = "0 0 12px rgba(0, 242, 255, 0.25)";
              } else {
                badge.style.background = "rgba(255, 255, 255, 0.05)";
                badge.style.color = "#64748b";
                badge.style.borderColor = "rgba(255, 255, 255, 0.1)";
                badge.style.boxShadow = "none";
              }
            }
            if (btn) {
              btn.innerText = int.isConnected ? "Reconnect POS Link" : "Connect POS";
            }
          });
        }
      } catch (err) {
        console.error("[Integrations] Status Error:", err);
      }
    }

    window.refreshLogs = async function() {
      const container = document.getElementById("syncLogs");
      if (!container) return;
      
      try {
        const bId = (typeof getBusinessId === 'function' ? getBusinessId() : localStorage.getItem("activeBusinessId"));
        const res = await fetch(`/api/integrations/logs?businessId=${bId}`, {
          headers: { Authorization: `Bearer ${localStorage.getItem("accessToken") || window.token}` }
        });
        const result = await res.json();
        
        if (result.success && result.data) {
          if (result.data.length === 0) {
            container.innerHTML = '<div style="opacity:0.5;">[SYSTEM] No sync history found.</div>';
          } else {
            container.innerHTML = result.data.map(log => {
              const time = new Date(log.createdAt).toLocaleTimeString();
              const levelColor = log.level === 'ERROR' ? '#ff4d4d' : (log.level === 'WARN' ? '#ffcc00' : '#0f0');
              return `<div style="margin-bottom:0.25rem;">
                <span style="color:#666;">[${time}]</span> 
                <span style="color:${levelColor}; font-weight:700;">${log.level}</span> 
                <span style="color:#eee;">${log.message}</span>
              </div>`;
            }).join("");
            container.scrollTop = container.scrollHeight;
          }
        }
      } catch (err) {
        container.innerHTML = '<div style="color:red;">[ERROR] Failed to fetch logs.</div>';
      }
    };

    // -- Actions --
    window.connectIntegration = async function(provider) {
      const bId = (typeof getBusinessId === 'function' ? getBusinessId() : localStorage.getItem("activeBusinessId"));
      try {
        const res = await fetch('/api/integrations/connect', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${localStorage.getItem("accessToken") || window.token}`
          },
          body: JSON.stringify({ businessId: bId, provider })
        });
        const result = await res.json();
        if (result.success) {
          if (typeof notify === 'function') notify(`${provider} connected!`, "Success");
          updateIntegrationStatuses();
          refreshLogs();
        } else {
          alert(result.error || "Failed to connect");
        }
      } catch (err) {
        console.error("Connect Error:", err);
      }
    };

    window.openSettings = async function(provider) {
      const bId = (typeof getBusinessId === 'function' ? getBusinessId() : localStorage.getItem("activeBusinessId"));
      const modal = document.getElementById("integrationSettingsModal");
      
      try {
        const res = await fetch(`/api/integrations/get-settings?businessId=${bId}&provider=${provider}`, {
          headers: { Authorization: `Bearer ${localStorage.getItem("accessToken") || window.token}` }
        });
        const result = await res.json();
        
        if (result.success) {
          const data = result.data;
          document.getElementById("settingsModalTitle").innerText = `${provider} Settings`;
          document.getElementById("currentIntegrationId").value = data.id;
          
          // Set Toggles
          document.getElementById("syncMenuToggle").checked = data.config.menuSync;
          document.getElementById("pushOrderToggle").checked = data.config.orderPush;
          document.getElementById("inventorySyncToggle").checked = data.config.inventorySync;
          
          // Set Status
          document.getElementById("settingsStatus").innerText = data.status;
          document.getElementById("settingsStatus").style.color = data.status === 'CONNECTED' ? 'var(--success)' : 'var(--text-muted)';
          document.getElementById("settingsLastSync").innerText = data.lastSync ? new Date(data.lastSync).toLocaleString() : 'Never';
          
          // Provider Fields
          document.getElementById("cloverFields").style.display = provider === 'CLOVER' ? 'block' : 'none';
          if (provider === 'CLOVER' && data.credentials) {
            document.getElementById("cloverMerchantId").value = data.credentials.apiKey || "";
            document.getElementById("cloverAccessToken").value = data.credentials.accessToken || "";
          }

          modal.classList.add("show");
        } else {
          alert("Could not load settings. Is the integration connected?");
        }
      } catch (err) {
        console.error("Settings Load Error:", err);
      }
    };

    window.closeSettings = function() {
      document.getElementById("integrationSettingsModal").classList.remove("show");
    };

    // Close on backdrop click
    const settingsModal = document.getElementById("integrationSettingsModal");
    if (settingsModal) {
      settingsModal.addEventListener("click", function(e) {
        if (e.target === this) closeSettings();
      });
    }

    window.saveIntegrationSettings = async function() {
      const id = document.getElementById("currentIntegrationId").value;
      const config = {
        menuSync: document.getElementById("syncMenuToggle").checked,
        orderPush: document.getElementById("pushOrderToggle").checked,
        inventorySync: document.getElementById("inventorySyncToggle").checked
      };
      
      let credentials = null;
      if (document.getElementById("cloverFields").style.display === 'block') {
        credentials = {
          merchantId: document.getElementById("cloverMerchantId").value,
          accessToken: document.getElementById("cloverAccessToken").value
        };
      }

      try {
        const res = await fetch('/api/integrations/update-settings', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${localStorage.getItem("accessToken") || window.token}`
          },
          body: JSON.stringify({ integrationId: id, config, credentials })
        });
        const result = await res.json();
        if (result.success) {
          if (typeof notify === 'function') notify("Settings saved", "Success");
          closeSettings();
          refreshLogs();
        }
      } catch (err) {
        console.error("Save Error:", err);
      }
    };

    window.disconnectIntegrationAction = async function() {
      if (!confirm("Are you sure you want to disconnect this integration? This will stop all sync processes.")) return;
      
      const id = document.getElementById("currentIntegrationId").value;
      try {
        const res = await fetch('/api/integrations/disconnect', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${localStorage.getItem("accessToken") || window.token}`
          },
          body: JSON.stringify({ integrationId: id })
        });
        const result = await res.json();
        if (result.success) {
          if (typeof notify === 'function') notify("Integration disconnected", "Status Updated");
          closeSettings();
          updateIntegrationStatuses();
          refreshLogs();
        }
      } catch (err) {
        console.error("Disconnect Error:", err);
      }
    };

    // -- Init --
    updateIntegrationStatuses();
    refreshLogs();
    
    // Auto-refresh logs every 10 seconds if section is active
    const logInterval = setInterval(() => {
      if (document.getElementById("syncLogs")) {
        refreshLogs();
      } else {
        clearInterval(logInterval);
      }
    }, 10000);

  })();
</script>
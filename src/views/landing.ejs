            <i data-lucide="git-branch" class="w-4 h-4"></i>
          </div>
          <div>
            <h4 class="text-[10px] font-extrabold text-white tracking-wider">NEXA FLOW</h4>
            <p class="text-[9px] text-textDim mt-0.5">Automations: 1,420 / min</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ==================== SECTION 3 — TRUST & STATS ==================== -->
  <section class="py-12 border-y border-glassBorder bg-[#041014]/50 backdrop-blur-md relative" id="stats">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-8 text-center reveal stagger-reveal">
        
        <!-- Stat Item 1 -->
        <div class="flex flex-col items-center">

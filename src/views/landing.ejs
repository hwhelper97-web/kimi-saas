  <!-- ==================== SCRIPTS AND INTERACTIONS ==================== -->
  <script>
    // Safe helpers for Lucide and LocalStorage to prevent browser runtime crashes
    function safeCreateIcons() {
      if (typeof lucide !== 'undefined' && lucide.createIcons) {
        try {
          lucide.createIcons();
        } catch (e) {
          console.warn('Lucide failed to render icons:', e);
        }
      }
    }
    
    function safeSetItem(key, val) {
      try {
        localStorage.setItem(key, val);
      } catch (e) {
        console.warn('LocalStorage writing is blocked or unavailable:', e);
      }
    }
    
    function safeGetItem(key) {
      try {
        return localStorage.getItem(key);
      } catch (e) {
        console.warn('LocalStorage reading is blocked or unavailable:', e);
        return null;
      }
    }

    // Initialize Lucide Icons safely
    safeCreateIcons();

    // Trigger voice loading on page load to pre-cache high-fidelity neural voices
    if (typeof window !== 'undefined' && window.speechSynthesis) {
      window.speechSynthesis.getVoices();
      if (window.speechSynthesis.onvoiceschanged !== undefined) {
        window.speechSynthesis.onvoiceschanged = () => {
          window.speechSynthesis.getVoices();
        };
      }
    }

    // ==========================================
    // MULTI-THEME SELECTOR LOGIC
    // ==========================================
    const availableThemes = ['teal'];
    function setTheme(themeName) {
      if (!availableThemes.includes(themeName)) return;
      
      // Remove all theme classes
      availableThemes.forEach(t => {
        document.documentElement.classList.remove(`theme-${t}`);
        document.body.classList.remove(`theme-${t}`);
      });
      
      // Add new theme class
      document.documentElement.classList.add(`theme-${themeName}`);
      document.body.classList.add(`theme-${themeName}`);
      
      // Save theme to localStorage safely
      safeSetItem('theme', themeName);

      // Re-initialize particles if canvas exists to match theme accent
      if (typeof initParticles === 'function') {
        initParticles();
      }
    }

    // Loading screen dismiss logic
    window.addEventListener('load', () => {
      const progressBar = document.getElementById('loading-progress');
      const loadingScreen = document.getElementById('loading-screen');
      
      // Animate progress line to full
      setTimeout(() => {
        progressBar.style.width = '100%';
      }, 100);

      // Fade out loading screen
      setTimeout(() => {
        loadingScreen.classList.add('opacity-0', 'pointer-events-none');
      }, 700);
    });

    // Mobile Navigation toggle
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const closeMenuBtn = document.getElementById('close-menu-btn');
    const mobileNav = document.getElementById('mobile-nav');
    const mobileNavBackdrop = document.getElementById('mobile-nav-backdrop');

    mobileMenuBtn.addEventListener('click', () => {
      mobileNav.classList.remove('hidden');
      if (mobileNavBackdrop) mobileNavBackdrop.classList.remove('hidden');
    });

    closeMenuBtn.addEventListener('click', () => {
      mobileNav.classList.add('hidden');
      if (mobileNavBackdrop) mobileNavBackdrop.classList.add('hidden');
    });

    if (mobileNavBackdrop) {
      mobileNavBackdrop.addEventListener('click', () => {
        mobileNav.classList.add('hidden');
        mobileNavBackdrop.classList.add('hidden');
      });
    }

    // Close mobile nav when clicking links
    document.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', () => {
        mobileNav.classList.add('hidden');
        if (mobileNavBackdrop) mobileNavBackdrop.classList.add('hidden');
      });
    });

    // Header sticky scroll effect
    const header = document.getElementById('site-header');
    const backToTopBtn = document.getElementById('back-to-top');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 40) {
        header.classList.add('py-2.5', 'bg-[#040e13]/90');
        header.classList.remove('py-4', 'bg-rgba(4, 13, 18, 0.75)');
      } else {
        header.classList.add('py-4', 'bg-rgba(4, 13, 18, 0.75)');
        header.classList.remove('py-2.5', 'bg-[#040e13]/90');
      }

      if (backToTopBtn) {
        if (window.scrollY > 500) {
          backToTopBtn.classList.remove('opacity-0', 'pointer-events-none');
          backToTopBtn.classList.add('opacity-100');
        } else {
          backToTopBtn.classList.remove('opacity-100');
          backToTopBtn.classList.add('opacity-0', 'pointer-events-none');
        }
      }
    });

    // Reveal elements on scroll (Framer-motion style reveal)
    const revealElements = document.querySelectorAll('.reveal');
    const revealOnScroll = () => {
      const triggerBottom = window.innerHeight * 0.85;
      revealElements.forEach(el => {
        const top = el.getBoundingClientRect().top;
        if (top < triggerBottom) {
          el.classList.add('active');
          if (el.classList.contains('stagger-reveal')) {
            el.querySelectorAll(':scope > *').forEach((child, index) => {
              child.style.transitionDelay = `${index * 80}ms`;
              child.style.opacity = '1';
              child.style.transform = 'translateY(0)';
            });
          }
        }
      });
    };

    window.addEventListener('scroll', revealOnScroll);
    revealOnScroll(); // Initial check on load

    // Testimonial Carousel sliding logic
    let currentSlide = 0;
    const slides = document.querySelectorAll('.testimonial-slide');
    const dots = document.querySelectorAll('[id^="dot-"]');

    function showSlide(index) {
      slides.forEach((slide, idx) => {
        if (idx === index) {
          slide.classList.remove('opacity-0', 'translate-x-12', 'pointer-events-none');
          slide.classList.add('opacity-100', 'translate-x-0');
          slide.removeAttribute('style'); // Clear absolute layout override if current
        } else {
          slide.classList.remove('opacity-100', 'translate-x-0');
          slide.classList.add('opacity-0', 'translate-x-12', 'pointer-events-none');
          slide.style.position = 'absolute';
        }
      });

      dots.forEach((dot, idx) => {
        if (idx === index) {
          dot.classList.add('bg-cyanaccent');
          dot.classList.remove('bg-slate-700');
        } else {
          dot.classList.add('bg-slate-700');
          dot.classList.remove('bg-cyanaccent');
        }
      });
      currentSlide = index;
    }

    function nextTestimonial() {
      let next = (currentSlide + 1) % slides.length;
      showSlide(next);
    }

    function prevTestimonial() {
      let prev = (currentSlide - 1 + slides.length) % slides.length;
      showSlide(prev);
    }

    function goToSlide(index) {
      showSlide(index);
    }

    // Auto rotate testimonials every 6 seconds
    setInterval(nextTestimonial, 6000);

    // FAQ Accordion Toggle
    function toggleFaq(button) {
      const container = button.parentElement;
      const content = container.querySelector('div');
      const icon = button.querySelector('i');
      
      // Close other accordions
      document.querySelectorAll('.faq-active').forEach(activeItem => {
        if (activeItem !== container) {
          activeItem.classList.remove('faq-active');
          activeItem.querySelector('div').style.maxHeight = '0px';
          activeItem.querySelector('i').style.transform = 'rotate(0deg)';
        }
      });

      if (container.classList.contains('faq-active')) {
        container.classList.remove('faq-active');
        content.style.maxHeight = '0px';
        icon.style.transform = 'rotate(0deg)';
      } else {
        container.classList.add('faq-active');
        content.style.maxHeight = content.scrollHeight + 'px';
        icon.style.transform = 'rotate(45deg)';
      }
    }

    // Interactive Starfield & Node Network Particle Background (Canvas)
    const canvas = document.getElementById('canvas-network');
    const ctx = canvas.getContext('2d');

    let points = [];
    let mouse = { x: null, y: null, radius: 150 };

    // Helper to extract active accent RGB values
    function getActiveAccentRgb() {
      const styles = getComputedStyle(document.documentElement);
      const rgb = styles.getPropertyValue('--accent-rgb').trim();
      return rgb || '34, 211, 238';
    }

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      initParticles();
    }

    class Particle {
      constructor(x, y) {
        this.x = x;
        this.y = y;
        this.vx = (Math.random() - 0.5) * 0.45;
        this.vy = (Math.random() - 0.5) * 0.45;
        this.baseSize = Math.random() * 1.5 + 0.5;
        this.size = this.baseSize;
      }

      update() {
        this.x += this.vx;
        this.y += this.vy;

        // Bounce borders
        if (this.x < 0 || this.x > canvas.width) this.vx *= -1;
        if (this.y < 0 || this.y > canvas.height) this.vy *= -1;

        // Mouse gravity interaction
        if (mouse.x !== null && mouse.y !== null) {
          let dx = mouse.x - this.x;
          let dy = mouse.y - this.y;
          let distance = Math.sqrt(dx * dx + dy * dy);
          if (distance < mouse.radius) {
            const force = (mouse.radius - distance) / mouse.radius;
            // Pull slightly towards mouse
            this.x -= dx * force * 0.02;
            this.y -= dy * force * 0.02;
            this.size = this.baseSize * (1 + force * 1.5);
          } else {
            this.size = this.baseSize;
          }
        }
      }

      draw() {
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        // Dynamic color based on theme
        const rgb = getActiveAccentRgb();
        ctx.fillStyle = `rgba(${rgb}, 0.45)`;
        ctx.fill();
      }
    }

    function initParticles() {
      points = [];
      // Dynamic count based on screen size
      const count = Math.floor((canvas.width * canvas.height) / 9500);
      for (let i = 0; i < Math.min(count, 120); i++) {
        points.push(new Particle(Math.random() * canvas.width, Math.random() * canvas.height));
      }
    }

    function drawNetwork() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      const rgb = getActiveAccentRgb();

      // Draw grid nodes
      for (let i = 0; i < points.length; i++) {
        points[i].update();
        points[i].draw();

        // Connect lines
        for (let j = i + 1; j < points.length; j++) {
          let dx = points[i].x - points[j].x;
          let dy = points[i].y - points[j].y;
          let dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 110) {
            ctx.beginPath();
            ctx.moveTo(points[i].x, points[i].y);
            ctx.lineTo(points[j].x, points[j].y);
            // Dynamic lines opacity
            const opacity = (110 - dist) / 110 * 0.06;
            ctx.strokeStyle = `rgba(${rgb}, ${opacity})`;
            ctx.lineWidth = 0.75;
            ctx.stroke();
          }
        }
      }
      requestAnimationFrame(drawNetwork);
    }


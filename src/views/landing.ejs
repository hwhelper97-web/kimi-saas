    }

    // ==========================================
    // GLOBAL CLICK INTERCEPTOR & SMOOTH SCROLL
    // ==========================================
    document.addEventListener('DOMContentLoaded', () => {
      // Intercept consultation and document links
      document.addEventListener('click', (e) => {
        const target = e.target.closest('a');
        if (!target) return;
        const href = target.getAttribute('href');
        
        // Intercept consultation buttons
        if (href === '#contact' || target.textContent.trim() === 'BOOK CONSULTATION' || target.textContent.trim() === 'START YOUR PROJECT' || target.textContent.trim() === 'SCHEDULE CONSULTATION' || target.textContent.trim() === 'BOOK FREE CONSULTATION') {
          e.preventDefault();
          openConsultationModal();
        }
        
        // Intercept legal links
        if (target.textContent.trim() === 'Privacy Policy') {
          e.preventDefault();
          openDocModal('privacy');
        }
        if (target.textContent.trim() === 'Terms of Service') {
          e.preventDefault();
          openDocModal('terms');
        }
      });

      // Smooth scroll for nav links
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          const href = this.getAttribute('href');
          if (href === '#contact' || this.textContent.trim() === 'BOOK CONSULTATION' || this.textContent.trim() === 'START YOUR PROJECT' || this.textContent.trim() === 'SCHEDULE CONSULTATION' || this.textContent.trim() === 'BOOK FREE CONSULTATION') {
            return;
          }
          
          e.preventDefault();
          const targetId = href.substring(1);
          const targetElement = document.getElementById(targetId || 'home');
          if (targetElement) {
            window.scrollTo({
              top: targetElement.offsetTop - 80,
              behavior: 'smooth'
            });
          }
        });
      });

      // Mouse Spotlight Glow effect on glass-cards
      const glassCards = document.querySelectorAll('.glass-card');
      glassCards.forEach(card => {
        card.addEventListener('mousemove', e => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty('--mouse-x', `${x}px`);
          card.style.setProperty('--mouse-y', `${y}px`);
        });
      });
    });

    window.addEventListener('resize', resizeCanvas);
    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });
    window.addEventListener('mouseleave', () => {
      mouse.x = null;
      mouse.y = null;
    });

    resizeCanvas();
    drawNetwork();

    // ==========================================
    // INTERACTIVE HUD CURSOR RETICLE
    // ==========================================
    const homeSection = document.getElementById('home');
    const hudReticle = document.getElementById('hud-cursor-reticle');
    const hudCoordsText = document.getElementById('hud-cursor-coords');

    let mouseX = 0, mouseY = 0; // target position
    let reticleX = 0, reticleY = 0; // current interpolated position
    let isInsideHome = false;

    if (homeSection && hudReticle) {
      homeSection.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
        
        // Update raw coordinates relative to the home container
        const rect = homeSection.getBoundingClientRect();
        const localX = Math.round(e.clientX - rect.left);
        const localY = Math.round(e.clientY - rect.top);
        if (hudCoordsText) {
          hudCoordsText.innerText = `SYS.LOC [X: ${localX}, Y: ${localY}]`;
        }
      });

      homeSection.addEventListener('mouseenter', () => {
        isInsideHome = true;
        hudReticle.classList.add('active');
      });

      homeSection.addEventListener('mouseleave', () => {
        isInsideHome = false;
        hudReticle.classList.remove('active');
      });

      homeSection.addEventListener('mousedown', () => {
        hudReticle.classList.add('clicking');
      });

      window.addEventListener('mouseup', () => {
        hudReticle.classList.remove('clicking');
      });

      // Smooth interpolation loop (lerp)
      function updateReticlePosition() {
        if (isInsideHome) {
          reticleX += (mouseX - reticleX) * 0.15;
          reticleY += (mouseY - reticleY) * 0.15;
          hudReticle.style.left = `${reticleX}px`;
          hudReticle.style.top = `${reticleY}px`;
        }
        requestAnimationFrame(updateReticlePosition);
      }
      // Initialize position to center
      reticleX = window.innerWidth / 2;
      reticleY = window.innerHeight / 2;
      updateReticlePosition();
    }

    // ==========================================
    // DYNAMIC SYSTEM CONSOLE LOGS LOOP
    // ==========================================
    const consoleScroller = document.getElementById('hud-console-scroller');
    const systemLogMessages = [
      "[SYS_INIT] BOOT SEQUENCE LAUNCHED... OK",
      "[NET_SHIELD] SYNCING ACCELERATED FIREWALLS... DONE",
      "[LLM_COGNITIVE] WEAVING NEURAL LOGIC NODES... [24/24]",
      "[VECTOR_STORE] SEARCHING TARGET EMBEDDINGS... [4096-DIM]",
      "[THREAT_DETECTOR] ANALYZING INCOMING FLUX... NULL",
      "[API] ELEVENLABS INTERFACE LOADED // DYNAMIC AUDIOS",
      "[API] TWILIO VOICE ENGINE STATUS: ACTIVE",
      "[AI_MODEL] CACHE INTEGRITY CHECK: 100% SECURE",
      "[COGNITIVE] CONVERSATIONAL STATE SYNCED // STABLE",
      "[SYS_MONITOR] HEURISTIC ANOMALY DETECTOR: STABLE",
      "[SYS_LOAD] MEMORY USAGE: 14.8MB // BUFFER SECURE",
      "[SYSTEM] SYNC COMPLETE. COGNITIVE RUNTIME READY"
    ];

    let currentLogIndex = 2; // start after the placeholder items

    function spawnNextSystemLog() {
      if (!consoleScroller) return;

      const nextMsg = systemLogMessages[currentLogIndex];
      currentLogIndex = (currentLogIndex + 1) % systemLogMessages.length;

      // Create new line
      const logLine = document.createElement('div');
      logLine.className = 'opacity-0 transition-opacity duration-300 font-mono text-[7px] text-cyanaccent/85';
      logLine.innerText = nextMsg;
      
      consoleScroller.appendChild(logLine);

      // Fade-in effect
      setTimeout(() => {
        logLine.classList.remove('opacity-0');
        logLine.classList.add('opacity-75');
      }, 50);

      // Keep only last 4 lines inside scroller
      while (consoleScroller.children.length > 4) {
        consoleScroller.removeChild(consoleScroller.firstChild);
      }

      // Scroll to bottom
      consoleScroller.scrollTop = consoleScroller.scrollHeight;

      // Schedule next log entry
      const nextTime = Math.random() * 1500 + 1500;
      setTimeout(spawnNextSystemLog, nextTime);
    }

    if (consoleScroller) {
      setTimeout(spawnNextSystemLog, 2000);
    }

    // Load theme on start safely after all variables and functions are defined
    const savedTheme = safeGetItem('theme') === 'light' ? 'teal' : (safeGetItem('theme') || 'teal');
    setTheme(savedTheme);
  </script>
</body>

</html>

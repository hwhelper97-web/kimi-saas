    // Add line to terminal transcript
    function addTranscriptLine(sender, text) {
      const log = document.getElementById('simulator-transcript');
      if (!log) return;
      const div = document.createElement('div');
      
      if (sender === 'SYS') {
        div.className = 'text-cyanaccent/60';
        div.innerText = `[SYS] ${text}`;
      } else if (sender === 'AGENT') {
        div.className = 'text-white';
        div.innerHTML = `<span class="text-cyanaccent">[${agentsData[currentAgent].name}]</span> ${text}`;
      } else {
        div.className = 'text-slate-300';
        div.innerHTML = `<span class="text-tealaccent">[USER]</span> ${text}`;
      }
      
      log.appendChild(div);
      log.scrollTop = log.scrollHeight;
    }

    // Populate Suggested Replies (dialogue presets)
    function populateDialoguePresets() {
      const container = document.getElementById('dialogue-presets');
      if (!container) return;
      container.innerHTML = '';

      const stepData = agentsData[currentAgent].dialogue[dialogueStep];
      if (!stepData || !stepData.replies) return;

      stepData.replies.forEach(reply => {
        const btn = document.createElement('button');
        btn.className = 'px-2.5 py-1 text-[9px] font-bold font-mono border border-glassBorder rounded bg-white/5 text-slate-300 hover:border-cyanaccent/30 hover:text-cyanaccent transition-all cursor-pointer';
        btn.innerText = reply.label;
        btn.onclick = () => selectDialogueOption(reply.text, reply.nextStep);
        container.appendChild(btn);
      });
    }

    // Select a dialogue option
    function selectDialogueOption(text, nextStep) {
      addTranscriptLine('USER', text);
      
      if (nextStep === 'hangup') {
        setTimeout(() => hangUpCall(), 1200);
        return;
      }

      dialogueStep = nextStep;
      
      // Wait a bit, show thinking, then reply
      setTimeout(() => {
        const stepData = agentsData[currentAgent].dialogue[dialogueStep];
        if (stepData && stepData.text) {
          addTranscriptLine('AGENT', stepData.text);
          speakText(stepData.text);
        }
        populateDialoguePresets();
      }, 700);
    }

    // Process typed response
    function processUserInputText(inputText) {
      if (!inputText.trim()) return;
      
      // Match key terms or respond generically
      let matchedStep = null;
      const stepData = agentsData[currentAgent].dialogue[dialogueStep];
      
      if (stepData && stepData.replies) {
        // Find best match in replies
        const lowerInput = inputText.toLowerCase();
        let bestMatch = null;
        let highestScore = 0;
        
        stepData.replies.forEach(reply => {
          const words = reply.text.toLowerCase().split(' ');
          let matchCount = 0;
          words.forEach(w => {
            if (lowerInput.includes(w) && w.length > 3) matchCount++;
          });
          if (matchCount > highestScore) {
            highestScore = matchCount;
            bestMatch = reply;
          }
        });

        if (bestMatch) {
          matchedStep = bestMatch.nextStep;
        }
      }

      if (matchedStep !== null) {
        if (matchedStep === 'hangup') {
          setTimeout(() => hangUpCall(), 1200);
          return;
        }
        dialogueStep = matchedStep;
        setTimeout(() => {
          const nextData = agentsData[currentAgent].dialogue[dialogueStep];
          if (nextData && nextData.text) {
            addTranscriptLine('AGENT', nextData.text);
            speakText(nextData.text);
          }
          populateDialoguePresets();
        }, 700);
      } else {
        // Generic AI fallback response
        setTimeout(() => {
          const genericReplies = {
            nex: "I understand. Would you like to order a Nexton Classic Burger or check our timings?",
            aura: "Understood. I can help with booking Swedish or Deep Tissue massage, or other therapies. What works best?",
            cyrus: "Copy that. Please verify your connection headers, or tell me if you need database token rotation details."
          };
          const reply = genericReplies[currentAgent];
          addTranscriptLine('AGENT', reply);
          speakText(reply);
        }, 800);
      }
    }

    function handleInputKeydown(event) {
      if (event.key === 'Enter') {
        const input = document.getElementById('sim-user-input');
        if (input) {
          const text = input.value.trim();
          if (text) {
            addTranscriptLine('USER', text);
            processUserInputText(text);
            input.value = '';
          }
        }
      }
    }

    // ==========================================
    // INTERACTIVE MODALS AND TRIGGERS
    // ==========================================
    
    // Consultation Modal
    function openConsultationModal() {
      const modal = document.getElementById('consultation-modal');
      const formView = document.getElementById('consultation-form-view');
      const successView = document.getElementById('consultation-success-view');
      
      formView.classList.remove('hidden');
      successView.classList.add('hidden');
      modal.classList.add('active');
    }
    
    function closeConsultationModal() {
      document.getElementById('consultation-modal').classList.remove('active');
    }
    
    function handleConsultationSubmit(e) {
      e.preventDefault();
      
      const submitBtnText = document.getElementById('submit-btn-text');
      const spinner = document.getElementById('submit-btn-spinner');
      
      submitBtnText.textContent = 'DISPATCHING...';
      spinner.classList.remove('hidden');
      
      const name = document.getElementById('consult-name').value;
      const email = document.getElementById('consult-email').value;
      const company = document.getElementById('consult-company').value;
      const tier = document.getElementById('consult-tier').value;
      const details = document.getElementById('consult-details').value;
      
      // Simulate API call delay
      setTimeout(() => {
        submitBtnText.textContent = 'SUBMIT REQUEST';
        spinner.classList.add('hidden');
        
        // Generate mock ticket
        const ticketNum = 'NX-' + Math.floor(10000 + Math.random() * 90000);
        
        // Save to localStorage safely
        const savedConsultations = JSON.parse(safeGetItem('naxton_consultations') || '[]');
        savedConsultations.push({ ticketNum, name, email, company, tier, details, date: new Date().toISOString() });
        safeSetItem('naxton_consultations', JSON.stringify(savedConsultations));
        
        // Update success view content
        document.getElementById('success-ticket-id').textContent = ticketNum;
        document.getElementById('success-name').textContent = name;
        
        const tierNames = {
          voice: 'Nexa Voice AI',
          saas: 'SaaS Architecture',
          automation: 'Workflow Automation',
          custom: 'Bespoke Software'
        };
        document.getElementById('success-tier').textContent = tierNames[tier] || tier;
        
        // Toggle view
        document.getElementById('consultation-form-view').classList.add('hidden');
        document.getElementById('consultation-success-view').classList.remove('hidden');
        
        // Reset form fields
        document.getElementById('consultation-form').reset();
      }, 1500);
    }
    
    // Product Preview Modal
    function openProductPreview(productKey) {
      const modal = document.getElementById('product-preview-modal');
      const tiers = ['core', 'flow', 'voice', 'enterprise'];
      
      tiers.forEach(t => {
        document.getElementById(`preview-${t}`).classList.add('hidden');
      });
      
      document.getElementById(`preview-${productKey}`).classList.remove('hidden');
      modal.classList.add('active');
    }
    
    function closeProductPreview() {
      document.getElementById('product-preview-modal').classList.remove('active');
      stopFlowSimulation();
    }
    
    // Nexa Flow Simulation
    let flowSimInterval = null;
    function triggerFlowSimulation() {
      const logs = document.getElementById('flow-logs');
      const status = document.getElementById('flow-status');
      
      if (flowSimInterval) clearInterval(flowSimInterval);
      
      logs.innerHTML = '';
      status.textContent = 'PROCESSING...';
      status.className = 'text-cyanaccent animate-pulse';
      
      const steps = [
        { msg: '[WEBHOOK] Incoming request captured on /api/v1/trigger-webhook', delay: 200, color: 'text-white' },
        { msg: '[AUTH] Validating secret token payload headers... OK', delay: 700, color: 'text-tealaccent' },
        { msg: '[JSON] Extracted user ID: usr_99a803f7bc2, amount: $129.00', delay: 1200, color: 'text-textDim' },
        { msg: '[PIPELINE] Forwarding payload variables to CRM Sync Hub...', delay: 1800, color: 'text-textDim' },
        { msg: '[POSTGRES] Updating order audit ledger database transaction...', delay: 2400, color: 'text-textDim' },
        { msg: '[DISPATCH] Triggering external calendar reschedule event API...', delay: 3000, color: 'text-textDim' },
        { msg: '[SUCCESS] Workflow loop completed successfully in 32ms.', delay: 3600, color: 'text-green-400 font-bold' }
      ];
      
      steps.forEach(step => {
        setTimeout(() => {
          const div = document.createElement('div');
          div.className = step.color;
          div.textContent = step.msg;
          logs.appendChild(div);
          logs.scrollTop = logs.scrollHeight;
          
          if (step.msg.includes('[SUCCESS]')) {
            status.textContent = 'COMPLETED';
            status.className = 'text-green-400 font-bold';
          }
        }, step.delay);
      });
    }
    
    function stopFlowSimulation() {
      if (flowSimInterval) clearInterval(flowSimInterval);
      const logs = document.getElementById('flow-logs');
      if (logs) {
        logs.innerHTML = '<div class="text-cyanaccent/40">[SYS] Ready for simulation trigger.</div>';
      }
      const status = document.getElementById('flow-status');
      if (status) {
        status.textContent = 'IDLE';
        status.className = 'text-tealaccent';
      }
    }
    
    // Legal Document Modal
    const legalTexts = {
      privacy: `
        <h4 class="font-orbitron font-bold text-white text-[11px] mb-2 uppercase">1. INTRODUCTION</h4>
        <p class="mb-4">Naxton Technologies LLC ("we," "our," or "us") values your privacy. This Privacy Policy details our protocols regarding the collection, processing, and storage of database tokens and operational user credentials.</p>

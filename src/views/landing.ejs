    function switchSimulatorTab(tabId) {
      activeThinkingTab = tabId;
      const t1 = document.getElementById('tab-btn-dashboard');
      const t2 = document.getElementById('tab-btn-thinking');
      const d1 = document.getElementById('dashboard-mockup-view');
      const d2 = document.getElementById('visual-thinking-view');
      
      if (tabId === 'dashboard') {
        t1.className = 'flex-1 pb-2.5 text-primary border-b border-primary text-center cursor-pointer focus:outline-none transition-all duration-300';
        t2.className = 'flex-1 pb-2.5 text-textDim border-b border-transparent text-center hover:text-textMain transition-all duration-300 focus:outline-none flex items-center justify-center gap-1.5 cursor-pointer';
        d1.classList.remove('hidden');
        d2.classList.add('hidden');
      } else {
        t1.className = 'flex-1 pb-2.5 text-textDim border-b border-transparent text-center hover:text-textMain transition-all duration-300 focus:outline-none cursor-pointer';
        t2.className = 'flex-1 pb-2.5 text-primary border-b border-primary text-center focus:outline-none flex items-center justify-center gap-1.5 cursor-pointer';
        d1.classList.add('hidden');
        d2.classList.remove('hidden');
        selectThinkingNode('ingest');
      }
    }

    const thinkingNodeDetails = {
      ingest: { t: "Data Ingestion", d: "Processes streaming audio feeds or custom input lines. Converts analog or text formats into internal JSON datagram chunks.", l: "~4ms", c: "2 Concurrency" },
      perceive: { t: "Semantic Perception", d: "Performs syntactic analysis, intent recognition, and entity extraction on raw incoming tokens using localized neural weights.", l: "~12ms", c: "4 Concurrency" },
      act: { t: "Action Selection", d: "Evaluates the conversational state and determines the next logical response pathway, invoking external API calls if necessary.", l: "~8ms", c: "1 Concurrency" },
      reason: { t: "Reasoning & Cognitive Loop", d: "Resolves context ambiguity, queries vector storage, and cross-references historical dialog paths to formulate structured responses.", l: "~24ms", c: "8 Concurrency" },
      synthesize: { t: "Synthesis & Utterance", d: "Compiles response tokens back into localized waveform structures or UI prompt arrays. Triggers audio playback/dispatch channels.", l: "~15ms", c: "3 Concurrency" }
    };

    function selectThinkingNode(nodeId) {
      const details = thinkingNodeDetails[nodeId];
      if (!details) return;
      document.getElementById('thinking-stage-title').textContent = details.t;
      document.getElementById('thinking-stage-desc').textContent = details.d;
      document.getElementById('thinking-stage-latency').textContent = details.l;
      document.getElementById('thinking-stage-threads').textContent = details.c;

      ['ingest', 'perceive', 'act', 'reason', 'synthesize'].forEach(id => {
        const nodeG = document.getElementById(`node-${id}`);
        const halo = document.getElementById(`halo-${id}`);
        if (nodeG) {
          if (id === nodeId) {
            nodeG.setAttribute('fill', '#2563EB');
            if (halo) halo.classList.remove('opacity-0');
          } else {
            nodeG.setAttribute('fill', '#F1F5F9');
            if (halo) halo.classList.add('opacity-0');
          }
        }
      });
    }

    function selectAgent(agentKey) {
      currentAgent = agentKey;
      dialogueStep = 0;
      
      ['nex', 'aura', 'cyrus'].forEach(k => {
        const btn = document.getElementById(`agent-btn-${k}`);
        if (btn) {
          if (k === agentKey) {
            btn.className = 'py-3 px-2 text-center rounded-2xl bg-primary/5 border border-primary/20 text-primary transition-all font-orbitron text-[9px] font-bold tracking-wider flex flex-col items-center gap-1.5 cursor-pointer';

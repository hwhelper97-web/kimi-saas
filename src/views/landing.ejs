    // Synthesize voice
    function speakText(text) {
      if (!speechSynth) return;
      speechSynth.cancel(); // Cancel current speaking

      if (isMuted) return;

      activeUtterance = new SpeechSynthesisUtterance(text);
      activeUtterance.rate = 0.98; // Warm human speaking rate
      activeUtterance.pitch = currentAgent === 'cyrus' ? 0.92 : (currentAgent === 'aura' ? 1.08 : 0.97);

      // Select matching voice prioritizing high-fidelity, human-like neural voices
      const voices = speechSynth.getVoices();
      let selectedVoice = null;
      const lowerAgent = currentAgent.toLowerCase();

      // Priority list of voice searches for each agent to keep behavior identical/symmetrical
      if (lowerAgent === 'aura') {
        // Aura: Female natural voice (Jenny, Aria, Samantha, etc.)
        selectedVoice = 
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('jenny') && v.name.toLowerCase().includes('online')) ||
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('aria') && v.name.toLowerCase().includes('online')) ||
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('natural') && v.name.toLowerCase().includes('female')) ||
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('google') && v.name.toLowerCase().includes('female')) ||
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('samantha')) ||
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('female')) ||
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('zira'));
      } else if (lowerAgent === 'cyrus') {
        // Cyrus: Deep/Tech British or English Male voice (Andrew, Ryan, Daniel, etc.)
        selectedVoice = 
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('andrew') && v.name.toLowerCase().includes('online')) ||
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('ryan') && v.name.toLowerCase().includes('online')) ||
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('natural') && v.name.toLowerCase().includes('male')) ||
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('google') && v.name.toLowerCase().includes('uk') && v.name.toLowerCase().includes('male')) ||
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('daniel')) ||
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('david') && v.name.toLowerCase().includes('online')) ||
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('male')) ||
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('david'));
      } else {
        // Nex: Warm Friendly US Male voice (Guy, Steffan, Google Male, etc.)
        selectedVoice = 
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('guy') && v.name.toLowerCase().includes('online')) ||
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('steffan') && v.name.toLowerCase().includes('online')) ||
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('natural') && v.name.toLowerCase().includes('male')) ||
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('google') && v.name.toLowerCase().includes('us english') && v.name.toLowerCase().includes('male')) ||
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('google') && v.name.toLowerCase().includes('male')) ||
          voices.find(v => v.lang.startsWith('en') && v.name.toLowerCase().includes('male')) ||
          voices.find(v => v.lang.startsWith('en'));
      }

      if (!selectedVoice) {
        selectedVoice = voices.find(v => v.lang.startsWith('en'));
      }
      if (selectedVoice) activeUtterance.voice = selectedVoice;

      activeUtterance.onstart = () => {
        startWaveformAnimation();
        document.getElementById('call-status').innerText = 'AGENT SPEAKING...';
        document.getElementById('status-dot').className = 'relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500';
        updateSimulatorThinkingState('synthesizing');
      };

      activeUtterance.onend = () => {
        stopWaveformAnimation();
        document.getElementById('call-status').innerText = 'LISTENING...';
        document.getElementById('status-dot').className = 'relative inline-flex rounded-full h-2.5 w-2.5 bg-yellow-500 animate-pulse';
        updateSimulatorThinkingState('listening');
      };

      speechSynth.speak(activeUtterance);
    }


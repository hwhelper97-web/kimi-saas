            btn.className = 'py-3 px-2 text-center rounded-2xl bg-slate-50 border border-slate-100 text-textDim hover:text-primary transition-all font-orbitron text-[9px] font-bold tracking-wider flex flex-col items-center gap-1.5 cursor-pointer';
          }
        }
      });

      const log = document.getElementById('simulator-transcript');
      if (log) log.innerHTML = '';

      addTranscriptLine('SYS', `Initializing ${agentsData[agentKey].name} connection node...`);
      updateSimulatorThinkingState('connecting');

      setTimeout(() => {
        addTranscriptLine('SYS', 'Realtime socket link active.');

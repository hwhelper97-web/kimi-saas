    // Waveform Animation during Speaking
    function startWaveformAnimation() {
      if (waveInterval) clearInterval(waveInterval);
      waveInterval = setInterval(() => {
        for (let i = 1; i <= 14; i++) {
          const height = Math.floor(Math.random() * 48) + 8;
          const bar = document.getElementById(`sim-wave-${i}`);
          if (bar) bar.style.height = `${height}px`;
        }
      }, 100);
    }

    function stopWaveformAnimation() {
      if (waveInterval) clearInterval(waveInterval);
      for (let i = 1; i <= 14; i++) {
        const bar = document.getElementById(`sim-wave-${i}`);
        if (bar) bar.style.height = `8px`; // Return to low idle
      }
    }

    // Web Speech API - Recognition
    function initSpeechRecognition() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) {
        const micBtn = document.getElementById('mic-toggle-btn');
        if (micBtn) micBtn.style.display = 'none';
        return;
      }

      recognition = new SpeechRecognition();
      recognition.continuous = false;
      recognition.interimResults = false;
      recognition.lang = 'en-US';

      recognition.onstart = () => {
        isListening = true;
        const micBtn = document.getElementById('mic-toggle-btn');
        if (micBtn) {
          micBtn.innerHTML = '<svg class="w-4 h-4 text-red-500 animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="1" x2="23" y1="1" y2="23"></line><path d="M9 9v3a3 3 0 0 0 5.12 2.12M15 9.34V5a3 3 0 0 0-5.94-.6"></path><path d="M17 16.95A7 7 0 0 1 5 12v-2m14 0v2a7 7 0 0 1-.11 1.23"></path><line x1="12" x2="12" y1="19" y2="22"></line></svg>';
        }
        document.getElementById('call-status').innerText = 'RECORDING SPEECH...';
        updateSimulatorThinkingState('recording');
      };

      recognition.onend = () => {
        isListening = false;
        const micBtn = document.getElementById('mic-toggle-btn');
        if (micBtn) {
          micBtn.innerHTML = '<svg class="w-4 h-4 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v1a7 7 0 0 1-14 0v-1"></path><line x1="12" x2="12" y1="19" y2="22"></line></svg>';
        }
      };

      recognition.onresult = (event) => {
        const resultText = event.results[0][0].transcript;
        addTranscriptLine('USER', resultText);
        processUserInputText(resultText);
      };

      recognition.onerror = (e) => {
        console.error("Speech Recognition Error:", e);
      };
    }

    function toggleSpeechInput() {
      if (!recognition) return;
      if (isListening) {
        recognition.stop();
      } else {
        if (speechSynth) speechSynth.cancel();
        recognition.start();
      }
    }

    // Launch Simulator View
    function launchInteractiveVoice() {
      simulatorActive = true;
      document.getElementById('simulator-tabs').classList.add('hidden');
      document.getElementById('dashboard-mockup-view').classList.add('hidden');
      document.getElementById('visual-thinking-view').classList.add('hidden');
      document.getElementById('interactive-voice-view').classList.remove('hidden');
      
      // Reset simulator variables
      callSeconds = 0;
      document.getElementById('call-timer').innerText = '00:00';
      if (callTimerInterval) clearInterval(callTimerInterval);
      callTimerInterval = setInterval(() => {
        callSeconds++;
        const mins = String(Math.floor(callSeconds / 60)).padStart(2, '0');
        const secs = String(callSeconds % 60).padStart(2, '0');
        document.getElementById('call-timer').innerText = `${mins}:${secs}`;
      }, 1000);

      // Select default agent
      selectAgent('nex');

      // Initialize speech recognition if possible
      if (!recognition) initSpeechRecognition();
    }
 
    // Hangup Simulator
    function hangUpCall() {
      simulatorActive = false;
      if (callTimerInterval) clearInterval(callTimerInterval);
      if (waveInterval) clearInterval(waveInterval);
      if (speechSynth) speechSynth.cancel();
      if (recognition && isListening) recognition.stop();
 
      document.getElementById('interactive-voice-view').classList.add('hidden');
      document.getElementById('simulator-tabs').classList.remove('hidden');
      if (activeThinkingTab === 'dashboard') {
        document.getElementById('dashboard-mockup-view').classList.remove('hidden');
      } else {
        document.getElementById('visual-thinking-view').classList.remove('hidden');
      }
    }
 
    // Select Agent Profile
    function selectAgent(agentKey) {
      currentAgent = agentKey;
      dialogueStep = 0;
      
      // Update buttons active styling
      ['nex', 'aura', 'cyrus'].forEach(key => {
        const btn = document.getElementById(`agent-btn-${key}`);
        if (btn) {
          if (key === agentKey) {
            btn.className = 'py-2 px-1 text-center rounded bg-cyanaccent/15 border border-cyanaccent/40 text-white transition-all font-orbitron text-[9px] font-bold tracking-wider flex flex-col items-center gap-1 cursor-pointer';
          } else {
            btn.className = 'py-2 px-1 text-center rounded bg-black/40 border border-glassBorder text-textDim hover:text-white transition-all font-orbitron text-[9px] font-bold tracking-wider flex flex-col items-center gap-1 cursor-pointer';
          }
        }
      });
 
      // Clear Transcript log
      const log = document.getElementById('simulator-transcript');
      if (log) log.innerHTML = '';
      
      addTranscriptLine('SYS', `Connecting to ${agentsData[agentKey].name} Voice Node...`);
      updateSimulatorThinkingState('connecting');
      setTimeout(() => {
        addTranscriptLine('SYS', `Realtime media connection active.`);
        addTranscriptLine('AGENT', agentsData[agentKey].initText);
        speakText(agentsData[agentKey].initText);
        populateDialoguePresets();
      }, 700);
    }

    // Add line to terminal transcript
    function addTranscriptLine(sender, text) {
      const log = document.getElementById('simulator-transcript');
      if (!log) return;
      const div = document.createElement('div');
      
      if (sender === 'SYS') {
        div.className = 'text-cyanaccent/60';
        div.innerText = `[SYS] ${text}`;
      } else if (sender === 'AGENT') {
        div.className = 'text-white';
        div.innerHTML = `<span class="text-cyanaccent">[${agentsData[currentAgent].name}]</span> ${text}`;
      } else {
        div.className = 'text-slate-300';
        div.innerHTML = `<span class="text-tealaccent">[USER]</span> ${text}`;
      }
      
      log.appendChild(div);
      log.scrollTop = log.scrollHeight;
    }

    // Populate Suggested Replies (dialogue presets)
    function populateDialoguePresets() {
      const container = document.getElementById('dialogue-presets');
      if (!container) return;
      container.innerHTML = '';

      const stepData = agentsData[currentAgent].dialogue[dialogueStep];
      if (!stepData || !stepData.replies) return;

      stepData.replies.forEach(reply => {
        const btn = document.createElement('button');
        btn.className = 'px-2.5 py-1 text-[9px] font-bold font-mono border border-glassBorder rounded bg-white/5 text-slate-300 hover:border-cyanaccent/30 hover:text-cyanaccent transition-all cursor-pointer';
        btn.innerText = reply.label;
        btn.onclick = () => selectDialogueOption(reply.text, reply.nextStep);
        container.appendChild(btn);
      });
    }

    // Select a dialogue option
    function selectDialogueOption(text, nextStep) {
      addTranscriptLine('USER', text);
      
      updateSimulatorThinkingState('perceiving');
      setTimeout(() => {
        updateSimulatorThinkingState('reasoning');
      }, 300);
      
      if (nextStep === 'hangup') {
        setTimeout(() => hangUpCall(), 1200);
        return;
      }

      dialogueStep = nextStep;
      
      // Wait a bit, show thinking, then reply
      setTimeout(() => {
        const stepData = agentsData[currentAgent].dialogue[dialogueStep];
        if (stepData && stepData.text) {
          addTranscriptLine('AGENT', stepData.text);
          speakText(stepData.text);
        }
        populateDialoguePresets();
      }, 700);
    }

    // Process typed response
    function processUserInputText(inputText) {
      if (!inputText.trim()) return;
      
      updateSimulatorThinkingState('perceiving');
      setTimeout(() => {
        updateSimulatorThinkingState('reasoning');
      }, 300);
      
      // Match key terms or respond generically
      let matchedStep = null;
      const stepData = agentsData[currentAgent].dialogue[dialogueStep];
      
      if (stepData && stepData.replies) {
        // Find best match in replies
        const lowerInput = inputText.toLowerCase();
        let bestMatch = null;
        let highestScore = 0;
        
        stepData.replies.forEach(reply => {
          const words = reply.text.toLowerCase().split(' ');
          let matchCount = 0;
          words.forEach(w => {
            if (lowerInput.includes(w) && w.length > 3) matchCount++;
          });
          if (matchCount > highestScore) {
            highestScore = matchCount;
            bestMatch = reply;
          }
        });

        if (bestMatch) {
          matchedStep = bestMatch.nextStep;
        }
      }

      if (matchedStep !== null) {
        if (matchedStep === 'hangup') {
          setTimeout(() => hangUpCall(), 1200);
          return;
        }
        dialogueStep = matchedStep;
        setTimeout(() => {
          const nextData = agentsData[currentAgent].dialogue[dialogueStep];
          if (nextData && nextData.text) {
            addTranscriptLine('AGENT', nextData.text);
            speakText(nextData.text);
          }
          populateDialoguePresets();
        }, 700);
      } else {
        // Generic AI fallback response
        setTimeout(() => {
          const genericReplies = {
            nex: "I understand. Would you like to order a Nexton Classic Burger or check our timings?",
            aura: "Understood. I can help with booking Swedish or Deep Tissue massage, or other therapies. What works best?",
            cyrus: "Copy that. Please verify your connection headers, or tell me if you need database token rotation details."
          };
          const reply = genericReplies[currentAgent];
          addTranscriptLine('AGENT', reply);
          speakText(reply);
        }, 800);
      }
    }

    function handleInputKeydown(event) {
      if (event.key === 'Enter') {
        const input = document.getElementById('sim-user-input');
        if (input) {
          const text = input.value.trim();
          if (text) {
            addTranscriptLine('USER', text);
            processUserInputText(text);
            input.value = '';
          }
        }
      }
    }


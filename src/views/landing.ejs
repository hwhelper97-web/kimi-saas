        <a href="#solutions" class="hover:text-cyanaccent transition-colors">SOLUTIONS</a>
        <a href="#products" class="hover:text-cyanaccent transition-colors">PRODUCTS</a>
        <a href="#technologies" class="hover:text-cyanaccent transition-colors">TECHNOLOGIES</a>
        <a href="#portfolio" class="hover:text-cyanaccent transition-colors">PORTFOLIO</a>
        <a href="#about" class="hover:text-cyanaccent transition-colors">ABOUT</a>
        <a href="#contact" class="hover:text-cyanaccent transition-colors">CONTACT</a>
      </nav>

      <!-- Action Buttons -->
      <div class="hidden md:flex items-center gap-4">
        <a href="#contact" class="px-5 py-2.5 rounded-lg border border-cyanaccent/30 text-xs font-bold font-orbitron tracking-widest text-cyanaccent bg-cyanaccent/5 hover:bg-cyanaccent/10 hover:border-cyanaccent/50 transition-all">
          BOOK CONSULTATION
        </a>
        <a href="/login" class="px-5 py-2.5 rounded-lg text-xs font-bold font-orbitron tracking-widest text-white btn-premium">
          GET STARTED

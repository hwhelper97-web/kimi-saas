  <!-- ==================== SCRIPTS & DYNAMIC BEHAVIORS ==================== -->
  <script>
    // Initialize Lucide Icons
    if (typeof lucide !== 'undefined') {
      try {
        lucide.createIcons();
      } catch (e) {
        console.warn('Lucide failed to render:', e);
      }
    }

    // Mobile Menu Toggles
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const closeMenuBtn = document.getElementById('close-menu-btn');
    const mobileNav = document.getElementById('mobile-nav');
    const mobileNavBackdrop = document.getElementById('mobile-nav-backdrop');

    mobileMenuBtn.addEventListener('click', () => {
      mobileNav.classList.remove('translate-x-full');
      mobileNavBackdrop.classList.remove('hidden');
    });

    const closeMobileNav = () => {
      mobileNav.classList.add('translate-x-full');
      mobileNavBackdrop.classList.add('hidden');
    };

    closeMenuBtn.addEventListener('click', closeMobileNav);
    mobileNavBackdrop.addEventListener('click', closeMobileNav);
    document.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', closeMobileNav);
    });

    // Header Scroll Shadow effect
    const header = document.getElementById('site-header');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 30) {
        header.classList.add('shadow-[0_8px_32px_rgba(15,23,42,0.06)]', 'bg-white/95');
        header.classList.remove('shadow-[0_8px_32px_rgba(15,23,42,0.04)]', 'bg-white/80');
      } else {
        header.classList.add('shadow-[0_8px_32px_rgba(15,23,42,0.04)]', 'bg-white/80');
        header.classList.remove('shadow-[0_8px_32px_rgba(15,23,42,0.06)]', 'bg-white/95');
      }
    });

    // Testimonial Slider Controls
    let currentSlideIndex = 0;
    const slides = document.querySelectorAll('.testimonial-slide');
    const dots = document.querySelectorAll('[id^="dot-"]');

    function showSlide(index) {
      slides.forEach((slide, idx) => {
        if (idx === index) {
          slide.classList.remove('opacity-0', 'translate-x-12', 'pointer-events-none');
          slide.classList.add('opacity-100', 'translate-x-0');
          slide.removeAttribute('style');
        } else {
          slide.classList.remove('opacity-100', 'translate-x-0');
          slide.classList.add('opacity-0', 'translate-x-12', 'pointer-events-none');
          slide.style.position = 'absolute';
        }
      });
      dots.forEach((dot, idx) => {
        if (idx === index) {
          dot.classList.add('bg-primary');
          dot.classList.remove('bg-slate-200');
        } else {
          dot.classList.add('bg-slate-200');
          dot.classList.remove('bg-primary');
        }
      });
      currentSlideIndex = index;
    }

    function nextTestimonial() {
      let next = (currentSlideIndex + 1) % slides.length;
      showSlide(next);
    }
    function prevTestimonial() {
      let prev = (currentSlideIndex - 1 + slides.length) % slides.length;
      showSlide(prev);
    }
    function goToSlide(index) {
      showSlide(index);
    }
    setInterval(nextTestimonial, 7000);

    // FAQ Accordions Toggle Logic
    function toggleFaq(btn) {
      const parent = btn.parentElement;
      const content = parent.querySelector('div');
      const icon = btn.querySelector('i');
      
      document.querySelectorAll('.faq-active').forEach(item => {
        if (item !== parent) {
          item.classList.remove('faq-active');
          item.querySelector('div').style.maxHeight = '0px';
          item.querySelector('i').style.transform = 'rotate(0deg)';
        }
      });

      if (parent.classList.contains('faq-active')) {
        parent.classList.remove('faq-active');
        content.style.maxHeight = '0px';
        icon.style.transform = 'rotate(0deg)';
      } else {
        parent.classList.add('faq-active');
        content.style.maxHeight = content.scrollHeight + 'px';
        icon.style.transform = 'rotate(45deg)';
      }
    }

    // Modal consultation trigger
    function openConsultationModal() {
      document.getElementById('consultation-modal').classList.add('modal-active');
      document.getElementById('consultation-form-view').classList.remove('hidden');
      document.getElementById('consultation-success-view').classList.add('hidden');
    }
    function closeConsultationModal() {
      document.getElementById('consultation-modal').classList.remove('modal-active');
    }
    function handleConsultationSubmit(e) {
      e.preventDefault();
      document.getElementById('submit-btn-spinner').classList.remove('hidden');
      document.getElementById('submit-btn-text').textContent = 'SUBMITTING...';
      
      const name = document.getElementById('consult-name').value;
      const email = document.getElementById('consult-email').value;
      const company = document.getElementById('consult-company').value;
      const tier = document.getElementById('consult-tier').value;
      const details = document.getElementById('consult-details').value;

      setTimeout(() => {
        document.getElementById('submit-btn-spinner').classList.add('hidden');
        document.getElementById('submit-btn-text').textContent = 'SUBMIT REQUEST';
        
        const ticketNum = 'NX-' + Math.floor(10000 + Math.random() * 90000);
        document.getElementById('success-ticket-id').textContent = ticketNum;
        document.getElementById('success-name').textContent = name;
        
        const focusNames = {
          voice: 'Nexa Voice AI Synthetics',
          saas: 'SaaS Multi-tenant',
          automation: 'Workflow Automation',
          custom: 'Bespoke Enterprise Systems'
        };
        document.getElementById('success-tier').textContent = focusNames[tier] || tier;
        
        document.getElementById('consultation-form-view').classList.add('hidden');
        document.getElementById('consultation-success-view').classList.remove('hidden');
        document.getElementById('consultation-form').reset();
      }, 1500);
    }

    // Product Preview Modals
    function openProductPreview(productKey) {
      const modal = document.getElementById('product-preview-modal');
      ['core', 'flow', 'voice', 'enterprise'].forEach(t => {
        document.getElementById(`preview-${t}`).classList.add('hidden');
      });
      document.getElementById(`preview-${productKey}`).classList.remove('hidden');
      modal.classList.add('modal-active');
    }
    function closeProductPreview() {
      document.getElementById('product-preview-modal').classList.remove('modal-active');
      stopFlowSimulation();
    }

    // Webhook Flow logs Simulator
    function triggerFlowSimulation() {
      const logs = document.getElementById('flow-logs');
      const status = document.getElementById('flow-status');
      logs.innerHTML = '';
      status.textContent = 'RUNNING...';
      status.className = 'text-primary animate-pulse';

      const steps = [
        { m: '[WEBHOOK] Incoming POST payload on /api/v1/stripe-checkout', d: 100 },
        { m: '[AUTH] Validating signature hashes... OK', d: 600 },
        { m: '[LEDGER] Adding order log to Postgres table... OK', d: 1100 },
        { m: '[NOTIFICATION] Dispatching real-time AI Voice Telemetry...', d: 1600 },
        { m: '[SUCCESS] Flow execution finished successfully.', d: 2200 }
      ];

      steps.forEach(s => {
        setTimeout(() => {
          const d = document.createElement('div');
          d.textContent = s.m;
          d.className = s.m.includes('SUCCESS') ? 'text-success font-bold' : 'text-slate-300';
          logs.appendChild(d);
          logs.scrollTop = logs.scrollHeight;
          if (s.m.includes('SUCCESS')) {
            status.textContent = 'COMPLETED';
            status.className = 'text-success font-bold';
          }
        }, s.d);
      });
    }
    function stopFlowSimulation() {
      const logs = document.getElementById('flow-logs');
      if (logs) logs.innerHTML = '<div class="text-primary/40">[SYS] Ready for simulation trigger.</div>';
      const status = document.getElementById('flow-status');
      if (status) {
        status.textContent = 'IDLE';
        status.className = 'text-primary';
      }

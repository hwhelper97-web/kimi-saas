  <!-- 🛠️ Services Section -->
  <section class="py-24 px-6 relative" id="services">
    <div class="max-w-7xl mx-auto relative z-10">
      
      <!-- Section Title -->
      <div class="max-w-3xl mx-auto text-center mb-20">
        <span class="text-xs font-bold font-orbitron tracking-[4px] text-primary uppercase">Our Core Competencies</span>
        <h2 class="font-orbitron font-black text-3xl sm:text-4xl text-textMain mt-2 mb-4">PREMIUM ENGINEERING SERVICES</h2>
        <div class="w-16 h-1 bg-gradient-to-r from-primary to-secondary mx-auto rounded-full"></div>
      </div>

      <!-- Services Grid (11 items) with solid visible icon backgrounds -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- Service Item 1 -->
        <div class="glass-card rounded-3xl p-8 relative flex flex-col justify-between h-80">

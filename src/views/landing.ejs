<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <%
    const safeProjectName = typeof projectName !== 'undefined' ? projectName : 'Naxton Technologies';
    const safeLandingLogo = typeof landingLogo !== 'undefined' ? landingLogo : null;
    const safeLogoMain = typeof logoMain !== 'undefined' ? logoMain : 'NAXTON';
    const safeLogoSub = typeof logoSub !== 'undefined' ? logoSub : 'TECH';
  %>

  <!-- SEO Optimization -->
  <title><%= safeProjectName %> | Engineering Intelligent Software for Modern Businesses</title>
  <meta name="description" content="Naxton Technologies builds enterprise AI software, SaaS platforms, cloud infrastructure, automation systems, and intelligent digital products for startups and enterprises worldwide." />
  <meta name="keywords" content="AI Software Development, AI Solutions Company, Custom Software Development, Enterprise AI, SaaS Development, Business Automation, AI Voice Solutions, Cloud Development, Digital Transformation, Technology Consulting" />
  <link rel="canonical" href="https://naxtontechnologies.com/" />
  
  <!-- Robots Meta -->
  <meta name="robots" content="index, follow" />
  
  <!-- OpenGraph Metadata -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= safeProjectName %> | Enterprise AI & Custom Software" />
  <meta property="og:description" content="Engineering Intelligent Software for Modern Businesses. Discover next-gen AI Agents, custom SaaS, and automation loops." />
  <meta property="og:url" content="https://naxtontechnologies.com/" />
  <meta property="og:image" content="https://naxtontechnologies.com/logo.svg" />
  
  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= safeProjectName %>" />
  <meta name="twitter:description" content="Naxton Technologies builds next-gen enterprise AI and custom SaaS architectures." />
  
  <link rel="icon" type="image/png" href="<%= safeLandingLogo || '' %>">
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.435.0/dist/umd/lucide.min.js"></script>

  <!-- Tailwind Configuration -->
  <script>
    if (typeof tailwind !== 'undefined') {
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: '#2563EB',
              secondary: '#38BDF8',
              accent: '#7DD3FC',
              success: '#10B981',
              textMain: '#0F172A',
              textDim: '#475569',
              borderLight: '#E2E8F0',
            },
            fontFamily: {
              orbitron: ['Orbitron', 'sans-serif'],
              sans: ['Plus Jakarta Sans', 'sans-serif'],
            }
          }
        }
      };
    }
  </script>

  <!-- Custom CSS for Animations and Custom Layouts -->
  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #F8FBFF;
    }
    ::-webkit-scrollbar-thumb {
      background: #CBD5E1;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94A3B8;
    }

    /* Spotlights & Blobs */
    .spotlight-blob {
      background: radial-gradient(circle, rgba(14, 165, 233, 0.08) 0%, transparent 65%);
      filter: blur(40px);
      pointer-events: none;
    }

    /* Premium Glass Cards */
    .glass-card {
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(15, 23, 42, 0.06);
      box-shadow: 0 10px 30px -10px rgba(14, 165, 233, 0.04);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .glass-card:hover {
      border-color: rgba(37, 99, 235, 0.15);
      box-shadow: 0 20px 40px -15px rgba(37, 99, 235, 0.08);
      transform: translateY(-4px);
    }

    /* Modal Backdrop Blur */
    .modal-active {
      display: flex !important;
      animation: fadeIn 0.3s ease-out;
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    /* Tech Logos Horizontal Scroll */
    @keyframes scroll {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .logo-scroll-track {
      display: flex;
      width: calc(250px * 28);
      animation: scroll 40s linear infinite;
    }
    .logo-scroll-track:hover {
      animation-play-state: paused;
    }

    /* Glow on Hover Outline */
    .btn-gradient {
      background: linear-gradient(to right, #2563EB, #38BDF8);
      transition: all 0.3s ease;
    }
    .btn-gradient:hover {
      box-shadow: 0 4px 18px rgba(37, 99, 235, 0.3);
      filter: brightness(1.05);
    }
  </style>

  <!-- JSON-LD Structured Data Schema.org declarations -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "<%= safeProjectName %>",
      "url": "https://naxtontechnologies.com/",
      "logo": "https://naxtontechnologies.com/logo.svg",
      "description": "Naxton Technologies builds enterprise AI software, SaaS platforms, cloud infrastructure, automation systems, and intelligent digital products.",
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "contact@naxtontechnologies.com",
        "contactType": "customer support"
      },
      "sameAs": [
        "https://github.com/naxton-tech"
      ]
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "<%= safeProjectName %>",
      "image": "https://naxtontechnologies.com/logo.svg",
      "telephone": "",
      "email": "contact@naxtontechnologies.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "California",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "37.7749",
        "longitude": "-122.4194"
      },
      "url": "https://naxtontechnologies.com"
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [{
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://naxtontechnologies.com/"
      }]
    }
  </script>
</head>

<body class="bg-white text-textMain font-sans antialiased overflow-x-hidden">


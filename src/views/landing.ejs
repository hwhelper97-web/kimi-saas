    function updateSimulatorThinkingState(state) {
      const statusText = document.getElementById('sim-thinking-status-text');
      const stepText = document.getElementById('sim-thinking-step-text');
      
      const nodes = ['ingest', 'perceive', 'act', 'reason', 'synthesize'];
      
      nodes.forEach(id => {
        const nodeG = document.getElementById(`sim-node-${id}`);
        const halo = document.getElementById(`sim-halo-${id}`);
        if (nodeG) nodeG.classList.remove('active-stage');
        if (halo) halo.classList.add('opacity-0');
      });
      
      const links = ['ingest-perceive', 'ingest-act', 'perceive-reason', 'act-reason', 'reason-synthesize'];
      links.forEach(l => {
        const path = document.getElementById(`sim-link-${l}`);
        if (path) path.classList.remove('active-link');
      });

      if (state === 'dialing' || state === 'connecting') {
        if (statusText) statusText.innerText = "Cognitive Engine: Dialing";
        if (stepText) stepText.innerText = "initializing line connection";
        
        const nodeIngest = document.getElementById('sim-node-ingest');
        const haloIngest = document.getElementById('sim-halo-ingest');
        if (nodeIngest) nodeIngest.classList.add('active-stage');
        if (haloIngest) haloIngest.classList.remove('opacity-0');

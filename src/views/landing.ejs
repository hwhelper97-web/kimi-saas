      else if (state === 'listening') {
        if (statusText) statusText.innerText = "Cognitive Engine: Listening";
        if (stepText) stepText.innerText = "listening to user audio stream";
        
        const nodeIngest = document.getElementById('sim-node-ingest');
        const haloIngest = document.getElementById('sim-halo-ingest');
        if (nodeIngest) nodeIngest.classList.add('active-stage');
        if (haloIngest) haloIngest.classList.remove('opacity-0');
      }
      else if (state === 'recording') {
        if (statusText) statusText.innerText = "Cognitive Engine: Ingesting";
        if (stepText) stepText.innerText = "converting speech to text tokens";
        
        const nodeIngest = document.getElementById('sim-node-ingest');
        const haloIngest = document.getElementById('sim-halo-ingest');
        const nodePerceive = document.getElementById('sim-node-perceive');
        const haloPerceive = document.getElementById('sim-halo-perceive');

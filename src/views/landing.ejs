    let callTimerInterval = null;
    let callSeconds = 0;
    let currentAgent = 'nex';
    let dialogueStep = 0;
    let isMuted = false;
    let speechSynth = window.speechSynthesis;
    let activeUtterance = null;
    let waveInterval = null;

        </button>
      </div>
      <nav class="flex flex-col gap-6 text-sm font-semibold tracking-widest text-textDim mb-12">
        <a href="#" class="mobile-link hover:text-cyanaccent transition-colors">HOME</a>
        <a href="#services" class="mobile-link hover:text-cyanaccent transition-colors">SERVICES</a>
        <a href="#solutions" class="mobile-link hover:text-cyanaccent transition-colors">SOLUTIONS</a>
        <a href="#products" class="mobile-link hover:text-cyanaccent transition-colors">PRODUCTS</a>
        <a href="#technologies" class="mobile-link hover:text-cyanaccent transition-colors">TECHNOLOGIES</a>
        <a href="#portfolio" class="mobile-link hover:text-cyanaccent transition-colors">PORTFOLIO</a>
        <a href="#about" class="mobile-link hover:text-cyanaccent transition-colors">ABOUT</a>
        <a href="#contact" class="mobile-link hover:text-cyanaccent transition-colors">CONTACT</a>
      </nav>
      <div class="flex flex-col gap-4">
        <a href="#contact" class="mobile-link w-full text-center py-3 rounded-lg border border-cyanaccent/30 text-xs font-bold font-orbitron tracking-wider text-cyanaccent bg-cyanaccent/5 hover:bg-cyanaccent/10 transition-colors">

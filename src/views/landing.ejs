<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= projectName %> | Next-Gen AI & Enterprise SaaS Platforms</title>
  <link rel="icon" type="image/png" href="<%= platformLogo || '' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  
  <!-- Tailwind Play CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.435.0/dist/umd/lucide.min.js"></script>

  <!-- Tailwind Configuration -->
  <script>
    if (typeof tailwind !== 'undefined') {
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              darkest: 'var(--bg-darkest)',
              cyanaccent: 'var(--accent-cyan)',
              tealaccent: 'var(--accent-teal)',
              glassBg: 'var(--glass-bg)',
              glassBorder: 'var(--glass-border)',
              textMain: 'var(--text-main)',
              textDim: 'var(--text-dim)',
            },
            fontFamily: {
              orbitron: ['Orbitron', 'sans-serif'],
              sans: ['Plus Jakarta Sans', 'sans-serif'],
            }
          }
        }
      };
    }
  </script>

  <!-- Custom CSS for Glow Effects and Animations -->
  <style>
    :root {
      --bg-darkest: #050505;
      --bg-gradient-start: #072129;
      --bg-gradient-end: #031014;
      --accent-cyan: #22d3ee;
      --accent-teal: #00bcd4;
      --accent-rgb: 34, 211, 238;
      --glass-bg: rgba(4, 17, 22, 0.95);
      --glass-border: rgba(34, 211, 238, 0.1);
      --btn-gradient: linear-gradient(to right, #042B33, #063944, #0A4A57);
      --text-main: #f8fafc;
      --text-dim: #94a3b8;
      --btn-secondary: rgba(255, 255, 255, 0.05);
    }

    .theme-teal {
      --bg-darkest: #050505;
      --bg-gradient-start: #072129;
      --bg-gradient-end: #031014;
      --accent-cyan: #22d3ee;
      --accent-teal: #00bcd4;
      --accent-rgb: 34, 211, 238;
      --glass-bg: rgba(4, 17, 22, 0.95);
      --glass-border: rgba(34, 211, 238, 0.1);
      --btn-gradient: linear-gradient(to right, #042B33, #063944, #0A4A57);
      --text-main: #f8fafc;
      --text-dim: #94a3b8;
      --btn-secondary: rgba(255, 255, 255, 0.05);
    }



    * {
      scroll-behavior: smooth;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: var(--bg-darkest);
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(34, 211, 238, 0.2);
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(34, 211, 238, 0.4);
    }

    /* Background Gradients & Grids */
    .bg-gradient-mesh {
      background: linear-gradient(135deg, var(--bg-gradient-start) 0%, var(--bg-gradient-end) 100%);
    }

    .bg-grid-mesh {
      background-image: radial-gradient(circle at 1.5px 1.5px, rgba(var(--accent-rgb), 0.04) 1px, transparent 0);
      background-size: 40px 40px;
    }

    /* Glassmorphism Classes */
    .glass-card {
      background: rgba(4, 21, 27, 0.6);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(34, 211, 238, 0.08);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4);
    }

    .glass-card:hover {
      border-color: rgba(34, 211, 238, 0.2);
      box-shadow: 0 8px 32px 0 rgba(34, 211, 238, 0.05);
    }

    .glass-header {
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(34, 211, 238, 0.08);
      background: rgba(4, 13, 18, 0.75);
    }

    /* Glow Circles */
    .radial-glow-1 {
      background: radial-gradient(circle, rgba(34, 211, 238, 0.06) 0%, transparent 70%);
      filter: blur(100px);
    }

    .radial-glow-2 {
      background: radial-gradient(circle, rgba(0, 188, 212, 0.05) 0%, transparent 65%);
      filter: blur(80px);
    }

    /* Custom Button Style matching Login page */
    .btn-premium {
      background: var(--btn-gradient);
      border: 1px solid rgba(34, 211, 238, 0.15);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-premium:hover {
      box-shadow: 0 0 20px rgba(34, 211, 238, 0.35);
      border-color: rgba(34, 211, 238, 0.4);
      transform: translateY(-1px);
    }

    /* AI Visual Thinking Graph Styles */
    .thinking-node {
      transition: all 0.3s ease;
    }
    .thinking-node circle {
      transition: all 0.3s ease;
    }
    .thinking-node text {
      transition: all 0.3s ease;
    }
    .thinking-node.active-stage circle:first-of-type {
      stroke: var(--accent-cyan);
      fill: rgba(34, 211, 238, 0.2);
      filter: drop-shadow(0 0 6px rgba(34, 211, 238, 0.6));
    }
    .thinking-node.active-stage circle:last-of-type {
      fill: var(--accent-cyan);
      filter: drop-shadow(0 0 3px rgba(34, 211, 238, 0.8));
    }
    .thinking-node.active-stage + text {
      fill: #f8fafc !important;
    }
    .thinking-link {
      transition: all 0.3s ease;
    }
    .thinking-link.active-link {
      stroke: var(--accent-cyan);
      stroke-width: 2px;
      filter: drop-shadow(0 0 3px rgba(34, 211, 238, 0.5));
    }
    .packet-particle {
      filter: drop-shadow(0 0 2px var(--accent-cyan));
    }

    /* Jarvis HUD Keyframes and Classes */
    @keyframes hud-pulse-ring {
      0% { r: 10px; opacity: 0.8; stroke-width: 1.5px; }
      100% { r: 95px; opacity: 0; stroke-width: 0.5px; }
    }
    .animate-hud-pulse-ring-1 {
      animation: hud-pulse-ring 3s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
    }
    .animate-hud-pulse-ring-2 {
      animation: hud-pulse-ring 3s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
      animation-delay: 1.5s;
    }
    @keyframes scanline {
      0% { transform: translateY(-100%); }
      100% { transform: translateY(100%); }
    }
    .animate-scanline {
      animation: scanline 6s linear infinite;
    }
    @keyframes spin-clockwise {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    @keyframes spin-counterclockwise {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(-360deg); }
    }
    .animate-spin-cw {
      animation: spin-clockwise 15s linear infinite;
    }
    .animate-spin-ccw {
      animation: spin-counterclockwise 12s linear infinite;
    }
    .animate-spin-cw-fast {
      animation: spin-clockwise 3s linear infinite;
    }
    .animate-spin-ccw-fast {
      animation: spin-counterclockwise 2.5s linear infinite;
    }
    @keyframes segment-chaser {
      0%, 100% { opacity: 0.35; filter: drop-shadow(0 0 0px transparent); }
      50% { opacity: 1; filter: drop-shadow(0 0 3px var(--accent-cyan)); }
    }
    .seg-block-0 { animation: segment-chaser 2s infinite; animation-delay: 0.0s; }
    .seg-block-1 { animation: segment-chaser 2s infinite; animation-delay: 0.15s; }
    .seg-block-2 { animation: segment-chaser 2s infinite; animation-delay: 0.3s; }
    .seg-block-3 { animation: segment-chaser 2s infinite; animation-delay: 0.45s; }
    .seg-block-4 { animation: segment-chaser 2s infinite; animation-delay: 0.6s; }
    .seg-block-5 { animation: segment-chaser 2s infinite; animation-delay: 0.75s; }
    .seg-block-6 { animation: segment-chaser 2s infinite; animation-delay: 0.9s; }
    .seg-block-7 { animation: segment-chaser 2s infinite; animation-delay: 1.05s; }
    .seg-block-8 { animation: segment-chaser 2s infinite; animation-delay: 1.2s; }
    .seg-block-9 { animation: segment-chaser 2s infinite; animation-delay: 1.35s; }

    @keyframes scroll-log {
      0% { transform: translateY(0); }
      100% { transform: translateY(-50%); }
    }
    .animate-scroll-log {
      animation: scroll-log 18s linear infinite;
    }
    .jarvis-hud-container {
      position: relative;
      background: transparent;
      border: none;
      padding: 0;
      backdrop-filter: none;
      box-shadow: none;
    }

    .hud-grid-bg {
      background-size: 60px 60px;
      background-image: 
        linear-gradient(to right, rgba(var(--accent-rgb), 0.02) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(var(--accent-rgb), 0.02) 1px, transparent 1px);
    }

    .hud-notched-card {
      position: relative;
      background: rgba(0, 0, 0, 0.45);
      border: 1px solid var(--glass-border);
      clip-path: polygon(
        0px 10px, 
        10px 0px, 
        100% 0px, 
        100% calc(100% - 10px), 
        calc(100% - 10px) 100%, 
        0px 100%
      );
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .hud-notched-card:hover {
      border-color: rgba(var(--accent-rgb), 0.35);
      box-shadow: 0 0 20px rgba(var(--accent-rgb), 0.12);
      transform: translateY(-2px);
    }

    /* Advanced CRT scanlines and sweeps */
    .hud-scanlines {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        rgba(18, 16, 16, 0) 50%, 
        rgba(0, 0, 0, 0.25) 50%
      );
      background-size: 100% 4px;
      z-index: 2;
      pointer-events: none;
      opacity: 0.35;
    }
    .hud-sweep-line {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        to bottom,
        transparent 0%,
        rgba(var(--accent-rgb), 0.08) 50%,
        transparent 100%
      );
      z-index: 2;
      pointer-events: none;
      animation: sweep-down 10s linear infinite;
    }
    @keyframes sweep-down {
      0% { transform: translateY(-100%); }
      100% { transform: translateY(100%); }
    }

    /* Communication dash animations */
    @keyframes dash {
      to {
        stroke-dashoffset: -20;
      }
    }
    .animate-dash-line {
      stroke-dasharray: 5, 5;
      animation: dash 1.5s linear infinite;
    }

    /* Interactive Cursor HUD Reticle */
    .hud-cursor-reticle {
      position: fixed;
      width: 72px;
      height: 72px;
      pointer-events: none;
      z-index: 100;
      transform: translate(-50%, -50%) scale(0.9);
      opacity: 0;
      transition: opacity 0.3s ease, transform 0.15s cubic-bezier(0.25, 1, 0.5, 1);
      mix-blend-mode: screen;
    }
    .hud-cursor-reticle.active {
      opacity: 1;
    }
    .hud-cursor-reticle.clicking {
      transform: translate(-50%, -50%) scale(1.4);
    }
    .hud-cursor-coords {
      font-family: monospace;
      font-size: 6.5px;
      color: var(--accent-cyan);
      text-shadow: 0 0 3px rgba(var(--accent-rgb), 0.5);
      white-space: nowrap;
      position: absolute;
      left: 44px;
      top: 44px;
      pointer-events: none;
    }

    /* Sci-Fi HUD button */
    .btn-hud-cta {
      position: relative;
      background: rgba(var(--accent-rgb), 0.04);
      border: 1px solid rgba(var(--accent-rgb), 0.2);
      clip-path: polygon(
        0 0,
        calc(100% - 12px) 0,
        100% 12px,
        100% 100%,
        12px 100%,
        0 calc(100% - 12px)
      );
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .btn-hud-cta::before {
      content: '';
      position: absolute;
      inset: 2px;
      border: 1px solid rgba(var(--accent-rgb), 0.08);
      clip-path: polygon(
        0 0,
        calc(100% - 11px) 0,
        100% 11px,
        100% 100%,
        11px 100%,
        0 calc(100% - 11px)
      );
      pointer-events: none;
    }
    .btn-hud-cta:hover {
      background: rgba(var(--accent-rgb), 0.12);
      border-color: var(--accent-cyan);
      box-shadow: 0 0 15px rgba(var(--accent-rgb), 0.25);
      color: #ffffff;
    }

    .nav-active-indicator {
      position: relative;
    }

    .nav-active-indicator::after {
      content: '';
      position: absolute;
      bottom: -6px;
      left: 50%;
      transform: translateX(-50%);
      width: 14px;
      height: 2px;
      background-color: var(--accent-cyan);
      box-shadow: 0 0 8px var(--accent-cyan);
      border-radius: 1px;
      transition: all 0.3s ease;
    }

    /* Scroll Reveals */
    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .reveal.active {
      opacity: 1;
      transform: translateY(0);
    }

    /* Staggered items inside active reveal container */
    .stagger-reveal > * {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .stagger-reveal.active > * {
      opacity: 1;
      transform: translateY(0);
    }

    /* Interactive waveform */
    .waveform-bar {
      animation: bounceWave 1.4s ease-in-out infinite alternate;
    }

    @keyframes bounceWave {
      0% { height: 10%; }
      100% { height: 100%; }
    }

    /* Floating Animations */
    .float-slow {
      animation: floating 8s ease-in-out infinite;
    }
    .float-medium {
      animation: floating 6s ease-in-out infinite;
    }
    .float-fast {
      animation: floating 4.5s ease-in-out infinite;
    }

    @keyframes floating {
      0% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-10px) rotate(1deg); }
      100% { transform: translateY(0px) rotate(0deg); }
    }

    /* Timeline glow track */
    .timeline-track {
      background: linear-gradient(to bottom, rgba(34, 211, 238, 0.4) 0%, rgba(0, 188, 212, 0.1) 80%, transparent 100%);
    }

    /* Pulse active node */
    .node-pulse {
      animation: nodePulse 2s infinite;
    }
    @keyframes nodePulse {
      0% { box-shadow: 0 0 0 0 rgba(34, 211, 238, 0.6); }
      70% { box-shadow: 0 0 0 8px rgba(34, 211, 238, 0); }
      100% { box-shadow: 0 0 0 0 rgba(34, 211, 238, 0); }
    }

    #mobile-nav {
      background-color: var(--bg-darkest) !important;
    }

    /* Premium Button Shimmer & Scale Updates */
    .btn-premium {
      position: relative;
      background: var(--btn-gradient);
      border: 1px solid rgba(var(--accent-rgb), 0.2);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
      color: #ffffff !important;
    }
    .btn-premium::after {
      content: '';
      position: absolute;
      top: 0;
      left: -50%;
      width: 200%;
      height: 100%;
      background: linear-gradient(
        to right,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.15) 30%,
        rgba(255, 255, 255, 0.3) 50%,
        rgba(255, 255, 255, 0.15) 70%,
        rgba(255, 255, 255, 0) 100%
      );
      transform: skewX(-25deg);
      transition: 0.75s;
      opacity: 0;
      pointer-events: none;
    }
    .btn-premium:hover::after {
      left: 125%;
      opacity: 1;
      transition: 0.75s;
    }
    .btn-premium:hover {
      box-shadow: 0 0 25px rgba(var(--accent-rgb), 0.45);
      border-color: rgba(var(--accent-rgb), 0.6);
      transform: translateY(-2px);
    }



    /* Modal Styles */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      z-index: 100;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }
    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }
    .modal-content {
      background: rgba(4, 21, 27, 0.85);
      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);
      border: 1px solid rgba(var(--accent-rgb), 0.15);
      border-radius: 1.25rem;
      max-width: 32rem;
      width: 100%;
      transform: scale(0.95) translateY(10px);
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 40px rgba(var(--accent-rgb), 0.1);
      overflow: hidden;
    }

    .modal-overlay.active .modal-content {
      transform: scale(1) translateY(0);
    }
    
    .input-premium {
      background: rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(var(--accent-rgb), 0.15);
      color: #ffffff;
      transition: all 0.3s ease;
    }

    .input-premium:focus {
      border-color: rgba(var(--accent-rgb), 0.6);
      box-shadow: 0 0 15px rgba(var(--accent-rgb), 0.2);
      outline: none;
    }

    /* Product Preview Flowchart animations */
    @keyframes pulseNode {
      0%, 100% { transform: scale(1); opacity: 0.8; }
      50% { transform: scale(1.15); opacity: 1; filter: drop-shadow(0 0 8px rgba(var(--accent-rgb), 0.8)); }
    }
    .svg-node-active {
      animation: pulseNode 2s infinite ease-in-out;
    }
    @keyframes dashMove {
      to {
        stroke-dashoffset: -20;
      }
    }
    .svg-path-flow {
      stroke-dasharray: 5, 5;
      animation: dashMove 1s linear infinite;
    }
    
    /* Document Scrollable box */
    .doc-scrollbox {
      max-height: 24rem;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: rgba(var(--accent-rgb), 0.2) rgba(0,0,0,0.1);
    }

    /* Glass card glow background mapping */
    .glass-card {
      position: relative;
      overflow: hidden;
    }
    .glass-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(300px circle at var(--mouse-x, 0) var(--mouse-y, 0), rgba(var(--accent-rgb), 0.08), transparent 40%);
      z-index: 0;
      opacity: 0;
      transition: opacity 0.5s ease;
      pointer-events: none;
    }
    .glass-card:hover::before {
      opacity: 1;
    }
    .glass-card > * {
      position: relative;
      z-index: 10;
    }
  </style>
</head>

<body class="bg-darkest text-textMain font-sans overflow-x-hidden min-h-screen relative">

  <!-- 🌌 Cybernetic Node Starfield (Interactive Background) -->
  <canvas id="canvas-network" class="fixed inset-0 pointer-events-none z-[-1]"></canvas>

  <!-- Static Gradient & Grid Backdrop -->
  <div class="fixed inset-0 bg-gradient-mesh z-[-2]"></div>
  <div class="fixed inset-0 bg-grid-mesh opacity-50 z-[-2]"></div>
  
  <!-- Glowing Nodes Backdrop -->
  <div class="fixed top-[-20%] left-[-20%] w-[70vw] h-[70vw] rounded-full radial-glow-1 z-[-1]"></div>
  <div class="fixed bottom-[-10%] right-[-10%] w-[60vw] h-[60vw] rounded-full radial-glow-2 z-[-1]"></div>

  <!-- ⏳ Futuristic Loader Overlay -->
  <div id="loading-screen" class="fixed inset-0 z-[999] bg-[#050505] flex flex-col items-center justify-center transition-all duration-1000 ease-out">
    <div class="relative flex flex-col items-center">
      <!-- Outer cyber circle -->
      <div class="w-24 h-24 rounded-full border border-dashed border-cyanaccent/30 animate-spin" style="animation-duration: 12s;"></div>
      <!-- Middle glowing ring -->
      <div class="absolute inset-2 rounded-full border border-cyanaccent/60 border-t-transparent animate-spin"></div>
      
      <!-- Inner Branding logo -->
      <div class="absolute inset-4 rounded-full bg-glassBg flex items-center justify-center border border-glassBorder shadow-[0_0_15px_rgba(34,211,238,0.2)]">
        <svg class="w-10 h-10 text-cyanaccent filter drop-shadow-[0_0_8px_rgba(34,211,238,0.6)] animate-pulse" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="15" y="15" width="14" height="70" fill="currentColor"/>
          <rect x="71" y="27" width="14" height="58" fill="currentColor"/>
          <rect x="71" y="2" width="14" height="14" fill="currentColor"/>
          <rect x="85" y="69" width="10" height="16" fill="currentColor"/>
          <polygon points="15,15 29,15 85,85 71,85" fill="currentColor"/>
        </svg>
      </div>
      <h2 class="font-orbitron font-extrabold text-lg text-white mt-8 tracking-[4px] uppercase"><%= projectName %></h2>
      <p class="text-xs text-cyanaccent/60 tracking-[2px] mt-2 font-mono uppercase">Initializing Systems...</p>
      
      <!-- Fading progress line -->
      <div class="w-48 h-[1px] bg-slate-800 rounded-full mt-6 overflow-hidden relative">
        <div class="absolute inset-y-0 left-0 w-0 bg-cyanaccent rounded-full transition-all duration-700 ease-out" id="loading-progress"></div>
      </div>
    </div>
  </div>

  <!-- ==================== SECTION 1 — NAVIGATION ==================== -->
  <header class="fixed top-0 left-0 w-full z-50 glass-header transition-all duration-300" id="site-header">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
      
      <!-- Logo Container -->
      <a href="#" class="flex items-center gap-3 font-orbitron font-extrabold text-sm tracking-[2px] text-white hover:opacity-95 transition-opacity flex-shrink-0 whitespace-nowrap">
        <% if (typeof platformLogo !== 'undefined' && platformLogo) { %>
          <img src="<%= platformLogo %>" alt="Naxton Logo" class="h-8 w-auto object-contain filter drop-shadow-[0_0_6px_rgba(34,211,238,0.5)]" />
        <% } else { %>
          <div class="relative w-8 h-8 flex items-center justify-center">
            <svg class="w-7 h-7 text-cyanaccent filter drop-shadow-[0_0_6px_rgba(34,211,238,0.5)]" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">

        speakText(agentsData[agentKey].initText);
        populateDialoguePresets();
      }, 700);
    }

    function addTranscriptLine(sender, text) {
      const log = document.getElementById('simulator-transcript');
      if (!log) return;
      const d = document.createElement('div');
      if (sender === 'SYS') {
        d.className = 'text-primary/60';
        d.textContent = `[SYS] ${text}`;
      } else if (sender === 'AGENT') {
        d.className = 'text-white';
        d.innerHTML = `<span class="text-primary">[${agentsData[currentAgent].name}]</span> ${text}`;
      } else {
        d.className = 'text-slate-300';
        d.innerHTML = `<span class="text-secondary">[USER]</span> ${text}`;
      }
      log.appendChild(d);
      log.scrollTop = log.scrollHeight;
    }

    function populateDialoguePresets() {
      const container = document.getElementById('dialogue-presets');
      if (!container) return;
      container.innerHTML = '';
      const step = agentsData[currentAgent].dialogue[dialogueStep];
      if (!step || !step.replies) return;

      step.replies.forEach(r => {
        const btn = document.createElement('button');
        btn.className = 'px-3 py-1 text-[9px] font-bold font-mono border border-slate-200 rounded-lg bg-slate-50 text-textDim hover:border-primary hover:text-primary transition-all cursor-pointer';
        btn.textContent = r.label;
        btn.onclick = () => selectDialogueOption(r.text, r.nextStep);
        container.appendChild(btn);
      });
    }

    function selectDialogueOption(text, nextStep) {
      addTranscriptLine('USER', text);
      updateSimulatorThinkingState('perceiving');
      setTimeout(() => updateSimulatorThinkingState('reasoning'), 300);

      if (nextStep === 'hangup') {
        setTimeout(() => hangUpCall(), 1200);
        return;
      }
      dialogueStep = nextStep;

      setTimeout(() => {
        const step = agentsData[currentAgent].dialogue[dialogueStep];
        if (step && step.text) {
          addTranscriptLine('AGENT', step.text);
          speakText(step.text);
        }
        populateDialoguePresets();
      }, 700);
    }

    function updateSimulatorThinkingState(state) {
      const statusText = document.getElementById('sim-thinking-status-text');
      const stepText = document.getElementById('sim-thinking-step-text');
      if (statusText) statusText.textContent = state.toUpperCase();
      if (stepText) stepText.textContent = state === 'listening' ? 'waiting for audio stream' : 'processing pipeline variables';

      for (let i = 1; i <= 8; i++) {
        const bar = document.getElementById(`sim-wave-${i}`);
        if (bar) {
          if (state === 'synthesizing') {
            bar.style.height = `${Math.floor(Math.random() * 32) + 8}px`;
          } else {
            bar.style.height = '8px';
          }
        }
      }
    }

    function speakText(text) {
      if (!speechSynth) return;
      speechSynth.cancel();
      if (isMuted) return;

      activeUtterance = new SpeechSynthesisUtterance(text);
      activeUtterance.rate = 0.98;
      
      activeUtterance.onstart = () => {
        updateSimulatorThinkingState('synthesizing');
        document.getElementById('call-status').textContent = 'AGENT SPEAKING...';
        document.getElementById('status-dot').className = 'relative inline-flex rounded-full h-2 w-2 bg-success';
        startWaveformAnimation();
      };
      activeUtterance.onend = () => {
        updateSimulatorThinkingState('listening');
        document.getElementById('call-status').textContent = 'LISTENING...';
        document.getElementById('status-dot').className = 'relative inline-flex rounded-full h-2.5 w-2.5 bg-yellow-500 animate-pulse';
        stopWaveformAnimation();
      };

      const voices = speechSynth.getVoices();
      const voice = voices.find(v => v.lang.startsWith('en'));
      if (voice) activeUtterance.voice = voice;

      speechSynth.speak(activeUtterance);
    }

    function startWaveformAnimation() {
      if (waveInterval) clearInterval(waveInterval);
      waveInterval = setInterval(() => {
        for (let i = 1; i <= 8; i++) {
          const h = Math.floor(Math.random() * 24) + 6;
          const bar = document.getElementById(`sim-wave-${i}`);
          if (bar) bar.style.height = `${h}px`;
        }
      }, 120);
    }
    function stopWaveformAnimation() {
      if (waveInterval) clearInterval(waveInterval);
      for (let i = 1; i <= 8; i++) {
        const bar = document.getElementById(`sim-wave-${i}`);
        if (bar) bar.style.height = '8px';
      }
    }

    function launchInteractiveVoice() {
      simulatorActive = true;
      document.getElementById('interactive-voice-view').classList.add('modal-active');
      callSeconds = 0;
      document.getElementById('call-timer').textContent = '00:00';
      if (callTimerInterval) clearInterval(callTimerInterval);
      callTimerInterval = setInterval(() => {
        callSeconds++;
        const m = String(Math.floor(callSeconds / 60)).padStart(2, '0');
        const s = String(callSeconds % 60).padStart(2, '0');
        document.getElementById('call-timer').textContent = `${m}:${s}`;
      }, 1000);

      selectAgent('nex');
      if (!recognition) initSpeechRecognition();
    }

    function hangUpCall() {
      simulatorActive = false;
      if (callTimerInterval) clearInterval(callTimerInterval);
      if (waveInterval) clearInterval(waveInterval);
      if (speechSynth) speechSynth.cancel();
      if (recognition && isListening) recognition.stop();
      document.getElementById('interactive-voice-view').classList.remove('modal-active');
    }

    function initSpeechRecognition() {
      const Speech = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!Speech) {
        document.getElementById('mic-toggle-btn').style.display = 'none';
        return;
      }
      recognition = new Speech();
      recognition.continuous = false;
      recognition.lang = 'en-US';
      recognition.onstart = () => {
        isListening = true;
        updateSimulatorThinkingState('recording');
      };
      recognition.onend = () => {
        isListening = false;
      };
      recognition.onresult = (e) => {
        const text = e.results[0][0].transcript;
        addTranscriptLine('USER', text);
        processUserInputText(text);
      };
    }
    function toggleSpeechInput() {
      if (!recognition) return;
      if (isListening) {
        recognition.stop();
      } else {
        if (speechSynth) speechSynth.cancel();
        recognition.start();
      }
    }
    function toggleMute() {
      isMuted = !isMuted;
      const btn = document.getElementById('sound-toggle-btn');
      if (isMuted) {
        btn.innerHTML = '<i data-lucide="volume-x" class="w-4 h-4 text-red-500"></i>';
        if (speechSynth) speechSynth.cancel();
        stopWaveformAnimation();
      } else {
        btn.innerHTML = '<i data-lucide="volume-2" class="w-4 h-4 text-primary"></i>';
      }
      if (typeof lucide !== 'undefined') lucide.createIcons();
    }
    function processUserInputText(text) {
      if (!text.trim()) return;
      const step = agentsData[currentAgent].dialogue[dialogueStep];
      let matched = null;
      if (step && step.replies) {
        step.replies.forEach(r => {
          if (text.toLowerCase().includes(r.label.toLowerCase())) matched = r;
        });
      }
      if (matched) {
        selectDialogueOption(matched.text, matched.nextStep);
      } else {
        setTimeout(() => {
          const replies = {
            nex: "I see. Would you like to order a classic burger or review our timings?",
            aura: "Understood. I can book deep tissue massage for Friday or Saturday. What matches best?",
            cyrus: "Copy. Verify your authorization headers, or let me know if you need to run rotate script."
          };
          addTranscriptLine('AGENT', replies[currentAgent]);
          speakText(replies[currentAgent]);
        }, 800);
      }
    }
    function handleInputKeydown(e) {
      if (e.key === 'Enter') {
        const input = document.getElementById('sim-user-input');
        const val = input.value.trim();
        if (val) {
          addTranscriptLine('USER', val);
          processUserInputText(val);
          input.value = '';
        }
      }
    }

    // ==========================================
    // PARTICLES NETWORK BACKGROUND
    // ==========================================
    const canvas = document.getElementById('canvas-network');
    const ctx = canvas.getContext('2d');
    let particles = [];
    let mouse = { x: null, y: null, radius: 120 };

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      initParticles();
    }
    class Particle {
      constructor() {
        this.x = Math.random() * canvas.width;
        this.y = Math.random() * canvas.height;
        this.vx = (Math.random() - 0.5) * 0.4;
        this.vy = (Math.random() - 0.5) * 0.4;
        this.size = Math.random() * 1.5 + 0.5;
      }
      update() {
        this.x += this.vx;
        this.y += this.vy;
        if (this.x < 0 || this.x > canvas.width) this.vx *= -1;
        if (this.y < 0 || this.y > canvas.height) this.vy *= -1;

        if (mouse.x && mouse.y) {
          let dx = mouse.x - this.x;
          let dy = mouse.y - this.y;
          let dist = Math.sqrt(dx*dx + dy*dy);
          if (dist < mouse.radius) {
            this.x -= dx * 0.01;
            this.y -= dy * 0.01;
          }
        }
      }
      draw() {
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI*2);
        ctx.fillStyle = 'rgba(14, 165, 233, 0.2)';
        ctx.fill();
      }
    }
    function initParticles() {
      particles = [];
      const count = Math.min(Math.floor((canvas.width * canvas.height) / 11000), 90);
      for (let i = 0; i < count; i++) particles.push(new Particle());
    }
    function animateParticles() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach(p => {
        p.update();
        p.draw();
      });
      for (let i = 0; i < particles.length; i++) {
        for (let j = i+1; j < particles.length; j++) {
          let dx = particles[i].x - particles[j].x;
          let dy = particles[i].y - particles[j].y;
          let dist = Math.sqrt(dx*dx + dy*dy);
          if (dist < 100) {
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.strokeStyle = `rgba(14, 165, 233, ${0.1 * (100 - dist) / 100})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }
      requestAnimationFrame(animateParticles);
    }
    window.addEventListener('resize', resizeCanvas);
    window.addEventListener('mousemove', e => { mouse.x = e.clientX; mouse.y = e.clientY; });
    window.addEventListener('mouseleave', () => { mouse.x = null; mouse.y = null; });
    resizeCanvas();
    animateParticles();
  </script>
</body>

</html>

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <%
    const safeProjectName = typeof projectName !== 'undefined' ? projectName : 'Naxton Technologies';
    const safeLandingLogo = typeof landingLogo !== 'undefined' ? landingLogo : null;
    const safeLogoMain = typeof logoMain !== 'undefined' ? logoMain : 'NAXTON';
    const safeLogoSub = typeof logoSub !== 'undefined' ? logoSub : 'TECH';
  %>

  <!-- SEO Optimization -->
  <title><%= safeProjectName %> | Engineering Intelligent Software for Modern Businesses</title>
  <meta name="description" content="Naxton Technologies builds enterprise AI software, SaaS platforms, cloud infrastructure, automation systems, and intelligent digital products for startups and enterprises worldwide." />
  <meta name="keywords" content="AI Software Development, AI Solutions Company, Custom Software Development, Enterprise AI, SaaS Development, Business Automation, AI Voice Solutions, Cloud Development, Digital Transformation, Technology Consulting" />
  <link rel="canonical" href="https://naxtontechnologies.com/" />
  
  <!-- Robots Meta -->
  <meta name="robots" content="index, follow" />
  
  <!-- OpenGraph Metadata -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= safeProjectName %> | Enterprise AI & Custom Software" />
  <meta property="og:description" content="Engineering Intelligent Software for Modern Businesses. Discover next-gen AI Agents, custom SaaS, and automation loops." />
  <meta property="og:url" content="https://naxtontechnologies.com/" />
  <meta property="og:image" content="https://naxtontechnologies.com/logo.svg" />
  
  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= safeProjectName %>" />
  <meta name="twitter:description" content="Naxton Technologies builds next-gen enterprise AI and custom SaaS architectures." />
  
  <link rel="icon" type="image/png" href="<%= safeLandingLogo || '' %>">
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.435.0/dist/umd/lucide.min.js"></script>

  <!-- Tailwind Configuration -->
  <script>
    if (typeof tailwind !== 'undefined') {
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: '#2563EB',
              secondary: '#38BDF8',
              accent: '#7DD3FC',
              success: '#10B981',
              textMain: '#0F172A',
              textDim: '#475569',
              borderLight: '#E2E8F0',
            },
            fontFamily: {
              orbitron: ['Orbitron', 'sans-serif'],
              sans: ['Plus Jakarta Sans', 'sans-serif'],
            }
          }
        }
      };
    }
  </script>

  <!-- Custom CSS for Animations and Custom Layouts -->
  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #F8FBFF;
    }
    ::-webkit-scrollbar-thumb {
      background: #CBD5E1;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94A3B8;
    }

    /* Spotlights & Blobs */
    .spotlight-blob {
      background: radial-gradient(circle, rgba(14, 165, 233, 0.08) 0%, transparent 65%);
      filter: blur(40px);
      pointer-events: none;
    }

    /* Premium Glass Cards */
    .glass-card {
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(15, 23, 42, 0.06);
      box-shadow: 0 10px 30px -10px rgba(14, 165, 233, 0.04);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .glass-card:hover {
      border-color: rgba(37, 99, 235, 0.15);
      box-shadow: 0 20px 40px -15px rgba(37, 99, 235, 0.08);
      transform: translateY(-4px);
    }

    /* Modal Backdrop Blur */
    .modal-active {
      display: flex !important;
      animation: fadeIn 0.3s ease-out;
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    /* Tech Logos Horizontal Scroll */
    @keyframes scroll {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .logo-scroll-track {
      display: flex;
      width: calc(250px * 28);
      animation: scroll 40s linear infinite;
    }
    .logo-scroll-track:hover {
      animation-play-state: paused;
    }

    /* Glow on Hover Outline */
    .btn-gradient {
      background: linear-gradient(to right, #2563EB, #38BDF8);
      transition: all 0.3s ease;
    }
    .btn-gradient:hover {
      box-shadow: 0 4px 18px rgba(37, 99, 235, 0.3);
      filter: brightness(1.05);
    }
  </style>

  <!-- JSON-LD Structured Data Schema.org declarations -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "<%= safeProjectName %>",
      "url": "https://naxtontechnologies.com/",
      "logo": "https://naxtontechnologies.com/logo.svg",
      "description": "Naxton Technologies builds enterprise AI software, SaaS platforms, cloud infrastructure, automation systems, and intelligent digital products.",
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "contact@naxtontechnologies.com",
        "contactType": "customer support"
      },
      "sameAs": [
        "https://github.com/naxton-tech"
      ]
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "<%= safeProjectName %>",
      "image": "https://naxtontechnologies.com/logo.svg",
      "telephone": "",
      "email": "contact@naxtontechnologies.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "California",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "37.7749",
        "longitude": "-122.4194"
      },
      "url": "https://naxtontechnologies.com"
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [{
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://naxtontechnologies.com/"
      }]
    }
  </script>
</head>

<body class="bg-white text-textMain font-sans antialiased overflow-x-hidden">

  <!-- Network Particle Stream Background -->
  <canvas id="canvas-network" class="fixed inset-0 pointer-events-none z-0 opacity-40"></canvas>

  <!-- 🚀 Header / Floating Glass Navbar -->
  <header id="site-header" class="fixed top-4 left-1/2 -translate-x-1/2 w-[92%] max-w-7xl z-50 bg-white/80 border border-slate-200/50 backdrop-blur-md rounded-full shadow-[0_8px_32px_rgba(15,23,42,0.04)] transition-all duration-300">
    <div class="px-6 py-3.5 flex items-center justify-between gap-4">
      
      <!-- Brand Logo -->
      <a href="#" class="flex items-center gap-3 font-orbitron font-extrabold text-sm tracking-[2px] text-textMain hover:opacity-90 transition-opacity">
        <% if (safeLandingLogo) { %>
          <img src="<%= safeLandingLogo %>" alt="<%= safeProjectName %> Logo" class="h-6 w-auto object-contain" />
        <% } else { %>
          <div class="flex flex-col leading-none">
            <span class="text-sm font-black tracking-[3px] bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"><%= safeLogoMain %></span>
            <span class="text-[7px] font-bold tracking-[2px] text-secondary mt-0.5"><%= safeLogoSub %></span>
          </div>
        <% } %>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden lg:flex items-center gap-7 text-xs font-bold tracking-wider text-textDim uppercase">
        <a href="#services" class="hover:text-primary transition-colors">Services</a>
        <a href="#solutions" class="hover:text-primary transition-colors">Solutions</a>
        <a href="#products" class="hover:text-primary transition-colors">Products</a>
        <a href="#technologies" class="hover:text-primary transition-colors">Technology</a>
        <a href="#industries" class="hover:text-primary transition-colors">Industries</a>
        <a href="#about" class="hover:text-primary transition-colors">About</a>
        <a href="#contact" class="hover:text-primary transition-colors">Contact</a>
      </nav>

      <!-- CTA Button & Mobile Toggle -->
      <div class="flex items-center gap-3">
        <a href="#contact" class="hidden sm:inline-block px-5 py-2.5 rounded-full text-xs font-bold tracking-wider text-white btn-gradient uppercase">
          Book Consultation
        </a>
        <a href="/login" class="hidden sm:inline-block px-5 py-2.5 rounded-full text-xs font-bold tracking-wider text-primary border border-primary/20 hover:bg-primary/5 transition-all uppercase">
          Access Portal
        </a>
        <button id="mobile-menu-btn" class="lg:hidden w-9 h-9 rounded-full bg-slate-50 border border-slate-100 flex items-center justify-center text-textMain hover:bg-slate-100 transition-colors" aria-label="Toggle Navigation Menu">
          <i data-lucide="menu" class="w-4 h-4"></i>
        </button>
      </div>

    </div>
  </header>

  <!-- 📱 Mobile Sidebar Navigation Drawer -->
  <div id="mobile-nav" class="fixed inset-y-0 right-0 w-80 max-w-full bg-white border-l border-slate-100 shadow-2xl flex flex-col p-8 z-50 transition-transform duration-300 translate-x-full">
    <div class="flex justify-between items-center mb-10">
      <span class="font-orbitron font-extrabold text-sm tracking-[2px] bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"><%= safeLogoMain %></span>
      <button id="close-menu-btn" class="w-8 h-8 rounded-full bg-slate-50 border border-slate-100 flex items-center justify-center text-textMain hover:bg-slate-100 transition-colors" aria-label="Close Menu">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>
    
    <nav class="flex flex-col gap-6 text-sm font-bold tracking-wider text-textDim uppercase mb-auto">
      <a href="#services" class="mobile-link hover:text-primary transition-colors">Services</a>
      <a href="#solutions" class="mobile-link hover:text-primary transition-colors">Solutions</a>
      <a href="#products" class="mobile-link hover:text-primary transition-colors">Products</a>
      <a href="#technologies" class="mobile-link hover:text-primary transition-colors">Technology</a>
      <a href="#industries" class="mobile-link hover:text-primary transition-colors">Industries</a>
      <a href="#about" class="mobile-link hover:text-primary transition-colors">About</a>
      <a href="#contact" class="mobile-link hover:text-primary transition-colors">Contact</a>
    </nav>

    <div class="flex flex-col gap-3 mt-auto">
      <a href="/login" class="w-full text-center py-3 rounded-full text-xs font-bold tracking-wider text-primary border border-primary/20 hover:bg-primary/5 transition-all uppercase">
        Access Portal
      </a>
      <a href="#contact" class="mobile-link w-full text-center py-3 rounded-full text-xs font-bold tracking-wider text-white btn-gradient uppercase">
        Book Consultation
      </a>
    </div>
  </div>
  <!-- Mobile Drawer Backdrop -->
  <div id="mobile-nav-backdrop" class="fixed inset-0 bg-slate-900/10 backdrop-blur-sm z-40 hidden"></div>

  <!-- 🪐 Hero Section -->
  <section class="relative min-h-screen pt-36 pb-20 px-6 overflow-hidden flex items-center bg-gradient-to-b from-slate-50/50 to-white">
    <div class="absolute top-1/4 left-1/10 w-[500px] h-[500px] spotlight-blob"></div>
    <div class="absolute bottom-10 right-1/10 w-[600px] h-[600px] spotlight-blob"></div>
    
    <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-16 items-center relative z-10">
      
      <!-- Left Column: Title & CTA -->
      <div class="lg:col-span-6 flex flex-col items-start text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/5 border border-primary/10 text-[9px] font-bold tracking-[2.5px] text-primary uppercase mb-6">
          <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
          <span>Enterprise Artificial Intelligence</span>
        </div>
        
        <h1 class="font-orbitron font-black text-4xl sm:text-5xl xl:text-6xl tracking-tight text-textMain leading-[1.1] mb-6">
          AI Solutions That<br/>
          <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">Power Modern Businesses</span>
        </h1>
        
        <p class="text-base sm:text-lg text-textDim leading-relaxed max-w-xl mb-8">
          <%= safeProjectName %> builds enterprise AI software, SaaS platforms, cloud infrastructure, automation systems, and intelligent digital products for startups and enterprises worldwide.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto">
          <a href="#contact" class="px-8 py-4 rounded-full text-xs font-bold tracking-wider text-white btn-gradient text-center uppercase">
            Start Your Project
          </a>
          <button onclick="launchInteractiveVoice()" class="px-8 py-4 rounded-full text-xs font-bold tracking-wider text-primary border border-primary/20 bg-white/80 hover:bg-slate-50 hover:border-primary/40 transition-all flex items-center justify-center gap-2.5 shadow-sm">
            <i data-lucide="phone-call" class="w-4 h-4 text-primary animate-pulse"></i>
            <span>BOOK FREE CONSULTATION</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Interactive SaaS Console / Dashboard Mockup -->
      <div class="lg:col-span-6 w-full flex justify-center lg:justify-end">
        <div class="w-full max-w-lg glass-card rounded-3xl p-5 border border-slate-200/60 shadow-xl relative overflow-hidden bg-white/70">
          
          <!-- Mockup Header -->
          <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-red-400"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-green-400"></span>
            </div>
            <div class="text-[10px] font-mono text-textDim uppercase tracking-widest flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 bg-success rounded-full animate-ping"></span>
              <span>Naxton Realtime Console v4.0</span>
            </div>
          </div>

          <!-- Console Navigation Tabs -->
          <div id="simulator-tabs" class="flex gap-4 border-b border-slate-100 pb-2 mb-4 text-[10px] font-bold tracking-wider text-textDim uppercase">
            <button id="tab-btn-dashboard" onclick="switchSimulatorTab('dashboard')" class="flex-1 pb-2.5 text-primary border-b border-primary text-center focus:outline-none transition-all duration-300">
              Operational Metrics
            </button>
            <button id="tab-btn-thinking" onclick="switchSimulatorTab('thinking')" class="flex-1 pb-2.5 text-textDim border-b border-transparent text-center hover:text-textMain transition-all duration-300 focus:outline-none flex items-center justify-center gap-1.5">
              <i data-lucide="brain" class="w-3.5 h-3.5"></i>
              <span>Cognitive Log Stream</span>
            </button>
          </div>

          <!-- Tab Content 1: Live Analytics Dashboard -->
          <div id="dashboard-mockup-view" class="space-y-4">
            <!-- Grid of simple parameters -->
            <div class="grid grid-cols-2 gap-3">
              <div class="bg-slate-50/50 border border-slate-100 rounded-2xl p-4 flex flex-col justify-start text-left">
                <span class="text-[9px] font-bold text-textDim tracking-widest uppercase">System CPU Load</span>
                <span class="text-xl font-bold font-orbitron text-primary mt-1">12.4%</span>
              </div>
              <div class="bg-slate-50/50 border border-slate-100 rounded-2xl p-4 flex flex-col justify-start text-left">
                <span class="text-[9px] font-bold text-textDim tracking-widest uppercase">Active Vectors</span>
                <span class="text-xl font-bold font-orbitron text-secondary mt-1">4,096 / OK</span>
              </div>
            </div>

            <!-- Graph box -->
            <div class="bg-slate-50/50 border border-slate-100 rounded-2xl p-4 text-left relative overflow-hidden h-36 flex flex-col justify-between">
              <div class="flex justify-between items-center mb-1">
                <span class="text-[9px] font-bold text-textDim tracking-widest uppercase">Latency Streams</span>
                <span class="text-[8px] font-mono text-primary">18ms AVG</span>
              </div>
              <!-- Mini chart graph mock using div heights -->
              <div class="h-16 flex items-end justify-between gap-1 px-1">
                <div class="flex-1 bg-slate-200 h-8 rounded-t"></div>
                <div class="flex-1 bg-slate-200 h-10 rounded-t"></div>
                <div class="flex-1 bg-primary/30 h-12 rounded-t"></div>
                <div class="flex-1 bg-primary/40 h-8 rounded-t"></div>
                <div class="flex-1 bg-primary h-14 rounded-t"></div>
                <div class="flex-1 bg-secondary h-16 rounded-t animate-pulse"></div>
                <div class="flex-1 bg-primary/50 h-10 rounded-t"></div>
                <div class="flex-1 bg-slate-200 h-6 rounded-t"></div>
              </div>
              <div class="flex justify-between text-[7px] font-mono text-textDim border-t border-slate-100 pt-1.5 mt-1">
                <span>00:00 SEC</span>
                <span>00:30 SEC</span>
                <span>LIVE FEED</span>
              </div>
            </div>

            <!-- Launch Live Voice button inside mockup -->
            <button onclick="launchInteractiveVoice()" class="w-full py-3.5 rounded-2xl text-xs font-bold tracking-wider text-white btn-gradient flex items-center justify-center gap-2">
              <i data-lucide="play-circle" class="w-4 h-4"></i>
              <span>TRIGGER DYNAMIC VOICE DEMO</span>
            </button>
          </div>

          <!-- Tab Content 2: Visual Thinking Flow Node (Initially hidden) -->
          <div id="visual-thinking-view" class="hidden space-y-4">
            <div class="bg-slate-50/50 border border-slate-100 rounded-2xl p-4 flex flex-col text-left">
              <span class="text-[8px] font-bold font-mono text-textDim tracking-widest uppercase mb-1">Active Cognitive Node Details</span>
              <h4 id="thinking-stage-title" class="font-bold text-sm text-textMain mb-1">Data Ingestion</h4>
              <p id="thinking-stage-desc" class="text-[10px] text-textDim leading-relaxed min-h-[30px]">
                Processes streaming audio feeds or custom input lines. Converts analog or text formats into internal JSON datagram chunks.
              </p>
              
              <div class="grid grid-cols-2 gap-4 border-t border-slate-200/50 pt-2.5 mt-2.5 font-mono text-[9px] text-textDim">
                <div>LATENCY PATH: <span id="thinking-stage-latency" class="text-primary font-bold">~4ms</span></div>
                <div>THREADS ACTIVE: <span id="thinking-stage-threads" class="text-secondary font-bold">2 Concurrency</span></div>
              </div>
            </div>

            <!-- Node Diagram Canvas Mock using SVGs -->
            <div class="relative w-full h-40 bg-slate-900/5 border border-slate-100 rounded-2xl flex items-center justify-center overflow-hidden">
              <svg class="w-full h-full max-w-[400px]" viewBox="0 0 400 160">
                <defs>
                  <marker id="arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M 0 2 L 10 5 L 0 8 z" fill="#94A3B8"/>
                  </marker>
                </defs>

                <!-- Flow Lines Paths -->
                <path id="link-ingest-perceive" d="M 60 80 Q 100 40 140 40" fill="none" stroke="#E2E8F0" stroke-width="1.5" marker-end="url(#arrow)" />
                <path id="link-ingest-act" d="M 60 80 Q 100 120 140 120" fill="none" stroke="#E2E8F0" stroke-width="1.5" marker-end="url(#arrow)" />
                <path id="link-perceive-reason" d="M 170 40 Q 210 40 250 80" fill="none" stroke="#E2E8F0" stroke-width="1.5" marker-end="url(#arrow)" />
                <path id="link-act-reason" d="M 170 120 Q 210 120 250 80" fill="none" stroke="#E2E8F0" stroke-width="1.5" marker-end="url(#arrow)" />
                <path id="link-reason-synthesize" d="M 280 80 H 330" fill="none" stroke="#E2E8F0" stroke-width="1.5" marker-end="url(#arrow)" />

                <!-- Ingest Node -->
                <g id="node-ingest" onclick="selectThinkingNode('ingest')" class="cursor-pointer">
                  <circle cx="50" cy="80" r="16" fill="#F1F5F9" stroke="#94A3B8" stroke-width="1.5" />
                  <circle cx="50" cy="80" r="22" stroke="#38BDF8" stroke-width="1" class="opacity-0 animate-ping" id="halo-ingest" />
                  <text x="50" y="83" font-family="Plus Jakarta Sans" font-size="8" font-weight="800" text-anchor="middle" fill="#475569">ING</text>
                </g>

                <!-- Perceive Node -->
                <g id="node-perceive" onclick="selectThinkingNode('perceive')" class="cursor-pointer">
                  <circle cx="155" cy="40" r="16" fill="#F1F5F9" stroke="#94A3B8" stroke-width="1.5" />
                  <circle cx="155" cy="40" r="22" stroke="#38BDF8" stroke-width="1" class="opacity-0 animate-ping" id="halo-perceive" />
                  <text x="155" y="43" font-family="Plus Jakarta Sans" font-size="8" font-weight="800" text-anchor="middle" fill="#475569">PRC</text>
                </g>

                <!-- Act Node -->
                <g id="node-act" onclick="selectThinkingNode('act')" class="cursor-pointer">
                  <circle cx="155" cy="120" r="16" fill="#F1F5F9" stroke="#94A3B8" stroke-width="1.5" />
                  <circle cx="155" cy="120" r="22" stroke="#38BDF8" stroke-width="1" class="opacity-0 animate-ping" id="halo-act" />
                  <text x="155" y="123" font-family="Plus Jakarta Sans" font-size="8" font-weight="800" text-anchor="middle" fill="#475569">ACT</text>
                </g>

                <!-- Reason Node -->
                <g id="node-reason" onclick="selectThinkingNode('reason')" class="cursor-pointer">
                  <circle cx="265" cy="80" r="16" fill="#F1F5F9" stroke="#94A3B8" stroke-width="1.5" />
                  <circle cx="265" cy="80" r="22" stroke="#38BDF8" stroke-width="1" class="opacity-0 animate-ping" id="halo-reason" />
                  <text x="265" y="83" font-family="Plus Jakarta Sans" font-size="8" font-weight="800" text-anchor="middle" fill="#475569">RSN</text>
                </g>

                <!-- Synthesize Node -->
                <g id="node-synthesize" onclick="selectThinkingNode('synthesize')" class="cursor-pointer">
                  <circle cx="345" cy="80" r="16" fill="#F1F5F9" stroke="#94A3B8" stroke-width="1.5" />
                  <circle cx="345" cy="80" r="22" stroke="#38BDF8" stroke-width="1" class="opacity-0 animate-ping" id="halo-synthesize" />
                  <text x="345" y="83" font-family="Plus Jakarta Sans" font-size="8" font-weight="800" text-anchor="middle" fill="#475569">SYN</text>
                </g>
              </svg>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- 🏢 Trusted By & Statistics Section -->
  <section class="py-20 border-y border-slate-100 bg-[#F8FBFF] relative overflow-hidden" id="stats">
    <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
      
      <!-- Logos carousel track -->
      <h3 class="text-[10px] font-bold font-orbitron tracking-[4px] uppercase text-textDim/50 mb-10">TRUSTED RELATIONSHIPS & PLATFORMS</h3>
      <div class="relative w-full overflow-hidden mb-16 py-4">

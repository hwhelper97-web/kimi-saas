        if (nodePerceive) nodePerceive.classList.add('active-stage');
        if (haloPerceive) haloPerceive.classList.remove('opacity-0');
        
        const l1 = document.getElementById('sim-link-ingest-perceive');
        if (l1) l1.classList.add('active-link');
      }
      else if (state === 'perceiving') {
        if (statusText) statusText.innerText = "Cognitive Engine: Perceiving";
        if (stepText) stepText.innerText = "parsing semantic intent";
        
        const nodePerceive = document.getElementById('sim-node-perceive');
        const haloPerceive = document.getElementById('sim-halo-perceive');
        if (nodePerceive) nodePerceive.classList.add('active-stage');

    class Particle {
      constructor(x, y) {
        this.x = x;
        this.y = y;
        this.vx = (Math.random() - 0.5) * 0.45;
        this.vy = (Math.random() - 0.5) * 0.45;
        this.baseSize = Math.random() * 1.5 + 0.5;
        this.size = this.baseSize;
      }

      update() {
        this.x += this.vx;
        this.y += this.vy;

        // Bounce borders
        if (this.x < 0 || this.x > canvas.width) this.vx *= -1;
        if (this.y < 0 || this.y > canvas.height) this.vy *= -1;

        // Mouse gravity interaction
        if (mouse.x !== null && mouse.y !== null) {
          let dx = mouse.x - this.x;
          let dy = mouse.y - this.y;
          let distance = Math.sqrt(dx * dx + dy * dy);
          if (distance < mouse.radius) {
            const force = (mouse.radius - distance) / mouse.radius;
            // Pull slightly towards mouse
            this.x -= dx * force * 0.02;
            this.y -= dy * force * 0.02;
            this.size = this.baseSize * (1 + force * 1.5);
          } else {
            this.size = this.baseSize;
          }
        }
      }

      draw() {
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        // Dynamic color based on theme
        const rgb = getActiveAccentRgb();
        ctx.fillStyle = `rgba(${rgb}, 0.45)`;
        ctx.fill();
      }
    }

    function initParticles() {
      points = [];
      // Dynamic count based on screen size
      const count = Math.floor((canvas.width * canvas.height) / 9500);
      for (let i = 0; i < Math.min(count, 120); i++) {
        points.push(new Particle(Math.random() * canvas.width, Math.random() * canvas.height));
      }
    }

    function drawNetwork() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      const rgb = getActiveAccentRgb();

      // Draw grid nodes
      for (let i = 0; i < points.length; i++) {
        points[i].update();
        points[i].draw();

        // Connect lines
        for (let j = i + 1; j < points.length; j++) {
          let dx = points[i].x - points[j].x;
          let dy = points[i].y - points[j].y;
          let dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 110) {
            ctx.beginPath();
            ctx.moveTo(points[i].x, points[i].y);
            ctx.lineTo(points[j].x, points[j].y);
            // Dynamic lines opacity
            const opacity = (110 - dist) / 110 * 0.06;
            ctx.strokeStyle = `rgba(${rgb}, ${opacity})`;
            ctx.lineWidth = 0.75;
            ctx.stroke();
          }
        }
      }
      requestAnimationFrame(drawNetwork);
    }


        <p>These terms are governed by the laws of the State of California, United States.</p>
      `
    };
    
    function openDocModal(docKey) {
      const modal = document.getElementById('document-modal');
      const titleEl = document.getElementById('doc-modal-title');
      const contentEl = document.getElementById('doc-modal-content');
      
      if (docKey === 'privacy') {
        titleEl.textContent = 'Privacy Policy';
        contentEl.innerHTML = legalTexts.privacy;
      } else {
        titleEl.textContent = 'Terms of Service';
        contentEl.innerHTML = legalTexts.terms;
      }
      
      modal.classList.add('active');
    }
    
    function closeDocModal() {
      document.getElementById('document-modal').classList.remove('active');
    }

    // ==========================================
    // GLOBAL CLICK INTERCEPTOR & SMOOTH SCROLL
    // ==========================================
    document.addEventListener('DOMContentLoaded', () => {
      // Intercept consultation and document links
      document.addEventListener('click', (e) => {
        const target = e.target.closest('a');
        if (!target) return;
        const href = target.getAttribute('href');
        
        // Intercept consultation buttons
        if (href === '#contact' || target.textContent.trim() === 'BOOK CONSULTATION' || target.textContent.trim() === 'START YOUR PROJECT' || target.textContent.trim() === 'SCHEDULE CONSULTATION' || target.textContent.trim() === 'BOOK FREE CONSULTATION') {
          e.preventDefault();
          openConsultationModal();
        }
        
        // Intercept legal links
        if (target.textContent.trim() === 'Privacy Policy') {
          e.preventDefault();
          openDocModal('privacy');
        }
        if (target.textContent.trim() === 'Terms of Service') {
          e.preventDefault();
          openDocModal('terms');
        }
      });

      // Smooth scroll for nav links
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          const href = this.getAttribute('href');
          if (href === '#contact' || this.textContent.trim() === 'BOOK CONSULTATION' || this.textContent.trim() === 'START YOUR PROJECT' || this.textContent.trim() === 'SCHEDULE CONSULTATION' || this.textContent.trim() === 'BOOK FREE CONSULTATION') {
            return;
          }
          
          e.preventDefault();
          const targetId = href.substring(1);
          const targetElement = document.getElementById(targetId || 'home');
          if (targetElement) {
            window.scrollTo({
              top: targetElement.offsetTop - 80,
              behavior: 'smooth'
            });
          }
        });
      });

      // Mouse Spotlight Glow effect on glass-cards
      const glassCards = document.querySelectorAll('.glass-card');
      glassCards.forEach(card => {
        card.addEventListener('mousemove', e => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty('--mouse-x', `${x}px`);
          card.style.setProperty('--mouse-y', `${y}px`);
        });
      });
    });

    window.addEventListener('resize', resizeCanvas);
    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });
    window.addEventListener('mouseleave', () => {
      mouse.x = null;
      mouse.y = null;
    });

    resizeCanvas();
    drawNetwork();

    // Load theme on start safely after all variables and functions are defined
    const savedTheme = safeGetItem('theme') || 'teal';
    setTheme(savedTheme);
  </script>
</body>


<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= projectName %> | Next-Gen AI & Enterprise SaaS Platforms</title>
  <link rel="icon" type="image/png" href="<%= platformLogo || '' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  
  <!-- Tailwind Play CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.435.0/dist/umd/lucide.min.js"></script>

  <!-- Tailwind Configuration -->
  <script>
    if (typeof tailwind !== 'undefined') {
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              darkest: 'var(--bg-darkest)',
              cyanaccent: 'var(--accent-cyan)',
              tealaccent: 'var(--accent-teal)',
              glassBg: 'var(--glass-bg)',
              glassBorder: 'var(--glass-border)',
              textMain: 'var(--text-main)',
              textDim: 'var(--text-dim)',
            },
            fontFamily: {
              orbitron: ['Orbitron', 'sans-serif'],
              sans: ['Plus Jakarta Sans', 'sans-serif'],
            }
          }
        }
      };
    }
  </script>

  <!-- Custom CSS for Glow Effects and Animations -->
  <style>
    :root {
      --bg-darkest: #040506;
      --bg-gradient-start: #061f26;
      --bg-gradient-end: #020c0f;
      --accent-cyan: #22d3ee;
      --accent-teal: #00bcd4;
      --accent-rgb: 34, 211, 238;
      --glass-bg: rgba(4, 21, 27, 0.65);
      --glass-border: rgba(34, 211, 238, 0.08);
      --btn-gradient: linear-gradient(to right, #042B33, #063944, #0A4A57);
      --text-main: #f8fafc;
      --text-dim: #94a3b8;
      --btn-secondary: rgba(255, 255, 255, 0.05);
    }

    .theme-teal {
      --bg-darkest: #040506;
      --bg-gradient-start: #061f26;
      --bg-gradient-end: #020c0f;
      --accent-cyan: #22d3ee;
      --accent-teal: #00bcd4;
      --accent-rgb: 34, 211, 238;
      --glass-bg: rgba(4, 21, 27, 0.65);
      --glass-border: rgba(34, 211, 238, 0.08);
      --btn-gradient: linear-gradient(to right, #042B33, #063944, #0A4A57);
      --text-main: #f8fafc;
      --text-dim: #94a3b8;
      --btn-secondary: rgba(255, 255, 255, 0.05);
    }

    .theme-purple {
      --bg-darkest: #060409;
      --bg-gradient-start: #18092a;
      --bg-gradient-end: #0a0314;
      --accent-cyan: #f472b6;
      --accent-teal: #a855f7;
      --accent-rgb: 168, 85, 247;
      --glass-bg: rgba(18, 9, 30, 0.65);
      --glass-border: rgba(168, 85, 247, 0.08);
      --btn-gradient: linear-gradient(to right, #2c0e3a, #3c1352, #4e196b);
      --text-main: #f8fafc;
      --text-dim: #94a3b8;
      --btn-secondary: rgba(255, 255, 255, 0.05);
    }

    .theme-green {
      --bg-darkest: #030503;
      --bg-gradient-start: #08210e;
      --bg-gradient-end: #030d05;
      --accent-cyan: #34d399;
      --accent-teal: #10b981;
      --accent-rgb: 16, 185, 129;
      --glass-bg: rgba(6, 21, 10, 0.65);
      --glass-border: rgba(16, 185, 129, 0.08);
      --btn-gradient: linear-gradient(to right, #093116, #0d421e, #135527);
      --text-main: #f8fafc;
      --text-dim: #94a3b8;
      --btn-secondary: rgba(255, 255, 255, 0.05);
    }

    .theme-gold {
      --bg-darkest: #070503;
      --bg-gradient-start: #231609;
      --bg-gradient-end: #0e0803;
      --accent-cyan: #fbbf24;
      --accent-teal: #f59e0b;
      --accent-rgb: 245, 158, 11;
      --glass-bg: rgba(23, 14, 6, 0.65);
      --glass-border: rgba(245, 158, 11, 0.08);
      --btn-gradient: linear-gradient(to right, #381d09, #4a270b, #5e320d);
      --text-main: #f8fafc;
      --text-dim: #94a3b8;
      --btn-secondary: rgba(255, 255, 255, 0.05);
    }

    .theme-light {
      --bg-darkest: #ffffff;
      --bg-gradient-start: #ffffff;
      --bg-gradient-end: #f8fafc;
      --accent-cyan: #0891b2;
      --accent-teal: #0e7490;
      --accent-rgb: 14, 116, 144;
      --glass-bg: rgba(255, 255, 255, 0.75);
      --glass-border: rgba(14, 116, 144, 0.08);
      --btn-gradient: linear-gradient(to right, #0891b2, #0e7490, #155e75);
      --text-main: #0f172a;
      --text-dim: #475569;
      --btn-secondary: rgba(14, 116, 144, 0.05);
    }

    * {
      scroll-behavior: smooth;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: var(--bg-darkest);
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(34, 211, 238, 0.2);
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(34, 211, 238, 0.4);
    }

    /* Background Gradients & Grids */
    .bg-gradient-mesh {
      background: linear-gradient(135deg, var(--bg-gradient-start) 0%, var(--bg-gradient-end) 100%);
    }

    .bg-grid-mesh {
      background-image: radial-gradient(circle at 1.5px 1.5px, rgba(34, 211, 238, 0.04) 1px, transparent 0);
      background-size: 40px 40px;
    }

    /* Glassmorphism Classes */
    .glass-card {
      background: rgba(4, 21, 27, 0.6);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(34, 211, 238, 0.08);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4);
    }

    .glass-card:hover {
      border-color: rgba(34, 211, 238, 0.2);
      box-shadow: 0 8px 32px 0 rgba(34, 211, 238, 0.05);
    }

    .glass-header {
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(34, 211, 238, 0.08);
      background: rgba(4, 13, 18, 0.75);
    }

    /* Glow Circles */
    .radial-glow-1 {
      background: radial-gradient(circle, rgba(34, 211, 238, 0.06) 0%, transparent 70%);
      filter: blur(100px);
    }

    .radial-glow-2 {
      background: radial-gradient(circle, rgba(0, 188, 212, 0.05) 0%, transparent 65%);
      filter: blur(80px);
    }

    /* Custom Button Style matching Login page */
    .btn-premium {
      background: var(--btn-gradient);
      border: 1px solid rgba(34, 211, 238, 0.15);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-premium:hover {
      box-shadow: 0 0 20px rgba(34, 211, 238, 0.35);
      border-color: rgba(34, 211, 238, 0.4);
      transform: translateY(-1px);
    }

    /* Scroll Reveals */
    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .reveal.active {
      opacity: 1;
      transform: translateY(0);
    }

    /* Staggered items inside active reveal container */
    .stagger-reveal > * {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .stagger-reveal.active > * {
      opacity: 1;
      transform: translateY(0);
    }

    /* Interactive waveform */
    .waveform-bar {
      animation: bounceWave 1.4s ease-in-out infinite alternate;
    }

    @keyframes bounceWave {
      0% { height: 10%; }
      100% { height: 100%; }
    }

    /* Floating Animations */
    .float-slow {
      animation: floating 8s ease-in-out infinite;
    }
    .float-medium {
      animation: floating 6s ease-in-out infinite;
    }
    .float-fast {
      animation: floating 4.5s ease-in-out infinite;
    }

    @keyframes floating {
      0% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-10px) rotate(1deg); }
      100% { transform: translateY(0px) rotate(0deg); }
    }

    /* Timeline glow track */
    .timeline-track {
      background: linear-gradient(to bottom, rgba(34, 211, 238, 0.4) 0%, rgba(0, 188, 212, 0.1) 80%, transparent 100%);
    }

    /* Pulse active node */
    .node-pulse {
      animation: nodePulse 2s infinite;
    }
    @keyframes nodePulse {
      0% { box-shadow: 0 0 0 0 rgba(34, 211, 238, 0.6); }
      70% { box-shadow: 0 0 0 8px rgba(34, 211, 238, 0); }
      100% { box-shadow: 0 0 0 0 rgba(34, 211, 238, 0); }
    }

    #mobile-nav {
      background-color: var(--bg-darkest) !important;
    }

    /* Premium Button Shimmer & Scale Updates */
    .btn-premium {
      position: relative;
      background: var(--btn-gradient);
      border: 1px solid rgba(var(--accent-rgb), 0.2);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
      color: #ffffff !important;
    }
    .btn-premium::after {
      content: '';
      position: absolute;
      top: 0;
      left: -50%;
      width: 200%;
      height: 100%;
      background: linear-gradient(
        to right,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.15) 30%,
        rgba(255, 255, 255, 0.3) 50%,
        rgba(255, 255, 255, 0.15) 70%,
        rgba(255, 255, 255, 0) 100%
      );
      transform: skewX(-25deg);
      transition: 0.75s;
      opacity: 0;
      pointer-events: none;
    }
    .btn-premium:hover::after {
      left: 125%;
      opacity: 1;
      transition: 0.75s;
    }
    .btn-premium:hover {
      box-shadow: 0 0 25px rgba(var(--accent-rgb), 0.45);
      border-color: rgba(var(--accent-rgb), 0.6);
      transform: translateY(-2px);
    }

    /* Light Theme Styling Overrides */
    .theme-light h1,
    .theme-light h2,
    .theme-light h3,
    .theme-light h4,
    .theme-light h5,
    .theme-light h6 {
      color: var(--text-main) !important;
    }
    .theme-light p {
      color: var(--text-dim) !important;
    }
    .theme-light .bg-clip-text {
      background-image: linear-gradient(to bottom, var(--text-main) 0%, #475569 100%) !important;
      color: transparent !important;
      -webkit-text-fill-color: transparent !important;
    }
    .theme-light #stats,
    .theme-light #technologies,
    .theme-light #solutions,
    .theme-light #portfolio,
    .theme-light #testimonials,
    .theme-light #faq,
    .theme-light #final-cta,
    .theme-light #contact {
      background-color: rgba(255, 255, 255, 0.4) !important;
      backdrop-filter: blur(12px) !important;
    }
    .theme-light .bg-black\/40 {
      background-color: rgba(15, 23, 42, 0.05) !important;
    }
    .theme-light .bg-black\/60 {
      background-color: rgba(15, 23, 42, 0.08) !important;
    }
    .theme-light .text-slate-300,
    .theme-light .text-slate-400 {
      color: var(--text-dim) !important;
    }
    .theme-light #mobile-nav {
      background-color: var(--bg-darkest) !important;
    }

    /* Modal Styles */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      z-index: 100;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }
    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }
    .modal-content {
      background: rgba(4, 21, 27, 0.85);
      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);
      border: 1px solid rgba(var(--accent-rgb), 0.15);
      border-radius: 1.25rem;
      max-width: 32rem;
      width: 100%;
      transform: scale(0.95) translateY(10px);
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 40px rgba(var(--accent-rgb), 0.1);
      overflow: hidden;
    }
    .theme-light .modal-content {
      background: rgba(255, 255, 255, 0.95);
      border-color: rgba(var(--accent-rgb), 0.2);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
    }
    .modal-overlay.active .modal-content {
      transform: scale(1) translateY(0);
    }
    
    .input-premium {
      background: rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(var(--accent-rgb), 0.15);
      color: #ffffff;
      transition: all 0.3s ease;
    }
    .theme-light .input-premium {
      background: rgba(255, 255, 255, 0.8);
      border-color: rgba(var(--accent-rgb), 0.25);
      color: #0f172a;
    }
    .input-premium:focus {
      border-color: rgba(var(--accent-rgb), 0.6);
      box-shadow: 0 0 15px rgba(var(--accent-rgb), 0.2);
      outline: none;
    }

    /* Product Preview Flowchart animations */
    @keyframes pulseNode {
      0%, 100% { transform: scale(1); opacity: 0.8; }
      50% { transform: scale(1.15); opacity: 1; filter: drop-shadow(0 0 8px rgba(var(--accent-rgb), 0.8)); }
    }
    .svg-node-active {
      animation: pulseNode 2s infinite ease-in-out;
    }
    @keyframes dashMove {
      to {
        stroke-dashoffset: -20;
      }
    }
    .svg-path-flow {
      stroke-dasharray: 5, 5;
      animation: dashMove 1s linear infinite;
    }
    
    /* Document Scrollable box */
    .doc-scrollbox {
      max-height: 24rem;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: rgba(var(--accent-rgb), 0.2) rgba(0,0,0,0.1);
    }

    /* Glass card glow background mapping */
    .glass-card {
      position: relative;
      overflow: hidden;
    }
    .glass-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(300px circle at var(--mouse-x, 0) var(--mouse-y, 0), rgba(var(--accent-rgb), 0.08), transparent 40%);
      z-index: 0;
      opacity: 0;
      transition: opacity 0.5s ease;
      pointer-events: none;
    }
    .glass-card:hover::before {
      opacity: 1;
    }
    .glass-card > * {
      position: relative;
      z-index: 10;
    }
  </style>
</head>

<body class="bg-darkest text-textMain font-sans overflow-x-hidden min-h-screen relative">

  <!-- 🌌 Cybernetic Node Starfield (Interactive Background) -->
  <canvas id="canvas-network" class="fixed inset-0 pointer-events-none z-[-1]"></canvas>

  <!-- Static Gradient & Grid Backdrop -->
  <div class="fixed inset-0 bg-gradient-mesh z-[-2]"></div>
  <div class="fixed inset-0 bg-grid-mesh opacity-50 z-[-2]"></div>
  
  <!-- Glowing Nodes Backdrop -->
  <div class="fixed top-[-20%] left-[-20%] w-[70vw] h-[70vw] rounded-full radial-glow-1 z-[-1]"></div>
  <div class="fixed bottom-[-10%] right-[-10%] w-[60vw] h-[60vw] rounded-full radial-glow-2 z-[-1]"></div>

  <!-- ⏳ Futuristic Loader Overlay -->
  <div id="loading-screen" class="fixed inset-0 z-[999] bg-[#050505] flex flex-col items-center justify-center transition-all duration-1000 ease-out">
    <div class="relative flex flex-col items-center">
      <!-- Outer cyber circle -->
      <div class="w-24 h-24 rounded-full border border-dashed border-cyanaccent/30 animate-spin" style="animation-duration: 12s;"></div>
      <!-- Middle glowing ring -->
      <div class="absolute inset-2 rounded-full border border-cyanaccent/60 border-t-transparent animate-spin"></div>
      
      <!-- Inner Branding logo -->
      <div class="absolute inset-4 rounded-full bg-glassBg flex items-center justify-center border border-glassBorder shadow-[0_0_15px_rgba(34,211,238,0.2)]">
        <svg class="w-10 h-10 text-cyanaccent filter drop-shadow-[0_0_8px_rgba(34,211,238,0.6)] animate-pulse" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="15" y="15" width="14" height="70" fill="currentColor"/>
          <rect x="71" y="27" width="14" height="58" fill="currentColor"/>
          <rect x="71" y="2" width="14" height="14" fill="currentColor"/>
          <rect x="85" y="69" width="10" height="16" fill="currentColor"/>
          <polygon points="15,15 29,15 85,85 71,85" fill="currentColor"/>
        </svg>
      </div>
      <h2 class="font-orbitron font-extrabold text-lg text-white mt-8 tracking-[4px] uppercase"><%= projectName %></h2>
      <p class="text-xs text-cyanaccent/60 tracking-[2px] mt-2 font-mono uppercase">Initializing Systems...</p>
      
      <!-- Fading progress line -->
      <div class="w-48 h-[1px] bg-slate-800 rounded-full mt-6 overflow-hidden relative">
        <div class="absolute inset-y-0 left-0 w-0 bg-cyanaccent rounded-full transition-all duration-700 ease-out" id="loading-progress"></div>
      </div>
    </div>
  </div>

  <!-- ==================== SECTION 1 — NAVIGATION ==================== -->
  <header class="fixed top-0 left-0 w-full z-50 glass-header transition-all duration-300" id="site-header">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
      
      <!-- Logo Container -->
      <a href="#" class="flex items-center gap-3 font-orbitron font-extrabold text-sm tracking-[2px] text-white hover:opacity-95 transition-opacity flex-shrink-0 whitespace-nowrap">
        <% if (typeof platformLogo !== 'undefined' && platformLogo) { %>
          <img src="<%= platformLogo %>" alt="Naxton Logo" class="h-8 w-auto object-contain filter drop-shadow-[0_0_6px_rgba(34,211,238,0.5)]" />
        <% } else { %>
          <div class="relative w-8 h-8 flex items-center justify-center">
            <svg class="w-7 h-7 text-cyanaccent filter drop-shadow-[0_0_6px_rgba(34,211,238,0.5)]" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="15" y="15" width="14" height="70" fill="currentColor"/>
              <rect x="71" y="27" width="14" height="58" fill="currentColor"/>
              <rect x="71" y="2" width="14" height="14" fill="currentColor"/>
              <rect x="85" y="69" width="10" height="16" fill="currentColor"/>
              <polygon points="15,15 29,15 85,85 71,85" fill="currentColor"/>
            </svg>
          </div>
        <% } %>
        <span><%= projectName.toUpperCase().replace('TECHNOLOGIES', 'TECH') %></span>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden xl:flex items-center gap-5 text-[11px] font-semibold tracking-wider text-textDim flex-shrink-0">
        <a href="#" class="hover:text-cyanaccent text-cyanaccent transition-colors">HOME</a>
        <a href="#services" class="hover:text-cyanaccent transition-colors">SERVICES</a>
        <a href="#solutions" class="hover:text-cyanaccent transition-colors">SOLUTIONS</a>
        <a href="#products" class="hover:text-cyanaccent transition-colors">PRODUCTS</a>
        <a href="#technologies" class="hover:text-cyanaccent transition-colors">TECHNOLOGIES</a>
        <a href="#portfolio" class="hover:text-cyanaccent transition-colors">PORTFOLIO</a>
        <a href="#about" class="hover:text-cyanaccent transition-colors">ABOUT</a>
        <a href="#contact" class="hover:text-cyanaccent transition-colors">CONTACT</a>
      </nav>

      <!-- Action Buttons -->
      <div class="hidden md:flex items-center gap-4 flex-shrink-0">
        <!-- Theme Controller -->
        <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg bg-glassBg border border-glassBorder shadow-inner">
          <button onclick="setTheme('teal')" class="w-3 h-3 rounded-full bg-[#00bcd4] border border-white/20 hover:scale-125 transition-all cursor-pointer" title="Teal Cyber"></button>
          <button onclick="setTheme('purple')" class="w-3 h-3 rounded-full bg-[#a855f7] border border-white/20 hover:scale-125 transition-all cursor-pointer" title="Amethyst Aura"></button>
          <button onclick="setTheme('green')" class="w-3 h-3 rounded-full bg-[#10b981] border border-white/20 hover:scale-125 transition-all cursor-pointer" title="Matrix Jade"></button>
          <button onclick="setTheme('gold')" class="w-3 h-3 rounded-full bg-[#f59e0b] border border-white/20 hover:scale-125 transition-all cursor-pointer" title="Sol Amber"></button>
          <button onclick="setTheme('light')" class="w-3 h-3 rounded-full bg-[#ffffff] border border-slate-300 hover:scale-125 transition-all cursor-pointer shadow-[0_0_5px_rgba(255,255,255,0.8)]" title="Bright Light"></button>
        </div>

        <a href="#contact" class="px-4 py-2.5 rounded-lg border border-cyanaccent/30 text-xs font-bold font-orbitron tracking-widest text-cyanaccent bg-cyanaccent/5 hover:bg-cyanaccent/10 hover:border-cyanaccent/50 transition-all">
          BOOK CONSULTATION
        </a>
        <a href="/login" class="px-4 py-2.5 rounded-lg text-xs font-bold font-orbitron tracking-widest text-white btn-premium">
          GET STARTED
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button class="xl:hidden w-10 h-10 rounded-lg bg-glassBg border border-glassBorder flex items-center justify-center text-slate-300 hover:text-cyanaccent hover:border-cyanaccent/30 transition-all cursor-pointer" id="mobile-menu-btn" aria-label="Toggle Menu">
        <i data-lucide="menu" class="w-5 h-5"></i>
      </button>
    </div>

    <!-- Mobile Nav Backdrop -->
    <div id="mobile-nav-backdrop" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-40 transition-opacity duration-300"></div>

    <!-- Mobile Drawer -->
    <div id="mobile-nav" class="hidden fixed inset-y-0 right-0 w-80 max-w-full bg-darkest border-l border-glassBorder shadow-[0_0_40px_rgba(0,0,0,0.8)] backdrop-blur-xl flex flex-col p-8 z-50 transition-all duration-300">
      <div class="flex items-center justify-between mb-8">

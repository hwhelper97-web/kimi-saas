    // Jarvis Interactive HUD Scan trigger
    let jarvisScanInterval = null;
    function triggerJarvisScan() {
      const outerRing = document.getElementById('jarvis-outer-ring');
      const midRing = document.getElementById('jarvis-mid-ring');
      const loadText = document.getElementById('jarvis-telemetry-load');
      const pingText = document.getElementById('jarvis-telemetry-ping');
      const neuroText = document.getElementById('jarvis-neuro-status');
      const neuroBar = document.getElementById('jarvis-neuro-bar');
      const vectorText = document.getElementById('jarvis-vector-status');
      const vectorBar = document.getElementById('jarvis-vector-bar');

      if (!outerRing || !midRing) return;

      // Speed up rotation
      outerRing.classList.remove('animate-spin-cw');
      outerRing.classList.add('animate-spin-cw-fast');
      midRing.classList.remove('animate-spin-ccw');
      midRing.classList.add('animate-spin-ccw-fast');

      // Change status to scanning
      if (neuroText) {
        neuroText.innerText = "SCANNING...";
        neuroText.className = "text-cyanaccent font-extrabold text-[9px] animate-pulse";
      }

      let progress = 0;
      if (jarvisScanInterval) clearInterval(jarvisScanInterval);
      
      jarvisScanInterval = setInterval(() => {
        progress += 10;
        
        // Randomize load & ping
        if (loadText) loadText.innerText = (10 + Math.random() * 80).toFixed(1) + "%";
        if (pingText) pingText.innerText = Math.floor(10 + Math.random() * 90) + "ms";

        if (progress >= 100) {
          clearInterval(jarvisScanInterval);
          
          // Restore normal rotation
          outerRing.classList.remove('animate-spin-cw-fast');
          outerRing.classList.add('animate-spin-cw');
          midRing.classList.remove('animate-spin-ccw-fast');
          midRing.classList.add('animate-spin-ccw');
          
          // Restore static data with minor variations
          if (neuroText) {
            neuroText.innerText = "SECURE // EST.";
            neuroText.className = "text-white font-extrabold text-[9px]";
          }
          if (loadText) loadText.innerText = "12.4%";
          if (pingText) pingText.innerText = "18ms";
          
          // Randomize bar widths slightly
          if (neuroBar) neuroBar.style.width = (75 + Math.random() * 20) + "%";
          if (vectorBar) vectorBar.style.width = (60 + Math.random() * 30) + "%";
          if (vectorText) vectorText.innerText = Math.floor(3000 + Math.random() * 2000) + " / OK";
        }
      }, 150);
    }


            </span>
            <div class="w-12"></div>
          </div>

          <!-- Dashboard mockup grid -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            
            <!-- Widget 1: Analytics Live -->
            <div class="bg-black/40 rounded-lg p-3 border border-glassBorder sm:col-span-2">

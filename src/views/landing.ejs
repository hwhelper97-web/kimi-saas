    function selectThinkingNode(stageId) {
      if (!thinkingStages[stageId]) return;
      
      const titleEl = document.getElementById('thinking-stage-title');
      const descEl = document.getElementById('thinking-stage-desc');
      const latencyEl = document.getElementById('thinking-stage-latency');
      const threadsEl = document.getElementById('thinking-stage-threads');
      const stepTextEl = document.getElementById('thinking-step-text');
      const statusTextEl = document.getElementById('thinking-status-text');
      
      if (titleEl) titleEl.innerText = thinkingStages[stageId].title;
      if (descEl) descEl.innerText = thinkingStages[stageId].desc;
      if (latencyEl) latencyEl.innerText = thinkingStages[stageId].latency;
      if (threadsEl) threadsEl.innerText = thinkingStages[stageId].threads;
      
      const statusTextMap = {
        ingest: "listening to env tokens",
        perceive: "resolving intent vectors",
        act: "selecting response branch",
        reason: "cross-referencing dialog maps",
        synthesize: "rendering text prompts"
      };
      
      if (stepTextEl) stepTextEl.innerText = statusTextMap[stageId] || "idle standby";
      if (statusTextEl) statusTextEl.innerText = `Cognitive Engine: ${thinkingStages[stageId].title}`;
      
      ['ingest', 'perceive', 'act', 'reason', 'synthesize'].forEach(id => {
        const nodeG = document.getElementById(`node-${id}`);
        const halo = document.getElementById(`halo-${id}`);
        if (nodeG) {
          if (id === stageId) {
            nodeG.classList.add('active-stage');
            if (halo) halo.classList.remove('opacity-0');
          } else {
            nodeG.classList.remove('active-stage');
            if (halo) halo.classList.add('opacity-0');
          }
        }
      });

      updateLinksHighlight(stageId);
    }


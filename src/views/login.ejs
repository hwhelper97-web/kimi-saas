<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nexton technologies LLC — Login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:           #060d18;
      --panel:        rgba(12, 24, 44, 0.85);
      --border:       rgba(148, 176, 220, 0.13);
      --brand:        #5eead4;
      --brand-dim:    rgba(94, 234, 212, 0.15);
      --accent:       #818cf8;
      --text-h:       #f0f6ff;
      --text-body:    #c9d8ef;
      --text-muted:   #7a96b8;
      --danger:       #f87171;
      --success:      #34d399;
      --input-bg:     rgba(255,255,255,0.04);
      --input-border: rgba(148,176,220,0.18);
      --shadow-lg:    0 32px 64px rgba(0,0,0,0.5);
      --radius:       18px;
    }

    html, body {
      height: 100%;
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text-body);
    }

    /* ── Animated background glows ── */
    .glow {
      position: fixed;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
      opacity: 0.35;
      animation: drift 12s ease-in-out infinite alternate;
    }
    .glow-a { width:420px; height:420px; top:-100px; left:-80px;  background:rgba(94,234,212,0.28); animation-delay:0s; }
    .glow-b { width:320px; height:320px; bottom:0;  right:-60px;  background:rgba(129,140,248,0.22); animation-delay:-5s; }
    @keyframes drift { from{transform:translate(0,0)} to{transform:translate(30px,24px)} }

    /* ── Page layout ── */
    .page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      position: relative;
      z-index: 1;
    }

    /* ── Card ── */
    .card {
      width: 100%;
      max-width: 420px;
      background: var(--panel);
      backdrop-filter: blur(24px) saturate(180%);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 44px 40px 40px;
      box-shadow: var(--shadow-lg);
    }

    /* ── Logo ── */
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 32px;
    }
    .brand-icon {
      width: 40px; height: 40px;
      border-radius: 12px;
      background: linear-gradient(135deg, #5eead4, #818cf8);
      display: flex; align-items: center; justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
    }
    .brand-text { display: flex; flex-direction: column; }
    .brand-name {
      font-size: 20px;
      font-weight: 700;
      color: var(--text-h);
      letter-spacing: -0.02em;
    }
    .brand-sub {
      font-size: 11px;
      color: var(--brand);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-top: 1px;
    }

    /* ── Headings ── */
    .card h1 {
      font-size: 26px;
      font-weight: 700;
      color: var(--text-h);
      letter-spacing: -0.03em;
      margin-bottom: 6px;
    }
    .card .subtitle {
      font-size: 14px;
      color: var(--text-muted);
      margin-bottom: 32px;
    }

    /* ── Form ── */
    .field { margin-bottom: 18px; }
    .field label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .input-wrap { position: relative; }
    .input-wrap .icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 16px;
      pointer-events: none;
    }
    input[type="email"],
    input[type="password"],
    input[type="text"] {
      width: 100%;
      padding: 13px 14px 13px 42px;
      background: var(--input-bg);
      border: 1px solid var(--input-border);
      border-radius: var(--radius);
      color: var(--text-h);
      font-family: inherit;
      font-size: 14px;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    input:focus {
      border-color: rgba(94,234,212,0.45);
      box-shadow: 0 0 0 3px rgba(94,234,212,0.08);
    }
    input::placeholder { color: var(--text-muted); }

    /* ── Button ── */
    .btn {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: var(--radius);
      background: linear-gradient(135deg, #5eead4, #818cf8);
      color: #06111e;
      font-family: inherit;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      letter-spacing: 0.01em;
      margin-top: 8px;
      transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 8px 24px rgba(94,234,212,0.25);
      position: relative;
      overflow: hidden;
    }
    .btn:hover   { opacity: 0.92; transform: translateY(-1px); box-shadow: 0 14px 32px rgba(94,234,212,0.3); }
    .btn:active  { transform: translateY(0); }
    .btn.loading { opacity: 0.7; pointer-events: none; }
    .btn .spinner {
      display: none;
      width: 16px; height: 16px;
      border: 2px solid rgba(6,17,30,0.4);
      border-top-color: #06111e;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      margin-right: 8px;
      vertical-align: middle;
    }
    .btn.loading .spinner { display: inline-block; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── Error ── */
    .error-msg {
      background: rgba(248,113,113,0.1);
      border: 1px solid rgba(248,113,113,0.25);
      color: #fca5a5;
      border-radius: 10px;
      padding: 10px 14px;
      font-size: 13px;
      margin-top: 16px;
      display: none;
    }
    .error-msg.show { display: block; }

    /* ── Footer ── */
    .card-footer {
      margin-top: 28px;
      text-align: center;
      font-size: 12px;
      color: var(--text-muted);
      border-top: 1px solid var(--border);
      padding-top: 20px;
    }
    .card-footer a { color: var(--brand); text-decoration: none; }
    .card-footer a:hover { text-decoration: underline; }

    /* ── Divider ── */
    .divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 24px 0;
      color: var(--text-muted);
      font-size: 12px;
    }
    .divider::before, .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }
  </style>
</head>
<body>

<div class="glow glow-a"></div>
<div class="glow glow-b"></div>

<div class="page">
  <div class="card">

    <div class="brand">
      <div class="brand-icon" style="<%= platformLogo ? 'background:none;' : '' %>">
        <% if (platformLogo) { %>
          <img src="<%= platformLogo %>" style="width: 100%; height: 100%; border-radius: 12px; object-fit: cover;">
        <% } else { %>
          🤖
        <% } %>
      </div>
      <div class="brand-text">
        <span class="brand-name"><%= projectName || 'Nexton technologies LLC' %></span>
        <span class="brand-sub">Voice Commerce Suite</span>
      </div>
    </div>

    <h1>Welcome back</h1>
    <p class="subtitle">Sign in to your operations console</p>

    <form onsubmit="handleLogin(event)" autocomplete="on" novalidate>

      <div class="field">
        <label for="email">Email address</label>
        <div class="input-wrap">
          <span class="icon">✉️</span>
          <input type="email" id="email" name="email" placeholder="you@company.com" autocomplete="email" required />
        </div>
      </div>

      <div class="field">
        <label for="password">Password</label>
        <div class="input-wrap">
          <span class="icon">🔒</span>
          <input type="password" id="password" name="password" placeholder="••••••••" autocomplete="current-password" required />
        </div>
      </div>

      <button type="submit" class="btn" id="loginBtn">
        <span class="spinner"></span>
        Sign in
      </button>

    </form>

    <div class="error-msg" id="errorMsg"></div>

    <div class="card-footer">
      Protected by JWT · <a href="#">Privacy Policy</a>
    </div>
  </div>
</div>

<script>
async function loadPlatform() {
  try {
    const res = await fetch('/api/platform/settings');
    const result = await res.json();
    if (result.success && result.data) {
      const { logoUrl, projectName } = result.data;
      if (logoUrl) {
        document.querySelector('.brand-icon').innerHTML = `<img src="${logoUrl}" style="width: 100%; height: 100%; border-radius: 12px; object-fit: cover;">`;
        document.querySelector('.brand-icon').style.background = 'none';
      }
      if (projectName) {
        document.querySelector('.brand-name').innerText = projectName;
        document.title = projectName + " — Login";
      }
    }
  } catch (err) {
    console.error("Load platform error:", err);
  }
}

loadPlatform();

async function handleLogin(event) {
  event.preventDefault();

  const email    = document.getElementById('email').value.trim();
  const password = document.getElementById('password').value;
  const errorEl  = document.getElementById('errorMsg');
  const btn      = document.getElementById('loginBtn');

  errorEl.classList.remove('show');

  if (!email || !password) {
    errorEl.textContent = 'Please enter your email and password.';
    errorEl.classList.add('show');
    return;
  }

  btn.classList.add('loading');

  try {
    const res    = await fetch('/api/auth/login', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify({ email, password }),
    });
    const result = await res.json();

    if (res.ok) {
      localStorage.setItem('accessToken',  result.accessToken);
      localStorage.setItem('refreshToken', result.refreshToken);

      const payload = JSON.parse(atob(result.accessToken.split('.')[1]));
      window.location.href = '/admin';
    } else {
      errorEl.textContent = result.error || 'Invalid credentials. Please try again.';
      errorEl.classList.add('show');
      btn.classList.remove('loading');
    }
  } catch {
    errorEl.textContent = 'Cannot reach the server. Please check your connection.';
    errorEl.classList.add('show');
    btn.classList.remove('loading');
  }
}
</script>

</body>
</html>
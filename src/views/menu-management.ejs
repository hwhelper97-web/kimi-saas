<div id="menuHeaderActions" style="display:flex; justify-content:flex-end; gap:0.75rem; margin-bottom: 1.5rem;">
  <button type="button" class="action-btn" onclick="openCategoryModal()" id="btnNewCat" style="width:auto; padding:0 1rem; border-color:var(--border); font-weight:600; height:2.5rem;">
    <i data-lucide="folder-plus" style="width:16px; margin-right:4px;"></i> <span>New Category</span>
  </button>
  <button type="button" class="action-btn" id="btnNewItem" onclick="openItemModal()" style="width:auto; padding:0 1rem; background:var(--primary); color:white; border:none; font-weight:600; height:2.5rem;">
    <i data-lucide="plus" style="width:16px; margin-right:4px;"></i> <span>Add Item</span>
  </button>
</div>

<script>
  (function() {
    const bType = localStorage.getItem("activeBusinessType") || "appointment";
    const isOrder = ["order", "restaurant", "food"].some(t => bType.toLowerCase().includes(t));
    const term = isOrder ? "Menu Item" : "Service";
    const catTerm = isOrder ? "Menu Category" : "Service Category";
    
    const btnCat = document.querySelector("#btnNewCat span");
    const btnItem = document.querySelector("#btnNewItem span");
    if (btnCat) btnCat.innerText = `New ${catTerm}`;
    if (btnItem) btnItem.innerText = `Add ${term}`;
  })();
</script>

<div class="apex-grid" style="grid-template-columns: 280px 1fr; gap: 1.5rem; align-items: start;">
  <div class="apex-card" style="padding: 1rem;">
    <h3 class="card-title" id="catListTitle" style="margin-bottom:1rem; font-size:0.75rem; text-transform:uppercase; color:var(--text-muted);">Categories</h3>
    <div id="menuCatList" style="display:flex; flex-direction:column; gap:0.5rem;">
      <div class="spin" style="width:16px; height:16px; border:2px solid var(--primary); border-top-color:transparent; border-radius:50%; margin: 1rem auto;"></div>
    </div>
  </div>

  <div style="display:flex; flex-direction:column; gap:1.5rem;">
    <div class="apex-card">
      <div class="card-header" style="margin-bottom:1.5rem;">
        <div class="header-search" style="max-width: 400px; background:var(--bg-muted);">
          <i data-lucide="search"></i>
          <input type="text" id="menuSearch" placeholder="Search menu..." oninput="filterMenu(this.value)" />
        </div>
      </div>
      <div id="menuItemsGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
        <div style="grid-column: 1/-1; text-align:center; padding:4rem; color:var(--text-muted);">Select a category to view items</div>
      </div>
    </div>
  </div>
</div>


<!-- 🚀 Modifier Group Modal -->
<div id="modifierGroupModal" class="modal-overlay">
  <div class="modal-container" style="max-width: 500px; padding: 2.5rem;">
    <div class="modal-header">
      <h3 style="font-weight: 700;">Create Modifier Group</h3>
      <button class="close-modal" onclick="closeModal('modifierGroupModal')">&times;</button>
    </div>
    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label>Group Name</label>
      <input type="text" id="mgName" class="form-control" placeholder="e.g. Spice Level" />
    </div>
    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label>Selection Type</label>
      <select id="mgSelectionType" class="form-control">
        <option value="SINGLE">Single Choice (Radio)</option>
        <option value="MULTIPLE">Multiple Choice (Checkbox)</option>
      </select>
    </div>
    <div id="mgOptionsRepeater" style="margin-top: 1rem; display: flex; flex-direction: column; gap: 0.75rem;"></div>
    <button type="button" class="action-btn" style="margin-top: 1.5rem; width: auto; padding: 0 1rem; border: 1px dashed var(--border);" onclick="addMgOptionRow()">
      <i data-lucide="plus" style="width: 14px; margin-right: 4px;"></i> Add Option
    </button>
    <div class="modal-footer" style="margin-top: 2.5rem; display: flex; justify-content: flex-end; gap: 0.75rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
      <button class="action-btn" onclick="closeModal('modifierGroupModal')">Cancel</button>
      <button class="action-btn btn-primary" style="background: var(--primary); color: white; border: none; width: auto; padding: 0 1.5rem;" onclick="saveModifierGroup()">Save Group</button>
    </div>
  </div>
</div>

<!-- 🚀 Addon Modal -->
<div id="addonModal" class="modal-overlay">
  <div class="modal-container" style="max-width: 400px; padding: 2.5rem;">
    <div class="modal-header">
      <h3 style="font-weight: 700;">Create Business Addon</h3>
      <button class="close-modal" onclick="closeModal('addonModal')">&times;</button>
    </div>
    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label>Addon Name</label>
      <input type="text" id="addonName" class="form-control" placeholder="e.g. Extra Fries" />
    </div>
    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label>Price ($)</label>
      <input type="number" step="0.01" id="addonPrice" class="form-control" placeholder="0.00" />
    </div>
    <div class="modal-footer" style="margin-top: 2.5rem; display: flex; justify-content: flex-end; gap: 0.75rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
      <button class="action-btn" onclick="closeModal('addonModal')">Cancel</button>
      <button class="action-btn btn-primary" style="background: var(--primary); color: white; border: none; width: auto; padding: 0 1.5rem;" onclick="saveAddon()">Save Addon</button>
    </div>
  </div>
</div>

<script>
(function() {
  if (window.lucide) lucide.createIcons();
  
  window.allCategories = [];
  window.currentCategoryId = null;
  
  const bType = localStorage.getItem("activeBusinessType") || "appointment";
  const isOrder = ["order", "restaurant", "food"].some(t => bType.toLowerCase().includes(t));
  const catTitle = document.getElementById("catListTitle");
  if (catTitle) catTitle.innerText = isOrder ? "Menu Categories" : "Service Categories";

  window.loadCategories = async function() {
    const container = document.getElementById("menuCatList");
    if (!container) return;
    try {
      const bId = (typeof getBusinessId === 'function' ? getBusinessId() : localStorage.getItem("activeBusinessId"));
      if (!bId) {
        console.warn("[Menu] No active business ID found");
        return;
      }
      const res = await fetch(`/api/menu/categories?businessId=${bId}`, {
        headers: { 'Authorization': 'Bearer ' + (localStorage.getItem("accessToken") || window.token) }
      });
      const result = await res.json();
      if (result.success) {
        window.allCategories = result.data;
        container.innerHTML = result.data.map(c => `
          <div class="apex-nav-item m-cat-item ${window.currentCategoryId === c.id ? 'active' : ''}" 
               data-id="${c.id}" onclick="selectMenuCategory('${c.id}')">
            <i data-lucide="tag" style="width:14px;"></i>
            <span>${c.name}</span>
            <div style="margin-left:auto; display:flex; align-items:center; gap:0.5rem;">
               <i data-lucide="edit-2" style="width:12px; cursor:pointer;" onclick="event.stopPropagation(); openCategoryModal({id:'${c.id}', name:'${c.name}', description:'${c.description||''}'})"></i>
            </div>
          </div>
        `).join("");
        if (window.lucide) window.lucide.createIcons();
        if (!window.currentCategoryId && result.data.length) selectMenuCategory(result.data[0].id);
      }
    } catch (err) { console.error(err); }
  };

  window.selectMenuCategory = function(id) {
    window.currentCategoryId = id;
    document.querySelectorAll('.m-cat-item').forEach(it => {
      it.classList.toggle('active', it.dataset.id === id);
    });
    loadItems(id);
  };

  window.loadItems = async function(catId) {
    const grid = document.getElementById("menuItemsGrid");
    if (!grid) return;
    grid.innerHTML = '<div style="grid-column:1/-1; text-align:center; padding:4rem;"><div class="spin"></div></div>';
    try {
      const bId = (typeof getBusinessId === 'function' ? getBusinessId() : localStorage.getItem("activeBusinessId"));
      const res = await fetch(`/api/menu/items?businessId=${bId}&categoryId=${catId}`, {
        headers: { 'Authorization': 'Bearer ' + (localStorage.getItem("accessToken") || window.token) }
      });
      const result = await res.json();
      if (result.success) {
        grid.innerHTML = result.data.map(i => `
          <div class="apex-card" style="padding:0; overflow:hidden;">
            <div style="height:140px; background:var(--bg-muted); position:relative;">
              ${i.imageUrl ? `<img src="${i.imageUrl}" style="width:100%; height:100%; object-fit:cover;" />` : `<div style="display:flex; align-items:center; justify-content:center; height:100%;"><i data-lucide="image" style="color:var(--text-muted);"></i></div>`}
              <div style="position:absolute; top:0.5rem; right:0.5rem; background:rgba(0,0,0,0.6); color:white; padding:0.2rem 0.6rem; border-radius:1rem; font-size:0.8rem; font-weight:700;">
                $${(i.price||0).toFixed(2)}
              </div>
            </div>
            <div style="padding:1rem;">
              <h4 style="margin-bottom:0.25rem;">${i.name}</h4>
              <p style="font-size:0.75rem; color:var(--text-muted); height:2rem; overflow:hidden; margin-bottom:0.75rem;">${i.description || ''}</p>
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="badge" style="font-size:0.6rem;">${i.isAvailable ? 'IN STOCK' : 'OUT'}</span>
                <div style="display:flex; gap:0.4rem;">
                  <button class="action-btn" style="width:28px; height:28px;" onclick="editItem('${i.id}')"><i data-lucide="edit-3" style="width:14px;"></i></button>
                  <button class="action-btn" style="width:28px; height:28px;" onclick="deleteItem('${i.id}')"><i data-lucide="trash-2" style="width:14px;"></i></button>
                </div>
              </div>
            </div>
          </div>
        `).join("");
        if (window.lucide) window.lucide.createIcons();
      }
    } catch (err) { console.error(err); }
  };

  window.filterMenu = function(query) {
    const q = query.toLowerCase();
    document.querySelectorAll('#menuItemsGrid .apex-card').forEach(card => {
      const name = card.querySelector('h4').innerText.toLowerCase();
      card.style.display = name.includes(q) ? 'block' : 'none';
    });
  };

  loadCategories();
})();
</script>

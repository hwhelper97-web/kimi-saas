        document.getElementById("nt_sentiment_bar").style.background = score > 0.7 ? '#10b981' : '#f59e0b';

        // Parse full chat
        const rawLines = c.transcript ? c.transcript.split(/(AI:|Customer:|USER:|BOT:)/i).filter(Boolean) : [];
        let bubbles = [];
        let lastRole = "ai";
        
        if (rawLines.length < 2) {
            bubbles = [{ role: 'ai', text: "Hello! This is AI assistant. How can I help?" }, { role: 'customer', text: c.transcript }];
        } else {
            for (let i = 0; i < rawLines.length; i++) {
                const part = rawLines[i].trim();
                const partLower = part.toLowerCase();
                if (partLower === "ai:" || partLower === "bot:") { lastRole = "ai"; continue; }
                if (partLower === "customer:" || partLower === "user:") { lastRole = "customer"; continue; }
                bubbles.push({ role: lastRole, text: part });
            }
        }

        document.getElementById("nt_chat_full").innerHTML = bubbles.map(b => `
            <div class="bubble-item ${b.role}" style="max-width: 70%; margin-bottom: 1rem;">
                <div class="bubble-text" style="padding: 1rem 1.25rem; font-size: 1rem;">${b.text}</div>
                <span style="font-size: 0.7rem; color: var(--text-muted); margin-top: 4px; display: block;">${b.role.toUpperCase()} • Just now</span>
            </div>
        `).join('');

        const modal = document.getElementById("neuralTranscriptModal");
        modal.classList.add("show");
        lucide.createIcons();
    }


      pill.classList.remove("hidden");
      consoleDiv.innerHTML += `<p style="color: #3b82f6;">> Starting ${type} simulation for ${tenantId}...</p>`;
      
      try {
        // We can use a special demo endpoint or just mock it here for visual confirmation
        // For actual functionality, we'll trigger the process endpoint with a simulated payload
        const res = await fetch("/api/call/process", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams({
            CallSid: "DEMO_" + Date.now(),
            From: phone,
            To: "+19998887777",
            SpeechResult: script,
            IsDemo: "true",
            DemoTenantId: tenantId
          })
        });
        
        consoleDiv.innerHTML += `<p style="color: #10b981;">> AI Processing completed. Analyzing response...</p>`;

  <div id="syncOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(6, 30, 38, 0.95); z-index: 10000; flex-direction: column; align-items: center; justify-content: center; backdrop-filter: blur(10px);">
    <div style="width: 120px; height: 120px; position: relative; margin-bottom: 2rem;">
      <svg style="width: 100%; height: 100%; transform: rotate(-90deg);">
        <circle cx="60" cy="60" r="54" style="fill: none; stroke: rgba(255,255,255,0.05); stroke-width: 8;"></circle>
        <circle id="syncProgressCircle" cx="60" cy="60" r="54" style="fill: none; stroke: var(--primary); stroke-width: 8; stroke-dasharray: 339; stroke-dashoffset: 339; transition: stroke-dashoffset 0.5s ease; stroke-linecap: round;"></circle>
      </svg>
      <div id="syncPercent" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 1.5rem; font-weight: 800;">0%</div>
    </div>
    <h2 style="color: var(--primary);">AI Sync in Progress</h2>
    <p id="syncStatus" style="color: var(--text-secondary);">Initializing Naxton AI Crawler...</p>
  </div>

  <script>
    const token = localStorage.getItem("accessToken") || sessionStorage.getItem("accessToken");
    if (!token) window.location.href = "/login";
    window.currentUser = JSON.parse(localStorage.getItem("user") || "{}");
    const socket = io({ auth: { token } });
    let allTenants = [];
    let revenueChartInstance = null;
    let callsChartInstance = null;
    let currentBusinessFilter = "";

    function toggleMobileSidebar() {
      const sidebar = document.querySelector('.apex-sidebar');
      const overlay = document.getElementById('sidebarOverlay');
      if (sidebar) {
        sidebar.classList.toggle('active');
        const isActive = sidebar.classList.contains('active');
        if (overlay) {
          overlay.style.display = isActive ? 'block' : 'none';
        }
      }
    }

    function logout() { 
      localStorage.removeItem("accessToken");
      localStorage.removeItem("user");
      localStorage.removeItem("activeBusinessId");
      window.location.href = "/logout"; 
    }

    function showSuccess(msg) {
      const box = document.getElementById("successBox");
      if (!box) return;
      box.innerText = msg;
      box.style.display = "block";
      setTimeout(() => { box.style.display = "none"; }, 5000);
    }

    function showError(msg) {
      const box = document.getElementById("errorBox");
      if (!box) return;
      box.innerText = msg;
      box.style.display = "block";
      setTimeout(() => { box.style.display = "none"; }, 5000);
    }

    function showSection(id, subTab = null) {
      document.querySelectorAll('.section-container').forEach(s => s.style.display = 'none');
      document.querySelectorAll('.apex-nav-item').forEach(n => n.classList.remove('active'));
      
      const targetSection = document.getElementById(id + 'Section');
      if (targetSection) targetSection.style.display = 'block';
      
      const navItem = document.getElementById('nav-' + id);
      if (navItem) navItem.classList.add('active');

      const sidebar = document.querySelector('.apex-sidebar');
      if (sidebar && sidebar.classList.contains('active')) {
        toggleMobileSidebar();
      }
      
      // Auto-load section specific data
      if (id === 'dashboard') { loadAnalytics(); loadActivityFeed(); loadBusinesses(); }
      if (id === 'tenants') loadTenants();
      if (id === 'support') { 
        loadSupportActivity(); 
        loadTicketsSA(); 
        loadConversationsSA();
        if (subTab) switchSupportTab(subTab);
        else switchSupportTab('overview');
      }
      if (id === 'provisioning') { nextStep(1); } // Initialize wizard
      if (id === 'billing') loadMintRequests();
      if (id === 'demo') loadDemoTenants();
      if (id === 'infra') loadInfraStats();
      if (id === 'aiops') loadAiOps();
      if (id === 'security') loadAuditLogs();
      if (id === 'incidents') loadIncidentsSA();
      if (id === 'queues') loadQueueStats();
      if (id === 'settings') loadSettingsGroup('GENERAL');
      if (id === 'phones') loadInventory();
      
      lucide.createIcons();
    }

    function switchSupportTab(tabId) {
      console.log("[Support] Switching to tab:", tabId);
      // Hide all support sub-tabs
      document.querySelectorAll('.support-tab-content').forEach(c => c.style.display = 'none');
      // Deactivate all support tab buttons
      document.querySelectorAll('.support-tabs .tab-btn').forEach(b => b.classList.remove('active'));
      
      // Show target tab
      const target = document.getElementById('support-' + tabId);
      if (target) target.style.display = 'block';
      
      // Activate target button (handles both click events and programmatic triggers)
      const btns = document.querySelectorAll('.support-tabs .tab-btn');
      btns.forEach(btn => {
        if (btn.getAttribute('onclick') && btn.getAttribute('onclick').includes(`'${tabId}'`)) {
          btn.classList.add('active');
        }
      });

      // Load specific tab data
      if (tabId === 'overview') loadSupportActivity();
      if (tabId === 'tickets') loadTicketsSA();
      if (tabId === 'inbox') loadConversationsSA();
      if (tabId === 'matrix') loadStaffSA();
    }

    /* ======================================
       INFRASTRUCTURE MONITORING
    ====================================== */
    let infraChartInstance = null;
    async function loadInfraStats() {
      try {
        const res = await fetch("/api/superadmin/infrastructure", { headers: { Authorization: "Bearer " + token } });
        const r = await res.json();
        if (r.success) {
          const h = r.data.health;
          document.getElementById("infraCpu").innerText = h.cpu;
          document.getElementById("infraRam").innerText = h.ram;
          document.getElementById("infraWs").innerText = h.websockets;
          document.getElementById("infraLatency").innerText = h.latency;
          
          renderInfraChart(r.data.metrics);
          renderHealthCheckpoints();
        }
      } catch (e) {}
    }

    function renderInfraChart(metrics) {
      if (infraChartInstance) infraChartInstance.destroy();
      // Generate some dummy labels if metrics are sparse
      const labels = metrics.length ? metrics.map(m => new Date(m.timestamp).toLocaleTimeString()) : ["10:00", "10:10", "10:20", "10:30", "10:40", "10:50"];
      const data = metrics.length ? metrics.map(m => m.value) : [20, 25, 22, 30, 28, 35];

      infraChartInstance = new Chart(document.getElementById("infraMetricsChart"), {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: 'System Load %',
            data,
            borderColor: 'var(--primary)',
            backgroundColor: 'rgba(var(--primary-rgb), 0.1)',
            fill: true,
            tension: 0.4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: { grid: { color: 'rgba(255,255,255,0.05)' }, beginAtZero: true },
            x: { grid: { display: false } }
          }
        }
      });
    }

    function renderHealthCheckpoints() {
      const container = document.getElementById("healthCheckpoints");
      const checks = [
        { name: "PostgreSQL Connection", status: "Healthy", time: "2ms" },
        { name: "Redis Cache Cluster", status: "Healthy", time: "1ms" },
        { name: "BullMQ Processors", status: "Active", time: "N/A" },
        { name: "WebSocket Gateway", status: "Connected", time: "14ms" },
        { name: "Storage S3 Bucket", status: "Accessible", time: "45ms" }
      ];
      container.innerHTML = checks.map(c => `
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; background: rgba(255,255,255,0.02); border-radius: 8px;">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <i data-lucide="check-circle" style="width: 14px; color: #10b981;"></i>
            <span style="font-size: 0.8rem; font-weight: 600;">${c.name}</span>
          </div>
          <span style="font-size: 0.7rem; color: var(--text-muted);">${c.time}</span>
        </div>
      `).join("");
      lucide.createIcons();
    }

    /* ======================================
       AI OPERATIONS
    ====================================== */
    async function loadAiOps() {
      try {
        const res = await fetch("/api/superadmin/ai-ops", { headers: { Authorization: "Bearer " + token } });
        const r = await res.json();
        if (r.success) {
          const s = r.data.aiStats;
          document.getElementById("aiOpenAiTokens").innerText = s.openai.tokens;
          document.getElementById("aiOpenAiCost").innerText = s.openai.cost;
          document.getElementById("aiElevenChars").innerText = s.elevenlabs.characters;
          document.getElementById("aiElevenCost").innerText = s.elevenlabs.cost;
          document.getElementById("aiDeepgramMins").innerText = s.deepgram.minutes;
          document.getElementById("aiDeepgramCost").innerText = s.deepgram.cost;
          document.getElementById("aiTwilioMins").innerText = s.twilio.minutes;
          document.getElementById("aiTwilioCost").innerText = s.twilio.cost;

          renderAiSessions(r.data.calls);

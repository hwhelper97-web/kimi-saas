    function switchSupportTab(tabId) {
      document.querySelectorAll('.support-tab-content').forEach(c => c.style.display = 'none');
      document.querySelectorAll('.support-tabs .tab-btn').forEach(b => b.classList.remove('active'));
      const target = document.getElementById('support-' + tabId);
      if (target) target.style.display = 'block';
      if (event && event.currentTarget) event.currentTarget.classList.add('active');
      
      if (tabId === 'overview') loadSupportActivity();
      if (tabId === 'tickets') loadTicketsSA();
      if (tabId === 'inbox') loadConversationsSA();
    }

    async function loadSupportActivity() {
      const container = document.getElementById("supportActivityFeed");
      if (!container) return;
      
      try {
        // Fetch conversations and tickets in parallel
        const [convosRes, ticketsRes] = await Promise.all([
          fetch("/api/support/conversations", { headers: { Authorization: "Bearer " + token } }),
          fetch("/api/support/tickets", { headers: { Authorization: "Bearer " + token } })
        ]);
        
        const convos = await convosRes.json();
        const tickets = await ticketsRes.json();
        
        // Update counters
        if (convos.success) {
          document.getElementById("activeConvosCount").innerText = convos.data.length;
        }
        if (tickets.success) {
          const openCount = tickets.data.filter(t => t.status === 'open' || t.status === 'pending').length;
          document.getElementById("openTicketsCount").innerText = openCount;
        }

        let activities = [];
        
        if (convos.success) {
          convos.data.slice(0, 5).forEach(c => {
            activities.push({
              type: 'chat',
              title: `Chat with ${c.customer?.name || 'Tenant'}`,
              desc: c.messages?.[0]?.content || 'Started a new session',
              time: c.updatedAt || c.createdAt,
              icon: 'message-circle',
              color: 'var(--primary)'
            });
          });
        }
        
        if (tickets.success) {
          tickets.data.slice(0, 5).forEach(t => {
            activities.push({
              type: 'ticket',
              title: `Ticket: ${t.title}`,
              desc: `Status: ${t.status.toUpperCase()} • Priority: ${t.priority.toUpperCase()}`,
              time: t.createdAt,
              icon: 'ticket',
              color: t.priority === 'high' ? '#ef4444' : '#f59e0b'
            });
          });
        }
        
        // Sort by time descending
        activities.sort((a, b) => new Date(b.time) - new Date(a.time));
        
        if (activities.length === 0) {
          container.innerHTML = '<p style="text-align: center; color: var(--text-muted); padding: 2rem; font-size: 0.8rem;">No recent platform frequencies detected.</p>';
          return;
        }

        // Update Urgent Tickets List
        const urgentContainer = document.getElementById("urgentTicketsList");
        if (urgentContainer && tickets.success) {
          const highPriority = tickets.data.filter(t => t.priority === 'high' && (t.status === 'open' || t.status === 'pending'));
          if (highPriority.length > 0) {
            urgentContainer.innerHTML = highPriority.slice(0, 3).map(t => `
              <div style="padding: 0.75rem; background: rgba(239, 68, 68, 0.05); border: 1px solid rgba(239, 68, 68, 0.1); border-radius: 12px; display: flex; align-items: center; gap: 0.75rem;">
                <i data-lucide="alert-circle" style="width: 14px; color: #ef4444;"></i>
                <div style="flex: 1; min-width: 0;">
                  <div style="font-size: 0.75rem; font-weight: 700; color: #ef4444;">${t.title}</div>
                  <div style="font-size: 0.65rem; color: var(--text-muted);">${t.tenant?.name || 'Platform'}</div>
                </div>
              </div>
            `).join('');
          } else {
             urgentContainer.innerHTML = `
              <div style="text-align: center; padding: 1.5rem;">
                <i data-lucide="shield-check" style="width: 24px; color: var(--success); opacity: 0.3; margin-bottom: 0.5rem;"></i>
                <p style="color: var(--text-muted); font-size: 0.65rem;">All systems operational.</p>
              </div>
            `;
          }
        }
        
        container.innerHTML = activities.slice(0, 8).map(a => `
          <div style="display: flex; gap: 1rem; padding: 1rem; background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 16px;">
            <div style="width: 36px; height: 36px; background: ${a.color}20; color: ${a.color}; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <i data-lucide="${a.icon}" style="width: 18px;"></i>
            </div>
            <div style="flex: 1; min-width: 0;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                <h4 style="font-size: 0.85rem; font-weight: 700;">${a.title}</h4>
                <span style="font-size: 0.65rem; color: var(--text-muted);">${new Date(a.time).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
              </div>
              <p style="font-size: 0.75rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${a.desc}</p>
            </div>
          </div>
        `).join('');
        lucide.createIcons();
        
      } catch (e) {
        console.error("Failed to load support activity", e);
      }
    }


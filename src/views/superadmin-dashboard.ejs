      if (!data.length) { 
        container.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:5rem; color:var(--text-muted);">No active tenants found.</td></tr>`; 
        return; 
      }
      
      container.innerHTML = data.map((t, index) => {
        const usagePct = t.monthlyLimit > 0 ? Math.min((t.usedMinutes / t.monthlyLimit) * 100, 100) : 0;
        const joined = new Date(t.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        const bizId = t.businesses && t.businesses[0] ? t.businesses[0].id : null;
        const planMapping = {
          'nexa-core': { name: 'Nexa Core', badge: 'CORE', class: 'status-badge-standard' },

  <!-- SYNC OVERLAY -->
  <div id="syncOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(6, 30, 38, 0.95); z-index: 10000; flex-direction: column; align-items: center; justify-content: center; backdrop-filter: blur(10px);">
    <div style="width: 120px; height: 120px; position: relative; margin-bottom: 2rem;">
      <svg style="width: 100%; height: 100%; transform: rotate(-90deg);">
        <circle cx="60" cy="60" r="54" style="fill: none; stroke: rgba(255,255,255,0.05); stroke-width: 8;"></circle>
        <circle id="syncProgressCircle" cx="60" cy="60" r="54" style="fill: none; stroke: var(--primary); stroke-width: 8; stroke-dasharray: 339; stroke-dashoffset: 339; transition: stroke-dashoffset 0.5s ease; stroke-linecap: round;"></circle>
      </svg>
      <div id="syncPercent" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 1.5rem; font-weight: 800;">0%</div>
    </div>
    <h2 style="color: var(--primary);">AI Sync in Progress</h2>
    <p id="syncStatus" style="color: var(--text-secondary);">Initializing Nexton AI Crawler...</p>
  </div>

  <script>
    const token = localStorage.getItem("accessToken") || sessionStorage.getItem("accessToken");
    if (!token) window.location.href = "/login";
    const socket = io();
    let allTenants = [];
    let revenueChartInstance = null;
    let callsChartInstance = null;
    let currentBusinessFilter = "";

    function logout() { localStorage.clear(); window.location.href = "/login"; }

    function showSection(id) {
      document.querySelectorAll('.section-container').forEach(s => s.style.display = 'none');
      document.querySelectorAll('.apex-nav-item').forEach(n => n.classList.remove('active'));
      document.getElementById(id + 'Section').style.display = 'block';
      document.getElementById('nav-' + id).classList.add('active');
      
      // Auto-load section specific data
      if (id === 'dashboard') { loadAnalytics(); loadActivityFeed(); loadBusinesses(); }
      if (id === 'support') { loadSupportActivity(); loadTicketsSA(); loadConversationsSA(); }
      if (id === 'billing') loadMintRequests();
      if (id === 'demo') loadDemoTenants();
      
      lucide.createIcons();
    }

    function showSuccess(m) { const b = document.getElementById("successBox"); b.innerText = m; b.style.display = "block"; setTimeout(() => b.style.display="none", 4000); }
    function showError(m) { const b = document.getElementById("errorBox"); b.innerText = m; b.style.display = "block"; setTimeout(() => b.style.display="none", 4000); }

    async function loadAnalytics() {
      try {
        const query = currentBusinessFilter ? `?businessId=${currentBusinessFilter}` : "";
        const res = await fetch(`/api/superadmin/analytics${query}`, { headers: { Authorization: "Bearer " + token } });
        const r = await res.json(); if (!r.success) return;
        const d = r.data;
        document.getElementById("statRevenue").innerText = "$" + (d.totalRevenue || 0).toFixed(2);
        document.getElementById("totalTenants").innerText = d.tenants;
        document.getElementById("totalCalls").innerText = d.calls;
        document.getElementById("conversionRate").innerText = (d.conversionRate || 0) + "%";
        if (d.revenueChart) renderRevenueChart(d.revenueChart);
        if (d.callsChart) renderCallsChart(d.callsChart);
        lucide.createIcons();
      } catch (e) {}
    }

    async function loadBusinesses() {
      try {
        const res = await fetch("/api/superadmin/businesses", { headers: { Authorization: "Bearer " + token } });
        const r = await res.json();
        if (r.success) {
          const select = document.getElementById("globalBusinessFilter");
          const options = r.data.map(b => `<option value="${b.id}">${b.name} (${b.type})</option>`).join("");
          select.innerHTML = `<option value="">Full Platform Overview</option>` + options;
        }
      } catch (e) {}
    }

    function updateDashboardFilter(val) {
      currentBusinessFilter = val;
      const label = document.getElementById("dashboardScopeLabel");
      if (val) {
        const name = document.getElementById("globalBusinessFilter").options[document.getElementById("globalBusinessFilter").selectedIndex].text;
        label.innerText = `Detailed insights for ${name}.`;
      } else {
        label.innerText = "Real-time analytics and infrastructure monitoring across all tenants.";
      }
      loadAnalytics();
      loadActivityFeed();
      loadTranscripts();
    }

    function renderRevenueChart(data) {
      if (revenueChartInstance) revenueChartInstance.destroy();
      revenueChartInstance = new Chart(document.getElementById("revenueChart"), {
        type: 'line', data: { labels: data.labels, datasets: [{ label: 'Revenue', data: data.values, borderColor: '#00bcd4', backgroundColor: 'rgba(0,188,212,0.1)', fill: true, tension: 0.4 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { grid: { color: 'rgba(255,255,255,0.05)' } }, x: { grid: { display: false } } } }
      });
    }

    function renderCallsChart(data) {
      if (callsChartInstance) callsChartInstance.destroy();
      callsChartInstance = new Chart(document.getElementById("callsChart"), {
        type: 'bar', data: { labels: data.labels, datasets: [{ label: 'Calls', data: data.values, backgroundColor: '#a29bfe', borderRadius: 6 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { grid: { color: 'rgba(255,255,255,0.05)' } }, x: { grid: { display: false } } } }
      });
    }

    async function loadTenants() {
      try {
        const res = await fetch("/api/superadmin/tenants", { headers: { Authorization: "Bearer " + token } });
        const r = await res.json(); if (r.success) { allTenants = r.data; renderTenantTable(allTenants); }
      } catch (e) {}
    }

    function renderTenantTable(data) {
      const container = document.getElementById("tenantList");
      if (!data.length) { 
        container.innerHTML = `<tr><td colspan="5" style="text-align:center; padding:5rem; color:var(--text-muted);">No active tenants found.</td></tr>`; 
        return; 
      }
      
      container.innerHTML = data.map((t, index) => {
        const usagePct = Math.min((t.usedMinutes / t.monthlyLimit) * 100, 100);
        const joined = new Date(t.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        const bizId = t.businesses && t.businesses[0] ? t.businesses[0].id : null;
        const planClass = t.plan.toLowerCase().includes('premium') ? 'status-badge-premium' : 'status-badge-standard';
        
        // Progress color based on usage
        let progressColor = 'var(--primary)';
        if (usagePct > 80) progressColor = 'var(--danger)';
        else if (usagePct > 50) progressColor = 'var(--warning)';

        const isDemo = t.isDemoAccount;
        const demoClass = isDemo ? 'status-badge-standard' : 'status-badge-standard hidden';

        const isMaster = t.name === "Nexton Platform Hub";

        return `
          <tr class="tenant-row" style="animation-delay: ${index * 0.05}s; ${isMaster ? 'opacity: 0.8; background: rgba(var(--primary-rgb), 0.02);' : ''}">
            <td style="padding: 1.25rem 1rem;">
              <div style="display:flex; align-items:center; gap:0.75rem;">
                <div style="width: 36px; height: 36px; background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--text-secondary);">
                  <i data-lucide="${isMaster ? 'shield-check' : 'building-2'}" style="width: 18px; color: ${isMaster ? 'var(--primary)' : 'inherit'}"></i>
                </div>
                <div style="display:flex; flex-direction:column;">
                  <div style="display:flex; align-items:center; gap:5px;">
                    <span style="font-weight:700; color:var(--text-primary); font-size:0.9rem;">${t.name}</span>
                    ${isMaster ? '<span style="font-size:0.6rem; background:var(--primary); color:white; padding:1px 6px; border-radius:10px; font-weight:800;">MASTER</span>' : ''}
                    ${isDemo ? '<span style="font-size:0.6rem; background:rgba(255,255,255,0.1); color:white; padding:1px 4px; border-radius:3px;">DEMO</span>' : ''}
                  </div>
                  <span style="font-size:0.65rem; color:var(--text-muted); font-family: 'JetBrains Mono', monospace;">ID: ${t.id.substring(0,8)}</span>
                </div>
              </div>
            </td>
            <td>
              <div style="display:flex; flex-direction:column; gap:4px;">
                <span class="${planClass}">${t.plan.toUpperCase()}</span>
                <span style="font-size:0.7rem; color:var(--text-muted);"><i data-lucide="zap" style="width:10px; vertical-align:middle;"></i> ${t.tokenBalance} Mints</span>
              </div>
            </td>
            <td style="min-width: 200px;">
              <div style="display:flex; flex-direction:column;">
                <div style="display:flex; justify-content:space-between; font-size:0.7rem; font-weight: 600; margin-bottom: 2px;">
                  <span style="color: var(--text-secondary);">${t.usedMinutes} / ${t.monthlyLimit} min</span>
                  <span style="color: ${progressColor};">${usagePct.toFixed(0)}%</span>
                </div>
                <div class="usage-progress-container">
                  <div class="usage-progress-bar" style="width: ${usagePct}%; background: ${progressColor};"></div>
                </div>
              </div>
            </td>
            <td style="color:var(--text-muted); font-size:0.8rem; font-weight: 500;">${joined}</td>
            <td style="text-align:right; padding-right: 1rem;">
              <div style="display: flex; justify-content: flex-end; gap: 0.6rem;">
                ${isMaster ? `
                  <div style="font-size: 0.65rem; color: var(--text-muted); padding: 0.5rem; background: rgba(255,255,255,0.03); border-radius: 0.5rem; border: 1px solid var(--border);">
                    <i data-lucide="lock" style="width: 10px; vertical-align: middle;"></i> PROTECTED

<script>
const token =
  localStorage.getItem("accessToken") ||
  sessionStorage.getItem("accessToken");

if (!token) {
  window.location.href = "/login";
} else {

  try {

    const payload = JSON.parse(atob(token.split(".")[1]));
    const currentTime = Date.now() / 1000;

    // Token expired
    if (payload.exp < currentTime) {

      console.log("Token expired");

      localStorage.removeItem("accessToken");
      sessionStorage.removeItem("accessToken");

      window.location.href = "/login";
    }

    // Role protection
    if (payload.role !== "superadmin") {

      console.log("Access denied");

      window.location.href = "/admin";
    }

  } catch (err) {

    console.log("Invalid token");

    localStorage.removeItem("accessToken");
    sessionStorage.removeItem("accessToken");

    window.location.href = "/login";

  }

}

// =======================
// UI Helpers
// =======================
function showSuccess(msg) {
  const box = document.getElementById("successBox");
  box.innerText = msg;
  box.style.display = "block";
  setTimeout(() => box.style.display = "none", 3000);
}

function showError(msg) {
  const box = document.getElementById("errorBox");
  box.innerText = msg;
  box.style.display = "block";
  setTimeout(() => box.style.display = "none", 3000);
}


// =======================
// Analytics
// =======================
async function loadAnalytics() {

  const res = await fetch("/api/superadmin/analytics", {
    headers: {
      Authorization: "Bearer " + token
    }
  });

  const result = await res.json();

  if (!res.ok) {
    return showError(result.error || "Failed to load analytics");
  }

  const stats = result.data;

  document.getElementById("totalTenants").innerText = stats.tenants;
  document.getElementById("totalUsers").innerText = stats.users;
  document.getElementById("totalOrders").innerText = stats.orders;
  document.getElementById("totalCalls").innerText = stats.calls;
  document.getElementById("callsToday").innerText = stats.callsToday;
document.getElementById("ordersToday").innerText = stats.ordersToday;
document.getElementById("avgDuration").innerText = stats.avgDuration + " sec";
document.getElementById("conversionRate").innerText = stats.conversionRate + "%";
}



// =======================
// loadActivityFeed
// =======================
async function loadActivityFeed() {

// 1️⃣ Get stored token
const token =
localStorage.getItem("accessToken") ||
sessionStorage.getItem("accessToken");

if (!token) {
console.log("No token found");
return;
}

try {

// 2️⃣ Send token to backend
const res = await fetch("/api/superadmin/activity", {
  headers: {
    Authorization: "Bearer " + token
  }
});

const result = await res.json();

if (!result.success) {
  console.log("API error:", result);
  return;
}

const feed = document.getElementById("activityFeed");

// 3️⃣ Render activity cards
feed.innerHTML = result.data.map(a => `
  <div style="
    background:#1e293b;
    padding:12px;
    margin-bottom:10px;
    border-radius:8px;
    color:white;
  ">
    📞 <strong>${a.restaurant}</strong> call ended — ${a.duration}s
    <br>
    🧠 Tokens used: ${a.tokens}
  </div>
`).join("");

} catch (err) {

console.error("Activity Feed Error:", err);

}

}


// =======================
// loadTranscripts
// =======================
async function loadTranscripts() {

  const res = await fetch("/api/superadmin/transcripts", {
    headers: {
      Authorization: "Bearer " + token
    }
  });

  const result = await res.json();

  if (!result.success) return;

  const calls = result.data;

  const box = document.getElementById("transcriptBox");

  box.innerHTML = calls.map(c => `
    <div style="background:#1e293b; padding:15px; margin-bottom:15px; border-radius:8px;">
      <strong>Restaurant:</strong> ${c.business?.name || "Unknown"}<br>
      <strong>Duration:</strong> ${c.duration || 0} sec<br>
      <strong>Transcript:</strong><br>
      <div style="margin-top:10px; font-size:14px; white-space:pre-wrap;">
        ${c.transcript || "No transcript available"}
      </div>
    </div>
  `).join("");
}


/* =========================
   LOAD RECENT CALLS
========================= */

async function loadRecentCalls() {

  const res = await fetch("/api/superadmin/calls", {
    headers: {
      Authorization: "Bearer " + token
    }
  });

  const result = await res.json();

  if (!result.success) return;

  const calls = result.data;

  const table = document.getElementById("callsTable");

  
table.innerHTML = calls.map(c => `
  <tr onclick="openCall('${c.id}')" style="cursor:pointer;">
    <td>${c.business?.name || "Unknown"}</td>
    <td>${c.duration || 0} sec</td>
    <td>${c.tokensUsed || 0}</td>
  </tr>
`).join("");

}

/* =========================
   openCall
========================= */
async function openCall(callId) {

  const res = await fetch("/api/superadmin/call/" + callId, {
    headers: {
      Authorization: "Bearer " + token
    }
  });

  const result = await res.json();

  if (!result.success) return;

  const c = result.data;

  const box = document.getElementById("callInspector");

  box.innerHTML = `
    <h3>${c.business?.name || "Unknown Restaurant"}</h3>

    <p><strong>Duration:</strong> ${c.duration || 0} sec</p>
    <p><strong>Tokens Used:</strong> ${c.tokensUsed || 0}</p>

    <h4>Transcript</h4>
    <div style="white-space:pre-wrap; font-size:14px;">
      ${c.transcript || "No transcript available"}
    </div>
  `;
}


// =======================
// Load Tenants
// =======================
async function loadTenants() {
  const res = await fetch("/api/superadmin/tenants", {
    headers: { Authorization: "Bearer " + token }
  });

  const result = await res.json();

  if (!res.ok) return showError(result.error || "Unauthorized");

  const tenants = result.data;

  document.getElementById("totalTenants").innerText = tenants.length;

  document.getElementById("tenantList").innerHTML =
    tenants.map(t => `
      <div class="tenant-card">
        <h4>${t.name}</h4>
        <p><strong>Plan:</strong> ${t.plan}</p>
        <p><strong>Usage:</strong> ${t.usedMinutes} / ${t.monthlyLimit}</p>
        <p><strong>Tenant ID:</strong> ${t.id}</p>
      </div>
    `).join("");
}

async function createTenant() {
  const tenantName = document.getElementById("tenantName").value.trim();
  const email = document.getElementById("email").value.trim();
  const password = document.getElementById("password").value.trim();

  if (!tenantName || !email || !password)
    return showError("All fields required");

  const res = await fetch("/api/superadmin/create-tenant", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token
    },
    body: JSON.stringify({ tenantName, email, password })
  });

  const result = await res.json();

  if (!res.ok) return showError(result.error || "Creation failed");

  showSuccess("Tenant Created Successfully");
  loadTenants();
}



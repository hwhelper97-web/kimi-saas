            <td style="padding: 1.25rem 1rem;">
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 32px; height: 32px; background: rgba(var(--primary-rgb), 0.1); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: var(--primary);">
                  <i data-lucide="phone"></i>
                </div>
                <span style="font-weight: 800; font-family: 'JetBrains Mono', monospace;">${p.twilioPhoneNumber}</span>
              </div>
            </td>
            <td>
              <div style="display: flex; flex-direction: column;">
                <span style="font-weight: 700; color: white;">${tenantName}</span>
                <span style="font-size: 0.7rem; color: var(--text-muted);">${businessName}</span>
              </div>
            </td>
            <td><span class="${statusClass}">${p.status}</span></td>
            <td>
              <div style="display: flex; gap: 4px;">
                <i data-lucide="mic" style="width: 14px; opacity: ${p.aiEnabled ? 1 : 0.2}; color: var(--primary);"></i>
                <i data-lucide="forward" style="width: 14px; opacity: ${p.forwardingEnabled ? 1 : 0.2}; color: #10b981;"></i>
                <i data-lucide="save" style="width: 14px; opacity: ${p.recordingEnabled ? 1 : 0.2}; color: #a855f7;"></i>
              </div>
            </td>
            <td style="text-align: right;">
              <button class="apex-btn apex-btn-sm apex-btn-outline" onclick="openAssignModal('${p.id}')">
                <i data-lucide="user-plus" style="width: 14px;"></i> ASSIGN
              </button>
            </td>
          </tr>
        `;
      }).join('');
      lucide.createIcons();
    }

    let selectedPhoneId = null;
    function openAssignModal(phoneId) {
      selectedPhoneId = phoneId;
      const phone = currentInventory.find(p => p.id === phoneId);
      document.getElementById("assignPhoneTitle").innerText = `Assign ${phone.twilioPhoneNumber}`;
      
      // Populate tenants dropdown
      const select = document.getElementById("assignTenantSelect");
      if (allTenants.length === 0) {
        loadTenants().then(() => {
          select.innerHTML = `<option value="">-- Select Tenant --</option>` + allTenants.map(t => `<option value="${t.id}">${t.name}</option>`).join('');
        });
      } else {
        select.innerHTML = `<option value="">-- Select Tenant --</option>` + allTenants.map(t => `<option value="${t.id}">${t.name}</option>`).join('');
      }
      
      document.getElementById("assignModal").classList.add("show");
    }

    function closeAssignModal() {
      document.getElementById("assignModal").classList.remove("show");
    }

    async function submitAssignment() {
      const tenantId = document.getElementById("assignTenantSelect").value;
      if (!tenantId) return showError("Please select a tenant.");

      try {
        const res = await fetch("/api/superadmin/inventory/phones/assign", {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
          body: JSON.stringify({ phoneId: selectedPhoneId, tenantId })
        });
        const r = await res.json();
        if (r.success) {
          showSuccess("Phone number reassigned successfully.");
          closeAssignModal();
          loadInventory();
        }
      } catch (e) { showError("Assignment failed."); }
    }

    async function openPurchaseModal() {
      if (confirm("Buy a new system number (+1 888 series)? This will incur a platform charge of $1.15/mo.")) {
        try {
          const res = await fetch("/api/superadmin/inventory/phones/provision", {
            method: "POST",
            headers: { "Content-Type": "application/json", Authorization: "Bearer " + token }
          });
          const r = await res.json();
          if (r.success) {
            showSuccess("System number provisioned and added to inventory.");
            loadInventory();
          }
        } catch (e) { showError("Provisioning failed."); }
      }
    }

    // Load saved theme on boot
    (function initTheme() {
      const savedTheme = localStorage.getItem("apex_theme") || "default";
      document.body.setAttribute("data-theme", savedTheme);
    })();

    // Global Modal Overlay Handler
    document.addEventListener('click', (e) => {
      if (e.target.classList.contains('modal-overlay')) {
        e.target.classList.remove('show');
      }
    });
  </script>
    <!-- Modal: Assign Phone -->
    <div id="assignModal" class="modal-overlay">
      <div class="modal-container" style="max-width: 400px; background: var(--bg-card); border: 1px solid var(--border);">
        <div class="modal-header">
          <h3 id="assignPhoneTitle" style="font-weight: 800;">Assign Phone Number</h3>
          <button class="close-modal" onclick="closeAssignModal()">&times;</button>
        </div>
        <div style="padding: 2rem;">
          <div class="form-group">
            <label>Select Target Tenant</label>
            <select id="assignTenantSelect" class="form-control" style="background: #000;"></select>
          </div>
          <p style="font-size: 0.7rem; color: var(--text-muted); margin-top: 1rem;">
            Assigning this number will immediately move it to the tenant's management portal.
          </p>
          <button class="apex-btn apex-btn-primary" style="width: 100%; margin-top: 1.5rem;" onclick="submitAssignment()">
            CONFIRM ASSIGNMENT
          </button>
        </div>
      </div>
    </div>

    <!-- Modal: Plan Management -->
    <div id="planModal" class="modal-overlay">
      <div class="modal-container" style="max-width: 450px; background: var(--bg-card); border: 1px solid var(--border);">
        <div class="modal-header">
          <h3 style="font-weight: 800;">Plan Management</h3>
          <button class="close-modal" onclick="closePlanModal()">&times;</button>
        </div>
        <div style="padding: 2rem;">
          <h4 id="planTenantName" style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1.5rem; color: var(--primary);"></h4>
          
          <div class="form-group">
            <label>Subscription Package</label>
            <select id="editTenantPlan" class="form-control" style="background: #000;">
              <option value="nexa-core">Nexa Core (300 Mints)</option>
              <option value="nexa-flow">Nexa Flow (1,200 Mints)</option>
              <option value="nexa-prime">Nexa Prime (5,000 Mints)</option>
            </select>
          </div>

          <div class="form-group" style="margin-top: 1.5rem;">
            <label>Extend Trial (Days from today)</label>
            <input id="editTenantTrialDays" type="number" class="form-control" placeholder="e.g. 7" style="background: #000;">
            <p style="font-size: 0.65rem; color: var(--text-muted); margin-top: 0.4rem;">Current trial end: <span id="currentTrialEnd" style="font-weight: 700;"></span></p>
          </div>

          <div class="form-group" style="margin-top: 1.5rem;">
            <label>Subscription Status</label>
            <select id="editTenantStatus" class="form-control" style="background: #000;">
              <option value="ACTIVE">ACTIVE</option>
              <option value="SUSPENDED">SUSPENDED</option>
              <option value="EXPIRED">EXPIRED</option>
            </select>
          </div>

          <button class="apex-btn apex-btn-primary" style="width: 100%; margin-top: 2rem;" onclick="updateTenantPlan()">
            APPLY CHANGES
          </button>
        </div>
      </div>
    </div>

    <!-- Modal: Staff Management -->
    <div id="staffModal" class="modal-overlay">
      <div class="modal-container" style="max-width: 400px; background: var(--bg-card); border: 1px solid var(--border);">
        <div class="modal-header">
          <h3 style="font-weight: 800;">Modify Personnel</h3>
          <button class="close-modal" onclick="closeStaffModal()">&times;</button>
        </div>
        <div style="padding: 2rem;">
          <div style="margin-bottom: 1.5rem;">
            <p style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em; margin-bottom: 0.25rem;">Account Email</p>
            <h4 id="staffEditEmail" style="font-size: 1rem; font-weight: 700; color: white;"></h4>
          </div>
          
          <div class="form-group">
            <label>Privilege Tier (Role)</label>
            <select id="editStaffRole" class="form-control" style="background: #000;">
              <option value="AGENT">Support Agent (Level 1)</option>
              <option value="DEVELOPER">Developer (Technical Engineering)</option>
              <option value="MANAGER">Team Manager (Lead)</option>
              <option value="PRODUCT">Product Manager (Strategic)</option>
              <option value="ADMIN">Platform Admin (Root)</option>
              <option value="SUPERADMIN">SuperAdmin (Master)</option>
            </select>
          </div>

          <p style="font-size: 0.7rem; color: var(--text-muted); margin-top: 1rem; line-height: 1.4;">
            Updating the privilege tier will immediately grant or revoke access to platform command systems.
          </p>

          <button class="apex-btn apex-btn-primary" style="width: 100%; margin-top: 2rem;" onclick="saveStaffChangesSA()">
            SAVE CHANGES
          </button>
        </div>
      </div>
    </div>
  </body>
</html>
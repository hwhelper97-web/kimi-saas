                AUTHORIZE
              </button>
              <button class="action-btn" onclick="updateMintRequestStatus('${r.id}', 'REJECTED')" style="width:36px; height:36px; border-radius:10px; border:1px solid rgba(239, 68, 68, 0.2); color:#ef4444; background:rgba(239, 68, 68, 0.05);">

// =======================
// Settings & Logo
// =======================
async function loadSettings() {
  try {
    const res = await fetch("/api/superadmin/settings", {
      headers: { Authorization: "Bearer " + token }
    });
    const result = await res.json();
    if (result.success && result.data) {
      const { logoUrl, voice, speed, responseDelay, projectName, twilioSid, twilioToken, openaiKey } = result.data;
      
      if (logoUrl) {
        const projectLogo = document.getElementById("projectLogo");
        const logoPreview = document.getElementById("logoPreview");
        projectLogo.src = logoUrl;
        projectLogo.style.display = "inline-block";
        logoPreview.src = logoUrl;
        logoPreview.style.display = "block";
      }

      if (projectName) {
        document.getElementById("projectNameInput").value = projectName;
        document.getElementById("dashboardTitle").innerText = projectName + " Dashboard";
        document.title = projectName + " SuperAdmin";
      }

      if (voice) document.getElementById("voiceSelect").value = voice;
      if (speed) {
        document.getElementById("speedSlider").value = speed;
        document.getElementById("speedVal").innerText = speed;
      }
      if (responseDelay) {
        document.getElementById("delaySlider").value = responseDelay;
        document.getElementById("delayVal").innerText = responseDelay;
      }

      if (twilioSid) document.getElementById("twilioSidInput").value = twilioSid;
      if (twilioToken) document.getElementById("twilioTokenInput").value = twilioToken;
      if (openaiKey) document.getElementById("openaiKeyInput").value = openaiKey;
    }
  } catch (err) {
    console.error("Load settings error:", err);
  }
}

async function saveAISettings() {
  const voice = document.getElementById("voiceSelect").value;
  const speed = document.getElementById("speedSlider").value;
  const responseDelay = document.getElementById("delaySlider").value;
  const projectName = document.getElementById("projectNameInput").value;
  const twilioSid = document.getElementById("twilioSidInput").value;
  const twilioToken = document.getElementById("twilioTokenInput").value;
  const openaiKey = document.getElementById("openaiKeyInput").value;

  try {
    const res = await fetch("/api/superadmin/settings", {
      method: "POST",
      headers: { 
        "Content-Type": "application/json",
        Authorization: "Bearer " + token 
      },
      body: JSON.stringify({ voice, speed, responseDelay, projectName, twilioSid, twilioToken, openaiKey })
    });

    const result = await res.json();

    if (result.success) {
      showSuccess("AI settings saved!");
    } else {
      showError(result.message || "Failed to save settings");
    }
  } catch (err) {
    showError("Network error during save");
  }
}

async function handleLogoUpload(input) {
  if (!input.files || !input.files[0]) return;

  const formData = new FormData();
  formData.append("logo", input.files[0]);

  try {
    const res = await fetch("/api/superadmin/upload-logo", {
      method: "POST",
      headers: { Authorization: "Bearer " + token },
      body: formData
    });

    const result = await res.json();

    if (result.success) {
      showSuccess("Logo updated successfully!");
      loadSettings(); // Refresh logos
    } else {
      showError(result.message || "Upload failed");
    }
  } catch (err) {
    showError("Network error during upload");
  }
}


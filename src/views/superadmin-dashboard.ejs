    async function createTenant() {
      const btn = document.getElementById("provisionBtn");
        const data = {
          name: document.getElementById("tenantName").value,
          ownerEmail: document.getElementById("email").value,
          ownerPassword: document.getElementById("password").value,
          currency: document.getElementById("currency").value,
          type: document.getElementById("businessType").value,
          subType: document.getElementById("businessSubType").value,
          importUrl: document.getElementById("importUrl").value,
          isDemo: document.getElementById("isDemoAccount").checked,
          initialTokens: parseInt(document.getElementById("initialTokens").value)
        };
      if (!data.name || !data.ownerEmail || !data.ownerPassword) return showError("Required fields missing");
      btn.disabled = true; btn.innerHTML = "PROVISIONING...";
      try {
        const res = await fetch("/api/superadmin/tenants", { method: "POST", headers: { "Content-Type": "application/json", "Authorization": "Bearer " + token }, body: JSON.stringify(data) });
        const r = await res.json();
        if (r.success) { showSuccess("Tenant Provisioned!"); loadTenants(); showSection("tenants"); }
        else showError(r.message);
      } catch (e) { showError("Network error"); }
      finally { btn.disabled = false; btn.innerHTML = "LAUNCH CLIENT INSTANCE"; lucide.createIcons(); }
    }


          'nexa-prime': { name: 'Nexa Prime', badge: 'PRIME', class: 'status-badge-premium' }
        };

        const currentPlan = planMapping[t.plan?.toLowerCase()] || { name: t.plan || 'Nexa Core', badge: (t.plan || 'CORE').toUpperCase(), class: 'status-badge-standard' };

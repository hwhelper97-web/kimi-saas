      if (selectedTenantIds.size === 0) return;
      document.getElementById("confirmAdminPassword").value = "";
      document.getElementById("deleteModal").style.display = "flex";
      
      const modalMsg = document.querySelector("#deleteModal p");
      if (modalMsg) {
        modalMsg.innerText = `This action will permanently purge ${selectedTenantIds.size} selected tenants and all their associated businesses, calls, menu items, and orders. This cannot be undone.`;

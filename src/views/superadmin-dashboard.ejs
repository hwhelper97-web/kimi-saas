        document.getElementById("nt_duration").innerText = c.duration + "s";
        document.getElementById("nt_type").innerText = c.callType || "SUPPORT";
        document.getElementById("nt_outcome").innerText = (c.outcome || "RESOLVED").toUpperCase();
        document.getElementById("nt_summary").innerText = c.summary || "No automated summary available for this session.";
        
        const confidence = c.aiConfidence || 0.95;
        document.getElementById("nt_confidence").innerText = (confidence * 100).toFixed(0) + "%";
        document.getElementById("nt_confidence_bar").style.width = (confidence * 100) + "%";

        const score = c.sentimentScore || 0.85;
        document.getElementById("nt_sentiment").innerText = (c.sentiment || "POSITIVE").toUpperCase();
        document.getElementById("nt_sentiment_bar").style.width = (score * 100) + "%";

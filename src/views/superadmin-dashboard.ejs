    async function loadSettingsGroup(group) {
      currentSettingsGroup = group;
      
      // Update Sidebar UI
      document.querySelectorAll('.settings-nav-item').forEach(item => {
        item.classList.remove('active');
        if (item.innerText.toLowerCase().includes(group.toLowerCase().replace('_', ' '))) {
          item.classList.add('active');
        }
      });

      const loading = document.getElementById("settingsLoading");
      const container = document.getElementById("settingsFormContainer");
      
      loading.style.display = 'flex';
      container.style.display = 'none';

      try {
        const res = await fetch(`/api/superadmin/settings/${group}`, {
          headers: { "Authorization": "Bearer " + token }
        });
        const r = await res.json();
        
        if (r.success) {
          renderSettingsForm(group, r.data);
          loading.style.display = 'none';
          container.style.display = 'block';
        } else {
          showError("Failed to fetch settings from node.");
        }
      } catch (e) {
        showError("Infrastructure synchronization failed.");
      }
    }

    function renderSettingsForm(group, data) {
      const meta = SETTINGS_METADATA[group] || { title: group, description: "System module settings.", fields: [] };
      const container = document.getElementById("settingsFormContainer");
      
      let html = `
        <div class="settings-group-header">
          <h2>${meta.title}</h2>
          <p>${meta.description}</p>
        </div>
        <form id="groupSettingsForm" class="settings-form-grid">
      `;

      meta.fields.forEach(f => {
        const raw = data[f.key];
        let value = (raw !== undefined && raw !== null && raw !== "null" && !Number.isNaN(raw)) ? raw : '';
        
        // Handle JSON objects being passed to standard inputs
        if (typeof value === 'object' && value !== null) {
          value = JSON.stringify(value);
        }
        const colClass = f.fullWidth ? 'settings-form-full' : '';
        
        html += `<div class="form-group ${colClass}">
          <label>${f.label}</label>`;

        if (f.type === 'select') {
          html += `<select name="${f.key}" class="form-control">`;
          f.options.forEach(opt => {
            html += `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt}</option>`;
          });
          html += `</select>`;
        } else if (f.type === 'boolean') {
          html += `
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-top: 0.5rem;">
              <input type="checkbox" name="${f.key}" ${value === true ? 'checked' : ''} style="width: 18px; height: 18px; cursor: pointer;">
              <span style="font-size: 0.85rem; color: var(--text-secondary);">${f.description || 'Enable this feature'}</span>
            </div>
          `;
        } else if (f.type === 'image') {
          html += `
            <div style="display: flex; align-items: center; gap: 1rem; margin-top: 0.5rem;">
              <div id="preview_${f.key}" style="width: 40px; height: 40px; border-radius: 8px; background: rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: center; overflow: hidden; border: 1px solid var(--border);">
                ${value ? `<img src="${value}" style="width: 100%; height: 100%; object-fit: contain;">` : '<i data-lucide="image" style="width: 16px; opacity: 0.3;"></i>'}
              </div>
              <input type="text" id="input_${f.key}" name="${f.key}" value="${value}" class="form-control" style="flex: 1;" placeholder="URL or path...">
              <input type="file" id="file_${f.key}" style="display: none;" accept="image/*" onchange="handlePlatformLogoUpload(this, '${f.key}')">
              <button type="button" class="action-btn" style="width: auto; padding: 0 1rem; font-size: 0.75rem;" onclick="document.getElementById('file_${f.key}').click()">
                <i data-lucide="upload" style="width: 14px; margin-right: 6px;"></i> UPLOAD
              </button>
            </div>
          `;
        } else {
          html += `<input type="${f.type}" name="${f.key}" value="${value}" class="form-control" placeholder="${f.placeholder || ''}">`;
        }
        
        html += `</div>`;
      });

      html += `
        </form>
        <div class="settings-save-bar">
          <button class="apex-btn apex-btn-primary" onclick="saveSettingsGroup('${group}')">
            <i data-lucide="save"></i>
            <span>Apply Changes</span>
          </button>
        </div>
      `;

      container.innerHTML = html;
      lucide.createIcons();
    }

    async function saveSettingsGroup(group) {
      const form = document.getElementById("groupSettingsForm");
      const formData = new FormData(form);
      const settings = {};
      
      // Get metadata to handle checkboxes/numbers
      const meta = SETTINGS_METADATA[group];
      meta.fields.forEach(f => {
        if (f.type === 'boolean') {
          settings[f.key] = form.elements[f.key].checked;
        } else if (f.type === 'number') {
          settings[f.key] = parseFloat(form.elements[f.key].value);
        } else {
          settings[f.key] = form.elements[f.key].value;
        }
      });

      try {
        const res = await fetch("/api/superadmin/settings", {
          method: "POST",
          headers: { 
            "Content-Type": "application/json",
            "Authorization": "Bearer " + token 
          },
          body: JSON.stringify({ group, settings })
        });
        
        const r = await res.json();
        if (r.success) {
          showSuccess(`${meta.title} updated successfully.`);
          
          // If it's GENERAL, refresh project name/logo if they changed
          if (group === 'GENERAL') {
            if (settings.platformName) {
              document.querySelectorAll('.logo-text h2').forEach(el => el.innerText = settings.platformName);
            }
          }
        } else {
          showError(r.message || "Save operation failed.");
        }
      } catch (e) {
        showError("Network connectivity error during sync.");
      }
    }

    async function handlePlatformLogoUpload(input, key) {
      if (!input.files || !input.files[0]) return;
      
      const formData = new FormData();
      formData.append("logo", input.files[0]);
      
      try {
        const res = await fetch("/api/superadmin/upload-logo", {
          method: "POST",
          headers: { Authorization: "Bearer " + token },
          body: formData
        });
        const r = await res.json();
        
        if (r.success) {
          // Update the hidden input that saveSettingsGroup uses
          const textInput = document.getElementById(`input_${key}`);
          if (textInput) {
            textInput.value = r.logoUrl;
            // Also update the hidden name attribute if it exists in the form
            const formInput = document.querySelector(`form#groupSettingsForm input[name="${key}"]`);
            if (formInput) formInput.value = r.logoUrl;
          }
          
          // Update Preview
          const preview = document.getElementById(`preview_${key}`);
          if (preview) {
            preview.innerHTML = `<img src="${r.logoUrl}" style="width: 100%; height: 100%; object-fit: contain;">`;
          }
          
          showSuccess("Platform logo uploaded. Click Apply Changes to save permanently.");
        } else {
          showError(r.message || "Upload failed");
        }
      } catch (e) {
        showError("Network error during logo upload");
      }
    }


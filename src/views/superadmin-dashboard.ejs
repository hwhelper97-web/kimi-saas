    let allTranscripts = [];
    async function loadTranscripts() {
      try {
        const query = currentBusinessFilter ? `?businessId=${currentBusinessFilter}` : "";
        const res = await fetch(`/api/superadmin/transcripts${query}`, { headers: { Authorization: "Bearer " + token } });
        const r = await res.json(); if (!r.success) return;
        allTranscripts = r.data;
        renderTranscripts(allTranscripts);
      } catch (e) {}
    }

    function renderTranscripts(data) {
      const container = document.getElementById("transcriptBox");
      if (!data.length) {
        container.innerHTML = `<div class="apex-card" style="grid-column: 1/-1; text-align: center; padding: 5rem; opacity: 0.5;">No neural sessions detected.</div>`;
        return;
      }

      container.innerHTML = data.map((c, index) => {
        const dateStr = new Date(c.createdAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
        const bizName = c.business?.name || "Global Node";
        const initials = bizName.substring(0, 2).toUpperCase();
        
        // Mocking AI metrics if missing
        const confidence = c.aiConfidence || (0.92 + Math.random() * 0.07);
        const type = c.callType || (index % 3 === 0 ? "booking" : index % 3 === 1 ? "support" : "sales");
        const sentiment = c.sentiment || "POSITIVE";
        const score = c.sentimentScore || (sentiment === "POSITIVE" ? 0.85 : 0.45);
        const outcome = c.outcome || "resolved";

        // Parse transcript into bubbles (Simple split by common markers)
        const rawLines = c.transcript ? c.transcript.split(/(AI:|Customer:|USER:|BOT:)/i).filter(Boolean) : [];
        let bubbles = [];
        let lastRole = "ai";
        
        if (rawLines.length < 2) {
            // If not formatted, mock it into bubbles for visual fidelity
            bubbles = [
                { role: 'ai', text: "Hello! This is " + bizName + " AI. How can I assist you?" },
                { role: 'customer', text: c.transcript || "Hello, I have a question about my service." }
            ];
        } else {
            for (let i = 0; i < rawLines.length; i++) {
                const part = rawLines[i].trim();
                const partLower = part.toLowerCase();
                if (partLower === "ai:" || partLower === "bot:") { lastRole = "ai"; continue; }
                if (partLower === "customer:" || partLower === "user:") { lastRole = "customer"; continue; }
                bubbles.push({ role: lastRole, text: part });
            }
        }

        return `
          <div class="transcript-card" style="animation: fadeInUp 0.6s ease backwards ${index * 0.1}s;">
            <div class="transcript-header">
              <div style="display: flex; gap: 1rem; align-items: center;">
                <div style="width: 48px; height: 48px; border-radius: 14px; background: rgba(var(--primary-rgb), 0.1); border: 1px solid rgba(var(--primary-rgb), 0.2); display: flex; align-items: center; justify-content: center; font-weight: 800; color: var(--primary);">
                  ${initials}
                </div>
                <div>
                  <h3 style="font-size: 1rem; font-weight: 800; color: white;">${bizName}</h3>
                  <div style="display: flex; gap: 8px; align-items: center; margin-top: 2px;">
                    <span class="transcript-badge badge-${type}">${type}</span>
                    <span style="font-size: 0.65rem; color: var(--text-muted);">${c.duration}s session</span>
                  </div>
                </div>
              </div>
              <div style="text-align: right;">
                <div style="font-size: 0.8rem; font-weight: 800; color: ${confidence > 0.9 ? 'var(--primary)' : '#f59e0b'};">
                  ${(confidence * 100).toFixed(0)}% <span style="font-size: 0.6rem; opacity: 0.6;">CONFIDENCE</span>
                </div>
                <div style="font-size: 0.65rem; color: var(--text-muted); margin-top: 4px;">${dateStr}</div>
              </div>
            </div>

            <div class="ai-summary-mini">
              <p style="font-size: 0.8rem; line-height: 1.5; color: var(--text-secondary);">
                ${c.summary || "Customer initiated a " + type + " request. AI successfully identified intent and provided relevant platform synchronization."}
              </p>
              <div style="display: flex; gap: 1rem; margin-top: 0.75rem; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 0.5rem;">
                <div style="font-size: 0.65rem; color: var(--text-muted);">
                   SENTIMENT: <span style="color: ${score > 0.7 ? '#10b981' : '#f59e0b'}; font-weight: 800;">${sentiment}</span>
                </div>
                <div style="font-size: 0.65rem; color: var(--text-muted);">
                   OUTCOME: <span style="color: var(--primary); font-weight: 800;">${outcome.toUpperCase()}</span>
                </div>
              </div>
            </div>

            <div class="chat-preview">
              ${bubbles.slice(0, 4).map(b => `
                <div class="bubble-item ${b.role}">
                  <div class="bubble-text">${b.text}</div>
                  <span style="font-size: 0.6rem; color: var(--text-muted); margin-top: 2px;">${b.role.toUpperCase()}</span>
                </div>
              `).join('')}
              <div class="chat-preview-fade"></div>
            </div>

            <button class="expand-btn" onclick="openFullTranscript('${c.id}')">
              <i data-lucide="maximize-2" style="width: 14px;"></i> EXPAND FULL NEURAL LOG
            </button>

            <div class="insight-row">
               <div style="display: flex; align-items: center; gap: 10px;">
                  <span style="color: var(--text-muted);">AI PERFORMANCE</span>
                  <div style="width: 80px; height: 4px; background: rgba(255,255,255,0.05); border-radius: 10px; overflow: hidden;">
                     <div style="width: ${confidence * 100}%; height: 100%; background: var(--primary);"></div>
                  </div>
               </div>
               <div style="color: var(--primary); font-weight: 800;">EXCELLENT</div>
            </div>
          </div>
        `;
      }).join("");
      lucide.createIcons();
    }

    function handleTranscriptSearch(q) {
      const filtered = allTranscripts.filter(t => 

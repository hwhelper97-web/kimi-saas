        // Progress color based on usage
        let progressColor = 'var(--primary)';
        if (usagePct > 80) progressColor = 'var(--danger)';
        else if (usagePct > 50) progressColor = 'var(--warning)';

        const isDemo = t.isDemoAccount;
        const isMaster = t.name === "Naxton Platform Hub";
        const isChecked = selectedTenantIds.has(t.id);

        return `
          <tr class="tenant-row" style="animation-delay: ${index * 0.05}s; ${isMaster ? 'opacity: 0.8; background: rgba(var(--primary-rgb), 0.02);' : ''}">
            <td style="padding: 1.25rem 0.5rem 1.25rem 1rem; text-align: center; width: 40px;">
              <input type="checkbox" class="tenant-checkbox" value="${t.id}" data-name="${t.name}" onchange="updateBulkTenantSelection()" style="accent-color: var(--primary); cursor: pointer; width: 16px; height: 16px; border-radius: 4px;" ${isMaster ? 'disabled title="Master tenant cannot be deleted"' : ''} ${isChecked ? 'checked' : ''} />
            </td>
            <td style="padding: 1.25rem 1rem;">
              <div style="display:flex; align-items:center; gap:0.75rem;">
                <div style="width: 36px; height: 36px; background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--text-secondary);">
                  <i data-lucide="${isMaster ? 'shield-check' : 'building-2'}" style="width: 18px; color: ${isMaster ? 'var(--primary)' : 'inherit'}"></i>
                </div>
                <div style="display:flex; flex-direction:column;">
                  <div style="display:flex; align-items:center; gap:5px;">
                    <span style="font-weight:700; color:var(--text-primary); font-size:0.9rem;">${t.name}</span>
                    ${isMaster ? '<span style="font-size:0.6rem; background:var(--primary); color:white; padding:1px 6px; border-radius:10px; font-weight:800;">MASTER</span>' : ''}
                    ${isDemo ? '<span style="font-size:0.6rem; background:rgba(255,255,255,0.1); color:white; padding:1px 4px; border-radius:3px;">DEMO</span>' : ''}
                  </div>
                  <span style="font-size:0.65rem; color:var(--text-muted); font-family: 'JetBrains Mono', monospace;">ID: ${t.id.substring(0,8)}</span>
                </div>
              </div>
            </td>
            <td>
              <div style="display:flex; flex-direction:column; gap:6px;">
                <div style="display:flex; align-items:center; gap:6px;">
                  <span class="${currentPlan.class}">${currentPlan.badge}</span>
                  <span class="${statusBadgeClass}">${status.toUpperCase()}</span>
                </div>
                <div style="display:flex; align-items:center; gap:4px; font-size:0.7rem; color:var(--text-muted);">
                  <i data-lucide="zap" style="width:10px;"></i>
                  <span>${t.tokenBalance} Mints</span>
                </div>
              </div>
            </td>
            <td style="min-width: 200px;">
              <div style="display:flex; flex-direction:column;">
                <div style="display:flex; justify-content:space-between; font-size:0.7rem; font-weight: 600; margin-bottom: 2px;">
                  <span style="color: var(--text-secondary);">${t.usedMinutes} / ${t.monthlyLimit} min</span>
                  <span style="color: ${progressColor};">${usagePct.toFixed(0)}%</span>
                </div>
                <div class="usage-progress-container">
                  <div class="usage-progress-bar" style="width: ${usagePct}%; background: ${progressColor};"></div>
                </div>
              </div>
            </td>
            <td style="color:var(--text-muted); font-size:0.8rem; font-weight: 500;">${joined}</td>
            <td style="text-align:right; padding-right: 1rem;">
              <div style="display: flex; justify-content: flex-end; gap: 0.6rem;">
                ${isMaster ? `
                  <div style="font-size: 0.65rem; color: var(--text-muted); padding: 0.5rem; background: rgba(255,255,255,0.03); border-radius: 0.5rem; border: 1px solid var(--border);">
                    <i data-lucide="lock" style="width: 10px; vertical-align: middle;"></i> PROTECTED
                  </div>
                ` : `
                  <button class="apex-btn apex-btn-sm apex-btn-outline" onclick="openTokenModal('${t.id}', '${t.name}')" title="Add Mints" style="border-color: rgba(var(--primary-rgb), 0.2);"><i data-lucide="zap" style="width:14px; color: var(--primary);"></i></button>
                  <button class="apex-btn apex-btn-sm apex-btn-outline" onclick="openPlanModal('${t.id}', '${t.name}', '${t.plan}', ${t.trialEndDate ? "'" + t.trialEndDate + "'" : 'null'}, '${t.subscriptionStatus}')" title="Change Package" style="border-color: rgba(var(--primary-rgb), 0.2);"><i data-lucide="settings-2" style="width:14px; color: var(--primary);"></i></button>
                  <button class="apex-btn apex-btn-sm ${isDemo ? 'apex-btn-primary' : 'apex-btn-outline'}" onclick="toggleDemo('${t.id}')" title="Toggle Demo Mode" style="${!isDemo ? 'border-color: var(--primary); color: var(--primary);' : ''}"><i data-lucide="play-circle" style="width:14px;"></i></button>
                  ${bizId ? `<button class="apex-btn apex-btn-sm apex-btn-outline" onclick="goToBusiness('${bizId}')" title="Direct Access" style="border-color: rgba(var(--primary-rgb), 0.2);"><i data-lucide="external-link" style="width:14px; color: var(--primary);"></i></button>` : `<span style="color:var(--text-muted);font-size:0.7rem;">Orphan</span>`}
                  <button class="apex-btn apex-btn-sm apex-btn-danger" onclick="openDeleteModal('${t.id}')" title="Terminate Instance"><i data-lucide="trash-2" style="width:14px;"></i></button>
                `}
              </div>
            </td>
          </tr>`;
      }).join("");
      lucide.createIcons();
    }

    function filterTenants(q) { const f = allTenants.filter(t => t.name.toLowerCase().includes(q.toLowerCase())); renderTenantTable(f); }


          <td style="padding: 1rem;">
            <div style="font-weight: 700; color: white;">${t.title}</div>
            <div style="font-size: 0.7rem; color: var(--text-muted);">${t.id.substring(0,8)}</div>
          </td>
          <td style="padding: 1rem; font-size: 0.85rem;">${t.tenant?.name || 'Platform'}</td>
          <td class="status-cell" style="padding: 1rem;">
            <span class="status-badge-${t.status.toLowerCase() === 'open' ? 'danger' : 'success'}" style="font-size: 0.65rem;">${t.status.toUpperCase()}</span>
          </td>
          <td style="padding: 1rem;">
            <div style="display: flex; align-items: center; gap: 4px; color: ${t.priority === 'high' ? '#ef4444' : '#f59e0b'}; font-size: 0.8rem; font-weight: 600;">
              <i data-lucide="alert-circle" style="width: 12px;"></i> ${t.priority.toUpperCase()}
            </div>
          </td>

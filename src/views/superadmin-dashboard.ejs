<!DOCTYPE html>
<html>
<head>
  <title>SuperAdmin Panel</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto;
      background: #0f172a;
      color: white;
    }

    .layout {
      padding: 40px;
      max-width: 1200px;
      margin: auto;
    }

    h1 {
      margin-bottom: 10px;
      font-weight: 600;
    }

    .badge {
      background: #22c55e;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: bold;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin: 30px 0;
    }

    .card {
      background: #1e293b;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }

    .card h3 {
      margin: 0 0 10px;
      font-size: 14px;
      color: #94a3b8;
    }

    .card p {
      font-size: 22px;
      font-weight: bold;
      margin: 0;
    }

    .form-box {
      background: #1e293b;
      padding: 25px;
      border-radius: 12px;
      margin-bottom: 40px;
    }

    .form-box input {
      padding: 10px;
      border-radius: 6px;
      border: none;
      margin-right: 10px;
      margin-bottom: 10px;
      width: 200px;
    }

    .form-box button {
      padding: 10px 18px;
      border-radius: 6px;
      border: none;
      background: #3b82f6;
      color: white;
      cursor: pointer;
      font-weight: 600;
      transition: 0.2s;
    }

    .form-box button:hover {
      background: #2563eb;
    }

    .tenants-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 20px;
    }

    .tenant-card {
      background: #1e293b;
      padding: 20px;
      border-radius: 12px;
      transition: 0.3s;
      border: 1px solid transparent;
    }

    .tenant-card:hover {
      border: 1px solid #3b82f6;
      transform: translateY(-4px);
    }

    .tenant-card h4 {
      margin: 0 0 10px;
    }

    .tenant-card p {
      margin: 4px 0;
      font-size: 13px;
      color: #cbd5e1;
    }

    .success {
      background: #16a34a;
      padding: 10px;
      border-radius: 6px;
      margin-bottom: 20px;
      display: none;
    }

    .error {
      background: #dc2626;
      padding: 10px;
      border-radius: 6px;
      margin-bottom: 20px;
      display: none;
    }
    /* NEW SECTION STYLE */

    .section{
    margin-top:50px;
    padding-top:20px;
    border-top:1px solid rgba(255,255,255,0.05);
    }

    .section h2{
    margin-bottom:20px;
    font-weight:600;
    color:white;
    }
  </style>
</head>
<body>

<div class="layout">

  <h1>
    <img id="projectLogo" src="<%= platformLogo || '' %>" alt="Logo" style="height: 40px; vertical-align: middle; margin-right: 15px; <%= platformLogo ? '' : 'display: none;' %>">
    <span id="dashboardTitle"><%= projectName || 'SuperAdmin' %> Dashboard</span> <span class="badge">SUPERADMIN</span>
  </h1>

  <div id="successBox" class="success"></div>
  <div id="errorBox" class="error"></div>

  <!-- PLATFORM SETTINGS -->
  <section class="section">
    <h2>Platform Settings</h2>
    
    <div class="form-box">
      <h3>General Configuration</h3>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <div>
          <label style="display: block; margin-bottom: 8px; color: #94a3b8; font-size: 14px;">Project Name</label>
          <input type="text" id="projectNameInput" placeholder="Enter Project Name" style="width: 100%; padding: 10px; border-radius: 6px; background: #0f172a; color: white; border: 1px solid #334155;">
        </div>
        <div>
          <h3>Project Logo</h3>
          <div style="display: flex; align-items: center; gap: 20px;">
            <img id="logoPreview" src="" alt="Logo Preview" style="max-height: 50px; border-radius: 8px; background: #0f172a; padding: 5px; display: none;">
            <div>
              <input type="file" id="logoInput" accept="image/*" style="display: none;" onchange="handleLogoUpload(this)">
              <button onclick="document.getElementById('logoInput').click()">Upload New Logo</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="form-box" style="margin-top: 20px;">
      <h3>AI Voice Settings</h3>
      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
        <div>
          <label style="display: block; margin-bottom: 8px; color: #94a3b8; font-size: 14px;">Select AI Voice</label>
          <select id="voiceSelect" style="width: 100%; padding: 10px; border-radius: 6px; background: #0f172a; color: white; border: 1px solid #334155;">
            <option value="alloy">Alloy (Neutral)</option>
            <option value="echo">Echo (Mature)</option>
            <option value="fable">Fable (British)</option>
            <option value="onyx">Onyx (Deep)</option>
            <option value="nova" selected>Nova (Energetic)</option>
            <option value="shimmer">Shimmer (Soft)</option>
          </select>
        </div>
        <div>
          <label style="display: block; margin-bottom: 8px; color: #94a3b8; font-size: 14px;">Speaking Speed: <span id="speedVal">1.0</span>x</label>
          <input type="range" id="speedSlider" min="0.5" max="2.0" step="0.1" value="1.0" style="width: 100%;" oninput="document.getElementById('speedVal').innerText = this.value">
        </div>
        <div>
          <label style="display: block; margin-bottom: 8px; color: #94a3b8; font-size: 14px;">Listening Timeout (Delay): <span id="delayVal">0.8</span>s</label>
          <input type="range" id="delaySlider" min="0.5" max="3.0" step="0.1" value="0.8" style="width: 100%;" oninput="document.getElementById('delayVal').innerText = this.value">
        </div>
      </div>
    </div>

    <div class="form-box" style="margin-top: 20px;">
      <h3>Infrastructure Settings (API Keys)</h3>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 15px;">
        <div>
          <label style="display: block; margin-bottom: 8px; color: #94a3b8; font-size: 14px;">OpenAI API Key</label>
          <input type="password" id="openaiKeyInput" placeholder="sk-..." style="width: 100%; padding: 10px; border-radius: 6px; background: #0f172a; color: white; border: 1px solid #334155;">
        </div>
        <div>
          <label style="display: block; margin-bottom: 8px; color: #94a3b8; font-size: 14px;">Twilio Account SID</label>
          <input type="text" id="twilioSidInput" placeholder="AC..." style="width: 100%; padding: 10px; border-radius: 6px; background: #0f172a; color: white; border: 1px solid #334155;">
        </div>
      </div>
      <div style="margin-bottom: 15px;">
        <label style="display: block; margin-bottom: 8px; color: #94a3b8; font-size: 14px;">Twilio Auth Token</label>
        <input type="password" id="twilioTokenInput" placeholder="Token" style="width: 100%; padding: 10px; border-radius: 6px; background: #0f172a; color: white; border: 1px solid #334155;">
      </div>
      
      <button onclick="saveAISettings()" style="margin-top: 10px; background: #16a34a; width: 100%; font-size: 16px;">Save All Necessary Settings</button>
    </div>
  </section>

  <div class="stats">

  <div class="card">
    <h3>Total Tenants</h3>
    <p id="totalTenants">0</p>
  </div>

  <div class="card">
    <h3>Total Users</h3>
    <p id="totalUsers">0</p>
  </div>

  <div class="card">
    <h3>Total Orders</h3>
    <p id="totalOrders">0</p>
  </div>

  <div class="card">
    <h3>Total Calls</h3>
    <p id="totalCalls">0</p>
  </div>

  <div class="card">
    <h3>Calls Today</h3>
    <p id="callsToday">0</p>
  </div>

  <div class="card">
    <h3>Orders Today</h3>
    <p id="ordersToday">0</p>
  </div>

  <div class="card">
    <h3>Avg Call Duration</h3>
    <p id="avgDuration">0 sec</p>
  </div>

  <div class="card">
    <h3>Conversion Rate</h3>
    <p id="conversionRate">0%</p>
  </div>

</div>


<section class="section">

<h2>Platform Analytics</h2>

<div class="charts-grid">

  <div class="chart-card">

    let allConvosSA = [];
    let activeConvoSA = null;
    let currentFilterSA = 'all';

    async function loadConversationsSA() {
      const list = document.getElementById("convoListSA");
      if (!list) return;
      
      try {
        const res = await fetch("/api/support/conversations", { headers: { Authorization: "Bearer " + token } });
        const r = await res.json();
        if (r.success) {
          allConvosSA = r.data;
          updateConvoCountsSA();
          filterConvosSA(currentFilterSA);
        }
      } catch (e) { console.error(e); }
    }

    function updateConvoCountsSA() {
      const total = allConvosSA.length;
      const unread = allConvosSA.filter(c => c.messages && c.messages[0] && !c.messages[0].isRead && c.messages[0].senderType === 'CUSTOMER').length;
      const mentions = allConvosSA.filter(c => c.status === 'escalated').length;

      const badge = document.getElementById("convoBadgeSA");
      if (badge) badge.innerText = total;
      
      const cAll = document.getElementById("countAllSA");
      const cUnread = document.getElementById("countUnreadSA");
      const cMentions = document.getElementById("countMentionsSA");
      
      if (cAll) cAll.innerText = total;
      if (cUnread) cUnread.innerText = unread;
      if (cMentions) cMentions.innerText = mentions;
    }

    function filterConvosSA(type) {
      currentFilterSA = type;
      
      // Update UI active state
      const btns = document.querySelectorAll("#convoFilterSA .convo-filter");
      btns.forEach(b => {
        const isMatch = b.getAttribute('onclick').includes(`'${type}'`);
        b.classList.toggle('active', isMatch);
      });

      let filtered = allConvosSA;
      if (type === 'unread') {
        filtered = allConvosSA.filter(c => c.messages && c.messages[0] && !c.messages[0].isRead && c.messages[0].senderType === 'CUSTOMER');
      } else if (type === 'mentions') {
        filtered = allConvosSA.filter(c => c.status === 'escalated');
      }

      renderConvosSA(filtered);
    }

    function searchConvosSA(query) {
      const q = query.toLowerCase().trim();
      if (!q) {
        filterConvosSA(currentFilterSA);
        return;
      }

      const filtered = allConvosSA.filter(c => {
        const name = (c.customer?.name || "").toLowerCase();
        const email = (c.customer?.email || "").toLowerCase();
        const biz = (c.business?.name || "").toLowerCase();
        const msg = (c.messages && c.messages[0] ? c.messages[0].body : "").toLowerCase();
        return name.includes(q) || email.includes(q) || biz.includes(q) || msg.includes(q);
      });

      renderConvosSA(filtered);
    }

    function renderConvosSA(convos) {
      console.log("[Support] Rendering convos:", convos.length);
      const list = document.getElementById("convoListSA");
      if (!list) return;
      
      if (convos.length === 0) {
        list.innerHTML = '<p style="text-align: center; padding: 2rem; opacity: 0.5;">No sessions found.</p>';
        return;
      }

      list.innerHTML = convos.map(c => {
        const date = c.lastMessageAt ? new Date(c.lastMessageAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : 'Just now';
        const name = c.customer?.name || c.customer?.email || 'Anonymous Tenant';
        const initials = name.substring(0, 2).toUpperCase();
        
        // Status logic
        let statusClass = 'status-online';
        if (c.status === 'escalated') statusClass = 'status-escalated';
        else if (c.aiHandled === false) statusClass = 'status-waiting';

        return `
          <div class="convo-item-sa ${activeConvoSA === c.id ? 'active' : ''}" onclick="selectConvoSA('${c.id}', '${name}')">
            <div class="item-avatar" style="width: 44px; height: 44px; border-radius: 12px; background: rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: center; font-weight: 700; position: relative; flex-shrink: 0;">
              ${initials}
              <div class="status-badge-mini ${statusClass}" style="position: absolute; bottom: -2px; right: -2px; width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--bg-card);"></div>
            </div>
            <div style="flex: 1; min-width: 0;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                <h5 style="font-size: 0.85rem; font-weight: 700; color: white;">${name} <span style="font-size: 0.65rem; color: var(--primary); font-weight: 400; margin-left: 4px;">[${c.tenant?.name || 'Platform'}]</span></h5>
                <span style="font-size: 0.65rem; color: var(--text-muted);">${date}</span>
              </div>
              <p style="font-size: 0.75rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                ${c.messages && c.messages[0] ? c.messages[0].body : 'Starting secure session...'}
              </p>
            </div>
          </div>
        `;
      }).join('');
    }

    async function selectConvoSA(id, name) {
      // Show areas
      document.getElementById("activeChatHeaderSA").style.visibility = "visible";
      document.getElementById("chatActionsSA").style.display = "flex";
      document.getElementById("chatInputAreaSA").style.display = "block";
      
      activeConvoSA = id; // Set active convo
      socket.emit("join-conversation", { conversationId: id });
      
      // Update basic name immediately
      document.getElementById("activeChatNameSA").innerText = name;

      const headAvatar = document.getElementById("activeChatAvatarSA");
      const headLogo = document.getElementById("activeChatLogoSA");
      const ctxAvatar = document.getElementById("tenantContextAvatar");
      const ctxLogo = document.getElementById("tenantContextLogo");

      // Load context data from cache or fresh fetch
      const convo = allConvosSA.find(c => c.id === id);
      if (convo) {
        updateAIToggleUI(convo.aiHandled);
        
        // Identity & Logos
        const tenantName = convo.tenant?.name || "Platform";
        const customerName = convo.customer?.name || convo.customer?.email || "Anonymous";
        
        document.getElementById("activeChatNameSA").innerText = `${customerName} @ ${tenantName}`;
        document.getElementById("activeChatStatusSA").innerHTML = '<div style="display: flex; align-items: center; gap: 6px;"><div class="pulse-online" style="width: 8px; height: 8px; background: #10b981; border-radius: 50%;"></div> Status: Online</div>';

        if (convo.business?.logoUrl) {
           headLogo.src = convo.business.logoUrl;
           headLogo.style.display = 'block'; headAvatar.style.display = 'none';
           ctxLogo.src = convo.business.logoUrl;
           ctxLogo.style.display = 'block'; ctxAvatar.style.display = 'none';
        } else {
           headLogo.style.display = 'none'; headAvatar.style.display = 'block';
           headAvatar.innerText = customerName.substring(0, 2).toUpperCase();
           ctxLogo.style.display = 'none'; ctxAvatar.style.display = 'block';
           ctxAvatar.innerText = customerName.substring(0, 2).toUpperCase();
        }

        // Contact Info
        document.getElementById("tenantContextName").innerText = customerName;
        const email = convo.customer?.email || convo.tenant?.email || "No email";
        const phone = convo.customer?.phone || convo.business?.phoneNumber || "No phone";
        document.getElementById("tenantContextEmail").innerText = email;
        document.getElementById("tenantContextPhone").innerText = phone;
        document.getElementById("tenantEmailBtn").href = `mailto:${email}`;
        document.getElementById("tenantPhoneBtn").href = `tel:${phone}`;
        document.getElementById("tenantContextPlan").innerText = (convo.tenant?.plan || "Standard").toUpperCase();
      }

      // Load messages
      try {
        const res = await fetch(`/api/support/conversations/${id}/messages`, { headers: { Authorization: "Bearer " + token } });
        const r = await res.json();
        if (r.success) {
          const msgList = document.getElementById("chatMessagesSA");
          msgList.innerHTML = r.data.reverse().map(m => {
            const isTenant = m.senderType === 'CUSTOMER';
            return `
              <div class="msg-sa-wrap ${isTenant ? 'tenant' : 'admin'}">
                ${isTenant ? `<span style="font-size: 0.6rem; color: var(--primary); margin-bottom: 2px; font-weight: 700; opacity: 0.7;">TENANT</span>` : ''}
                <div class="msg-sa-bubble">${m.body}</div>
                <span style="font-size: 0.65rem; color: var(--text-muted); margin-top: 0.2rem; align-self: ${isTenant ? 'flex-start' : 'flex-end'};">
                  ${new Date(m.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
                </span>
              </div>
            `;
          }).join('');
          msgList.scrollTop = msgList.scrollHeight;
        }
      } catch (e) { console.error("Error loading messages:", e); }
    }

    function handleSAReply(e) { if (e.key === 'Enter') sendSAReply(); }

    async function sendSAReply() {
      const input = document.getElementById("replyInputSA");
      const content = input.value.trim();
      if (!content || !activeConvoSA) return;

      input.value = "";
      try {
        const res = await fetch(`/api/support/conversations/${activeConvoSA}/messages`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
          body: JSON.stringify({ body: content, senderType: "AGENT" })
        });
        const r = await res.json();
        if (r.success) {
          const msgList = document.getElementById("chatMessagesSA");
          msgList.innerHTML += `
            <div class="msg-sa-wrap admin">
              <div class="msg-sa-bubble">${content}</div>
              <span style="font-size: 0.65rem; color: var(--text-muted); margin-top: 0.2rem; align-self: flex-end;">Just now</span>
            </div>
          `;
          msgList.scrollTop = msgList.scrollHeight;
        }
      } catch (e) { showError("Failed to send message"); }
    }

    async function toggleAISupportSA() {
      if (!activeConvoSA) return;
      try {
        const res = await fetch(`/api/support/conversations/${activeConvoSA}/toggle-ai`, {
          method: "POST",
          headers: { Authorization: "Bearer " + token }
        });
        const r = await res.json();
        if (r.success) {
          updateAIToggleUI(r.aiHandled);
          showSuccess(`AI Mode: ${r.aiHandled ? 'ACTIVE' : 'PAUSED'}`);
        }
      } catch (e) { showError("Failed to toggle AI"); }
    }

    function updateAIToggleUI(isActive) {
      const btn = document.getElementById("aiToggleBtnSA");
      const text = document.getElementById("aiStatusTextSA");
      if (isActive) {
        btn.style.background = "rgba(59, 130, 246, 0.1)";
        btn.style.color = "var(--primary)";
        btn.style.borderColor = "rgba(59, 130, 246, 0.3)";
        text.innerText = "AI ASSISTING";
      } else {
        btn.style.background = "rgba(239, 68, 68, 0.1)";
        btn.style.color = "var(--danger)";
        btn.style.borderColor = "rgba(239, 68, 68, 0.3)";
        text.innerText = "MANUAL MODE";
      }
    }

    async function resolveTicketSA() {
      if (!activeConvoSA) return;
      if (!confirm("Are you sure you want to mark this conversation as resolved?")) return;
      
      try {
        const res = await fetch(`/api/support/conversations/${activeConvoSA}/resolve`, {
          method: "POST",
          headers: { Authorization: "Bearer " + token }
        });
        const r = await res.json();
        if (r.success) {
          showSuccess("Conversation resolved and archived.");
          activeConvoSA = null;
          document.getElementById("activeChatHeaderSA").style.visibility = 'hidden';
          document.getElementById("chatActionsSA").style.display = 'none';
          document.getElementById("chatMessagesSA").innerHTML = "";
          loadConversationsSA();
        }
      } catch (e) { showError("Failed to resolve conversation"); }
    }

    async function searchTicketsSA(query) {
      const q = query.toLowerCase().trim();
      const list = document.getElementById("ticketsListTableSA");
      if (!list) return;
      
      try {
        const res = await fetch("/api/support/tickets", { headers: { Authorization: "Bearer " + token } });
        const r = await res.json();
        if (r.success) {
          const filtered = r.data.filter(t => 
            t.title.toLowerCase().includes(q) || 
            (t.tenant?.name || "").toLowerCase().includes(q) ||
            t.id.toLowerCase().includes(q)
          );
          renderTicketsSA(filtered);
        }
      } catch (e) { console.error(e); }
    }

    async function viewTicketSA(id) {
      try {
        const res = await fetch("/api/support/tickets", { headers: { Authorization: "Bearer " + token } });
        const r = await res.json();
        if (!r.success) return;
        
        const t = r.data.find(x => x.id === id);
        if (!t) return;

        // Populate Modal
        document.getElementById("mt_id").innerText = `TICKET #${t.id.substring(0,8).toUpperCase()}`;
        document.getElementById("mt_title").innerText = t.title;
        document.getElementById("mt_tenant").innerText = t.tenant?.name || 'Global Instance';
        document.getElementById("mt_desc").innerText = t.description || 'No description provided for this neural incident.';
        
        const priorityEl = document.getElementById("mt_priority");
        priorityEl.style.color = t.priority === 'high' ? '#ef4444' : '#f59e0b';
        priorityEl.innerHTML = `<i data-lucide="alert-circle" style="width: 14px;"></i> ${t.priority.toUpperCase()}`;
        
        const modal = document.getElementById("ticketModalSA");
        modal.classList.add("show");

        // Wire Resolve Button
        const resolveBtn = document.getElementById("mt_action_btn");
        if (t.status === 'resolved' || t.status === 'closed') {
          resolveBtn.style.display = 'none';
        } else {
          resolveBtn.style.display = 'block';
          resolveBtn.onclick = () => updateTicketStatusSA(t.id, 'closed');
        }

        lucide.createIcons();

      } catch (e) { console.error(e); showError("Failed to load ticket details"); }
    }

    function closeTicketModalSA() {
      document.getElementById("ticketModalSA").classList.remove("show");
    }

    async function updateTicketStatusSA(id, status) {
      const responseText = document.getElementById("mt_response").value.trim();
      if (!responseText) return showError("Please provide a resolution response for the tenant.");
      
      if (!confirm(`Are you sure you want to mark this ticket as ${status.toUpperCase()} and send the response?`)) return;
      
      try {
        const res = await fetch(`/api/support/tickets/${id}/status`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
          body: JSON.stringify({ status, responseText })
        });
        const r = await res.json();
        if (r.success) {
          showSuccess(`Ticket ${status.toUpperCase()} and response sent.`);
          
          // Live/Direct UI Update
          const row = document.getElementById(`ticket-row-${id}`);
          if (row) {
            const cell = row.querySelector(".status-cell");
            if (cell) {
              cell.innerHTML = `<span class="status-badge-success" style="font-size: 0.65rem;">${status.toUpperCase()}</span>`;
            }
          }

          document.getElementById("mt_response").value = "";
          closeTicketModalSA();
          loadSupportActivity(); // Refresh activity feed
        }
      } catch (e) { showError("Failed to update ticket status"); }
    }

    async function filterTicketsByStatusSA(status) {
      const list = document.getElementById("ticketsListTableSA");
      if (!list) return;
      
      try {
        const res = await fetch("/api/support/tickets", { headers: { Authorization: "Bearer " + token } });
        const r = await res.json();
        if (r.success) {
          const filtered = status === 'all' 
            ? r.data 
            : r.data.filter(t => t.status.toLowerCase() === status.toLowerCase());
          renderTicketsSA(filtered);
        }
      } catch (e) { console.error(e); }
    }


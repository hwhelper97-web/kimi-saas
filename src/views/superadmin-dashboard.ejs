      }
      container.innerHTML = incidents.map(i => `
        <div class="apex-card" style="padding: 1.25rem; border-left: 4px solid ${i.severity === 'critical' ? '#ef4444' : i.severity === 'major' ? '#f59e0b' : '#3b82f6'};">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
            <div>
              <h4 style="font-size: 1rem; font-weight: 700;">${i.title}</h4>
              <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">${i.description}</p>
            </div>
            <span class="status-badge-standard" style="background: rgba(255,255,255,0.05);">${i.status.toUpperCase()}</span>
          </div>
          <div style="display: flex; gap: 1rem; margin-top: 1rem; font-size: 0.7rem; color: var(--text-muted);">
            <span><i data-lucide="clock" style="width: 12px; vertical-align: middle;"></i> ${new Date(i.createdAt).toLocaleString()}</span>
            <span><i data-lucide="layers" style="width: 12px; vertical-align: middle;"></i> ${i.affectedServices || 'All Services'}</span>
          </div>
        </div>
      `).join("");
      lucide.createIcons();
    }

    function openCreateIncidentModal() {
      document.getElementById("incidentModalSA").classList.add("show");
    }

    function closeIncidentModalSA() {
      document.getElementById("incidentModalSA").classList.remove("show");
    }

    async function submitIncidentSA() {
      const data = {
        severity: document.getElementById("inc_severity").value,
        title: document.getElementById("inc_title").value,
        affectedServices: document.getElementById("inc_services").value,
        description: document.getElementById("inc_description").value
      };

      if (!data.title || !data.description) return showError("Required fields missing");

      try {
        const res = await fetch("/api/superadmin/incidents", {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
          body: JSON.stringify(data)
        });
        const r = await res.json();
        if (r.success) {
          showSuccess("Incident broadcasted to all terminals.");
          closeIncidentModalSA();
          loadIncidentsSA();
        }
      } catch (e) { showError("Failed to declare incident"); }
    }

    /* ======================================
       PROVISIONING WIZARD LOGIC
    ====================================== */
    let currentProvisionStep = 1;

    function nextStep(step) {
      // Validation for step 1
      if (step === 2 && currentProvisionStep === 1) {
        if (!document.getElementById("tenantName").value || !document.getElementById("email").value || !document.getElementById("password").value) {
          return showError("Please complete all identity fields.");
        }
      }

      // Hide all content
      document.querySelectorAll('.step-content').forEach(c => c.classList.remove('active'));
      document.querySelectorAll('.step-indicator').forEach(i => i.classList.remove('active'));

      // Show target step
      document.getElementById(`step-${step}`).classList.add('active');
      document.getElementById(`step-dot-${step}`).classList.add('active');
      
      // Mark previous as completed
      for(let i = 1; i < step; i++) {
        document.getElementById(`step-dot-${i}`).classList.add('completed');
        document.getElementById(`step-dot-${i}`).innerHTML = '<i data-lucide="check" style="width: 18px;"></i>';
      }
      
      currentProvisionStep = step;
      lucide.createIcons();
    }

    async function startDeploymentSequence() {
      const btn = document.getElementById("provisionBtn");
      const overlay = document.getElementById("deployOverlay");
      const statusText = document.getElementById("deployStatus");
      const progressBar = document.getElementById("deployProgress");
      
      // Validation for step 3
      if (!document.getElementById("initialTokens").value) {
        return showError("Please set initial resource allocation.");
      }

      // Hide steps, show overlay
      document.querySelectorAll('.step-content').forEach(c => c.classList.remove('active'));
      overlay.style.display = 'flex';
      
      const sequence = [
        { progress: 10, status: "Establishing Neural Uplink..." },
        { progress: 25, status: "Allocating Dedicated CPU Clusters..." },
        { progress: 45, status: "Initializing Prisma Schema..." },
        { progress: 65, status: "Cloning Voice Model Weights..." },
        { progress: 85, status: "Securing JWT Secret Chains..." },
        { progress: 95, status: "Finalizing API Gateways..." }
      ];

      for (const item of sequence) {
        statusText.innerText = item.status;
        progressBar.style.width = item.progress + "%";
        await new Promise(r => setTimeout(r, 800));
      }

      // Final Call to API
      try {
        await createTenant();
        statusText.innerText = "Deployment Successful! Redirecting...";
        progressBar.style.width = "100%";
        setTimeout(() => {
          showSection('tenants');
          // Reset Wizard for next time
          setTimeout(() => location.reload(), 500);
        }, 2000);
      } catch (e) {
        overlay.style.display = 'none';
        document.getElementById(`step-${currentProvisionStep}`).classList.add('active');
        showError("Deployment Failed: " + e.message);
      }
    }

    /* ======================================
       WORKER QUEUES
    ====================================== */
    async function loadQueueStats() {
      try {
        const res = await fetch("/api/superadmin/queues", { headers: { Authorization: "Bearer " + token } });
        const r = await res.json();
        if (r.success) {
          const container = document.getElementById("queuesGrid");

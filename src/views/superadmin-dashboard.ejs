                <h4 style="font-weight: 700;">${q.name}</h4>
                <span class="pulse-online" style="background: ${q.active > 0 ? '#10b981' : '#64748b'};"></span>
              </div>
              <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; text-align: center;">
                <div><div style="font-size: 1.25rem; font-weight: 800; color: #10b981;">${q.active}</div><div style="font-size: 0.6rem; color: var(--text-muted);">ACTIVE</div></div>
                <div><div style="font-size: 1.25rem; font-weight: 800; color: var(--primary);">${q.waiting}</div><div style="font-size: 0.6rem; color: var(--text-muted);">WAITING</div></div>
                <div><div style="font-size: 1.25rem; font-weight: 800; color: #ef4444;">${q.failed}</div><div style="font-size: 0.6rem; color: var(--text-muted);">FAILED</div></div>
                <div><div style="font-size: 1.25rem; font-weight: 800; color: var(--text-muted);">${q.processed}</div><div style="font-size: 0.6rem; color: var(--text-muted);">DONE</div></div>
              </div>

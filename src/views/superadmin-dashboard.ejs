    function showSuccess(m) { const b = document.getElementById("successBox"); b.innerText = m; b.style.display = "block"; setTimeout(() => b.style.display="none", 4000); }
    function showError(m) { const b = document.getElementById("errorBox"); b.innerText = m; b.style.display = "block"; setTimeout(() => b.style.display="none", 4000); }

    async function loadAnalytics() {
      const debugLog = document.getElementById("debugDataLog");
      if (debugLog) debugLog.innerText = "Synchronizing with Naxton AI Cloud...";
      
      try {
        const query = currentBusinessFilter ? `?businessId=${currentBusinessFilter}` : "";
        const res = await fetch(`/api/superadmin/analytics${query}`, { headers: { Authorization: "Bearer " + token } });
        
        // 🛡️ AUTO-LOGOUT ON SESSION EXPIRE
        if (res.status === 401) {
          console.warn("[SuperAdmin] Session expired. Redirecting to login...");
          logout();
          return;
        }
        
        if (debugLog) debugLog.innerText = `HTTP ${res.status}: Fetching payload...`;
        
        const r = await res.json(); 
        console.log("[SuperAdmin] Analytics Payload:", r);
        
        if (debugLog) debugLog.innerText = JSON.stringify(r, null, 2);

        if (!r.success) {
          console.error("[SuperAdmin] Analytics API Error:", r.message);
          if (r.error === "Token expired or invalid") { logout(); return; }
          showError("Failed to synchronize platform analytics: " + (r.message || "Unknown error"));
          return;
        }
        
        const d = r.data;
        console.log("[SuperAdmin] Processing counts:", { tenants: d.tenants, calls: d.calls, revenue: d.totalRevenue });

        // Primary Stats
        if (document.getElementById("statRevenue")) document.getElementById("statRevenue").innerText = "$" + (d.totalRevenue || 0).toLocaleString(undefined, {minimumFractionDigits: 2});
        if (document.getElementById("totalTenants")) document.getElementById("totalTenants").innerText = d.tenants || 0;
        if (document.getElementById("totalCalls")) document.getElementById("totalCalls").innerText = d.calls || 0;
        if (document.getElementById("conversionRate")) document.getElementById("conversionRate").innerText = (d.conversionRate || 0) + "%";
        
        // Charts
        if (d.revenueChart) renderRevenueChart(d.revenueChart);
        if (d.callsChart) renderCallsChart(d.callsChart);

        if (d.supportMetrics) {
          const sm = d.supportMetrics;
          if (document.getElementById("stat_totalTickets")) document.getElementById("stat_totalTickets").innerText = sm.totalTickets || 0;
          if (document.getElementById("stat_openTickets_label")) document.getElementById("stat_openTickets_label").innerText = `${sm.openCount || 0} Open`;
          if (document.getElementById("stat_activeChats")) document.getElementById("stat_activeChats").innerText = sm.activeChats || 0;
          if (document.getElementById("stat_unassigned")) document.getElementById("stat_unassigned").innerText = `${sm.unassignedChats || 0} Unassigned`;

          if (document.getElementById("stat_sla")) document.getElementById("stat_sla").innerText = `${sm.compliance}%`;
          if (document.getElementById("stat_openTickets")) document.getElementById("stat_openTickets").innerText = sm.openCount || 0;
          if (document.getElementById("label_velocity")) document.getElementById("label_velocity").innerText = `${sm.velocity}h`;
          if (document.getElementById("label_compliance")) document.getElementById("label_compliance").innerHTML = `<i data-lucide="check"></i> ${sm.compliance}%`;
          if (document.getElementById("label_response")) document.getElementById("label_response").innerText = `${sm.response}m`;
          
          if (sm.volumeChart) renderSupportChart(sm.volumeChart.trends || sm.volumeChart);
        }
        lucide.createIcons();
      } catch (e) {
        console.error("[SuperAdmin] Analytics Error:", e);
        if (debugLog) debugLog.innerText = "CRITICAL SCRIPT ERROR: " + e.message;
      }
    }

    async function loadBusinesses() {
      try {
        const res = await fetch("/api/superadmin/businesses", { headers: { Authorization: "Bearer " + token } });
        const r = await res.json();
        if (r.success) {
          const select = document.getElementById("globalBusinessFilter");
          const options = r.data.map(b => `<option value="${b.id}">${b.name} (${b.type})</option>`).join("");
          select.innerHTML = `<option value="">Full Platform Overview</option>` + options;
        }
      } catch (e) {}
    }

    function updateDashboardFilter(val) {
      currentBusinessFilter = val;
      const label = document.getElementById("dashboardScopeLabel");
      if (val) {
        const name = document.getElementById("globalBusinessFilter").options[document.getElementById("globalBusinessFilter").selectedIndex].text;
        label.innerText = `Detailed insights for ${name}.`;
      } else {
        label.innerText = "Real-time analytics and infrastructure monitoring across all tenants.";

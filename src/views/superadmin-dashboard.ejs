    async function confirmBulkDeleteTenants() {
      const password = document.getElementById("confirmAdminPassword").value;
      if (!password) return showError("Superadmin password required");
      
      const btn = document.getElementById("finalDeleteBtn");
      btn.disabled = true; btn.innerHTML = `PURGING ${selectedTenantIds.size} TENANTS...`;

      try {
        const tenantIdsArr = Array.from(selectedTenantIds);
        const res = await fetch(`/api/superadmin/tenants/bulk`, {
          method: "DELETE",
          headers: {
            "Content-Type": "application/json",
            "Authorization": "Bearer " + token
          },
          body: JSON.stringify({ tenantIds: tenantIdsArr, adminPassword: password })
        });
        const r = await res.json();
        if (r.success) {
          showSuccess(r.message || `Purged ${r.deletedCount} tenants!`);
          closeDeleteModal();
          clearTenantSelection();
          loadTenants();
        } else {
          showError(r.message);
        }
      } catch (e) {
        showError("Network error during bulk delete");
      } finally {
        btn.disabled = false;
        btn.innerHTML = "PURGE ACCOUNT";
      }
    }


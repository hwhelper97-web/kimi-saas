    async function loadTenants() {
      try {
        console.log("[SuperAdmin] Fetching tenants...");
        const res = await fetch("/api/superadmin/tenants", { headers: { Authorization: "Bearer " + token } });
        if (res.status === 401) return logout();
        
        const r = await res.json(); 
        console.log("[SuperAdmin] Tenants response:", r);
        if (r.success) { 
          allTenants = r.data; 
          renderTenantTable(allTenants); 
          loadDemoTenants();
        } else {
          showError(r.message || "Failed to load tenants");
          document.getElementById("tenantList").innerHTML = `<tr><td colspan="5" style="text-align:center; padding:5rem; color:var(--danger);">Error: ${r.message || "Failed to load"}</td></tr>`;
        }
      } catch (e) {
        console.error("[SuperAdmin] Load tenants error:", e);
        document.getElementById("tenantList").innerHTML = `<tr><td colspan="5" style="text-align:center; padding:5rem; color:var(--danger);">Network Error: ${e.message}</td></tr>`;
      }
    }

    function renderTenantTable(data) {

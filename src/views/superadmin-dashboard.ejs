              <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
                <button class="apex-btn apex-btn-sm apex-btn-outline" onclick="manageStaffSA('${s.id}', '${s.email}', '${s.role}')" title="Modify Permissions">
                  <i data-lucide="settings-2" style="width: 14px;"></i>
                </button>
                ${!isSelf ? `
                  <button class="apex-btn apex-btn-sm apex-btn-danger" onclick="deleteStaffSA('${s.id}', '${s.email}')" title="Revoke Access">
                    <i data-lucide="user-minus" style="width: 14px;"></i>
                  </button>
                ` : ''}
              </div>
            </td>
          </tr>
        `;
      }).join("");
      if (window.lucide) lucide.createIcons();
    }

    let selectedStaffId = null;
    function manageStaffSA(id, email, role) {
      selectedStaffId = id;
      document.getElementById("staffEditEmail").innerText = email;
      document.getElementById("editStaffRole").value = role.toUpperCase();
      document.getElementById("staffModal").classList.add("show");
    }

    function closeStaffModal() {
      document.getElementById("staffModal").classList.remove("show");
    }

    async function saveStaffChangesSA() {
      const role = document.getElementById("editStaffRole").value;
      const btn = document.querySelector('#staffModal .apex-btn-primary');
      btn.disabled = true;
      btn.innerText = "SAVING...";

      try {
        const res = await fetch(`/api/auth/staff/${selectedStaffId}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
          body: JSON.stringify({ role })
        });
        const r = await res.json();
        if (r.success) {
          showSuccess("Personnel credentials updated.");
          closeStaffModal();
          loadStaffSA();
        } else {
          showError(r.message || "Update failed.");
        }
      } catch (e) {
        showError("Network Error");
      } finally {
        btn.disabled = false;
        btn.innerText = "SAVE CHANGES";
      }
    }

    async function deleteStaffSA(id, email) {
      if (!confirm(`Are you sure you want to PERMANENTLY revoke access for ${email}? This action cannot be undone.`)) return;

      try {
        const res = await fetch(`/api/auth/staff/${id}`, {
          method: "DELETE",
          headers: { Authorization: "Bearer " + token }
        });
        const r = await res.json();
        if (r.success) {
          showSuccess("Personnel access revoked.");
          loadStaffSA();
        } else {
          showError(r.message || "Revoke failed.");
        }
      } catch (e) {
        showError("Network Error");
      }
    }

    function getRoleColorSA(role) {
      const colors = {
        'DEVELOPER': '#00f2ff',
        'MANAGER': '#a855f7',
        'PRODUCT': '#f59e0b',
        'AGENT': '#10b981',
        'ADMIN': '#ef4444',
        'SUPERADMIN': '#ef4444'
      };
      return colors[role.toUpperCase()] || 'rgba(255,255,255,0.1)';
    }

    async function handleCreateStaffSA(e) {
      e.preventDefault();
      const form = e.target;
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());
      const btn = form.querySelector('button[type="submit"]');
      
      btn.disabled = true;
      btn.innerText = "PROVISIONING...";
      
      try {
        const res = await fetch("/api/auth/create-staff", {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
          body: JSON.stringify(data)
        });
        const r = await res.json();
        if (r.success) {
          const details = `Email: ${r.access.email}\nPassword: ${r.access.password}`;
          showSuccess(`Staff Provisioned! ACCESS DETAILS:\n${details}`);
          
          // Optionally show a more persistent UI for the access details
          const formCard = form.closest('.apex-card');
          const existingDetails = formCard.querySelector('.access-details-box');
          if (existingDetails) existingDetails.remove();
          
          const detailsBox = document.createElement('div');
          detailsBox.className = 'access-details-box';
          detailsBox.style = 'margin-top: 1.5rem; padding: 1rem; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 12px;';
          detailsBox.innerHTML = `
            <p style="font-size: 0.7rem; color: #10b981; font-weight: 800; margin-bottom: 0.5rem; text-transform: uppercase;">Credentials Generated</p>
            <div style="font-family: monospace; font-size: 0.8rem; color: white;">
              <div>Email: ${r.access.email}</div>
              <div>Pass: ${r.access.password}</div>
            </div>
            <p style="font-size: 0.6rem; color: var(--text-muted); margin-top: 0.5rem;">Please copy these details. They will not be shown again.</p>
          `;
          form.appendChild(detailsBox);

          form.reset();
          loadStaffSA();
        } else {
          showError(r.error || r.message || "Failed to provision staff");
        }
      } catch (err) {
        showError("Network Error");
      } finally {
        btn.disabled = false;
        btn.innerText = "PROVISION CREDENTIALS";
      }
    }

    async function loadSupportActivity() {
      const container = document.getElementById("supportActivityFeed");
      if (!container) return;
      
      try {
        // Fetch conversations and tickets in parallel
        const [convosRes, ticketsRes] = await Promise.all([
          fetch("/api/support/conversations", { headers: { Authorization: "Bearer " + token } }),
          fetch("/api/support/tickets", { headers: { Authorization: "Bearer " + token } })
        ]);
        
        const convos = await convosRes.json();
        const tickets = await ticketsRes.json();
        
        // Update counters
        if (convos.success) {
          document.getElementById("activeConvosCount").innerText = convos.data.length;
        }
        if (tickets.success) {
          const openCount = tickets.data.filter(t => t.status === 'open' || t.status === 'pending').length;
          document.getElementById("openTicketsCount").innerText = openCount;
        }

        let activities = [];
        
        if (convos.success) {
          convos.data.slice(0, 5).forEach(c => {
            activities.push({
              type: 'chat',
              title: `Chat with ${c.customer?.name || 'Tenant'}`,
              desc: c.messages?.[0]?.body || 'Started a new session',
              time: c.updatedAt || c.createdAt,
              icon: 'message-circle',
              color: 'var(--primary)'
            });
          });
        }
        
        if (tickets.success) {
          tickets.data.slice(0, 5).forEach(t => {
            activities.push({
              type: 'ticket',
              title: `Ticket: ${t.title}`,
              desc: `Status: ${t.status.toUpperCase()} • Priority: ${t.priority.toUpperCase()}`,
              time: t.createdAt,
              icon: 'ticket',
              color: t.priority === 'high' ? '#ef4444' : '#f59e0b'
            });
          });
        }
        
        // Sort by time descending
        activities.sort((a, b) => new Date(b.time) - new Date(a.time));
        
        if (activities.length === 0) {
          container.innerHTML = '<p style="text-align: center; color: var(--text-muted); padding: 2rem; font-size: 0.8rem;">No recent platform frequencies detected.</p>';
          return;
        }

        // Update Urgent Tickets List
        const urgentContainer = document.getElementById("urgentTicketsList");
        if (urgentContainer && tickets.success) {
          const highPriority = tickets.data.filter(t => t.priority === 'high' && (t.status === 'open' || t.status === 'pending'));
          if (highPriority.length > 0) {
            urgentContainer.innerHTML = highPriority.slice(0, 3).map(t => `
              <div style="padding: 0.75rem; background: rgba(239, 68, 68, 0.05); border: 1px solid rgba(239, 68, 68, 0.1); border-radius: 12px; display: flex; align-items: center; gap: 0.75rem;">
                <i data-lucide="alert-circle" style="width: 14px; color: #ef4444;"></i>
                <div style="flex: 1; min-width: 0;">
                  <div style="font-size: 0.75rem; font-weight: 700; color: #ef4444;">${t.title}</div>
                  <div style="font-size: 0.65rem; color: var(--text-muted);">${t.tenant?.name || 'Platform'}</div>
                </div>
              </div>
            `).join('');
          } else {
             urgentContainer.innerHTML = `
              <div style="text-align: center; padding: 1.5rem;">
                <i data-lucide="shield-check" style="width: 24px; color: var(--success); opacity: 0.3; margin-bottom: 0.5rem;"></i>
                <p style="color: var(--text-muted); font-size: 0.65rem;">All systems operational.</p>
              </div>
            `;
          }
        }
        
        container.innerHTML = activities.slice(0, 8).map(a => `
          <div style="display: flex; gap: 1rem; padding: 1rem; background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 16px;">
            <div style="width: 36px; height: 36px; background: ${a.color}20; color: ${a.color}; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <i data-lucide="${a.icon}" style="width: 18px;"></i>
            </div>
            <div style="flex: 1; min-width: 0;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                <h4 style="font-size: 0.85rem; font-weight: 700;">${a.title}</h4>
                <span style="font-size: 0.65rem; color: var(--text-muted);">${new Date(a.time).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
              </div>
              <p style="font-size: 0.75rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${a.desc}</p>
            </div>
          </div>
        `).join('');
        lucide.createIcons();
        
      } catch (e) {
        console.error("Failed to load support activity", e);
      }
    }

    async function loadTicketsSA() {

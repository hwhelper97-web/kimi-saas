          </td>
          <td style="padding: 1.25rem 1rem;">
            <div style="display:flex; flex-direction:column;">
              <span style="font-size:0.85rem; color:var(--text-primary); font-weight:600;">${new Date(r.createdAt).toLocaleDateString()}</span>
              <span style="font-size:0.65rem; color:var(--text-muted);">${new Date(r.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>

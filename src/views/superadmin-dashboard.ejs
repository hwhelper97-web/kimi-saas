    ============================================================================= */
    
    async function loadMintRequests() {
      try {
        const container = document.getElementById("mintRequestList");
        container.innerHTML = `<tr><td colspan="5" style="text-align:center; padding:3rem;"><div class="loader-ring" style="width:24px; height:24px; margin:0 auto;"></div></td></tr>`;

        const res = await fetch("/api/superadmin/mint-requests", { headers: { Authorization: "Bearer " + token } });
        const r = await res.json();
        if (r.success) {
          renderMintRequests(r.data);
        } else {
          showError("Failed to synchronize mint requests.");
        }
      } catch (e) {
        console.error("Load mint requests error:", e);
      }
    }


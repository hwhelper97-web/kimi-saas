    /* ======================================
       SECURITY & AUDIT
    ====================================== */
    let currentAuditLogs = [];
    async function loadAuditLogs() {
      try {
        const res = await fetch("/api/superadmin/audit-logs", { headers: { Authorization: "Bearer " + token } });
        const r = await res.json();
        if (r.success) {
          currentAuditLogs = r.data;
          renderAuditLogs(r.data);
        }
      } catch (e) {}
    }

    function renderAuditLogs(logs) {
      const container = document.getElementById("auditLogsList");
      if (!logs.length) {
        container.innerHTML = `<tr><td colspan="6" style="text-align: center; padding: 3rem; color: var(--text-muted);">No logs found.</td></tr>`;
        return;
      }
      container.innerHTML = logs.map(l => `
        <tr>
          <td style="font-size: 0.75rem; color: var(--text-muted);">${new Date(l.createdAt).toLocaleString()}</td>
          <td style="font-weight: 700;">${l.userId ? l.userId.substring(0,8) : 'SYSTEM'}</td>
          <td><span class="status-badge-standard">${l.action}</span></td>
          <td>${l.resource}</td>
          <td style="font-family: monospace; font-size: 0.75rem;">${l.ipAddress || '127.0.0.1'}</td>
          <td><button type="button" class="action-btn" onclick="event.stopPropagation(); viewLogDetails('${l.id}')"><i data-lucide="eye" style="width: 14px;"></i></button></td>
        </tr>
      `).join("");
      lucide.createIcons();
    }

    function viewLogDetails(id) {
      const log = currentAuditLogs.find(l => l.id === id);
      if (!log) return;

      const meta = document.getElementById("auditLogMeta");
      meta.innerHTML = `
        <div>
          <p class="label-caps" style="opacity: 0.5; font-size: 0.6rem;">Timestamp</p>
          <p style="font-size: 0.85rem; font-weight: 600;">${new Date(log.createdAt).toLocaleString()}</p>
        </div>
        <div>
          <p class="label-caps" style="opacity: 0.5; font-size: 0.6rem;">Resource</p>
          <p style="font-size: 0.85rem; font-weight: 600;">${log.resource}</p>
        </div>
        <div>
          <p class="label-caps" style="opacity: 0.5; font-size: 0.6rem;">Admin ID</p>
          <p style="font-size: 0.85rem; font-weight: 600;">${log.userId}</p>
        </div>
        <div>
          <p class="label-caps" style="opacity: 0.5; font-size: 0.6rem;">IP Address</p>
          <p style="font-size: 0.85rem; font-weight: 600;">${log.ipAddress || 'N/A'}</p>
        </div>
      `;

      const payload = document.getElementById("auditLogPayload");
      try {
        const details = typeof log.details === 'string' ? JSON.parse(log.details) : log.details;
        payload.innerText = JSON.stringify(details, null, 2);
      } catch (e) {
        payload.innerText = log.details || "No metadata provided.";
      }

      document.getElementById("auditLogModal").classList.add("show");
    }

    function closeAuditLogModal() {
      document.getElementById("auditLogModal").classList.remove("show");
    }

    /* ======================================
       INCIDENTS
    ====================================== */
    async function loadIncidentsSA() {
      try {
        const res = await fetch("/api/superadmin/incidents", { headers: { Authorization: "Bearer " + token } });
        const r = await res.json();
        if (r.success) {
          renderIncidentsSA(r.data);
        }
      } catch (e) {}
    }

    function renderIncidentsSA(incidents) {
      const container = document.getElementById("incidentsList");
      if (!incidents.length) {
        container.innerHTML = `<div style="text-align: center; padding: 3rem; color: var(--text-muted);">No incidents recorded.</div>`;

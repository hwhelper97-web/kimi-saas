<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quantum Telemetry Nexus | Naxton AI</title>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;800&family=Outfit:wght@400;600;800;900&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        :root {
            --nexus-primary: #00f2ff;
            --nexus-bg: #030712;
            --nexus-card: rgba(255, 255, 255, 0.01);
            --nexus-border: rgba(255, 255, 255, 0.08);
            --text-muted: #64748b;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--nexus-bg);
            color: white;
            font-family: 'Outfit', sans-serif;
            height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* 🌌 Deep Space Background */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background: radial-gradient(circle at 50% 50%, rgba(0, 242, 255, 0.02) 0%, transparent 70%);
            pointer-events: none;
            z-index: -1;
        }

        /* 💠 Premium Header */
        header {
            height: 80px;
            padding: 0 3rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.01);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--nexus-border);
            z-index: 100;
        }

        .logo-group {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .logo-glow {
            width: 40px;
            height: 40px;
            background: var(--nexus-primary);
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 242, 255, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #030712;
        }

        .logo-text {
            font-size: 1.5rem;
            font-weight: 900;
            letter-spacing: -0.04em;
        }

        .logo-text span {
            color: var(--nexus-primary);
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.2em;
            display: block;
            margin-top: -4px;
        }

        /* 🎛 Main Layout */
        main {
            flex: 1;
            display: flex;
            overflow: hidden;
        }

        /* 📂 Sidebar */
        .sidebar {
            width: 380px;
            background: rgba(255, 255, 255, 0.01);
            backdrop-filter: blur(30px);
            border-right: 1px solid var(--nexus-border);
            padding: 2.5rem;
            display: flex;
            flex-direction: column;
            gap: 2.5rem;
        }

        .sidebar-label {
            font-size: 0.75rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .active-session {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--nexus-border);
            padding: 1.5rem;
            border-radius: 1.5rem;
            margin-bottom: 1rem;
            transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
            cursor: pointer;
        }

        .active-session:hover {
            border-color: var(--nexus-primary);
            background: rgba(0, 242, 255, 0.03);
            transform: scale(1.02);
        }

        .session-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .session-name { font-weight: 800; font-size: 1.1rem; }
        .session-id { font-family: 'JetBrains Mono'; font-size: 0.7rem; color: var(--text-muted); margin-top: 0.25rem; }

        /* 📟 Quantum Terminal */
        .terminal-container {
            flex: 1;
            padding: 2.5rem;
            display: flex;
            flex-direction: column;
        }

        .quantum-shell {
            flex: 1;
            background: rgba(0, 0, 0, 0.4);
            border-radius: 2.5rem;
            border: 1px solid var(--nexus-border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
        }

        .quantum-shell::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            background-size: 100% 4px, 3px 100%;
            pointer-events: none;
            z-index: 10;
        }

        .shell-header {
            padding: 1.5rem 2.5rem;
            background: rgba(255, 255, 255, 0.02);
            border-bottom: 1px solid var(--nexus-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .shell-logs {
            flex: 1;
            padding: 2.5rem;
            overflow-y: auto;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.9rem;
            line-height: 1.8;
            scrollbar-width: none;
        }
        .shell-logs::-webkit-scrollbar { display: none; }

        .log-entry {
            display: flex;
            gap: 1.5rem;
            margin-bottom: 0.75rem;
            animation: logIn 0.3s forwards;
        }

        @keyframes logIn { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: translateX(0); } }

        .log-time { color: var(--text-muted); min-width: 90px; }
        .log-tag { font-weight: 800; min-width: 100px; text-transform: uppercase; font-size: 0.75rem; }
        .log-msg { color: #cbd5e1; }

        /* Status Colors */
        .success { color: #10b981; }
        .error { color: #ef4444; }
        .warning { color: #f59e0b; }
        .info { color: var(--nexus-primary); }
        .ai { color: #8b5cf6; }
        .tool { color: #ec4899; }

        /* 📱 Mobile view responsive styling overrides */
        @media (max-width: 768px) {
            body {
                overflow-y: auto !important;
                height: auto !important;
            }
            header {
                padding: 1rem 1.5rem !important;
                height: auto !important;
                flex-direction: column !important;
                gap: 1rem !important;
                align-items: flex-start !important;
            }
            .logo-text {
                font-size: 0.9rem !important;
            }
            main {
                flex-direction: column !important;
                overflow: visible !important;
                height: auto !important;
            }
            .sidebar {
                width: 100% !important;
                border-right: none !important;
                border-bottom: 1px solid var(--nexus-border);
                padding: 1.5rem !important;
                gap: 1.5rem !important;
            }
            .sidebar > div:last-child {
                display: none !important; /* hide static security text on mobile */
            }
            .terminal-container {
                height: 60vh !important;
                min-height: 400px !important;
            }
            .quantum-shell {
                padding: 0.5rem 1rem !important;
            }
            .shell-logs {
                padding: 1rem !important;
                font-size: 0.8rem !important;
            }
        }
    </style>
</head>
<body>

<header>
    <div class="logo-group">
        <div class="logo-glow"><i data-lucide="zap"></i></div>
        <div class="logo-text">NAXTON AI <span>Quantum Telemetry Nexus</span></div>
    </div>
    <div style="display: flex; align-items: center; gap: 2rem;">
        <div id="socketStatus" style="display: flex; align-items: center; gap: 0.75rem; background: rgba(16, 185, 129, 0.1); padding: 0.6rem 1.25rem; border-radius: 1rem; border: 1px solid rgba(16, 185, 129, 0.2); color: #10b981; font-weight: 800; font-size: 0.8rem;">
            <div style="width: 8px; height: 8px; background: currentColor; border-radius: 50%; box-shadow: 0 0 10px currentColor;"></div>
            SYNC_ESTABLISHED
        </div>
    </div>
</header>

<main>
    <div class="sidebar">
        <div>
            <span class="sidebar-label"><i data-lucide="activity" style="width: 14px;"></i> Active Synapses</span>
            <div id="activeCallsList" style="margin-top: 1rem;">
                <div style="font-size: 0.75rem; color: var(--text-muted); font-style: italic;">No active voice channels.</div>
            </div>
            <div style="margin-top: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem;">
                <button style="width: 100%; background: rgba(0, 242, 255, 0.12); border: 1px solid rgba(0, 242, 255, 0.4); color: var(--nexus-primary); border-radius: 10px; padding: 0.6rem; font-weight: 800; font-size: 0.75rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem; transition: all 0.2s;" onclick="runCommandDirect('sim-call')">
                    <i data-lucide="zap" style="width: 14px;"></i> SIMULATE CALL EVENT
                </button>
                <button style="width: 100%; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--nexus-border); color: #94a3b8; border-radius: 10px; padding: 0.5rem; font-weight: 700; font-size: 0.75rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem; transition: all 0.2s;" onclick="runCommandDirect('clear')">
                    <i data-lucide="trash-2" style="width: 14px;"></i> CLEAR LOG CONSOLE
                </button>
            </div>
        </div>

        <div style="margin-top: auto; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--nexus-border); padding: 1.5rem; border-radius: 1.5rem;">
            <span class="sidebar-label" style="color: #ef4444;"><i data-lucide="shield-alert" style="width: 14px;"></i> Security Protocol</span>
            <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.75rem; line-height: 1.5; font-weight: 500;">
                Quantum observability active. Multi-tenant voice streams are being synchronized across the intelligence grid.
            </p>
        </div>
    </div>

    <div class="terminal-container">
        <div class="quantum-shell">
            <div class="shell-header">
                <div style="display: flex; gap: 0.75rem; align-items: center;">
                    <div style="width: 12px; height: 12px; border-radius: 50%; background: #ff5f56;"></div>
                    <div style="width: 12px; height: 12px; border-radius: 50%; background: #ffbd2e;"></div>
                    <div style="width: 12px; height: 12px; border-radius: 50%; background: #27c93f;"></div>
                    <span style="font-size: 0.7rem; color: #64748b; font-family: 'JetBrains Mono'; font-weight: 700; margin-left: 0.5rem;">INTERACTIVE NEXUS CLI</span>
                </div>
                <div style="font-family: 'JetBrains Mono'; font-size: 0.75rem; color: var(--nexus-primary); font-weight: 700;">root@naxton-intelligence:~# nexus --monitor --live</div>
            </div>
            <div class="shell-logs" id="terminalLogs">
                <div class="log-entry">
                    <span class="log-time">[00:00:00]</span>
                    <span class="log-tag info">NEXUS</span>
                    <span class="log-msg">Initializing Quantum Observation Grid... Ready. Type <b style="color: var(--nexus-primary);">help</b> for interactive commands.</span>
                </div>
            </div>
            <!-- INTERACTIVE COMMAND PROMPT -->
            <div style="padding: 0.85rem 1.75rem; background: rgba(0,0,0,0.6); border-top: 1px solid var(--nexus-border); display: flex; align-items: center; gap: 0.75rem;">
                <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: var(--nexus-primary); font-weight: 800; white-space: nowrap;">root@naxton-intelligence:~#</span>
                <input type="text" id="terminalCmdInput" style="flex: 1; background: transparent; border: none; outline: none; color: white; font-family: 'JetBrains Mono', monospace; font-size: 0.85rem;" placeholder="Type command (e.g. status, ping, sim-call, clear, help)..." onkeydown="if(event.key==='Enter') runTerminalCommand()">
                <button style="background: rgba(0, 242, 255, 0.15); border: 1px solid rgba(0, 242, 255, 0.4); color: var(--nexus-primary); border-radius: 8px; padding: 0.4rem 1rem; font-weight: 800; font-size: 0.75rem; cursor: pointer; transition: all 0.2s;" onclick="runTerminalCommand()">EXECUTE</button>
            </div>
        </div>
    </div>
</main>

<script src="/socket.io/socket.io.js"></script>
<script>
    if (window.lucide) lucide.createIcons();

    // 🛡️ Authentication & Connection
    function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
        return null;
    }

    const token = getCookie('token');
    const tenantMap = new Map();
    const terminalLogs = document.getElementById('terminalLogs');
    const activeCallsList = document.getElementById('activeCallsList');

    const socket = io({
        auth: { token: token },
        reconnection: true,
        reconnectionDelay: 1000
    });
    
    socket.on('connect', () => {
        document.getElementById('socketStatus').innerHTML = `
            <div style="width: 8px; height: 8px; background: currentColor; border-radius: 50%; box-shadow: 0 0 10px currentColor;"></div>
            SYNC_ESTABLISHED
        `;
        document.getElementById('socketStatus').style.color = '#10b981';
        addLog('success', 'NEXUS', 'Quantum link established. Synchronizing intelligence grid...');
        socket.emit('join_superadmin');
    });

    socket.on('disconnect', () => {
        document.getElementById('socketStatus').style.color = '#ef4444';
        document.getElementById('socketStatus').innerHTML = `
            <div style="width: 8px; height: 8px; background: currentColor; border-radius: 50%; box-shadow: 0 0 10px currentColor;"></div>
            SYNC_LOST
        `;
    });

    function addLog(type, tag, message) {
        const entry = document.createElement('div');
        entry.className = 'log-entry';
        
        const timestamp = new Date().toLocaleTimeString('en-GB', { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
        
        entry.innerHTML = `
            <span class="log-time">[${timestamp}]</span>
            <span class="log-tag ${type}">${tag || 'SYSTEM'}</span>
            <span class="log-msg">${message}</span>
        `;
        
        terminalLogs.appendChild(entry);
        terminalLogs.scrollTop = terminalLogs.scrollHeight;

        if (terminalLogs.children.length > 500) {
            terminalLogs.removeChild(terminalLogs.firstChild);
        }
    }

    function updateActiveCalls(data, action) {
        if (action === 'start') {
            tenantMap.set(data.businessId, data.businessName);
            const item = document.createElement('div');
            item.className = 'active-session';
            item.id = `call-${data.callSid || data.businessId}`;
            item.innerHTML = `
                <div class="session-info">
                    <div>
                        <div class="session-name">${data.businessName}</div>
                        <div class="session-id">SID: ${data.callSid?.substring(0,12) || 'INITIALIZING...'}</div>
                    </div>
                    <div style="width: 10px; height: 10px; border-radius: 50%; background: #10b981; box-shadow: 0 0 10px #10b981;"></div>
                </div>
            `;
            activeCallsList.appendChild(item);
        } else if (action === 'end') {
            const item = document.getElementById(`call-${data.callSid || data.businessId}`);
            if (item) item.remove();
        }
    }

    socket.on('call_debug', (data) => {
        const tName = tenantMap.get(data.businessId) || data.businessId?.substring(0,8) || 'SYSTEM';
        addLog(data.type, tName, data.message);
    });

    socket.on('call_started', (data) => {
        addLog('success', data.businessName || 'UNKNOWN', `Neural synapse established.`);
        updateActiveCalls(data, 'start');
    });

    socket.on('call_ended', (data) => {
        const tName = tenantMap.get(data.businessId) || 'SYSTEM';
        addLog('warning', tName, `Synapse dissolved.`);
        updateActiveCalls(data, 'end');
    });

    socket.on('call_transcribed', (data) => {
        const tName = tenantMap.get(data.businessId) || 'SYSTEM';
        const type = data.role === 'user' ? 'info' : 'ai';
        const prefix = data.role === 'user' ? 'USER: ' : 'AI: ';
        addLog(type, tName, prefix + data.text);
    });

    // 🚀 Global Event Telemetry (Clicks & Connections)
    socket.on('app_telemetry', (data) => {
        addLog(data.type || 'info', data.source || 'APP', data.message);
    });

    // 💻 Interactive CLI Command Handler
    function runCommandDirect(cmd) {
        const input = document.getElementById('terminalCmdInput');
        if (input) input.value = cmd;
        runTerminalCommand();
    }

    function runTerminalCommand() {
        const input = document.getElementById('terminalCmdInput');
        if (!input) return;
        const raw = input.value.trim();
        if (!raw) return;
        
        input.value = '';
        addLog('info', 'CLI', `root@naxton-intelligence:~# ${raw}`);
        
        const parts = raw.split(' ');
        const cmd = parts[0].toLowerCase();

        switch (cmd) {
            case 'help':
                addLog('info', 'HELP', 'Available CLI commands:');
                addLog('info', 'HELP', '  status    — Check platform sync & active synapse nodes');
                addLog('info', 'HELP', '  ping      — Measure socket bridge latency');
                addLog('info', 'HELP', '  sim-call  — Inject simulated neural call stream event');
                addLog('info', 'HELP', '  telemetry — Display quantum node resource specs');
                addLog('info', 'HELP', '  clear     — Wipe console output buffer');
                break;
                
            case 'status':
                const isConn = socket && socket.connected;
                addLog(isConn ? 'success' : 'error', 'SYSTEM', `Socket Bridge Status: ${isConn ? 'ONLINE (Port 5000)' : 'DISCONNECTED'}`);
                addLog('info', 'SYSTEM', `Active Synapses (Live Calls): ${tenantMap.size}`);
                break;
                
            case 'ping':
                const start = Date.now();
                socket.emit('ping_check', {}, () => {
                    const latency = Date.now() - start;
                    addLog('success', 'PONG', `Latency: ${latency}ms`);
                });
                setTimeout(() => {
                    addLog('info', 'PONG', 'Socket round-trip latency: < 5ms (Local Cluster)');
                }, 100);
                break;
                
            case 'clear':
                terminalLogs.innerHTML = '';
                addLog('info', 'NEXUS', 'Console buffer cleared. Ready.');
                break;
                
            case 'sim-call':
                const simSid = 'CA_SIM_' + Math.floor(Math.random() * 900000 + 100000);
                const simData = {
                    businessId: 'sim-demo-tenant',
                    businessName: 'Apex Auto Repair (Simulated)',
                    callSid: simSid
                };
                updateActiveCalls(simData, 'start');
                addLog('success', 'SIMULATOR', `Neural call initiated [SID: ${simSid}]`);
                setTimeout(() => {
                    addLog('info', simData.businessName, 'USER: Hi, I would like to check my car repair status for booking #8492.');
                }, 800);
                setTimeout(() => {
                    addLog('ai', simData.businessName, 'AI: Hello! Your car brake inspection is complete and ready for pickup at 5 PM.');
                }, 2000);
                setTimeout(() => {
                    addLog('warning', simData.businessName, 'Synapse dissolved.');
                    updateActiveCalls(simData, 'end');
                }, 4000);
                break;
                
            case 'telemetry':
                addLog('info', 'TELEMETRY', 'Node Version: v20.x | OS: Windows 11 x64');
                addLog('info', 'TELEMETRY', 'Memory RSS: 142MB | Heap Used: 78MB');
                addLog('info', 'TELEMETRY', 'PostgreSQL Connection Pool: 10 connections active');
                addLog('info', 'TELEMETRY', 'Redis Cluster Bridge: 127.0.0.1:6379 connected');
                break;
                
            default:
                addLog('error', 'CLI', `Command not recognized: '${cmd}'. Type 'help' for command list.`);
                break;
        }
    }
</script>
</body>
</html>
</body>
</html>

<div class="support-center-container">
    <style>
        :root {
            --support-bg: #0b0f1a;
            --support-card: rgba(17, 24, 39, 0.7);
            --support-accent: #00d2ff;
            --support-accent-glow: rgba(0, 210, 255, 0.3);
            --support-border: rgba(255, 255, 255, 0.08);
            --support-text: #f3f4f6;
            --support-text-muted: #9ca3af;
        }

        .support-center-container {
            display: grid;
            grid-template-columns: 1fr 360px;
            gap: 2rem;
            height: calc(100vh - 180px);
            color: var(--support-text);
            animation: fadeIn 0.4s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Main Chat Area */
        .chat-main-section {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            min-width: 0;
        }

        .chat-card {
            flex: 1;
            background: var(--support-card);
            backdrop-filter: blur(20px);
            border: 1px solid var(--support-border);
            border-radius: 24px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        .chat-header {
            padding: 1.25rem 2rem;
            border-bottom: 1px solid var(--support-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255, 255, 255, 0.02);
        }

        .header-info {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .support-avatar {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--support-accent), #3b82f6);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 15px var(--support-accent-glow);
        }

        .status-badge {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.75rem;
            color: #10b981;
            font-weight: 600;
        }

        .pulse-online {
            width: 8px;
            height: 8px;
            background: #10b981;
            border-radius: 50%;
            box-shadow: 0 0 8px #10b981;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.5; }
            100% { opacity: 1; }
        }

        /* Messages Area */
        .messages-viewport {
            flex: 1;
            overflow-y: auto;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            scrollbar-width: thin;
            scrollbar-color: var(--support-border) transparent;
        }

        .msg-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            max-width: 80%;
        }

        .msg-group.support { align-self: flex-start; }
        .msg-group.customer { align-self: flex-end; }

        .bubble {
            padding: 1rem 1.25rem;
            border-radius: 18px;
            font-size: 0.9375rem;
            line-height: 1.5;
            position: relative;
        }

        .support .bubble {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--support-border);
            border-bottom-left-radius: 4px;
        }

        .customer .bubble {
            background: linear-gradient(135deg, #00d2ff 0%, #3b82f6 100%);
            color: white;
            border-bottom-right-radius: 4px;
            box-shadow: 0 10px 20px rgba(0, 210, 255, 0.2);
        }

        .msg-meta {
            font-size: 0.7rem;
            color: var(--support-text-muted);
            margin: 0 0.5rem;
        }

        .customer .msg-meta { text-align: right; }

        /* Input Area */
        .chat-input-wrapper {
            padding: 1.5rem 2rem;
            border-top: 1px solid var(--support-border);
            background: rgba(0, 0, 0, 0.2);
        }

        .input-box {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--support-border);
            border-radius: 16px;
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            transition: all 0.2s;
        }

        .input-box:focus-within {
            border-color: var(--support-accent);
            background: rgba(255, 255, 255, 0.05);
            box-shadow: 0 0 20px rgba(0, 210, 255, 0.1);
        }

        .chat-field {
            flex: 1;
            background: transparent;
            border: none;
            color: white;
            outline: none;
            font-size: 0.9375rem;
        }

        .input-actions {
            display: flex;
            gap: 0.75rem;
            color: var(--support-text-muted);
        }

        .action-icon-btn {
            background: transparent;
            border: none;
            color: inherit;
            cursor: pointer;
            padding: 0.5rem;
            border-radius: 8px;
            transition: all 0.2s;
        }

        .action-icon-btn:hover {
            color: var(--support-accent);
            background: rgba(0, 210, 255, 0.1);
        }

        .send-btn-glow {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: var(--support-accent);
            border: none;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 0 15px var(--support-accent-glow);
            transition: transform 0.2s;
        }

        .send-btn-glow:hover { transform: scale(1.05); }

        /* Right Sidebar */
        .support-sidebar {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            overflow-y: auto;
            padding-right: 0.5rem;
        }

        .sidebar-card {
            background: var(--support-card);
            border: 1px solid var(--support-border);
            border-radius: 20px;
            padding: 1.5rem;
        }

        .card-label {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--support-text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 1.25rem;
            display: block;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 1rem;
            font-size: 0.875rem;
        }

        .detail-row:last-child { margin-bottom: 0; }

        .article-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem;
            margin: 0 -0.75rem;
            border-radius: 10px;
            color: var(--support-text);
            text-decoration: none;
            font-size: 0.875rem;
            transition: background 0.2s;
        }

        .article-link:hover { background: rgba(255, 255, 255, 0.05); }
        .article-link i { color: var(--support-accent); }

        /* AI Assistant Card */
        .ai-promo-card {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(168, 85, 247, 0.1));
            border: 1px solid rgba(99, 102, 241, 0.2);
            position: relative;
            overflow: hidden;
        }

        .ai-promo-card::after {
            content: '';
            position: absolute;
            top: -20px;
            right: -20px;
            width: 100px;
            height: 100px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.3) 0%, transparent 70%);
            filter: blur(20px);
        }

        .btn-premium {
            width: 100%;
            padding: 0.875rem;
            border-radius: 12px;
            border: none;
            font-weight: 700;
            font-size: 0.875rem;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-ai {
            background: #6366f1;
            color: white;
            box-shadow: 0 10px 20px rgba(99, 102, 241, 0.3);
        }

        .btn-ticket {
            background: transparent;
            border: 1px solid var(--support-border);
            color: white;
        }

        .btn-ticket:hover { background: rgba(255, 255, 255, 0.05); border-color: var(--support-accent); }

    </style>

    <div class="chat-main-section">
        <div class="chat-card">
            <div class="chat-header">
                <div class="header-info">
                    <div class="support-avatar">
                        <i data-lucide="message-square" style="color: white; width: 22px;"></i>
                    </div>
                    <div>
                        <h3 style="font-size: 1rem; font-weight: 700;">Chat with Support</h3>
                        <div class="status-badge">
                            <div class="pulse-online"></div>
                            Online <span style="color: var(--support-text-muted); font-weight: 400; margin-left: 4px;">• Typically replies in a few minutes</span>
                        </div>
                    </div>
                </div>
                <button class="action-button" onclick="endSupportChat()" style="border-radius: 10px; padding: 0.5rem 1rem; background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); font-size: 0.75rem; cursor: pointer;">
                    End Chat
                </button>
            </div>

            <div class="messages-viewport" id="supportMessages">
                <!-- Welcome Message -->
                <div class="msg-group support">
                    <div class="bubble">
                        Neural Connection Established. 👋 How can we help you with Nexton AI today?
                    </div>
                    <span class="msg-meta">Just now</span>
                </div>
            </div>

            <div class="chat-input-wrapper">
                <div class="input-box">
                    <div class="input-actions">
                        <button class="action-icon-btn"><i data-lucide="plus" style="width: 18px;"></i></button>
                    </div>
                    <input type="text" class="chat-field" id="supportInput" placeholder="Type your message..." onkeypress="if(event.key==='Enter') sendSupportMessage()">
                    <div class="input-actions">
                        <button class="action-icon-btn"><i data-lucide="smile" style="width: 18px;"></i></button>
                        <button class="action-icon-btn"><i data-lucide="mic" style="width: 18px;"></i></button>
                        <button class="send-btn-glow" onclick="sendSupportMessage()"><i data-lucide="send" style="width: 18px;"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <aside class="support-sidebar">
        <!-- Conversation Details -->
        <div class="sidebar-card">
            <span class="card-label">Conversation Details</span>
            <div class="detail-row">
                <span style="color: var(--support-text-muted);">Status</span>
                <span style="color: #10b981; font-weight: 700;">Active</span>
            </div>
            <div class="detail-row">
                <span style="color: var(--support-text-muted);">Started</span>
                <span>Today, 10:30 AM</span>
            </div>
            <div class="detail-row">
                <span style="color: var(--support-text-muted);">Neural Link</span>
                <span style="color: var(--support-accent);">Synchronized</span>
            </div>
            <div class="detail-row">
                <span style="color: var(--support-text-muted);">SLA Response</span>
                <span style="color: var(--support-accent);">< 2 min</span>
            </div>
        </div>

        <!-- Related Articles -->
        <div class="sidebar-card">
            <span class="card-label">Related Articles</span>
            <a href="#" class="article-link"><i data-lucide="file-text" style="width: 16px;"></i> How to Upgrade Your Plan</a>
            <a href="#" class="article-link"><i data-lucide="file-text" style="width: 16px;"></i> Pro Plan Features Explained</a>
            <a href="#" class="article-link"><i data-lucide="file-text" style="width: 16px;"></i> Billing and Subscription FAQ</a>
            <a href="#" class="article-link"><i data-lucide="file-text" style="width: 16px;"></i> How AI Agents Work</a>
            <a href="#" style="font-size: 0.75rem; color: var(--support-accent); text-decoration: none; margin-top: 1rem; display: block;">View all articles →</a>
        </div>

        <!-- AI Promo -->
        <div class="sidebar-card ai-promo-card">
            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
                <div style="width: 40px; height: 40px; background: rgba(99, 102, 241, 0.2); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                    <i data-lucide="bot" style="color: #6366f1;"></i>
                </div>
                <div>
                    <h4 style="font-size: 0.875rem; font-weight: 700;">Try AI Assistant</h4>
                    <p style="font-size: 0.7rem; color: var(--support-text-muted);">Get instant answers now.</p>
                </div>
            </div>
            <button class="btn-premium btn-ai">
                <i data-lucide="sparkles" style="width: 16px;"></i>
                Ask AI Assistant
            </button>
        </div>

        <div class="sidebar-card">
            <h4 style="font-size: 0.875rem; font-weight: 700; margin-bottom: 0.5rem;">Need More Help?</h4>
            <p style="font-size: 0.75rem; color: var(--support-text-muted); margin-bottom: 1.5rem;">Initialize a fresh support thread or escalate to a formal ticket.</p>
            <button class="btn-premium btn-ai" onclick="startNewSupportChat()" style="background: var(--support-accent); margin-bottom: 0.75rem;">
                <i data-lucide="message-circle" style="width: 16px;"></i>
                Start New Chat
            </button>
            <button class="btn-premium btn-ticket" onclick="loadSection('create-ticket')">
                <i data-lucide="ticket" style="width: 16px;"></i>
                Open Support Ticket
            </button>
        </div>
    </aside>
    
    <!-- Modal: End Chat Confirmation -->
    <div id="endChatModal" class="modal-overlay">
        <div class="modal-container" style="max-width: 400px; background: rgba(13, 17, 23, 0.95); backdrop-filter: blur(20px); border: 1px solid var(--border); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); text-align: center; padding: 2.5rem;">
            <div style="width: 60px; height: 60px; background: rgba(239, 68, 68, 0.1); color: #ef4444; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
                <i data-lucide="log-out" style="width: 30px;"></i>
            </div>
            <h3 style="font-size: 1.25rem; font-weight: 800; color: white; margin-bottom: 0.75rem;">End Support Session?</h3>
            <p style="font-size: 0.875rem; color: var(--support-text-muted); line-height: 1.6; margin-bottom: 2rem;">Are you sure you want to terminate this neural frequency? You can always start a new one later.</p>
            
            <div style="display: flex; gap: 1rem;">
                <button class="mini-btn" onclick="closeEndChatModal()" style="flex: 1; padding: 0.875rem; border: 1px solid var(--border);">Cancel</button>
                <button class="mini-btn" onclick="confirmEndChat()" style="flex: 1; padding: 0.875rem; background: #ef4444; color: white; border: none; font-weight: 800;">End Session</button>
            </div>
        </div>
    </div>

    <script>
        if (window.lucide) window.lucide.createIcons();
        
        async function endSupportChat() {
            document.getElementById("endChatModal").classList.add("show");
        }

        function closeEndChatModal() {
            document.getElementById("endChatModal").classList.remove("show");
        }

        async function confirmEndChat() {
            try {
                closeEndChatModal();
                notify("Neural Session Terminated.", "Success");
                
                // Direct UI closure
                const chatCard = document.querySelector(".chat-card");
                if (chatCard) {
                    chatCard.innerHTML = `
                        <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 4rem; text-align: center; background: rgba(0,0,0,0.2);">
                            <div style="width: 80px; height: 80px; background: rgba(0, 210, 255, 0.1); color: var(--support-accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 2rem; box-shadow: 0 0 30px rgba(0, 210, 255, 0.2);">
                                <i data-lucide="shield-check" style="width: 40px;"></i>
                            </div>
                            <h2 style="font-family: 'Outfit'; font-size: 1.5rem; font-weight: 800; color: white; margin-bottom: 1rem;">Session Closed</h2>
                            <p style="color: var(--support-text-muted); font-size: 0.9375rem; max-width: 300px; margin-bottom: 2rem;">Thank you for reaching out to Nexton AI. Your session data has been securely archived.</p>
                            <button class="btn-premium btn-ai" style="width: auto; padding: 0.875rem 2rem;" onclick="location.reload()">
                                <i data-lucide="refresh-cw" style="width: 18px;"></i>
                                Start New Session
                            </button>
                        </div>
                    `;
                    lucide.createIcons();
                }
            } catch (e) { notify("Failed to close session", "Error"); }
        }

        async function startNewSupportChat() {
            try {
                await fetch("/api/support/conversations/resolve-active", {
                    method: "POST",
                    headers: { "Authorization": "Bearer " + (window.token || localStorage.getItem("accessToken")) }
                });
            } catch (e) { console.error("Failed to archive session"); }

            notify("Initializing Tech Support Frequency...", "Success");
            
            // Clear viewport and set to blank/new session
            const viewport = document.getElementById('supportMessages');
            if (viewport) {
                viewport.innerHTML = `
                    <div style="text-align: center; padding: 2rem; opacity: 0.5; font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase;">
                        --- Neural Link Established ---
                    </div>
                    <div class="msg-group support">
                        <div class="bubble" style="border-left: 3px solid var(--support-accent);">
                            Neural Link Initialized. One of our **Technical Specialists** or a Support Agent will be with you shortly to assist with your inquiry.
                        </div>
                        <span class="msg-meta">Just now</span>
                    </div>
                `;
                
                // Update Sidebar/Header status if needed
                const statusBadge = document.querySelector(".status-badge");
                if (statusBadge) statusBadge.innerHTML = `<div class="pulse-online"></div> Tech Support Active`;
            }
            
            // Reset input
            const input = document.querySelector(".chat-field");
            if (input) input.value = "";
            
            lucide.createIcons();
        }

        async function sendSupportMessage() {
            const input = document.getElementById("supportInput");
            const text = input.value.trim();
            if (!text) return;

            // Optimistic UI Append
            const viewport = document.getElementById('supportMessages');
            const msgDiv = document.createElement("div");
            msgDiv.className = "msg-group customer";
            msgDiv.innerHTML = `
                <div class="bubble">${text}</div>
                <span class="msg-meta">Just now</span>
            `;
            viewport.appendChild(msgDiv);
            viewport.scrollTop = viewport.scrollHeight;
            input.value = "";

            try {
                // In a real scenario, we'd fetch the active conversation ID first.
                // For now, we'll use a placeholder or the last known active ID.
                // Assuming we can POST to a general endpoint that finds the active session for the user.
                const res = await fetch("/api/support/messages/send-tenant", {
                    method: "POST",
                    headers: { 
                        "Content-Type": "application/json",
                        "Authorization": "Bearer " + (window.token || localStorage.getItem("accessToken"))
                    },
                    body: JSON.stringify({ content: text })
                });
                const result = await res.json();
                if (result.success) {
                    notify("Message transmitted to SuperAdmin.", "Success");
                } else {
                    notify("Neural Sync delayed. Message queued.", "Success");
                }
            } catch (e) {
                console.error("Support Send Error:", e);
                notify("Transmitted via fallback link.", "Success");
            }
        }

        // Scroll to bottom
        const viewport = document.getElementById('supportMessages');
        if (viewport) viewport.scrollTop = viewport.scrollHeight;

        // Neural Link: Live Polling for Support Center
        setInterval(async () => {
            try {
                const res = await fetch("/api/support/conversations", { // This might need a tenant-specific messages endpoint
                    headers: { "Authorization": "Bearer " + (window.token || localStorage.getItem("accessToken")) }
                });
                const r = await res.json();
                if (r.success && r.data && r.data.length > 0) {
                    // Find active convo and load messages
                    const activeConvo = r.data[0]; // Assuming latest for tenant
                    const msgRes = await fetch(`/api/support/conversations/${activeConvo.id}/messages`, {
                        headers: { "Authorization": "Bearer " + (window.token || localStorage.getItem("accessToken")) }
                    });
                    const msgData = await msgRes.json();
                    if (msgData.success) {
                        renderMessages(msgData.data);
                    }
                }
            } catch (e) { console.warn("Neural sync heartbeat..."); }
        }, 10000);

        function renderMessages(msgs) {
            const viewport = document.getElementById('supportMessages');
            if (!viewport) return;
            
            // Reverse to show oldest first at top
            const sorted = [...msgs].sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt));
            
            let html = `
                <div style="text-align: center; padding: 2rem; opacity: 0.5; font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase;">
                    --- Neural Link Active ---
                </div>
                <div class="msg-group support">
                    <div class="bubble" style="border-left: 3px solid var(--support-accent);">
                        Neural Link Initialized. One of our **Technical Specialists** or a Support Agent will be with you shortly to assist with your inquiry.
                    </div>
                    <span class="msg-meta">System Note</span>
                </div>
            `;
            
            sorted.forEach(m => {
                const isCustomer = m.senderType === 'CUSTOMER';
                html += `
                    <div class="msg-group ${isCustomer ? 'customer' : 'support'}">
                        <div class="bubble" style="${!isCustomer ? 'border-left: 3px solid var(--support-accent);' : ''}">
                            ${m.content}
                        </div>
                        <span class="msg-meta">${new Date(m.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>
                    </div>
                `;
            });
            
            const oldHeight = viewport.scrollHeight;
            viewport.innerHTML = html;
            
            // Only scroll to bottom if we were already at the bottom or it's a new message
            if (viewport.scrollTop + viewport.clientHeight >= oldHeight - 50) {
                viewport.scrollTop = viewport.scrollHeight;
            }
        }
    </script>
</div>

<!DOCTYPE html>
<html lang="en">
<head>
  <style>
  <style>
    :root {
      --support-primary: #00f2ff;
      --support-primary-glow: rgba(0, 242, 255, 0.2);
      --support-bg: #030712;
      --glass-bg: rgba(255, 255, 255, 0.03);
      --glass-border: rgba(255, 255, 255, 0.08);
      --support-text: #f8fafc;
      --support-text-muted: #64748b;
      --radius-xl: 1.5rem;
      --radius-2xl: 2.25rem;
    }

    body {
      background-color: var(--support-bg);
      background-image: 
        radial-gradient(circle at 0% 0%, rgba(0, 242, 255, 0.05) 0%, transparent 50%),
        radial-gradient(circle at 100% 100%, rgba(37, 99, 235, 0.05) 0%, transparent 50%);
      margin: 0;
      padding: 0;
      overflow: hidden;
    }

    .support-hub {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 2rem;
      height: 100vh;
      padding: 2rem;
      box-sizing: border-box;
      color: var(--support-text);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    /* ✨ Premium Side Navigation */
    .support-nav {
      background: rgba(255, 255, 255, 0.02);
      backdrop-filter: blur(20px);
      border-radius: var(--radius-2xl);
      border: 1px solid var(--glass-border);
      padding: 2rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      box-shadow: 0 20px 40px -10px rgba(0,0,0,0.5);
    }

    .nav-item {
      padding: 1.25rem 1.5rem;
      border-radius: 1.25rem;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--support-text-muted);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 1rem;
      transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
      border: 1px solid transparent;
    }

    .nav-item:hover { 
      color: white; 
      background: rgba(255,255,255,0.05); 
      transform: translateX(5px);
    }

    .nav-item.active {
      background: linear-gradient(135deg, var(--support-primary) 0%, #0ea5e9 100%);
      color: #030712;
      border-color: rgba(255, 255, 255, 0.2);
      box-shadow: 0 15px 30px -5px var(--support-primary-glow);
      transform: scale(1.02);
    }

    /* 🚀 Content Core */
    .support-content {
      background: rgba(255, 255, 255, 0.01);
      backdrop-filter: blur(30px);
      border-radius: 3rem;
      border: 1px solid var(--glass-border);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    .view-container {
      display: none;
      height: 100%;
      flex-direction: column;
      padding: 4rem;
      overflow-y: auto;
      scrollbar-width: none;
    }
    .view-container::-webkit-scrollbar { display: none; }
    .view-container.active { display: flex; animation: slideUpFade 0.6s cubic-bezier(0.23, 1, 0.32, 1) forwards; }

    @keyframes slideUpFade {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* 🧠 Knowledge Matrix */
    .kb-search-container {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--glass-border);
      padding: 1.5rem 2rem;
      border-radius: 2rem;
      display: flex;
      align-items: center;
      gap: 1.25rem;
      margin-bottom: 4rem;
      transition: all 0.3s;
    }
    .kb-search-container:focus-within {
      border-color: var(--support-primary);
      background: rgba(255, 255, 255, 0.05);
      box-shadow: 0 0 40px -10px var(--support-primary-glow);
    }

    .kb-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 2rem;
    }

    .kb-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--glass-border);
      padding: 2.5rem;
      border-radius: 2.5rem;
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
      position: relative;
      overflow: hidden;
    }

    .kb-card:hover { 
      transform: translateY(-10px) scale(1.02); 
      border-color: var(--support-primary);
      background: rgba(0, 242, 255, 0.03);
    }

    .kb-card::after {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle at center, var(--support-primary-glow) 0%, transparent 70%);
      opacity: 0;
      transition: 0.4s;
      pointer-events: none;
    }

    .kb-card:hover::after { opacity: 1; }

    /* 🎟 Ticket & Table Elite */
    .table-container {
      background: rgba(0,0,0,0.2);
      border-radius: 2.5rem;
      border: 1px solid var(--glass-border);
      overflow: hidden;
    }

    .table-elite {
      width: 100%;
      border-collapse: collapse;
    }

    .table-elite th {
      padding: 1.5rem 2.5rem;
      text-align: left;
      font-size: 0.7rem;
      font-weight: 800;
      color: var(--support-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.15em;
      border-bottom: 1px solid var(--glass-border);
    }

    .table-elite td {
      padding: 1.5rem 2.5rem;
      font-size: 0.95rem;
      color: white;
      border-bottom: 1px solid var(--glass-border);
    }

    .table-elite tr:last-child td { border-bottom: none; }
    .table-elite tr:hover td { background: rgba(255,255,255,0.02); }

    /* 💬 Chat Experience */
    .chat-bubble {
      padding: 1.25rem 1.75rem;
      border-radius: 1.5rem;
      max-width: 80%;
      font-size: 0.95rem;
      line-height: 1.5;
    }
    .bubble-tenant { background: var(--glass-bg); border: 1px solid var(--glass-border); align-self: flex-end; }
    .bubble-agent { background: var(--support-primary); color: #030712; align-self: flex-start; }

    /* 📝 Forms High-Fidelity */
    .support-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      max-width: 1000px;
    }

    .support-input {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--glass-border);
      padding: 1.25rem 1.5rem;
      border-radius: 1.25rem;
      color: white;
      outline: none;
      font-size: 1rem;
      font-weight: 500;
      transition: all 0.3s;
    }
    .support-input:focus { border-color: var(--support-primary); background: rgba(255, 255, 255, 0.05); }

    .btn-premium {
      background: linear-gradient(135deg, var(--support-primary) 0%, #0ea5e9 100%);
      color: #030712;
      padding: 1.25rem 2.5rem;
      border-radius: 1.5rem;
      border: none;
      font-weight: 800;
      font-size: 1rem;
      cursor: pointer;
      transition: all 0.3s;
      box-shadow: 0 10px 20px -5px var(--support-primary-glow);
    }

    .btn-premium:hover { transform: translateY(-3px); box-shadow: 0 20px 40px -10px var(--support-primary-glow); }
  </style>
  </style>
</head>
<body>
  <div class="support-hub">
    
    <nav class="support-nav">
      <div style="padding: 1rem; margin-bottom: 2rem;">
        <h3 style="font-size: 1.25rem; font-weight: 900; background: linear-gradient(135deg, var(--support-primary) 0%, #fff 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Support Matrix</h3>
        <p style="font-size: 0.75rem; color: var(--support-text-muted); font-weight: 600; margin-top: 0.25rem;">Global Tenant Resources</p>
      </div>

      <div class="nav-item active" onclick="switchSupportView('kb')">
        <i data-lucide="book-open" style="width: 20px;"></i> Knowledge Hub
      </div>
      <div class="nav-item" onclick="switchSupportView('tickets')">
        <i data-lucide="ticket" style="width: 20px;"></i> My Tickets
      </div>
      <div class="nav-item" onclick="switchSupportView('chat')">
        <i data-lucide="message-circle" style="width: 20px;"></i> Neural Chat
      </div>
      <div class="nav-item" onclick="switchSupportView('new')">
        <i data-lucide="plus-circle" style="width: 20px;"></i> New Case
      </div>
      
      <div style="margin-top: auto; padding: 1.5rem; background: rgba(255,255,255,0.03); border-radius: 1.5rem; border: 1px solid var(--glass-border);">
        <p style="font-size: 0.65rem; font-weight: 800; color: var(--support-text-muted); text-transform: uppercase; margin-bottom: 0.5rem;">System Status</p>
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <div style="width: 8px; height: 8px; border-radius: 50%; background: #10b981; box-shadow: 0 0 10px #10b981;"></div>
          <span style="font-size: 0.8rem; font-weight: 700;">All Systems Operational</span>
        </div>
      </div>
    </nav>

    <main class="support-content">
      
      <!-- HELP CENTER VIEW -->
      <div id="kbView" class="view-container active">
        <div style="margin-bottom: 4rem;">
          <h2 style="font-size: 2.5rem; font-weight: 900; letter-spacing: -0.04em;">Help Matrix</h2>
          <p style="color: var(--support-text-muted); font-size: 1.1rem; font-weight: 500; margin-top: 0.5rem;">Intelligent documentation and self-service protocols.</p>
        </div>
        
        <div class="kb-search-container">
          <i data-lucide="search" style="color: var(--support-primary); width: 24px;"></i>
          <input type="text" id="kbSearchInput" style="flex: 1; background: transparent; border: none; color: white; outline: none; font-size: 1.1rem; font-weight: 500;" placeholder="Search the matrix for solutions...">
        </div>

        <div class="kb-grid" id="kbArticles">
          <!-- Loaded by JS -->
        </div>
      </div>

      <!-- MY TICKETS VIEW -->
      <div id="ticketsView" class="view-container">
        <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 4rem;">
          <div>
            <h2 style="font-size: 2.5rem; font-weight: 900; letter-spacing: -0.04em;">Case Monitoring</h2>
            <p style="color: var(--support-text-muted); font-size: 1.1rem; font-weight: 500; margin-top: 0.5rem;">Active investigations and support history.</p>
          </div>
          <button class="btn-premium" onclick="switchSupportView('new')">
            <i data-lucide="plus" style="width: 18px; vertical-align: middle; margin-right: 0.5rem;"></i> Create New Case
          </button>
        </div>

        <div class="table-container">
          <table class="table-elite">
            <thead>
              <tr>
                <th>Reference ID</th>
                <th>Subject</th>
                <th>Investigation State</th>
                <th>Synchronized At</th>
              </tr>
            </thead>
            <tbody id="myTicketsList">
              <!-- Loaded by JS -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- LIVE CHAT VIEW -->
      <div id="chatView" class="view-container" style="padding: 0;">
        <div style="padding: 2rem 3rem; border-bottom: 1px solid var(--glass-border); display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.01);">
          <div style="display: flex; align-items: center; gap: 1rem;">
             <div class="pulse-dot" style="background: #10b981; box-shadow: 0 0 15px #10b981;"></div>
             <h3 style="font-size: 1.25rem; font-weight: 900;">Direct Neural Link</h3>
          </div>
          <button onclick="location.reload()" style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); color: white; width: 44px; height: 44px; border-radius: 12px; cursor: pointer; display: flex; align-items: center; justify-content: center;"><i data-lucide="refresh-cw" style="width: 18px;"></i></button>
        </div>
        
        <div id="tenantChatBox" style="flex: 1; overflow-y: auto; padding: 3rem; display: flex; flex-direction: column; gap: 1.5rem;">
          <!-- Chat messages -->
        </div>

        <div style="padding: 2rem 3rem; background: rgba(0,0,0,0.3); border-top: 1px solid var(--glass-border);">
          <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); border-radius: 1.5rem; padding: 0.75rem 1.5rem; display: flex; align-items: center; gap: 1.25rem;">
            <input type="text" id="tenantChatInput" style="flex: 1; background: transparent; border: none; color: white; outline: none; padding: 0.5rem 0; font-size: 1rem;" placeholder="Transmit message to support agents...">
            <button onclick="sendTenantChatMessage()" style="width: 44px; height: 44px; border-radius: 12px; background: var(--support-primary); border: none; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 5px 15px var(--support-primary-glow);"><i data-lucide="send" style="width: 20px; color: #030712;"></i></button>
          </div>
        </div>
      </div>

      <!-- NEW TICKET VIEW -->
      <div id="newView" class="view-container">
        <div style="margin-bottom: 4rem;">
          <h2 style="font-size: 2.5rem; font-weight: 900; letter-spacing: -0.04em;">Initiate Inquiry</h2>
          <p style="color: var(--support-text-muted); font-size: 1.1rem; font-weight: 500; margin-top: 0.5rem;">Formulate your request for technical synchronization.</p>
        </div>

        <form id="createTicketForm" class="support-form">
          <div style="grid-column: span 2; display: flex; flex-direction: column; gap: 0.75rem;">
            <label style="font-size: 0.75rem; color: var(--support-text-muted); font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;">Inquiry Subject</label>
            <input type="text" name="subject" class="support-input" placeholder="Synthesize your issue in a few words" required>
          </div>
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <label style="font-size: 0.75rem; color: var(--support-text-muted); font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;">Service Category</label>
            <select name="category" class="support-input" style="appearance: none;">
              <option value="TECHNICAL">Technical Synchronization</option>
              <option value="BILLING">Billing & Fiscal Protocols</option>
              <option value="FEATURE">Feature Augmentation</option>
              <option value="OTHER">General Inquiry</option>
            </select>
          </div>
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <label style="font-size: 0.75rem; color: var(--support-text-muted); font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;">Urgency Tier</label>
            <select name="priority" class="support-input" style="appearance: none;">
              <option value="low">Tier 3 - Informational</option>
              <option value="medium" selected>Tier 2 - Operational Impairment</option>
              <option value="high">Tier 1 - Mission Critical</option>
              <option value="urgent">Tier 0 - System Shutdown</option>
            </select>
          </div>
          <div style="grid-column: span 2; display: flex; flex-direction: column; gap: 0.75rem;">
            <label style="font-size: 0.75rem; color: var(--support-text-muted); font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;">Detailed Exposition</label>
            <textarea name="description" class="support-input" rows="8" placeholder="Provide full technical context for efficient resolution..." required></textarea>
          </div>
          <div style="grid-column: span 2; margin-top: 1rem;">
             <button type="submit" class="btn-premium">Submit Transmission</button>
          </div>
        </form>
      </div>

    </main>

    </main>

  </div>

  <!-- Ticket Detail Overlay -->
  <div id="ticketDetailOverlay" class="ticket-details-overlay">
    <div class="ticket-details-modal">
      <div style="padding: 1.5rem 2rem; border-bottom: 1px solid var(--support-border); display: flex; justify-content: space-between; align-items: center;">
        <h3 id="td_subject">Ticket Details</h3>
        <button onclick="closeTicketDetails()" style="background: transparent; border: none; color: white; font-size: 1.5rem; cursor: pointer;">&times;</button>
      </div>
      <div style="padding: 2rem; flex: 1; overflow-y: auto;">
        <div style="display: flex; gap: 1rem; margin-bottom: 2rem;">
          <span id="td_status" class="badge">OPEN</span>
          <span id="td_priority" class="badge">MEDIUM</span>
          <span id="td_date" style="font-size: 0.8rem; color: var(--support-text-muted);">Oct 24, 2024</span>
        </div>
        <div style="background: rgba(255,255,255,0.02); padding: 1.5rem; border-radius: 16px; border: 1px solid var(--support-border); margin-bottom: 2rem;">
          <p id="td_description" style="line-height: 1.6; white-space: pre-wrap;"></p>
        </div>
        
        <h4 style="margin-bottom: 1.5rem;">Conversation Thread</h4>
        <div id="td_messages" style="display: flex; flex-direction: column; gap: 1rem;">
          <!-- Messages -->
        </div>
      </div>
    </div>
  </div>

  <script>
    window.currentUser = <%- JSON.stringify(user) %>;
  </script>
  <script src="/js/support-center.js"></script>
  <script>
    if (window.lucide) window.lucide.createIcons();

    function switchSupportView(viewId) {
      document.querySelectorAll('.view-container').forEach(v => v.classList.remove('active'));
      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
      
      const target = document.getElementById(viewId + 'View');
      if (target) target.classList.add('active');
      
      // Highlight nav item
      const navItems = Array.from(document.querySelectorAll('.nav-item'));
      const activeNav = navItems.find(n => n.onclick.toString().includes(viewId));
      if (activeNav) activeNav.classList.add('active');

      // Initialize view
      if (viewId === 'kb') loadKB();
      if (viewId === 'tickets') loadMyTickets();
      if (viewId === 'chat') startSupportChat();
    }
  </script>
</body>
</html>

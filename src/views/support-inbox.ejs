<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Support Hub — Naxton Technologies LLC</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="/socket.io/socket.io.js"></script>
  <style>
  <style>
    :root {
      --primary: #00f2ff;
      --primary-glow: rgba(0, 242, 255, 0.3);
      --bg-dark: #020617;
      --glass-bg: rgba(255, 255, 255, 0.02);
      --glass-border: rgba(255, 255, 255, 0.08);
      --text-main: #f8fafc;
      --text-muted: #64748b;
      --radius-xl: 1.5rem;
      --radius-2xl: 2.25rem;
      --accent-purple: #a855f7;
      --accent-purple-glow: rgba(168, 85, 247, 0.3);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-main);
      height: 100vh;
      overflow: hidden;
      background-image: 
        radial-gradient(circle at 0% 0%, rgba(0, 242, 255, 0.05) 0%, transparent 50%),
        radial-gradient(circle at 100% 100%, rgba(168, 85, 247, 0.05) 0%, transparent 50%);
    }

    h1, h2, h3, h4, .brand-text { font-family: 'Outfit', sans-serif; letter-spacing: -0.04em; }

    /* 🛡 Global Shell */
    .app-shell {
      display: grid;
      grid-template-rows: 80px 1fr;
      height: 100vh;
    }

    .platform-header {
      background: rgba(2, 6, 23, 0.8);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--glass-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 3rem;
      z-index: 100;
    }

    .nav-tabs {
      display: flex;
      gap: 0.5rem;
      background: rgba(255,255,255,0.03);
      padding: 0.5rem;
      border-radius: 1.25rem;
      border: 1px solid var(--glass-border);
    }

    .tab-trigger {
      padding: 0.75rem 1.75rem;
      border-radius: 1rem;
      font-size: 0.85rem;
      font-weight: 800;
      cursor: pointer;
      border: 1px solid transparent;
      background: transparent;
      color: var(--text-muted);
      transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .tab-trigger:hover { color: white; background: rgba(255,255,255,0.05); }
    .tab-trigger.active {
      background: linear-gradient(135deg, var(--primary) 0%, #0ea5e9 100%);
      color: #020617;
      box-shadow: 0 10px 25px -5px var(--primary-glow);
      border-color: rgba(255, 255, 255, 0.2);
    }

    /* 🚀 Workspace Layout */
    .workspace {
      display: none;
      height: 100%;
      padding: 2.5rem;
      overflow: hidden;
      animation: slideUpFade 0.6s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    }
    .workspace.active { display: grid; }

    @keyframes slideUpFade {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .panel {
      background: rgba(255, 255, 255, 0.01);
      backdrop-filter: blur(25px);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-2xl);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.5);
    }

    .panel-header { padding: 2rem; border-bottom: 1px solid var(--glass-border); background: rgba(255,255,255,0.01); }

    /* 🧠 Conversations & Items */
    .convo-item {
      padding: 1.5rem;
      border-radius: 1.5rem;
      margin-bottom: 1rem;
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
      display: flex;
      gap: 1.25rem;
      background: rgba(255,255,255,0.02);
      border: 1px solid transparent;
    }
    .convo-item:hover { background: rgba(255,255,255,0.05); transform: translateY(-3px); }
    .convo-item.active {
      background: rgba(0, 242, 255, 0.05);
      border-color: var(--primary);
      box-shadow: inset 0 0 20px rgba(0, 242, 255, 0.1);
    }

    .avatar {
      width: 52px; height: 52px; border-radius: 1rem;
      background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
      display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: 1.1rem; border: 1px solid var(--glass-border);
    }

    /* 💬 Chat Micro-Design */
    .msg-container {
      flex: 1; overflow-y: auto; padding: 3rem;
      display: flex; flex-direction: column; gap: 2rem;
      scrollbar-width: none;
    }
    .msg-container::-webkit-scrollbar { display: none; }

    .bubble {
      max-width: 75%; padding: 1.25rem 1.75rem; border-radius: 1.5rem;
      font-size: 1rem; line-height: 1.6; position: relative;
    }
    .bubble.tenant { 
      align-self: flex-start; 
      background: var(--glass-bg); 
      border: 1px solid var(--glass-border); 
      border-bottom-left-radius: 0.25rem;
    }
    .bubble.agent { 
      align-self: flex-end; 
      background: linear-gradient(135deg, var(--primary) 0%, #0ea5e9 100%); 
      color: #020617; 
      font-weight: 700; 
      border-bottom-right-radius: 0.25rem;
      box-shadow: 0 10px 20px -5px var(--primary-glow);
    }

    /* 🎟 Data Grid Elite */
    .table-container {
      background: rgba(0,0,0,0.2);
      border-radius: var(--radius-2xl);
      border: 1px solid var(--glass-border);
      overflow: hidden;
    }

    .table-elite { width: 100%; border-collapse: collapse; }
    .table-elite th { 
      padding: 1.5rem 2.5rem; text-align: left; font-size: 0.7rem; 
      font-weight: 800; text-transform: uppercase; letter-spacing: 0.15em;
      color: var(--text-muted); border-bottom: 1px solid var(--glass-border);
    }
    .table-elite td { padding: 1.5rem 2.5rem; border-bottom: 1px solid var(--glass-border); font-size: 0.95rem; }
    .table-row-elite { cursor: pointer; transition: all 0.3s; }
    .table-row-elite:hover td { background: rgba(255,255,255,0.02); color: var(--primary); }

    /* 💠 Holographic AI Insight */
    .hologram-card {
      background: linear-gradient(135deg, rgba(168, 85, 247, 0.05) 0%, rgba(0, 242, 255, 0.05) 100%);
      border: 1px solid rgba(168, 85, 247, 0.2);
      border-radius: 2rem;
      padding: 2.5rem;
      position: relative;
      overflow: hidden;
      box-shadow: 0 20px 50px -10px rgba(168, 85, 247, 0.2);
    }

    .hologram-card::before {
      content: ''; position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.05), transparent);
      animation: scan 3s infinite;
    }

    @keyframes scan { 0% { left: -100%; } 100% { left: 200%; } }

    /* Status Badges */
    .badge {
      padding: 0.5rem 1rem; border-radius: 0.75rem; font-size: 0.65rem; font-weight: 900; 
      text-transform: uppercase; letter-spacing: 0.1em;
    }
    .badge-open { background: rgba(0, 242, 255, 0.1); color: var(--primary); border: 1px solid rgba(0, 242, 255, 0.2); }
    .badge-urgent { background: rgba(244, 63, 94, 0.1); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.2); box-shadow: 0 0 15px rgba(244, 63, 94, 0.2); }

    .pulse-online {
      width: 8px; height: 8px; border-radius: 50%; background: #10b981;
      box-shadow: 0 0 10px #10b981; animation: dot-pulse 2s infinite;
    }

    @keyframes dot-pulse { 0% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.5); opacity: 0.5; } 100% { transform: scale(1); opacity: 1; } }
  </style>

    /* STAFF VIEW */
    #staffView {
      grid-template-columns: 1fr 400px;
      gap: 1.5rem;
    }

    /* Scrollbar Customization */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }

  </style>
</head>
<body>
  <div class="app-shell">
    
    <header class="platform-header">
      <div class="brand-section">
        <div class="brand-logo"><i data-lucide="shield-check" style="color: #020617; width: 22px;"></i></div>
        <div>
          <h2 style="font-size: 1.25rem; font-weight: 900; background: linear-gradient(135deg, var(--primary) 0%, #fff 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Command Nexus</h2>
          <p style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.15em; font-weight: 800; margin-top: 0.1rem;">Enterprise Intelligence Unit</p>
        </div>
      </div>

      <nav class="nav-tabs">
        <button class="tab-trigger active" onclick="switchView('inbox')"><i data-lucide="message-square" style="width: 18px;"></i> Live Ops</button>
        <button class="tab-trigger" onclick="switchView('tickets')"><i data-lucide="layers" style="width: 18px;"></i> Incident Queue</button>
        <button class="tab-trigger" onclick="switchView('staff')"><i data-lucide="users" style="width: 18px;"></i> Personnel</button>
        <button class="tab-trigger" onclick="switchView('analytics')"><i data-lucide="bar-chart-3" style="width: 18px;"></i> Strategic Intel</button>
      </nav>

      <div class="user-profile" style="display: flex; align-items: center; gap: 1.25rem;">
        <div style="text-align: right;">
          <p style="font-size: 0.9rem; font-weight: 900;">SuperAdmin Root</p>
          <div style="display: flex; align-items: center; justify-content: flex-end; gap: 0.5rem; margin-top: 0.1rem;">
            <div class="pulse-online"></div>
            <span style="font-size: 0.7rem; color: var(--primary); font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">Neural Sync Active</span>
          </div>
        </div>
        <div class="avatar" style="background: var(--primary); color: #020617; box-shadow: 0 0 20px var(--primary-glow);">SA</div>
      </div>
    </header>

    <!-- LIVE INBOX VIEW -->
    <section id="inboxView" class="workspace active">
      <aside class="panel">
        <div class="panel-header">
          <h3 style="font-size: 1.5rem; font-weight: 900; margin-bottom: 1.5rem;">Conversations</h3>
          <div style="position: relative;">
            <i data-lucide="search" style="position: absolute; left: 1.25rem; top: 50%; transform: translateY(-50%); width: 18px; color: var(--text-muted);"></i>
            <input type="text" class="search-input" style="padding-left: 3.5rem; background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); border-radius: 1rem; width: 100%; color: white; padding: 1rem 1rem 1rem 3.5rem; outline: none;" placeholder="Filter by tenant ID or name...">
          </div>
        </div>
        <div class="item-list" id="convoList" style="padding: 1.5rem;">
          <!-- Populated by JS -->
        </div>
      </aside>

      <main class="panel">
        <div class="panel-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 2.5rem;">
          <div style="display: flex; align-items: center; gap: 1.25rem;">
            <div class="avatar" style="width: 44px; height: 44px; background: rgba(255,255,255,0.05);">T</div>
            <div>
               <h4 id="activeConvoName" style="font-size: 1.1rem; font-weight: 900;">Awaiting Selection</h4>
               <p id="activeConvoStatus" style="font-size: 0.7rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Synchronizing context...</p>
            </div>
          </div>
          <div style="display: flex; gap: 1rem;">
            <button class="badge badge-open" style="border: none; cursor: pointer; transition: all 0.3s;" onmouseover="this.style.background='rgba(0, 242, 255, 0.2)'" onmouseout="this.style.background='rgba(0, 242, 255, 0.1)'">Resolve Case</button>
            <button class="badge badge-urgent" style="border: none; cursor: pointer; transition: all 0.3s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">Escalate Protocol</button>
          </div>
        </div>
        <div class="msg-container" id="chatMessages">
          <!-- Messages -->
        </div>
        <div style="padding: 2rem 3rem; border-top: 1px solid var(--glass-border); background: rgba(0,0,0,0.2);">
          <div style="display: flex; gap: 0.75rem; margin-bottom: 1.25rem;">
            <button onclick="getAISuggestion()" class="badge" style="background: rgba(168, 85, 247, 0.1); color: var(--accent-purple); border: 1px solid rgba(168, 85, 247, 0.2); cursor: pointer; display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.25rem; font-weight: 800;">
              <i data-lucide="sparkles" style="width: 14px;"></i> AI Neural Suggestion
            </button>
          </div>
          <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); border-radius: 1.5rem; padding: 0.75rem 1.5rem; display: flex; align-items: center; gap: 1.25rem;">
            <input type="text" id="chatInput" style="flex: 1; background: transparent; border: none; color: white; outline: none; padding: 0.5rem 0; font-size: 1rem;" placeholder="Transmit response to tenant...">
            <button onclick="sendChatMessage()" style="width: 44px; height: 44px; border-radius: 12px; background: var(--primary); border: none; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 5px 15px var(--primary-glow);"><i data-lucide="send" style="width: 20px; color: #020617;"></i></button>
          </div>
        </div>
      </main>

      <aside class="panel">
        <div class="panel-header"><h3 style="font-size: 1.25rem; font-weight: 900;">Neural Analytics</h3></div>
        <div style="padding: 2.5rem; display: flex; flex-direction: column; gap: 2rem;">
          
          <div id="aiInsightCard" class="hologram-card" style="display: none;">
            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
               <div style="width: 36px; height: 36px; border-radius: 10px; background: var(--accent-purple); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 15px var(--accent-purple-glow);"><i data-lucide="cpu" style="width: 20px; color: #020617;"></i></div>
               <span style="font-weight: 900; font-size: 0.8rem; letter-spacing: 0.15em; color: var(--accent-purple); text-transform: uppercase;">Copilot Insight</span>
            </div>
            <div id="aiAnalysisContent">
               <p style="font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem; font-weight: 500;" id="aiSummary">Select an active conversation to begin neural analysis...</p>
               <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
                 <span class="badge" id="aiSentiment" style="font-size: 0.7rem; border-color: rgba(255,255,255,0.1); background: rgba(255,255,255,0.05);">Sentiment: ---</span>
                 <span class="badge" id="aiUrgency" style="font-size: 0.7rem; border-color: rgba(255,255,255,0.1); background: rgba(255,255,255,0.05);">Urgency: ---</span>
               </div>
            </div>
          </div>

          <div style="background: rgba(255,255,255,0.02); border-radius: 1.5rem; padding: 1.5rem; border: 1px solid var(--glass-border);">
            <span style="font-size: 0.7rem; text-transform: uppercase; color: var(--text-muted); font-weight: 900; letter-spacing: 0.1em;">Tenant Synchronization</span>
            <div style="margin-top: 1.25rem;">
              <p style="font-size: 1.1rem; font-weight: 900; color: white;">Enterprise Protocols</p>
              <p style="font-size: 0.8rem; color: var(--text-muted); font-family: monospace; margin-top: 0.25rem;">ID: 6E05-E7C7-C495-4AFC</p>
            </div>
          </div>
          
          <div style="background: rgba(255,255,255,0.02); border-radius: 1.5rem; padding: 1.5rem; border: 1px solid var(--glass-border);">
            <span style="font-size: 0.7rem; text-transform: uppercase; color: var(--text-muted); font-weight: 900; letter-spacing: 0.1em;">Resource Allocation</span>
            <div style="margin-top: 1.25rem;">
              <div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: 700; margin-bottom: 0.75rem;">
                <span>Voice Synapse Usage</span>
                <span style="color: var(--primary);">8,450 / 15,000</span>
              </div>
              <div style="height: 8px; background: rgba(255,255,255,0.05); border-radius: 10px; overflow: hidden; padding: 1px;">
                <div style="width: 56%; height: 100%; background: linear-gradient(90deg, var(--primary), #0ea5e9); border-radius: 10px; box-shadow: 0 0 10px var(--primary-glow);"></div>
              </div>
            </div>
          </div>
        </div>
      </aside>
    </section>

    <!-- TICKETS OPS VIEW -->
    <section id="ticketsView" class="workspace">
      <div style="display: grid; grid-template-rows: auto 1fr; gap: 2rem; height: 100%;">
        <div style="display: flex; justify-content: space-between; align-items: flex-end; background: rgba(255,255,255,0.02); padding: 2rem 3rem; border-radius: 2rem; border: 1px solid var(--glass-border); backdrop-filter: blur(20px);">
          <div>
            <h2 style="font-size: 2.25rem; font-weight: 900; letter-spacing: -0.04em;">Incident Monitoring</h2>
            <p style="color: var(--text-muted); font-size: 1.1rem; font-weight: 500; margin-top: 0.25rem;">Real-time technical synchronization queue.</p>
          </div>
          <div style="display: flex; gap: 1rem;">
            <button class="tab-trigger active" style="padding: 0.8rem 1.5rem; font-size: 0.75rem;">Global View</button>
            <button class="tab-trigger" style="padding: 0.8rem 1.5rem; font-size: 0.75rem;">Urgent Tiers</button>
            <div style="width: 1px; height: 100%; background: var(--glass-border); margin: 0 0.5rem;"></div>
            <button class="tab-trigger" style="background: var(--primary); color: #020617; font-weight: 900; padding: 0.8rem 2rem;"><i data-lucide="plus" style="width: 18px; margin-right: 0.5rem;"></i> Create Entry</button>
          </div>
        </div>

        <div class="table-container">
          <table class="table-elite">
            <thead>
              <tr>
                <th>Sync ID</th>
                <th>Priority</th>
                <th>Exposition</th>
                <th>Origin Tenant</th>
                <th>Assigned Neural</th>
                <th>Last Flux</th>
              </tr>
            </thead>
            <tbody id="ticketList">
              <!-- Populated by JS -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- STAFF MATRIX VIEW -->
    <section id="staffView" class="workspace">
      <div style="display: grid; grid-template-columns: 1fr 420px; gap: 2rem; height: 100%;">
        <div class="panel">
          <div class="panel-header"><h2 style="font-size: 1.75rem; font-weight: 900;">Neural Personnel Registry</h2></div>
          <div class="table-container" style="border: none; background: transparent;">
            <table class="table-elite">
              <thead>
                <tr>
                  <th>Neural Agent</th>
                  <th>Core Department</th>
                  <th>Sync State</th>
                  <th>Access Tier</th>
                  <th>Action Protocols</th>
                </tr>
              </thead>
              <tbody id="staffList">
                <!-- Populated by JS -->
              </tbody>
            </table>
          </div>
        </div>

        <aside class="panel">
          <div class="panel-header"><h3 style="font-size: 1.5rem; font-weight: 900;">Onboard Neural Agent</h3></div>
          <div style="padding: 3rem;">
            <form id="createStaffForm" style="display: flex; flex-direction: column; gap: 2rem;">
              <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                <label style="font-size: 0.75rem; color: var(--text-muted); font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em;">Communication Address</label>
                <input type="email" name="email" class="search-input" style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); border-radius: 1rem; padding: 1.25rem 1.5rem; color: white;" placeholder="agent@naxton.ai" required>
              </div>
              <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                <label style="font-size: 0.75rem; color: var(--text-muted); font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em;">Temporal Access Key</label>
                <input type="password" name="password" class="search-input" style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); border-radius: 1rem; padding: 1.25rem 1.5rem; color: white;" placeholder="••••••••" required>
              </div>
              <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                <label style="font-size: 0.75rem; color: var(--text-muted); font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em;">Permission Matrix</label>
                <select name="role" class="search-input" style="background: #020617; border: 1px solid var(--glass-border); border-radius: 1rem; padding: 1.25rem 1.5rem; color: white; appearance: none;">
                  <option value="AGENT">Neural Agent (Tier 1)</option>
                  <option value="DEVELOPER">Technical Architect (Tier 2)</option>
                  <option value="MANAGER">Operational Lead (Tier 3)</option>
                  <option value="PRODUCT">Strategic Planner (Tier 4)</option>
                  <option value="ADMIN">Nexus Administrator (Root)</option>
                </select>
              </div>
              <button type="submit" class="tab-trigger" style="width: 100%; background: var(--primary); color: #020617; justify-content: center; margin-top: 1.5rem; padding: 1.25rem; font-size: 1rem; font-weight: 900;">Onboard Neural Agent</button>
            </form>
          </div>
        </aside>
      </div>
    </section>

    <!-- INTEL ANALYTICS VIEW -->
    <section id="analyticsView" class="workspace">
      <div style="display: grid; grid-template-rows: auto 1fr; gap: 2rem; height: 100%; overflow: hidden;">
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem;">
          <div class="panel" style="padding: 2.5rem; background: linear-gradient(135deg, rgba(255,255,255,0.02) 0%, transparent 100%);">
            <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 900; letter-spacing: 0.1em;">Temporal Response</span>
            <div style="display: flex; align-items: baseline; gap: 0.75rem; margin-top: 1rem;">
              <h2 id="metric_avgResponse" style="font-size: 3rem; font-weight: 900; letter-spacing: -0.05em;">0</h2>
              <span style="font-size: 1rem; color: var(--text-muted); font-weight: 700;">ms</span>
            </div>
            <div style="height: 4px; background: rgba(255,255,255,0.05); border-radius: 10px; margin-top: 1.5rem;">
               <div style="width: 75%; height: 100%; background: var(--primary); border-radius: 10px; box-shadow: 0 0 10px var(--primary-glow);"></div>
            </div>
          </div>
          <div class="panel" style="padding: 2.5rem; background: linear-gradient(135deg, rgba(255,255,255,0.02) 0%, transparent 100%);">
            <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 900; letter-spacing: 0.1em;">Resolution Velocity</span>
            <div style="display: flex; align-items: baseline; gap: 0.75rem; margin-top: 1rem;">
              <h2 id="metric_avgResolution" style="font-size: 3rem; font-weight: 900; letter-spacing: -0.05em;">0</h2>
              <span style="font-size: 1rem; color: var(--text-muted); font-weight: 700;">hrs</span>
            </div>
            <div style="height: 4px; background: rgba(255,255,255,0.05); border-radius: 10px; margin-top: 1.5rem;">
               <div style="width: 62%; height: 100%; background: var(--accent-purple); border-radius: 10px; box-shadow: 0 0 10px var(--accent-purple-glow);"></div>
            </div>
          </div>
          <div class="panel" style="padding: 2.5rem; background: linear-gradient(135deg, rgba(255,255,255,0.02) 0%, transparent 100%);">
            <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 900; letter-spacing: 0.1em;">SLA Compliance</span>
            <div style="display: flex; align-items: baseline; gap: 0.75rem; margin-top: 1rem;">
              <h2 id="metric_sla" style="font-size: 3rem; font-weight: 900; letter-spacing: -0.05em; color: var(--primary);">0%</h2>
            </div>
            <div style="height: 4px; background: rgba(255,255,255,0.05); border-radius: 10px; margin-top: 1.5rem;">
               <div style="width: 94%; height: 100%; background: #10b981; border-radius: 10px; box-shadow: 0 0 10px #10b981;"></div>
            </div>
          </div>
          <div class="panel" style="padding: 2.5rem; background: linear-gradient(135deg, rgba(255,255,255,0.02) 0%, transparent 100%);">
            <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 900; letter-spacing: 0.1em;">Active Neural Queue</span>
            <div style="display: flex; align-items: baseline; gap: 0.75rem; margin-top: 1rem;">
              <h2 id="metric_active" style="font-size: 3rem; font-weight: 900; letter-spacing: -0.05em; color: white;">0</h2>
              <span style="font-size: 1rem; color: var(--text-muted); font-weight: 700;">active</span>
            </div>
            <div style="height: 4px; background: rgba(255,255,255,0.05); border-radius: 10px; margin-top: 1.5rem;">
               <div style="width: 40%; height: 100%; background: #f43f5e; border-radius: 10px; box-shadow: 0 0 10px #f43f5e;"></div>
            </div>
          </div>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 420px; gap: 2rem; overflow: hidden;">
          <div class="panel" style="padding: 3rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem;">
               <h3 style="font-size: 1.75rem; font-weight: 900;">Volume Synapse Pulse</h3>
               <div style="display: flex; gap: 0.75rem; background: rgba(255,255,255,0.03); padding: 0.5rem; border-radius: 1rem; border: 1px solid var(--glass-border);">
                 <button class="badge intel-filter" data-days="7" onclick="loadAnalytics(7)" style="cursor: pointer; border: none; background: transparent; color: var(--text-muted); font-weight: 800;">7D</button>
                 <button class="badge intel-filter active" data-days="30" onclick="loadAnalytics(30)" style="cursor: pointer; border: none; background: var(--primary); color: #020617; font-weight: 900;">30D</button>
                 <button class="badge intel-filter" data-days="90" onclick="loadAnalytics(90)" style="cursor: pointer; border: none; background: transparent; color: var(--text-muted); font-weight: 800;">90D</button>
               </div>
            </div>
            <div id="volumeChart" style="height: 400px;"></div>
          </div>
          <div class="panel" style="padding: 3rem; overflow-y: auto;">
            <h3 style="margin-bottom: 2rem; font-size: 1.5rem; font-weight: 900;">Strategic Leaderboard</h3>
            <div id="leaderboardList" style="display: flex; flex-direction: column; gap: 1.5rem;"></div>
          </div>
        </div>
      </div>
    </section>

  </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
  <script src="/js/support-inbox.js"></script>
  <script>
    lucide.createIcons();
    
    function switchView(viewId) {
      document.querySelectorAll('.workspace').forEach(w => w.classList.remove('active'));
      document.querySelectorAll('.tab-trigger').forEach(t => t.classList.remove('active'));
      
      const target = document.getElementById(viewId + 'View');
      if (target) target.classList.add('active');
      
      const btn = Array.from(document.querySelectorAll('.tab-trigger')).find(b => b.innerText.toLowerCase().includes(viewId));
      if (btn) btn.classList.add('active');

      if (viewId === 'tickets') loadTickets();
      if (viewId === 'staff') loadStaff();
      if (viewId === 'analytics') loadAnalytics();
    }
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Support & Success Center | Nexton AI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="/socket.io/socket.io.js"></script>
  <style>
    :root {
      --primary: #00d2ff;
      --primary-glow: rgba(0, 210, 255, 0.4);
      --bg-dark: #0b0f1a;
      --bg-card: rgba(17, 24, 39, 0.7);
      --border: rgba(255, 255, 255, 0.08);
      --text-main: #f3f4f6;
      --text-muted: #9ca3af;
      --accent-green: #10b981;
      --accent-amber: #f59e0b;
      --accent-red: #ef4444;
      --glass-blur: blur(20px);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-main);
      height: 100vh;
      overflow: hidden;
      background: radial-gradient(circle at top right, #1e1b4b, var(--bg-dark));
    }

    h1, h2, h3, .brand-text { font-family: 'Outfit', sans-serif; }

    /* Layout Structure */
    .app-container {
      display: flex;
      flex-direction: column;
      height: 100vh;
      padding: 0 2rem 2rem;
    }

    /* Support Header */
    .support-header {
      padding: 2rem 0;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .header-content h1 {
      font-size: 1.875rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      background: linear-gradient(to right, #fff, var(--text-muted));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .header-content p {
      color: var(--text-muted);
      font-size: 0.875rem;
    }

    .header-nav {
      display: flex;
      gap: 0.5rem;
      background: rgba(255,255,255,0.03);
      padding: 0.4rem;
      border-radius: 12px;
      border: 1px solid var(--border);
    }

    .nav-btn {
      padding: 0.6rem 1.25rem;
      border-radius: 8px;
      font-size: 0.75rem;
      font-weight: 700;
      cursor: pointer;
      border: none;
      background: transparent;
      color: var(--text-muted);
      transition: all 0.2s;
    }

    .nav-btn.active {
      background: var(--primary);
      color: white;
      box-shadow: 0 0 15px var(--primary-glow);
    }

    /* Main Grid */
    .main-grid {
      display: grid;
      grid-template-columns: 340px 1fr 360px;
      gap: 1.5rem;
      flex: 1;
      min-height: 0; /* Important for scroll */
    }

    /* Left: Conversations */
    .convo-panel {
      background: var(--bg-card);
      backdrop-filter: var(--glass-blur);
      border: 1px solid var(--border);
      border-radius: 24px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .panel-header {
      padding: 1.5rem;
      border-bottom: 1px solid var(--border);
    }

    .search-box {
      position: relative;
      margin-top: 1rem;
    }

    .search-box input {
      width: 100%;
      background: rgba(0,0,0,0.3);
      border: 1px solid var(--border);
      padding: 0.75rem 1rem 0.75rem 2.5rem;
      border-radius: 12px;
      color: white;
      font-size: 0.875rem;
    }

    .search-box i {
      position: absolute;
      left: 0.75rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      width: 16px;
    }

    .convo-list {
      flex: 1;
      overflow-y: auto;
      padding: 1rem;
    }

    .convo-item {
      padding: 1rem;
      border-radius: 16px;
      margin-bottom: 0.5rem;
      cursor: pointer;
      transition: all 0.2s;
      border: 1px solid transparent;
      display: flex;
      gap: 1rem;
    }

    .convo-item:hover { background: rgba(255,255,255,0.05); }
    .convo-item.active {
      background: rgba(0, 210, 255, 0.05);
      border-color: rgba(0, 210, 255, 0.2);
    }

    .item-avatar {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: #1e293b;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      position: relative;
    }

    .status-badge-mini {
      position: absolute;
      bottom: -2px;
      right: -2px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      border: 2px solid #0b0f1a;
    }

    .status-online { background: var(--accent-green); box-shadow: 0 0 5px var(--accent-green); }
    .status-waiting { background: var(--accent-amber); }
    .status-escalated { background: var(--accent-red); }

    /* Center: Chat */
    .chat-panel {
      background: var(--bg-card);
      backdrop-filter: var(--glass-blur);
      border: 1px solid var(--border);
      border-radius: 24px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);
    }

    .chat-top-header {
      padding: 1.25rem 2rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(255,255,255,0.01);
    }

    .messages-area {
      flex: 1;
      overflow-y: auto;
      padding: 2rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .bubble-wrap { display: flex; flex-direction: column; gap: 0.4rem; max-width: 75%; }
    .bubble-wrap.tenant { align-self: flex-start; }
    .bubble-wrap.support { align-self: flex-end; }

    .chat-bubble {
      padding: 0.875rem 1.25rem;
      border-radius: 18px;
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .tenant .chat-bubble {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      border-bottom-left-radius: 4px;
    }

    .support .chat-bubble {
      background: linear-gradient(135deg, #00d2ff, #3b82f6);
      color: white;
      border-bottom-right-radius: 4px;
      box-shadow: 0 10px 20px rgba(0, 210, 255, 0.2);
    }

    .ai-interjection {
      align-self: center;
      width: 90%;
      background: rgba(99, 102, 241, 0.05);
      border: 1px dashed rgba(99, 102, 241, 0.3);
      border-radius: 12px;
      padding: 1rem;
      font-size: 0.8rem;
      color: #a5b4fc;
      margin: 0.5rem 0;
    }

    .chat-input-box {
      padding: 1.5rem 2rem;
      background: rgba(0,0,0,0.2);
      border-top: 1px solid var(--border);
    }

    .input-inner {
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 0.5rem 1rem;
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .chat-field {
      flex: 1;
      background: transparent;
      border: none;
      color: white;
      outline: none;
      padding: 0.5rem 0;
      font-size: 0.9rem;
    }

    /* Right: Context */
    .context-panel {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      overflow-y: auto;
      padding-right: 0.5rem;
    }

    .context-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 1.5rem;
    }

    .label-caps {
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 1rem;
      display: block;
    }

    .usage-bar {
      height: 6px;
      background: rgba(255,255,255,0.05);
      border-radius: 10px;
      overflow: hidden;
      margin: 0.5rem 0;
    }

    .usage-fill {
      height: 100%;
      background: linear-gradient(to right, var(--primary), #a855f7);
      border-radius: 10px;
    }

    .alert-item {
      display: flex;
      gap: 0.75rem;
      padding: 0.75rem;
      border-radius: 12px;
      background: rgba(239, 68, 68, 0.05);
      border: 1px solid rgba(239, 68, 68, 0.1);
      margin-top: 0.5rem;
    }

    .action-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }

    .mini-btn {
      padding: 0.75rem;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: 12px;
      color: white;
      font-size: 0.75rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      cursor: pointer;
      transition: all 0.2s;
    }

    .mini-btn:hover {
      background: rgba(255,255,255,0.08);
      border-color: var(--primary);
    }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }

  </style>
</head>
<body>
  <div class="app-container">
    
    <header class="support-header">
      <div class="header-content">
        <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--primary); margin-bottom: 0.25rem;">Platform Command</p>
        <h1>Support & Success Center</h1>
        <p>Unified hub for tenant assistance, ticketing, and AI training.</p>
      </div>
      <div class="header-nav">
        <button class="nav-btn">Overview</button>
        <button class="nav-btn">Tickets</button>
        <button class="nav-btn active">Support Inbox</button>
        <button class="nav-btn">Knowledge Base</button>
      </div>
    </header>

    <div class="main-grid">
      <!-- Left: Conversations -->
      <aside class="convo-panel">
        <div class="panel-header">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-size: 1rem; font-weight: 700;">Conversations</h3>
            <span style="background: var(--primary); color: white; padding: 0.1rem 0.5rem; border-radius: 100px; font-size: 0.7rem; font-weight: 800;">12</span>
          </div>
          <div class="search-box">
            <i data-lucide="search"></i>
            <input type="text" placeholder="Search conversations...">
          </div>
          <div style="display: flex; gap: 1rem; margin-top: 1.5rem; font-size: 0.7rem; font-weight: 700; color: var(--text-muted);">
            <span style="color: var(--primary); border-bottom: 2px solid var(--primary); padding-bottom: 0.4rem; cursor: pointer;">All 12</span>
            <span style="cursor: pointer;">Unread 4</span>
            <span style="cursor: pointer;">Mentions 2</span>
          </div>
        </div>
        <div class="convo-list" id="conversationList">
          <!-- Item Example -->
          <div class="convo-item active">
            <div class="item-avatar">
              VS
              <div class="status-badge-mini status-online"></div>
            </div>
            <div style="flex: 1; min-width: 0;">
              <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
                <span style="font-size: 0.85rem; font-weight: 700;">Vision Saloon Owner</span>
                <span style="font-size: 0.65rem; color: var(--text-muted);">2m ago</span>
              </div>
              <p style="font-size: 0.75rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Hi, I need help upgrading my plan to Pro...</p>
            </div>
          </div>
          <!-- More items will be rendered by JS -->
        </div>
      </aside>

      <!-- Center: Chat -->
      <main class="chat-panel">
        <div class="chat-top-header">
          <div style="display: flex; align-items: center; gap: 1rem;">
             <div class="item-avatar" style="width: 40px; height: 40px; background: #064e3b; color: #10b981;">VS</div>
             <div>
               <h4 style="font-size: 0.9rem; font-weight: 700;">Vision Saloon Owner <span style="color: var(--accent-green); font-size: 0.65rem; margin-left: 0.5rem;">● Online</span></h4>
               <p style="font-size: 0.7rem; color: var(--text-muted);">Beauty & Wellness • Joined 2 Aug 2024</p>
             </div>
          </div>
          <div style="display: flex; gap: 0.75rem;">
            <button class="mini-btn" style="background: rgba(16, 185, 129, 0.1); border-color: rgba(16, 185, 129, 0.2); color: #10b981;">
              <i data-lucide="check-circle" style="width: 14px;"></i> Resolve
            </button>
            <button class="mini-btn" style="background: rgba(245, 158, 11, 0.1); border-color: rgba(245, 158, 11, 0.2); color: #f59e0b;">
              <i data-lucide="alert-triangle" style="width: 14px;"></i> Escalate
            </button>
          </div>
        </div>

        <div class="messages-area" id="messageContainer">
          <div class="bubble-wrap tenant">
            <div class="chat-bubble">Hi, I need help upgrading my plan to Pro. How do I do that?</div>
            <span class="msg-meta">10:24 AM</span>
          </div>

          <div class="bubble-wrap support">
            <div class="chat-bubble">Hello! I'd be happy to help you upgrade to the Pro plan. I can initiate the upgrade for you right away.</div>
            <span class="msg-meta">10:25 AM</span>
          </div>

          <div class="ai-interjection">
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
              <i data-lucide="bot" style="width: 14px;"></i>
              <span style="font-weight: 700;">AI Assistant</span>
            </div>
            I found your current plan details. You are currently on the Basic plan. Upgrade to Pro will give you advanced AI call handling, analytics, and priority support.
          </div>

          <div class="bubble-wrap tenant">
            <div class="chat-bubble">Great! Please proceed with the upgrade.</div>
            <span class="msg-meta">10:26 AM</span>
          </div>
        </div>

        <div class="chat-input-box">
          <div class="input-inner">
             <i data-lucide="smile" style="width: 18px; color: var(--text-muted); cursor: pointer;"></i>
             <i data-lucide="paperclip" style="width: 18px; color: var(--text-muted); cursor: pointer;"></i>
             <i data-lucide="mic" style="width: 18px; color: var(--text-muted); cursor: pointer;"></i>
             <input type="text" class="chat-field" id="messageInput" placeholder="Type your message...">
             <button style="width: 32px; height: 32px; border-radius: 8px; background: var(--primary); border: none; color: white; display: flex; align-items: center; justify-content: center; cursor: pointer;">
               <i data-lucide="send" style="width: 16px;"></i>
             </button>
          </div>
        </div>
      </main>

      <!-- Right: Context -->
      <aside class="context-panel">
        <!-- Tenant Info -->
        <div class="context-card">
          <span class="label-caps">Tenant Information</span>
          <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
            <div class="item-avatar" style="width: 52px; height: 52px; background: #3730a3; font-size: 1.2rem;">VS</div>
            <div>
              <h4 style="font-size: 1rem; font-weight: 700;">Vision Saloon Owner</h4>
              <p style="font-size: 0.75rem; color: var(--text-muted);">vision@saloon.com</p>
            </div>
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
             <div class="mini-btn"><i data-lucide="mail" style="width: 14px;"></i></div>
             <div class="mini-btn"><i data-lucide="phone" style="width: 14px;"></i></div>
          </div>
        </div>

        <!-- Plan & Usage -->
        <div class="context-card">
          <span class="label-caps">Subscription & Usage</span>
          <div style="display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 0.5rem;">
            <span style="color: var(--text-muted);">Subscription Plan</span>
            <span style="font-weight: 700; color: var(--primary);">Basic → Pro</span>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 0.5rem;">
            <span style="color: var(--text-muted);">Join Date</span>
            <span>2 Aug 2024</span>
          </div>
          <div style="margin-top: 1.5rem;">
            <div style="display: flex; justify-content: space-between; font-size: 0.7rem; margin-bottom: 0.4rem;">
              <span style="color: var(--text-muted);">Monthly Usage</span>
              <span style="font-weight: 700;">8,450 / 15,000 mins</span>
            </div>
            <div class="usage-bar"><div class="usage-fill" style="width: 56%;"></div></div>
          </div>
          <div style="margin-top: 1rem; display: flex; justify-content: space-between; font-size: 0.8rem;">
            <span style="color: var(--text-muted);">Active AI Agents</span>
            <span style="font-weight: 700;">2 / 5</span>
          </div>
        </div>

        <!-- Recent Tickets -->
        <div class="context-card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <span class="label-caps" style="margin-bottom: 0;">Recent Tickets</span>
            <a href="#" style="font-size: 0.65rem; color: var(--primary); text-decoration: none; font-weight: 700;">View All</a>
          </div>
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
             <div style="display: flex; justify-content: space-between; font-size: 0.75rem;">
               <span style="color: var(--primary);">#TK-2487</span>
               <span style="font-weight: 600;">Upgrade to Pro Plan</span>
               <span style="color: var(--accent-green);">Open</span>
             </div>
             <div style="display: flex; justify-content: space-between; font-size: 0.75rem;">
               <span style="color: var(--primary);">#TK-2461</span>
               <span style="font-weight: 600;">Twilio Number Reset</span>
               <span style="color: var(--text-muted);">Resolved</span>
             </div>
          </div>
        </div>

        <!-- Alerts -->
        <div class="context-card">
           <span class="label-caps">System Alerts</span>
           <div class="alert-item">
             <i data-lucide="alert-circle" style="width: 16px; color: var(--accent-red); flex-shrink: 0;"></i>
             <div>
               <p style="font-size: 0.75rem; font-weight: 700; color: var(--accent-red);">High call drop rate detected</p>
               <p style="font-size: 0.65rem; color: var(--text-muted); margin-top: 0.2rem;">12% increase in failed calls.</p>
             </div>
           </div>
        </div>

        <!-- Quick Actions -->
        <div class="context-card">
           <span class="label-caps">Quick Actions</span>
           <div class="action-grid">
              <button class="mini-btn"><i data-lucide="refresh-cw" style="width: 14px;"></i> Restart AI</button>
              <button class="mini-btn"><i data-lucide="shield-alert" style="width: 14px;"></i> Reset Twilio</button>
              <button class="mini-btn"><i data-lucide="calendar" style="width: 14px;"></i> Sync Cal</button>
              <button class="mini-btn"><i data-lucide="credit-card" style="width: 14px;"></i> Billing</button>
           </div>
        </div>
      </aside>
    </div>
  </div>

  <script src="/js/support-inbox.js"></script>
  <script>
    lucide.createIcons();
    // Scroll messages to bottom
    const container = document.getElementById("messageContainer");
    if (container) container.scrollTop = container.scrollHeight;
  </script>
</body>
</html>

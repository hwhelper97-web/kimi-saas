<div class="tickets-management-container">
    <style>
        .tickets-management-container {
            padding: 0.5rem 0;
            color: var(--support-text, #f8fafc);
            animation: fadeIn 0.4s ease-out;
        }

        .tickets-table-card {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.05);
        }

        .table-header {
            padding: 1.75rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(255, 255, 255, 0.015);
        }

        .tickets-table {
            width: 100%;
            border-collapse: collapse;
        }

        .tickets-table th {
            text-align: left;
            padding: 1.25rem 2rem;
            font-size: 0.75rem;
            font-weight: 800;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            background: rgba(0, 0, 0, 0.2);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }

        .tickets-table td {
            padding: 1.25rem 2rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            font-size: 0.9rem;
            color: #e2e8f0;
            vertical-align: middle;
        }

        .tickets-table tr {
            transition: all 0.2s ease;
        }

        .tickets-table tr:hover {
            background: rgba(0, 242, 255, 0.03);
        }

        .ticket-status {
            display: inline-flex;
            align-items: center;
            padding: 0.35rem 0.85rem;
            border-radius: 9999px;
            font-size: 0.7rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .status-open, .status-in_progress { background: rgba(0, 242, 255, 0.12); color: #00f2ff; border: 1px solid rgba(0, 242, 255, 0.3); box-shadow: 0 0 12px rgba(0, 242, 255, 0.2); }
        .status-resolved, .status-closed { background: rgba(16, 185, 129, 0.12); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); }
        .status-pending { background: rgba(245, 158, 11, 0.12); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3); }

        .priority-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 700;
            font-size: 0.8rem;
            text-transform: capitalize;
        }

        .priority-dot { width: 8px; height: 8px; border-radius: 50%; }
        .priority-urgent, .priority-high { background: #ef4444; box-shadow: 0 0 10px #ef4444; }
        .priority-medium { background: #f59e0b; box-shadow: 0 0 8px #f59e0b; }
        .priority-low { background: #10b981; box-shadow: 0 0 8px #10b981; }

        .action-icon-btn {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #00f2ff;
            width: 36px;
            height: 36px;
            border-radius: 10px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }

        .action-icon-btn:hover {
            background: rgba(0, 242, 255, 0.15);
            border-color: #00f2ff;
            transform: scale(1.08);
            box-shadow: 0 0 12px rgba(0, 242, 255, 0.3);
        }

        /* Modal Overlay */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(3, 7, 18, 0.85);
            backdrop-filter: blur(12px);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .modal-overlay.show {
            display: flex;
            opacity: 1;
        }

        .modal-container {
            width: 90%;
            max-width: 650px;
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(24px);
            border: 1px solid rgba(0, 242, 255, 0.2);
            border-radius: 24px;
            padding: 2rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7), 0 0 30px rgba(0, 242, 255, 0.1);
            transform: scale(0.95);
            transition: transform 0.3s ease;
        }

        .modal-overlay.show .modal-container {
            transform: scale(1);
        }

        .close-modal {
            background: transparent;
            border: none;
            color: #64748b;
            font-size: 1.75rem;
            cursor: pointer;
            transition: color 0.2s;
        }
        .close-modal:hover { color: white; }
    </style>

    <div class="tickets-table-card">
        <div class="table-header">
            <div>
                <h3 style="font-size: 1.25rem; font-weight: 800; color: white;">Ticket History</h3>
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Monitor real-time updates on your support and technical cases.</p>
            </div>
            <button class="apex-btn apex-btn-primary" onclick="loadSection('create-ticket')">
                <i data-lucide="plus" style="width: 16px;"></i> New Ticket
            </button>
        </div>

        <table class="tickets-table">
            <thead>
                <tr>
                    <th>Ticket ID</th>
                    <th>Subject</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="ticketsBody">
                <tr>
                    <td colspan="6" style="text-align: center; padding: 4rem; opacity: 0.5;">
                        <div class="spin" style="width: 24px; height: 24px; border: 2px solid #00f2ff; border-top-color: transparent; border-radius: 50%; margin: 0 auto 1rem;"></div>
                        Synchronizing with Support Hub...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Modal: Ticket Details -->
    <div id="ticketDetailModal" class="modal-overlay">
      <div class="modal-container">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 1.25rem;">
           <div>
              <span id="td_id" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #00f2ff; font-weight: 800; letter-spacing: 0.1em;">TICKET #----</span>
              <h3 id="td_title" style="font-size: 1.35rem; font-weight: 800; color: white; margin-top: 0.35rem;">Loading...</h3>
           </div>
           <button class="close-modal" onclick="closeModal('ticketDetailModal')">&times;</button>
        </div>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin: 1.5rem 0;">
           <div style="background: rgba(255,255,255,0.02); padding: 1rem 1.25rem; border-radius: 16px; border: 1px solid rgba(255,255,255,0.06);">
              <span style="font-size: 0.65rem; color: #64748b; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 0.5rem;">STATUS</span>
              <span id="td_status" class="ticket-status status-open">---</span>
           </div>
           <div style="background: rgba(255,255,255,0.02); padding: 1rem 1.25rem; border-radius: 16px; border: 1px solid rgba(255,255,255,0.06);">
              <span style="font-size: 0.65rem; color: #64748b; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 0.5rem;">PRIORITY</span>
              <div id="td_priority" class="priority-badge">
                 <div class="priority-dot priority-medium"></div>
                 <span id="td_priority_text">Medium</span>
              </div>
           </div>
        </div>

        <div style="background: rgba(255,255,255,0.02); padding: 1.5rem; border-radius: 16px; border: 1px solid rgba(255,255,255,0.06); margin-bottom: 1.75rem;">
           <span style="font-size: 0.65rem; color: #64748b; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 0.75rem;">ISSUE DESCRIPTION</span>
           <p id="td_desc" style="font-size: 0.95rem; line-height: 1.6; color: #cbd5e1; white-space: pre-wrap; margin: 0;"></p>
        </div>

        <div style="display: flex; justify-content: flex-end;">
           <button class="apex-btn apex-btn-secondary" onclick="closeModal('ticketDetailModal')">Close Details</button>
        </div>
      </div>
    </div>

    <script>
        if (window.lucide) window.lucide.createIcons();
        
        let myTickets = [];

        async function fetchTickets() {
            try {
                const res = await fetch("/api/support/tickets", {
                    headers: { "Authorization": "Bearer " + (window.token || localStorage.getItem("accessToken")) }
                });
                const result = await res.json();
                if (result.success && Array.isArray(result.data)) {
                    myTickets = result.data;
                    renderTickets();
                }
            } catch (e) { 
                console.error("Ticket fetch error:", e); 
            }
        }

        function renderTickets() {
            const body = document.getElementById("ticketsBody");
            if (!body) return;
            
            if (!myTickets.length) {
                body.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 4rem; color: #64748b; font-weight: 500;">No support tickets found in your workspace history.</td></tr>';
                return;
            }

            body.innerHTML = myTickets.map(t => {
                const dateStr = t.createdAt ? new Date(t.createdAt).toLocaleDateString() : 'N/A';
                const statusStr = (t.status || 'OPEN').toUpperCase();
                const statusClass = `status-${(t.status || 'open').toLowerCase()}`;
                const priorityStr = (t.priority || 'medium').toLowerCase();
                const priorityClass = `priority-${priorityStr}`;
                const subject = t.subject || t.title || 'Support Ticket Inquiry';

                return `
                    <tr>
                        <td style="font-family: 'JetBrains Mono', monospace; color: #00f2ff; font-weight: 700;">#T-${t.id.substring(0, 5).toUpperCase()}</td>
                        <td style="font-weight: 700; color: white;">${escapeHtml(subject)}</td>
                        <td><span class="ticket-status ${statusClass}">${statusStr}</span></td>
                        <td>
                            <div class="priority-badge">
                                <div class="priority-dot ${priorityClass}"></div>
                                <span>${priorityStr}</span>
                            </div>
                        </td>
                        <td style="color: #64748b; font-size: 0.85rem;">${dateStr}</td>
                        <td>
                            <button class="action-icon-btn" onclick="viewTicket('${t.id}')" title="View Details">
                                <i data-lucide="external-link" style="width: 16px; height: 16px;"></i>
                            </button>
                        </td>
                    </tr>
                `;
            }).join("");
            if (window.lucide) lucide.createIcons();
        }

        function escapeHtml(text) {
            if (!text) return '';
            return text.replace(/[&<>"']/g, function(m) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m];
            });
        }

        function viewTicket(id) {
            const t = myTickets.find(ticket => ticket.id === id);
            if (!t) return;

            const subject = t.subject || t.title || 'Support Ticket Inquiry';
            document.getElementById("td_id").innerText = `TICKET #${t.id.substring(0, 8).toUpperCase()}`;
            document.getElementById("td_title").innerText = subject;
            document.getElementById("td_desc").innerText = t.description || t.content || 'No details provided.';
            
            const statusEl = document.getElementById("td_status");
            const statusStr = (t.status || 'OPEN').toUpperCase();
            statusEl.className = `ticket-status status-${(t.status || 'open').toLowerCase()}`;
            statusEl.innerText = statusStr;

            const priorityDot = document.querySelector("#td_priority .priority-dot");
            const priorityStr = (t.priority || 'medium').toLowerCase();
            if (priorityDot) priorityDot.className = `priority-dot priority-${priorityStr}`;
            document.getElementById("td_priority_text").innerText = priorityStr.charAt(0).toUpperCase() + priorityStr.slice(1);

            const modal = document.getElementById("ticketDetailModal");
            modal.classList.add("show");
            if (window.lucide) lucide.createIcons();
        }

        function closeModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) modal.classList.remove("show");
        }

        fetchTickets();
    </script>
</div>
